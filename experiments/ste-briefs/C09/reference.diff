+    for (let hop = 2; hop <= 9; hop++) snap = engine.traceHop();
+    expect(snap.trace.hop).toBe(9);
+    expect(engine.snapshot().browserDisplay.body).toBe('Updated /about at tick 2');
+    const cdn = engine.snapshot().cdn;
