+    // for a MISS or non-GET pass-through (the pass-through rides the MISS
+    // shape's origin leg without touching the ledger).
+    return withHopPrefix(cdnChainParts(snapshot, from, t), t.edgeStatus === 'HIT' ? 6 : 9);
