+        throw new Error(`webserver: writeFile — unknown fs path "${path}"`);
+      }
+      if (typeof body !== 'string' || body.length === 0) {
+        throw new Error(`webserver: writeFile — body must be a non-empty string`);
+      }
+      fs.set(path, body);
+    },
