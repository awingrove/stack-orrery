@@ -0,0 +1,98 @@
+import { describe, it, expect } from 'vitest';
+import { buildOrreryRings, computeStageLayout, polarToWorld } from '../../js/panel/layout.js';
+import { STAGE6_RINGS, buildStage6Extras } from '../../js/panel/layout-stage6.js';
+
+// Stage-boundary extraction from camera.test.js (guard-file-size): the
+// Stage 6 ring ladder, the DNS/router node seats, and the widete boundY are
+// pinned here so camera.test.js stays inside the 450-line test cap.
+describe('stage 6 layout', () => {
+  it('inherits the stage-5 ring stack and seats the DNS and Router nodes on new spokes', () => {
+    // CHECKS: 8 rings — the stage-5 stack plus RING 7 · DNS, with the client
+    // ring shifted to RING 8 · BROWSERS; radii stay k * ringGap.
+    const rings = buildOrreryRings(400, 6);
+    expect(rings.map((r) => r.id)).toEqual(STAGE6_RINGS.map(([id]) => id));
+    expect(rings.map((r) => r.radius)).toEqual([400, 800, 1200, 1600, 2000, 2400, 2800, 3200]);
+    expect(STAGE6_RINGS.map(([, label]) => label)).toEqual([
+      'RING 1 · DATABASE',
+      'RING 2 · WORKERS',
+      'RING 3 · CACHE',
+      'RING 4 · WEBSERVERS',
+      'RING 5 · LOADBALANCER',
+      'RING 6 · NETWORK',
+      'RING 7 · DNS',
+      'RING 8 · BROWSERS',
+    ]);
+
+    const layout = computeStageLayout(6, 5);
+    // The Router lives beside the 10.x hub (ring-network, 150°); the DNS
+    // ledger sits on the new DNS ring at 205°.
+    expect(layout.nodes['node-router']).toEqual({
+      id: 'node-router',
+      ring: 'ring-network',
+      radius: 2400,
+      angleDeg: 150,
+      ...polarToWorld(2400, 150),
+    });
+    expect(layout.nodes['node-dns']).toEqual({
+      id: 'node-dns',
+      ring: 'ring-dns',
+      radius: 2800,
+      angleDeg: 205,
+      ...polarToWorld(2800, 205),
+    });
+    // The stage-5 nodes all survive: DB, workers, cache, backends, LB, hub.
+    for (const id of [
+      'node-db',
+      'node-queue',
+      'node-worker',
+      'node-cache',
+      'node-lb',
+      'node-network',
+      'node-browser',
+    ]) {
+      expect(layout.nodes[id]).toBeDefined();
+    }
+    // The new wires are spokes like every other stage's: hub -> router and
+    // browser -> dns, all derived from the same stage-5 geometry.
+    const wireIds = layout.wires.map((w) => w.id);
+    expect(wireIds).toContain('wire-network-router');
+    expect(wireIds).toContain('wire-browser-dns');
+    const routerWire = layout.wires.find((w) => w.id === 'wire-network-router');
+    expect(routerWire).toMatchObject({
+      fromId: 'node-network',
+      toId: 'node-router',
+      x1: layout.nodes['node-network'].x,
+      x2: layout.nodes['node-router'].x,
+      y1: layout.nodes['node-network'].y,
+      y2: layout.nodes['node-router'].y,
+    });
+
+    // CHECKS: the camera bounds widen vertically to the extra node reach
+    // (+180 padding), and stages 1-5 bounds stay unchanged by this slice.
+    expect(layout.bounds).toEqual({ minX: -3380, maxX: 120, minY: -1380, maxY: 1380 });
+    expect(computeStageLayout(5, 5).bounds).toEqual({
+      minX: -2980,
+      maxX: 120,
+      minY: -540,
+      maxY: 540,
+    });
+
+    // Unknown stages still fail loud: 7 is not a shipped stage.
+    expect(() => computeStageLayout(7)).toThrow(/expected 1-6/);
+  });
+
+  it('buildStage6Extras derives the router/browser-reach bound and lane wires from real geometry', () => {
+    // The extras builder is layout.js's only stage-6 seat of new nodes; the
+    // reach covers wire endpoints too, so wide browser slots stay inside the
+    // camera bounds.
+    const browser = { x: -3200, y: 0 };
+    const network = { x: -2400, y: 0 };
+    const { nodes, wires, boundY } = buildStage6Extras(400, { network, browser });
+    expect(nodes['node-router'].y).toBe(1200);
+    expect(nodes['node-dns'].y).toBe(-1183);
+    expect(boundY).toBe(1380);
+    expect(wires.map((w) => w.id)).toEqual(['wire-network-router', 'wire-browser-dns']);
+    const dnsWire = wires[1];
+    expect(dnsWire).toMatchObject({ fromId: 'node-browser', toId: 'node-dns', y1: 0, y2: -1183 });
+  });
+});
diff --git a/test/panel/model-stage6.test.js b/test/panel/model-stage6.test.js
new file mode 100644
index 0000000..e949076
--- /dev/null
+++ b/test/panel/model-stage6.test.js
@@ -0,0 +1,170 @@
+import { describe, it, expect } from 'vitest';
+import { describeSnapshot } from '../../js/panel/model.js';
+import { formatComponentState, componentTitle } from '../../js/panel/inspector-state.js';
+
+// Stage-boundary extraction from model.test.js (guard-file-size): the Stage
+// 6 DNS labels and the dns/router inspector state live here so model.test.js
+// stays inside the 450-line test cap.
+const baseSnapshot = {
+  stage: 6,
+  tick: 1,
+  users: 5,
+  serverAddress: '10.1',
+  queueDepth: 0,
+  served: 1,
+  avgLatencyTicks: 1,
+  dns: {
+    address: '10.60',
+    ttlTicks: 300,
+    lookups: 1,
+    cachedHits: 0,
+    authoritative: 1,
+    lastLookup: { name: 'example.com', status: 'AUTH', target: '10.1', atTick: 1 },
+    cache: [{ name: 'example.com', target: '10.1', expiresAtTick: 301, ttlRemaining: 300 }],
+  },
+  router: { address: '10.65', rightAddress: '20.1', routed: 0, lastCross: null },
+  workerQueue: {
+    address: '10.40',
+    workerAddress: '10.41',
+    jobDurationTicks: 2,
+    enqueued: 0,
+    completed: 0,
+    activeJob: null,
+    pendingJobs: [],
+    lastJobResult: null,
+  },
+  trace: {
+    hop: 2,
+    method: 'GET',
+    path: 'example.com/about',
+    host: 'example.com',
+    dnsTarget: '10.1',
+    nx: false,
+    request: 'GET example.com/about',
+    targetServer: '10.11',
+    asyncJob: false,
+    cacheStatus: 'MISS',
+    dbOp: null,
+    dbStale: false,
+    response: '200 This is the about page',
+    status: 200,
+    body: 'This is the about page',
+    routeId: 'about',
+  },
+};
+
+describe('describeSnapshot stage 6', () => {
+  it('describes the hosted 9-hop trace with the DNS ask/answer prelude and ledger labels', () => {
+    const labels = describeSnapshot(baseSnapshot);
+    expect(labels.stage).toBe(6);
+    expect(labels.totalHops).toBe(9);
+    expect(labels.hopStatus).toBe('Hop 2/9: DNS (10.60) -> Browser (10.2) answers 10.1');
+
+    const hopLabels = (hop, over = {}) =>
+      describeSnapshot({ ...baseSnapshot, trace: { ...baseSnapshot.trace, hop, ...over } })
+        .hopStatus;
+    // Hop 1 is the DNS ask — the browser's composure of the GET is not a
+    // wire hop, so no emission sentence exists on a hosted path.
+    expect(hopLabels(1)).toBe('Hop 1/9: Browser (10.2) -> DNS (10.60): who is example.com?');
+    expect(hopLabels(2)).toBe('Hop 2/9: DNS (10.60) -> Browser (10.2) answers 10.1');
+    // Hops 3-9 replay the stage-5 wire chain renumbered behind the prelude;
+    // the re-pointed GET reads its plain path exactly as the real trace
+    // carries it after hop 2.
+    expect(hopLabels(3, { request: 'GET /about' })).toBe(
+      'Hop 3/9: Network (10.x) routes to LoadBalancer (10.1)',
+    );
+    expect(hopLabels(4, { request: 'GET /about' })).toBe(
+      'Hop 4/9: LoadBalancer (10.1) -> 10.11 queue',
+    );
+    expect(hopLabels(5, { request: 'GET /about' })).toBe(
+      'Hop 5/9: Database SKIP — warm cache HIT (10.20)',
+    );
+    expect(hopLabels(6, { request: 'GET /about' })).toBe(
+      'Hop 6/9: WebServer (10.11) -> "200 This is the about page" (cache MISS)',
+    );
+    expect(hopLabels(9, { request: 'GET /about' })).toBe(
+      'Hop 9/9: Worker (10.41) idle — no async jobs in this trace',
+    );
+    expect(hopLabels(10)).toBe('Idle — type a path and click Go or Step 1 Hop ->');
+
+    // The DNS HUD labels mirror the ledger counters and the TTL, and the
+    // entry rows come straight off the snapshot's live Map.
+    expect(labels.dnsStatsLabel).toBe('Lookups: 1 · Cached: 0 · Authoritative: 1 · TTL: 300t');
+    expect(labels.dnsEntries).toEqual(baseSnapshot.dns.cache);
+    expect(labels.routerStatsLabel).toBe('Router 10.65 ⇄ 20.1 · Routed: 0');
+  });
+
+  // CHECKS: named counter-example — the host-less shape keeps the stage-5
+  // story byte-identical (8 hops, no DNS hop, no cross-subnet hop).
+  it('keeps a host-less /about trace at the byte-identical stage-5 sentences', () => {
+    const snap = {
+      ...baseSnapshot,
+      trace: {
+        ...baseSnapshot.trace,
+        hop: 1,
+        host: null,
+        dnsTarget: null,
+      },
+    };
+    const labels = describeSnapshot(snap);
+    // totalHops stays the stage-6 map value (9); the trace-aware final hop
+    // for the host-less shape (8) is panel.js's traceFinalHop contract.
+    expect(labels.totalHops).toBe(9);
+    expect(labels.hopStatus).toBe('Hop 1/8: Browser (10.2) emits "GET example.com/about"');
+    const hopLabels = (hop, over = {}) =>
+      describeSnapshot({ ...snap, trace: { ...snap.trace, hop, ...over } }).hopStatus;
+    expect(hopLabels(2)).toBe('Hop 2/8: Network (10.x) routes to LoadBalancer (10.1)');
+    expect(hopLabels(8)).toBe('Hop 8/8: Worker (10.41) idle — no async jobs in this trace');
+  });
+
+  // PINS: negative case — an NX answer ends the trace at hop 2 and the
+  // narrative never names a GET anywhere downstream: no hop 3, no served
+  // sentence — the browser renders the refusal card instead.
+  it('ends the NX narrative at the answer hop with no GET emitted', () => {
+    const snap = {
+      ...baseSnapshot,
+      trace: {
+        ...baseSnapshot.trace,
+        hop: 2,
+        host: 'nope.example',
+        dnsTarget: null,
+        nx: true,
+      },
+    };
+    const labels = describeSnapshot(snap);
+    expect(labels.hopStatus).toBe(
+      'Hop 2/2: DNS (10.60) -> Browser (10.2): NX no record — no GET emitted',
+    );
+    const after = describeSnapshot({ ...snap, trace: { ...snap.trace, hop: 3 } });
+    expect(after.hopStatus).toBe('Idle — type a path and click Go or Step 1 Hop ->');
+    expect(JSON.stringify(after.hopStatus + after.exchangeSummary)).not.toContain('GET /about');
+
+    // The dns inspector state carries the ledger and both counters; the
+    // router inspector exposes the gateway pair and its cross-subnet tally;
+    // the network table names all three new interfaces.
+    const dnsState = JSON.parse(formatComponentState(snap, 'dns'));
+    expect(dnsState).toEqual({
+      address: '10.60',
+      role: 'authoritative name server',
+      ttlTicks: 300,
+      lookups: 1,
+      cachedHits: 0,
+      authoritative: 1,
+      lastLookup: baseSnapshot.dns.lastLookup,
+      ledger: baseSnapshot.dns.cache,
+    });
+    expect(componentTitle(snap, 'dns')).toBe('DNS — mini-IP 10.60');
+    const routerState = JSON.parse(formatComponentState(snap, 'router'));
+    expect(routerState).toEqual({
+      address: '10.65',
+      rightAddress: '20.1',
+      routedTotal: 0,
+      lastCross: null,
+    });
+    expect(componentTitle(snap, 'router')).toBe('Router — mini-IP 10.65 ⇄ 20.1');
+    const networkState = JSON.parse(formatComponentState(snap, 'network'));
+    expect(networkState.interfaces['10.60']).toBe('DNS');
+    expect(networkState.interfaces['10.65']).toBe('Router (left)');
+    expect(networkState.interfaces['20.1']).toBe('Router (right)');
+  });
+});
