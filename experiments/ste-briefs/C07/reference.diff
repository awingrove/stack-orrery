diff --git a/test/sim/dns.test.js b/test/sim/dns.test.js
new file mode 100644
index 0000000..62cc9d9
--- /dev/null
+++ b/test/sim/dns.test.js
@@ -0,0 +1,90 @@
+import { describe, it, expect } from 'vitest';
+import { createDns } from '../../js/sim/dns.js';
+import { createEngine } from '../../js/sim/engine.js';
+
+describe('createDns', () => {
+  it('answers the authoritative table on a miss, the ledger inside ttlTicks, and evicts on expiry', () => {
+    // CHECKS: the constructor rejects a non-mini-IP address and a
+    // non-positive or non-integer ttlTicks (fail-loud over silent misconfig).
+    expect(() => createDns({ address: '1060' })).toThrow(/invalid mini-IP/);
+    expect(() => createDns({ ttlTicks: 0 })).toThrow(/ttlTicks/);
+    expect(() => createDns({ ttlTicks: 1.5 })).toThrow(/ttlTicks/);
+
+    const dns = createDns({ address: '10.60', ttlTicks: 5 });
+
+    // Cold lookup: a real Map miss against the authoritative table, which
+    // writes the ledger entry (writtenAtTick 5, expiresAtTick 10).
+    expect(dns.lookup('example.com', 5)).toEqual({
+      status: 'OK',
+      target: '10.1',
+      source: 'authoritative',
+    });
+    expect(dns.snapshot(5).cache).toEqual([
+      { name: 'example.com', target: '10.1', expiresAtTick: 10, ttlRemaining: 5 },
+    ]);
+    expect(dns.snapshot(5)).toMatchObject({ lookups: 1, authoritative: 1, cachedHits: 0 });
+
+    // PINS: a hit inside the TTL window is served from the ledger with ZERO
+    // authoritative consults — the counter and the ledger entry carry the proof.
+    expect(dns.lookup('example.com', 9)).toEqual({ status: 'OK', target: '10.1', source: 'cache' });
+    let snap = dns.snapshot(9);
+    expect(snap).toMatchObject({ lookups: 2, cachedHits: 1, authoritative: 1 });
+    expect(snap.lastLookup).toEqual({
+      name: 'example.com',
+      status: 'HIT',
+      target: '10.1',
+      atTick: 9,
+    });
+    expect(snap.cache[0].ttlRemaining).toBe(1);
+
+    // CHECKS: cached at tick T with ttlTicks 5 is responsive THROUGH tick
+    // T + 4 (the cache.js alive-through-ticks rule), and tick T + 5 is the
+    // first tick the entry is gone — the expired entry must NOT be answered
+    // from the ledger: eviction deletes it and the fresh authoritative
+    // consult re-writes it.
+    expect(dns.lookup('example.com', 9).source).toBe('cache');
+    const expired = dns.lookup('example.com', 10);
+    expect(expired).toEqual({ status: 'OK', target: '10.1', source: 'authoritative' });
+    snap = dns.snapshot(10);
+    expect(snap).toMatchObject({ cachedHits: 2, authoritative: 2 });
+    expect(snap.cache[0].expiresAtTick).toBe(15);
+
+    // CHECKS: an unknown name answers NX — the DNS layer never throws on a
+    // name (the throw rule belongs to cross-subnet addresses), and an NX
+    // lookup writes no ledger entry.
+    expect(dns.lookup('nope.example', 10)).toEqual({
+      status: 'NX',
+      name: 'nope.example',
+      source: 'authoritative',
+    });
+    expect(dns.snapshot(10)).toMatchObject({ authoritative: 2 });
+    expect(dns.snapshot(10).cache.map((e) => e.name)).toEqual(['example.com']);
+    expect(dns.snapshot(10).lastLookup.name).toBe('nope.example');
+  });
+
+  // PINS: the engine wires the DNS at 10.60 with the 300t default TTL and
+  // exposes snapshot.dns; stages 1-5 expose no DNS at all.
+  it('stage 6 engine exposes DNS 10.60 and resolves example.com through the trace', () => {
+    const engine = createEngine({ stage: 6 });
+    let snap = engine.snapshot();
+    expect(snap.dns).not.toBe(null);
+    expect(snap.dns.address).toBe('10.60');
+    expect(snap.dns.ttlTicks).toBe(300);
+
+    // The hosted trace really runs the ledger: the ask hop answers
+    // authoritatively and writes the entry; counting the lookup is the
+    // component's own state, not a faked aggregate.
+    for (let hop = 0; hop < 3; hop++) {
+      engine.traceHop({ method: 'GET', path: 'example.com/about' });
+    }
+    snap = engine.snapshot();
+    expect(snap.trace.host).toBe('example.com');
+    expect(snap.trace.dnsTarget).toBe('10.1');
+    expect(snap.dns.authoritative).toBe(1);
+    expect(snap.dns.cache[0]).toMatchObject({ name: 'example.com', target: '10.1' });
+
+    // Stages 1-5 expose no DNS.
+    expect(createEngine({ stage: 1 }).snapshot().dns).toBe(null);
+    expect(createEngine({ stage: 5 }).snapshot().dns).toBe(null);
+  });
+});
diff --git a/test/sim/engine.test.js b/test/sim/engine.test.js
index df79bf5..2c43546 100644
--- a/test/sim/engine.test.js
+++ b/test/sim/engine.test.js
@@ -49,4 +49,101 @@ describe('createEngine', () => {
   it('rejects an arrivalProb outside [0, 1]', () => {
     expect(() => createEngine({ arrivalProb: 1.5 })).toThrow(/arrivalProb/);
   });
+
+  it('rejects a stage outside 1..6', () => {
+    expect(() => createEngine({ stage: 7 })).toThrow(
+      /engine: stage must be 1, 2, 3, 4, 5, or 6, got 7/,
+    );
+  });
+
+  // PINS: the stage-6 trace machine — hosted paths get the DNS ask/answer
+  // prelude (9 hops: ask + answer + the stage-5 wire chain) and never emit
+  // a GET toward a hostname; the stage-5 chain then replays byte-identical.
+  it('traces example.com/about through the DNS ask/answer prelude into the stage-5 chain', () => {
+    const engine = createEngine({ stage: 6 });
+    const frames = [];
+    for (let hop = 1; hop <= 9; hop++) {
+      const snap = engine.traceHop({ method: 'GET', path: 'example.com/about' });
+      expect(snap.trace.hop).toBe(hop);
+      frames.push(snap.lastFrame);
+    }
+    expect(frames).toEqual([
+      '10.2 -> 10.60 | who is example.com?',
+      '10.60 -> 10.2 | 10.1',
+      // Hops 3-9: the stage-5 chain shifted +2, request re-pointed by the
+      // answer — no DNS tokens appear again after hop 2, and no pre-answer
+      // GET frame exists anywhere.
+      'routed 10.2 -> 10.1 (GET /about) to LoadBalancer',
+      'LB 10.1 -> 10.11 (GET /about) queued',
+      'Database SELECT /about @ 10.31 (fresh)',
+      '10.11 -> 10.2 | 200 This is the about page (cache MISS)',
+      'Network delivered 200 response to 10.2',
+      'Browser 10.2 received and displayed 200',
+      'Worker 10.41 idle — no async jobs in this trace',
+    ]);
+    const snap = engine.snapshot();
+    expect(snap.trace.hop).toBe(9);
+    expect(snap.trace.request).toBe('GET /about');
+    expect(snap.trace.dnsTarget).toBe('10.1');
+    // The rendered response landed on the browser exactly once.
+    expect(snap.browserDisplay.body).toBe('This is the about page');
+  });
+
+  // CHECKS: named counter-example — a plain /about path keeps the stage-5
+  // trace shape on stage 6 too: 8 hops, no DNS hop, no cross-subnet hop.
+  it('keeps a host-less /about trace at the stage-5 hop story on stage 6', () => {
+    const engine = createEngine({ stage: 6 });
+    const frames = [];
+    for (let hop = 1; hop <= 8; hop++) {
+      const snap = engine.traceHop({ method: 'GET', path: '/about' });
+      expect(snap.trace.hop).toBe(hop);
+      frames.push(snap.lastFrame);
+    }
+    // Byte-identical to the stage-5 machine's frames.
+    expect(frames).toEqual([
+      '10.2 -> 10.1 | GET /about',
+      'routed 10.2 -> 10.1 (GET /about) to LoadBalancer',
+      'LB 10.1 -> 10.11 (GET /about) queued',
+      'Database SELECT /about @ 10.31 (fresh)',
+      '10.11 -> 10.2 | 200 This is the about page (cache MISS)',
+      'Network delivered 200 response to 10.2',
+      'Browser 10.2 received and displayed 200',
+      'Worker 10.41 idle — no async jobs in this trace',
+    ]);
+    const snap = engine.snapshot();
+    expect(snap.trace.host).toBe(null);
+    expect(snap.dns.lookups).toBe(0);
+  });
+
+  // CHECKS: named counter-example — an NX answer ends the trace at hop 2, no
+  // GET is emitted (no onFinish, served stays 0, and hop 1 is the DNS ask —
+  // the GET never becomes a wire frame), the browser renders the NX card,
+  // and a following traceHop RESTARTS a fresh trace at hop 1 (it cannot walk
+  // a phantom hop 3 of the dead NX trace).
+  it('ends an NX trace at the DNS answer hop without ever emitting a GET', () => {
+    const engine = createEngine({ stage: 6 });
+    let snap = engine.traceHop({ method: 'GET', path: 'missing-host.example/about' });
+    expect(snap.lastFrame).toBe('10.2 -> 10.60 | who is missing-host.example?');
+    snap = engine.traceHop();
+    expect(snap.lastFrame).toBe('10.60 -> 10.2 | NX no record');
+    expect(snap.trace.hop).toBe(2);
+    expect(snap.trace.nx).toBe(true);
+    expect(snap.browserDisplay).toMatchObject({
+      status: 'NX',
+      body: 'NX no record — no GET emitted',
+    });
+    expect(snap.cache.entries).toEqual([]); // no GET ever reached the pool
+    expect(snap.queue).toEqual([]);
+
+    // A fresh traceHop restarts cleanly — hop 1 of a new emission.
+    snap = engine.traceHop({ method: 'GET', path: '/about' });
+    expect(snap.trace.hop).toBe(1);
+    expect(snap.trace.nx).toBe(false);
+    expect(snap.lastFrame).toBe('10.2 -> 10.1 | GET /about');
+    expect(engine.snapshot().served).toBe(0);
+    // And the restarted trace walks the full stage-5 chain to its finish.
+    for (let hop = 2; hop <= 8; hop++) snap = engine.traceHop();
+    expect(snap.trace.hop).toBe(8);
+    expect(snap.browserDisplay.status).toBe(200);
+  });
 });
