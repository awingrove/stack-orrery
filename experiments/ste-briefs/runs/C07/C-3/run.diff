diff --git a/js/sim/router.js b/js/sim/router.js
new file mode 100644
index 0000000..d7feb05
--- /dev/null
+++ b/js/sim/router.js
@@ -0,0 +1,85 @@
+// DOCUMENTS: the Stage 6 cross-subnet Router — a two-interface component
+// joining the 10.x and 20.x network instances. A frame whose destination
+// lives outside its ingress network's subnet takes exactly one router hop
+// (routed +1) and is delivered on the peer network; unknown hosts on the
+// peer side fail loud there ("no server at 20.9" — DL-1, mirroring
+// network.js). Frames addressed to the router's own interfaces answer a
+// slim "200 router": the interfaces are reachable, nothing sits behind
+// them until Stage 6b occupies the 20-side with the CDN edge.
+//
+// CHECKS: both interface addresses must be two-number mini-IPs on distinct
+// subnets, and routing before join() fails loud.
+const MINI_IP = /^\d+\.\d+$/;
+
+const subnetOf = (address) => String(address).split('.')[0];
+
+export function createRouter({ leftAddress = '10.65', rightAddress = '20.1' } = {}) {
+  if (!MINI_IP.test(leftAddress)) {
+    throw new Error(`router: invalid mini-IP address ${leftAddress}`);
+  }
+  if (!MINI_IP.test(rightAddress)) {
+    throw new Error(`router: invalid mini-IP address ${rightAddress}`);
+  }
+  if (subnetOf(leftAddress) === subnetOf(rightAddress)) {
+    throw new Error(
+      `router: interfaces must join two subnets, got ${leftAddress} and ${rightAddress}`,
+    );
+  }
+  let left = null;
+  let right = null;
+  let routed = 0;
+  let lastFrame = null;
+
+  function join({ left: leftNetwork, right: rightNetwork }) {
+    if (!leftNetwork || !rightNetwork) {
+      throw new Error('router: join needs both network instances');
+    }
+    left = leftNetwork;
+    right = rightNetwork;
+  }
+
+  function peerOf(ingress) {
+    if (!left || !right) throw new Error('router: no networks joined');
+    return ingress === 'left' ? right : left;
+  }
+
+  // One hop: hand the frame to the peer network for local delivery first,
+  // then count and name the hop — a dead cross-subnet frame fails loud at
+  // the peer and counts nothing (the throw is the whole story).
+  function route({ from, to, request, side: ingress }) {
+    const peer = peerOf(ingress);
+    const record = peer.deliverRouted({ from, to, request });
+    routed += 1;
+    lastFrame = `${from} -> ${to} routed via ${leftAddress} ⇄ ${rightAddress}`;
+    return record;
+  }
+
+  function routeQueue({ id, from, to, request, atTick, isYou = false, side: ingress }) {
+    const peer = peerOf(ingress);
+    peer.deliverRoutedQueue({ id, from, to, request, atTick, isYou });
+    routed += 1;
+    lastFrame = `${from} -> ${to} routed via ${leftAddress} ⇄ ${rightAddress}`;
+  }
+
+  // The router doubles as a reachable server on each of its interfaces, so
+  // a frame sent to 20.1 (or 10.65) itself answers instead of throwing.
+  function handleRequest() {
+    return '200 router';
+  }
+
+  return {
+    get leftAddress() {
+      return leftAddress;
+    },
+    get rightAddress() {
+      return rightAddress;
+    },
+    join,
+    route,
+    routeQueue,
+    handleRequest,
+    snapshot() {
+      return { leftAddress, rightAddress, routed, lastFrame };
+    },
+  };
+}
