+// DOCUMENTS: the Stage 6 canvas cards — the DNS resolver card
+// (#node-dns, ledger stats + live ledger rows) and the cross-subnet Router
+// side-card (#node-router, routed counter). Built in js rather than
+// panel.html because that page sits at its 550-line cap (same pattern as
+// teaching-drawer.js); panel.js runs this builder before wiring card
+// clicks, so the cards join the .node-card registry like static ones.
+// All content comes from textContent/attributes — no inline styles, no
+// innerHTML (CSP).
+
+function head(name, subtitle) {
+  const headEl = document.createElement('header');
+  headEl.className = 'node-head';
+  const nameEl = document.createElement('div');
+  nameEl.className = 'node-name';
+  const role = document.createElement('span');
+  role.className = 'role-name';
+  role.textContent = name;
+  const sub = document.createElement('span');
+  sub.className = 'node-subtitle';
+  sub.textContent = subtitle;
+  nameEl.append(role, sub);
+  const chip = document.createElement('span');
+  chip.className = 'ip-chip';
+  const code = document.createElement('span');
+  code.className = 'code-chip';
+  code.textContent = '</> Code';
+  headEl.append(nameEl, chip, code);
+  return { headEl, chip };
+}
+
+function card(id, component, name, subtitle, chipText) {
+  const article = document.createElement('article');
+  article.className = 'node-card';
+  article.id = id;
+  article.dataset.testid = id;
+  article.dataset.component = component;
+  article.hidden = true; // render-stage reveals it on stage 6
+  const { headEl, chip } = head(name, subtitle);
+  chip.textContent = chipText;
+  article.append(headEl);
+  return article;
+}
+
+export function buildStage6Nodes() {
+  const world = document.getElementById('orrery-world');
+
+  const dns = card('node-dns', 'dns', 'DNS', 'resolver + TTL ledger', '10.60');
+  const dnsStats = document.createElement('p');
+  dnsStats.id = 'dns-stats';
+  dnsStats.dataset.testid = 'dns-stats';
+  dnsStats.className = 'mono last-frame';
+  dnsStats.textContent = 'Lookups: 0 · Cached: 0 · Auth: 0 · TTL: 300t';
+  const dnsList = document.createElement('ul');
+  dnsList.id = 'dns-entries-list';
+  dnsList.dataset.testid = 'dns-entries-list';
+  dnsList.className = 'route-list';
+  dnsList.setAttribute('aria-label', 'DNS ledger');
+  dns.append(dnsStats, dnsList);
+
+  const router = card(
+    'node-router',
+    'router',
+    'Router',
+    'cross-subnet 10.x ⇄ 20.x',
+    '10.65 ⇄ 20.1',
+  );
+  const routerStats = document.createElement('p');
+  routerStats.id = 'router-stats';
+  routerStats.dataset.testid = 'router-stats';
+  routerStats.className = 'mono last-frame';
+  routerStats.textContent = 'Routed: 0 · Last: none';
+  router.append(routerStats);
+
+  world.append(dns, router);
+}
