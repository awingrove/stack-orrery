diff --git a/test/sim/dns.test.js b/test/sim/dns.test.js
new file mode 100644
index 0000000..257fc23
--- /dev/null
+++ b/test/sim/dns.test.js
@@ -0,0 +1,153 @@
+import { describe, it, expect } from 'vitest';
+import { createDns } from '../../js/sim/dns.js';
+import { createEngine } from '../../js/sim/engine.js';
+
+describe('createDns', () => {
+  it('answers a ledger hit inside ttlTicks with no authoritative consult and re-asks an expired entry', () => {
+    const dns = createDns({ address: '10.60', ttlTicks: 300 });
+
+    // Cold lookup: the authoritative table answers and fills the ledger.
+    expect(dns.lookup('example.com', 0)).toEqual({
+      status: 'OK',
+      name: 'example.com',
+      target: '10.1',
+      source: 'authoritative',
+    });
+    expect(dns.snapshot(0)).toMatchObject({ lookups: 1, cachedHits: 0, authoritative: 1 });
+
+    // PINS: a lookup inside ttlTicks is a ledger hit — cachedHits moves and
+    // the authoritative counter stays put (no second consult).
+    expect(dns.lookup('example.com', 5)).toEqual({
+      status: 'OK',
+      name: 'example.com',
+      target: '10.1',
+      source: 'ledger',
+    });
+    expect(dns.lookup('example.com', 299)).toEqual({
+      status: 'OK',
+      name: 'example.com',
+      target: '10.1',
+      source: 'ledger',
+    });
+    expect(dns.snapshot(299)).toMatchObject({ lookups: 3, cachedHits: 2, authoritative: 1 });
+    expect(dns.snapshot(299).cache).toEqual([
+      {
+        name: 'example.com',
+        target: '10.1',
+        cachedAtTick: 0,
+        expiresAtTick: 300,
+        ttlRemaining: 1,
+      },
+    ]);
+
+    // PINS (named counter-example): the entry expired at tick 300 — the
+    // lookup re-asks the authoritative table instead of answering from the
+    // ledger, and the fill restarts the TTL.
+    expect(dns.lookup('example.com', 300)).toEqual({
+      status: 'OK',
+      name: 'example.com',
+      target: '10.1',
+      source: 'authoritative',
+    });
+    expect(dns.snapshot(300)).toMatchObject({ lookups: 4, cachedHits: 2, authoritative: 2 });
+    expect(dns.snapshot(300).cache).toEqual([
+      {
+        name: 'example.com',
+        target: '10.1',
+        cachedAtTick: 300,
+        expiresAtTick: 600,
+        ttlRemaining: 300,
+      },
+    ]);
+
+    // CHECKS: the constructor rejects a non-mini-IP address and a
+    // non-positive or non-integer ttlTicks (fail-loud over silent misconfig).
+    expect(() => createDns({ address: '1060' })).toThrow(/invalid mini-IP/);
+    expect(() => createDns({ ttlTicks: 0 })).toThrow(/ttlTicks/);
+    expect(() => createDns({ ttlTicks: 2.5 })).toThrow(/ttlTicks/);
+  });
+
+  it('answers unknown names with NX no record and keeps the DNS layer throw-free', () => {
+    const dns = createDns();
+
+    // CHECKS: an unknown name answers NX from the lookup itself — the DNS
+    // layer does not throw on names; the throw rule lives at the network
+    // layer for unregistered addresses.
+    expect(dns.lookup('nope.example', 4)).toEqual({ status: 'NX', name: 'nope.example' });
+    const snap = dns.snapshot(4);
+    expect(snap).toMatchObject({ lookups: 1, cachedHits: 0, authoritative: 1 });
+    expect(snap.lastLookup).toEqual({
+      name: 'nope.example',
+      status: 'NX',
+      target: null,
+      atTick: 4,
+    });
+    // A failed lookup leaves no ledger entry behind to answer later.
+    expect(snap.cache).toEqual([]);
+  });
+});
+
+describe('stage 6 engine DNS wiring', () => {
+  it('stage 6 engine resolves hosted paths through DNS 10.60 with exactly two extra hops and leaves host-less paths at the stage-5 story', () => {
+    const engine = createEngine({ stage: 6 });
+    let snap = engine.snapshot();
+    expect(snap.dns).not.toBe(null);
+    expect(snap.dns.address).toBe('10.60');
+    expect(snap.dns.ttlTicks).toBe(300);
+    expect(snap.router).not.toBe(null);
+    expect(snap.router.leftAddress).toBe('10.65');
+    expect(snap.router.rightAddress).toBe('20.1');
+
+    // Hosted path: 10 hops = the stage-5 8-hop chain + 2 DNS hops. The GET
+    // rides the wire host-stripped; the authoritative consult fills the
+    // ledger once.
+    for (let hop = 0; hop < 10; hop++)
+      engine.traceHop({ method: 'GET', path: 'example.com/about' });
+    snap = engine.snapshot();
+    expect(snap.trace.hop).toBe(10);
+    expect(snap.trace.totalHops).toBe(10);
+    expect(snap.trace.request).toBe('GET example.com/about');
+    expect(snap.trace.dns).toMatchObject({ host: 'example.com', status: 'MISS', target: '10.1' });
+    expect(snap.dns).toMatchObject({ lookups: 1, cachedHits: 0, authoritative: 1 });
+    expect(snap.browserDisplay.body).toBe('This is the about page');
+
+    // A second hosted trace is a ledger hit with no authoritative consult.
+    for (let hop = 0; hop < 10; hop++)
+      engine.traceHop({ method: 'GET', path: 'example.com/about' });
+    snap = engine.snapshot();
+    expect(snap.trace.dns).toMatchObject({ host: 'example.com', status: 'HIT', target: '10.1' });
+    expect(snap.dns).toMatchObject({ lookups: 2, cachedHits: 1, authoritative: 1 });
+
+    // PINS (named counter-example): the host-less GET /about keeps the
+    // stage-5 hop count and story — no DNS hop fires and the DNS ledger
+    // does not move.
+    for (let hop = 0; hop < 8; hop++) engine.traceHop({ method: 'GET', path: '/about' });
+    snap = engine.snapshot();
+    expect(snap.trace.hop).toBe(8);
+    expect(snap.trace.totalHops).toBe(8);
+    expect(snap.trace.dns).toBe(null);
+    expect(snap.dns).toMatchObject({ lookups: 2, cachedHits: 1, authoritative: 1 });
+    expect(snap.browserDisplay.body).toBe('This is the about page');
+
+    // PINS: an unknown hosted name never emits a GET — the trace is the
+    // DNS ask plus the NX answer (3 hops), and no server serves anything.
+    const servedBefore = snap.served;
+    for (let hop = 0; hop < 3; hop++)
+      engine.traceHop({ method: 'GET', path: 'nope.example/about' });
+    snap = engine.snapshot();
+    expect(snap.trace.hop).toBe(3);
+    expect(snap.trace.totalHops).toBe(3);
+    expect(snap.dns).toMatchObject({ lookups: 3, authoritative: 2, cachedHits: 1 });
+    expect(snap.browserDisplay.status).toBe('NX');
+    expect(snap.browserDisplay.body).toBe('no record for nope.example');
+    expect(snap.served).toBe(servedBefore);
+
+    // Stages 1-5 expose no DNS and no router at all.
+    for (const stage of [1, 2, 3, 4, 5]) {
+      const bare = createEngine({ stage }).snapshot();
+      expect(bare.dns).toBe(null);
+      expect(bare.router).toBe(null);
+    }
+    expect(() => createEngine({ stage: 7 })).toThrow(/stage must be 1, 2, 3, 4, 5, or 6/);
+  });
+});
