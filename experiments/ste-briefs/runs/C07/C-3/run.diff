+}`,
+  },
+  dns: {
+    file: 'js/sim/dns.js',
+    code: `createDns({ address = '10.60', ttlTicks = 300,
+  records = { 'example.com': '10.1' } } = {}) {
+  const entries = new Map();  // name -> { target, cachedAtTick, expiresAtTick }
+  let lookups = 0, cachedHits = 0, authoritative = 0, lastLookup = null;
+  function lookup(name, currentTick = 0) {
+    lookups += 1;
+    const entry = entries.get(name);
+    if (entry && currentTick < entry.expiresAtTick) {  // ledger hit inside TTL
+      cachedHits += 1;                                // no authoritative consult
+      return { status: 'OK', name, target: entry.target, source: 'ledger' };
+    }
+    if (entry) entries.delete(name);  // expired: re-ask, do not answer stale
+    authoritative += 1;               // consult the authoritative table
+    const target = records[name] ?? null;
+    if (target) {
+      entries.set(name, { target, cachedAtTick: currentTick,
+        expiresAtTick: currentTick + ttlTicks });
+      return { status: 'OK', name, target, source: 'authoritative' };
+    }
+    return { status: 'NX', name };    // unknown names answer NX, no throw
+  }
+  function snapshot(currentTick = 0) { /* evict expired, expose counters */ }
+  return { address, lookup, snapshot };
+}`,
+  },
+  router: {
+    file: 'js/sim/router.js',
+    code: `createRouter({ leftAddress = '10.65', rightAddress = '20.1' } = {}) {
+  // both interfaces must be "<net>.<host>" mini-IPs on distinct subnets
+  let left = null, right = null, routed = 0, lastFrame = null;
+  function join({ left, right }) { /* both network instances attach here */ }
+  function route({ from, to, request, side: ingress }) {
+    const peer = ingress === 'left' ? right : left;
+    const record = peer.deliverRouted({ from, to, request });  // deliver first
+    routed += 1;   // a dead cross-subnet frame fails loud and counts nothing
+    lastFrame = \`\${from} -> \${to} routed via \${leftAddress} ⇄ \${rightAddress}\`;
+    return record;
+  }
+  function handleRequest() { return '200 router'; }  // the interfaces answer
+  return { leftAddress, rightAddress, join, route, routeQueue, handleRequest, snapshot };
 }`,
   },
 };
