diff --git a/test/sim/router.test.js b/test/sim/router.test.js
new file mode 100644
index 0000000..6a81676
--- /dev/null
+++ b/test/sim/router.test.js
@@ -0,0 +1,113 @@
+import { describe, it, expect } from 'vitest';
+import { createNetwork } from '../../js/sim/network.js';
+import { createRouter } from '../../js/sim/router.js';
+import { createWebServer } from '../../js/sim/webserver.js';
+import { createBrowser } from '../../js/sim/browser.js';
+
+describe('createRouter', () => {
+  it('routes a cross-subnet frame through exactly one router hop while same-subnet sends stay unchanged', () => {
+    const left = createNetwork({ subnet: '10' });
+    const right = createNetwork({ subnet: '20' });
+    const router = createRouter();
+    router.join({ left, right });
+    left.attachRouter(router, 'left');
+    right.attachRouter(router, 'right');
+    const homeServer = createWebServer({ address: '10.1' });
+    const edgeServer = createWebServer({ address: '20.2' });
+    left.registerServer('10.1', homeServer);
+    right.registerServer('20.2', edgeServer);
+    left.registerServer('10.65', router);
+    right.registerServer('20.1', router);
+
+    // Same-subnet passthrough: the send bypasses the router, exactly like
+    // the stage 1-5 wire contract.
+    expect(left.send({ from: '10.2', to: '10.1', request: 'GET /about' })).toEqual({
+      from: '10.2',
+      to: '10.1',
+      request: 'GET /about',
+      response: '200 This is the about page',
+    });
+    expect(router.snapshot()).toMatchObject({ routed: 0, lastFrame: null });
+
+    // PINS: a cross-subnet frame takes exactly one router hop (routed 1)
+    // and comes back as the plain wire record.
+    expect(left.send({ from: '10.2', to: '20.2', request: 'GET /' })).toEqual({
+      from: '10.2',
+      to: '20.2',
+      request: 'GET /',
+      response: '200 Welcome to the home page',
+    });
+    expect(router.snapshot().routed).toBe(1);
+    expect(router.snapshot().lastFrame).toBe('10.2 -> 20.2 routed via 10.65 ⇄ 20.1');
+
+    // The reverse direction hops through the router too.
+    expect(right.send({ from: '20.2', to: '10.1', request: 'GET /' }).response).toBe(
+      '200 Welcome to the home page',
+    );
+    expect(router.snapshot().routed).toBe(2);
+
+    // Queue delivery crosses the same way, one hop per frame.
+    left.deliverToQueue({
+      id: '1:1',
+      from: '10.2',
+      to: '20.2',
+      request: 'GET /',
+      atTick: 1,
+      isYou: true,
+    });
+    expect(router.snapshot().routed).toBe(3);
+    expect(edgeServer.queueSnapshot()).toEqual([
+      { id: '1:1', from: '10.2', to: '20.2', request: 'GET /', atTick: 1, isYou: true },
+    ]);
+
+    // CHECKS: the router's own interfaces are reachable endpoints on both
+    // sides; nothing behind them answers until Stage 6b.
+    expect(left.send({ from: '10.2', to: '10.65', request: 'GET /' }).response).toBe('200 router');
+    expect(right.send({ from: '20.2', to: '20.1', request: 'GET /' }).response).toBe('200 router');
+    expect(router.snapshot().routed).toBe(3);
+
+    // CHECKS: same-subnet unknown hosts still fail plain — no routed hop
+    // fires for a destination inside the sender's own subnet.
+    expect(() => left.send({ from: '10.2', to: '10.9', request: 'GET /' })).toThrow(
+      /no server at 10\.9/,
+    );
+    expect(router.snapshot().routed).toBe(3);
+
+    // CHECKS: the constructor rejects non-mini-IP interfaces and two
+    // interfaces on the same subnet (a router joins distinct subnets).
+    expect(() => createRouter({ leftAddress: '1065' })).toThrow(/invalid mini-IP/);
+    expect(() => createRouter({ rightAddress: 'x.1' })).toThrow(/invalid mini-IP/);
+    expect(() => createRouter({ leftAddress: '10.65', rightAddress: '10.66' })).toThrow(
+      /two subnets/,
+    );
+    expect(() =>
+      createRouter().route({ from: '10.2', to: '20.2', request: 'GET /', side: 'left' }),
+    ).toThrow(/no networks joined/);
+  });
+
+  // PINS: a send into subnet 20 to an unregistered host (20.9) fails loud
+  // at the peer network after the single router hop's bookkeeping is not
+  // even reached — the router counts nothing for a dead frame.
+  it('fails loud on an unregistered cross-subnet host like 20.9', () => {
+    const left = createNetwork({ subnet: '10' });
+    const right = createNetwork({ subnet: '20' });
+    const router = createRouter();
+    router.join({ left, right });
+    left.attachRouter(router, 'left');
+    right.attachRouter(router, 'right');
+
+    expect(() => left.send({ from: '10.2', to: '20.9', request: 'GET /' })).toThrow(
+      /no server at 20\.9/,
+    );
+    expect(router.snapshot().routed).toBe(0);
+    expect(() =>
+      left.deliverToQueue({ id: '1:1', from: '10.2', to: '20.9', request: 'GET /', atTick: 1 }),
+    ).toThrow(/no server at 20\.9/);
+    expect(router.snapshot().routed).toBe(0);
+
+    // The browser-facing end of the same story: a browser get() into
+    // subnet 20 to an unregistered host throws instead of rendering.
+    const browser = createBrowser({ address: '10.2', network: left });
+    expect(() => browser.get('20.9', '/')).toThrow(/no server at 20\.9/);
+  });
+});
