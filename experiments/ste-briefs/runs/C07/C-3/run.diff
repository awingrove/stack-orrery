@@ -0,0 +1,128 @@
+import { test, expect } from '@playwright/test';
+
+// Stage 6 (stage6a brief §5): DNS 10.60 with a tick-TTL answer ledger, the
+// cross-subnet Router 10.65 ⇄ 20.1, and the hosted-path trace grammar. The
+// sim runs from a fixed seed, so hop counts and counters are identical on
+// every run. Titles are manifest pins (SIM-6 / PANEL-6): do not reword.
+
+test('should switch to Stage 6, resolve example.com through DNS 10.60, and inspect DNS code + TTL ledger', async ({
+  page,
+}) => {
+  await page.goto('/panel.html');
+
+  await page.getByTestId('stage-pill-6').click();
+  await expect(page.getByTestId('stage-pill-6')).toHaveAttribute('aria-current', 'true');
+  // The 8-ring registry: DNS takes Ring 7 under the Network, whose hub now
+  // also carries the Router side-card.
+  await expect(page.getByTestId('node-dns')).toBeVisible();
+  await expect(page.getByTestId('node-router')).toBeVisible();
+  await expect(page.locator('.orrery-ring')).toHaveCount(8);
+  await expect(page.locator('.orrery-ring').first()).toHaveAttribute('r', '400');
+  await expect(page.locator('.orrery-ring').last()).toHaveAttribute('r', '3200');
+  await expect(page.getByTestId('dns-stats')).toHaveText(
+    'Lookups: 0 · Cached: 0 · Auth: 0 · TTL: 300t',
+  );
+  await expect(page.getByTestId('router-stats')).toHaveText('Routed: 0 · Last: none');
+
+  // A hosted trace resolves example.com -> 10.1: the ledger fills with the
+  // authoritative consult (Lookups 1, Auth 1) and the row shows the TTL.
+  await page.getByTestId('url-input').fill('example.com/about');
+  for (let hop = 0; hop < 10; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText('Hop 10/10');
+  await expect(page.getByTestId('dns-stats')).toHaveText(
+    'Lookups: 1 · Cached: 0 · Auth: 1 · TTL: 300t',
+  );
+  await expect(page.getByTestId('dns-entries-list')).toContainText('example.com -> 10.1');
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+  await expect(page.getByTestId('router-stats')).toHaveText('Routed: 0 · Last: none');
+
+  // The DNS card opens its executable code and live ledger in the inspector.
+  await page.getByTestId('node-dns').click();
+  await expect(page.getByTestId('inspector-code')).toContainText('createDns');
+  await expect(page.getByTestId('inspector-state')).toContainText('"authoritative": 1');
+  await expect(page.getByTestId('inspector-title')).toHaveText('DNS — mini-IP 10.60');
+
+  await page.getByTestId('node-router').click();
+  await expect(page.getByTestId('inspector-code')).toContainText('createRouter');
+  await expect(page.getByTestId('inspector-title')).toHaveText('Router — 10.65 ⇄ 20.1');
+});
+
+test('should trace example.com/about with DNS ask + answer hops', async ({ page }) => {
+  await page.goto('/panel.html?stage=6');
+
+  await page.getByTestId('url-input').fill('example.com/about');
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText('Hop 1/10');
+  await expect(page.getByTestId('hop-status')).toContainText(
+    'Browser (10.2) emits "GET example.com/about"',
+  );
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText(
+    'Hop 2/10: Browser (10.2) asks DNS (10.60) — example.com = ?',
+  );
+  await expect(page.getByTestId('node-dns')).toHaveClass(/active-hop/);
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText(
+    'Hop 3/10: DNS (10.60) answers example.com = 10.1 (authoritative)',
+  );
+  // The journey log labels the run with the hosted trace's own total.
+  await expect(page.getByTestId('journey-log')).toContainText('hop 3/10');
+
+  // The next hosted trace is a ledger hit with no authoritative consult:
+  // 7 hops finish trace 1, then the full 10-hop run 2.
+  for (let hop = 0; hop < 17; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('dns-stats')).toHaveText(
+    'Lookups: 2 · Cached: 1 · Auth: 1 · TTL: 300t',
+  );
+  await expect(page.getByTestId('hop-status')).toContainText('Hop 10/10');
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+});
+
+// Negative-case pin (stage6a brief §Negative-case 1): a host-less GET
+// /about on stage 6 keeps the stage-5 hop story — 8 hops, no DNS hop, no
+// cross-subnet hop, and the DNS ledger does not move.
+test('should keep GET /about on Stage 6 at the Stage 5 hop story', async ({ page }) => {
+  await page.goto('/panel.html?stage=6');
+
+  await page.getByTestId('url-input').fill('/about');
+  for (let hop = 0; hop < 8; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText('Hop 8/8');
+  await expect(page.getByTestId('dns-stats')).toHaveText(
+    'Lookups: 0 · Cached: 0 · Auth: 0 · TTL: 300t',
+  );
+  await expect(page.getByTestId('dns-entries-list')).not.toContainText('example.com');
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+  await expect(page.getByTestId('router-stats')).toHaveText('Routed: 0 · Last: none');
+
+  // The unknown-name dead-end: nope.example/about answers NX at hop 3 and
+  // nothing is served — the DNS ledger moves, no GET fires.
+  await page.getByTestId('url-input').fill('nope.example/about');
+  for (let hop = 0; hop < 3; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText(
+    'Hop 3/3: DNS (10.60) answers NX no record for nope.example',
+  );
+  await expect(page.getByTestId('browser-status-badge')).toContainText('NX');
+  await expect(page.getByTestId('dns-stats')).toHaveText(
+    'Lookups: 1 · Cached: 0 · Auth: 1 · TTL: 300t',
+  );
+  // No GET fired for the unknown name: the last served exchange stays the
+  // one the earlier /about trace produced.
+  await expect(page.getByTestId('exchange-inspector')).toHaveText(
+    '10.2 -> 10.11 GET /about => 200 This is the about page',
+  );
+});
+
+// Negative-case pin (stage6a brief §Negative-case 5): the live ?stage= set
+// extends to 6, and unknown values still fall back to stage 1.
+test('should deep-link ?stage=6 into the DNS stage and still fall back on unknown stages', async ({
+  page,
+}) => {
+  await page.goto('/panel.html?stage=6&users=8');
+  await expect(page.getByTestId('stage-pill-6')).toHaveAttribute('aria-current', 'true');
+  await expect(page.getByTestId('node-dns')).toBeVisible();
+  await expect(page.getByTestId('user-dots').locator('> *')).toHaveCount(8);
+
+  await page.goto('/panel.html?stage=9');
+  await expect(page.getByTestId('stage-pill-1')).toHaveAttribute('aria-current', 'true');
+  await expect(page.getByTestId('server-address')).toHaveText('10.1');
+});
