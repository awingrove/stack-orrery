diff --git a/js/sim/dns.js b/js/sim/dns.js
new file mode 100644
index 0000000..f4f7107
--- /dev/null
+++ b/js/sim/dns.js
@@ -0,0 +1,88 @@
+// DOCUMENTS: the Stage 6 component — a resolver with a small authoritative
+// table and a tick-TTL answer ledger (cache.js's ledger pattern applied to
+// names). lookup(name, currentTick) answers a live ledger entry straight
+// from the ledger (cachedHits) with no authoritative consult; a miss or an
+// expired entry consults the authoritative table and fills the ledger;
+// unknown names answer NX at the DNS layer without throwing — the fail-loud
+// throw rule lives at the network layer for addresses, not names here.
+// Deterministic by construction: no clock, no RNG — time arrives as the
+// `currentTick` argument, the same way the WebServer keeps time.
+//
+// CHECKS: the constructor rejects an address that is not a two-number
+// mini-IP and a ttlTicks that is not a positive integer (fail-loud over
+// silent mis-configuration, mirroring cache.js).
+export function createDns({
+  address = '10.60',
+  ttlTicks = 300,
+  records = { 'example.com': '10.1' },
+} = {}) {
+  if (!/^\d+\.\d+$/.test(address)) {
+    throw new Error(`dns: invalid mini-IP address ${address}`);
+  }
+  if (!Number.isInteger(ttlTicks) || ttlTicks < 1) {
+    throw new Error(`dns: ttlTicks must be a positive integer, got ${ttlTicks}`);
+  }
+  const entries = new Map(); // name -> { name, target, cachedAtTick, expiresAtTick }
+  let lookups = 0;
+  let cachedHits = 0;
+  let authoritative = 0;
+  let lastLookup = null;
+
+  // An entry is stale the moment the current tick reaches its expiry:
+  // filled at tick T with ttlTicks = 300 means alive through tick T + 299.
+  function lookup(name, currentTick = 0) {
+    lookups += 1;
+    const entry = entries.get(name);
+    if (entry && currentTick < entry.expiresAtTick) {
+      cachedHits += 1;
+      lastLookup = { name, status: 'HIT', target: entry.target, atTick: currentTick };
+      return { status: 'OK', name, target: entry.target, source: 'ledger' };
+    }
+    // An expired entry is dropped here, before the authoritative consult —
+    // the ledger answers nothing past its own expiry tick.
+    if (entry) entries.delete(name);
+    authoritative += 1;
+    const target = Object.prototype.hasOwnProperty.call(records, name) ? records[name] : null;
+    if (target) {
+      entries.set(name, {
+        name,
+        target,
+        cachedAtTick: currentTick,
+        expiresAtTick: currentTick + ttlTicks,
+      });
+      lastLookup = { name, status: 'MISS', target, atTick: currentTick };
+      return { status: 'OK', name, target, source: 'authoritative' };
+    }
+    lastLookup = { name, status: 'NX', target: null, atTick: currentTick };
+    return { status: 'NX', name };
+  }
+
+  function snapshot(currentTick = 0) {
+    for (const [name, entry] of entries) {
+      if (currentTick >= entry.expiresAtTick) entries.delete(name);
+    }
+    return {
+      address,
+      ttlTicks,
+      lookups,
+      cachedHits,
+      authoritative,
+      lastLookup,
+      cache: [...entries.values()].map((e) => ({
+        name: e.name,
+        target: e.target,
+        cachedAtTick: e.cachedAtTick,
+        expiresAtTick: e.expiresAtTick,
+        ttlRemaining: e.expiresAtTick - currentTick,
+      })),
+    };
+  }
+
+  return {
+    get address() {
+      return address;
+    },
+    lookup,
+    snapshot,
+  };
+}
