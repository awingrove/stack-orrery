diff --git a/js/panel/legend-drawer.js b/js/panel/legend-drawer.js
new file mode 100644
index 0000000..2a95c74
--- /dev/null
+++ b/js/panel/legend-drawer.js
@@ -0,0 +1,56 @@
+// DOCUMENTS: the HUD legend drawer content — the app's own glossary (tick
+// clock, cache stats trio, Ring 3 site chips, wire-lane direction labels).
+// Built in js rather than panel.html because that page sits at its 550-line
+// cap; the toggle button stays in the HTML, and this builder creates the
+// hidden aside once at boot. All content comes from textContent — no
+// innerHTML, no inline styles (CSP).
+
+function legendRow(parts) {
+  const row = document.createElement('p');
+  row.className = 'legend-row';
+  for (const part of parts) {
+    if (typeof part === 'string') {
+      row.append(document.createTextNode(part));
+    } else {
+      const code = document.createElement('code');
+      code.textContent = part.code;
+      row.append(code);
+    }
+  }
+  return row;
+}
+
+export function initLegendDrawer() {
+  const panel = document.createElement('aside');
+  panel.id = 'legend-panel';
+  panel.dataset.testid = 'legend-panel';
+  panel.className = 'legend-panel';
+  panel.hidden = true; // closed by default: the first view is the orrery
+  panel.setAttribute('aria-label', 'Legend');
+  panel.append(
+    legendRow([
+      'Clock — tick = 100 ms (sim time advances in explicit ticks, ',
+      { code: 'TICK_MS = 100' },
+      ' in ',
+      { code: 'js/panel/model.js' },
+      '). Wire lanes name the direction: ',
+      { code: 'request =>' },
+      ', ',
+      { code: '<- response' },
+      ', ',
+      { code: 'enqueue =>' },
+      ', ',
+      { code: 'write =>' },
+      '.',
+    ]),
+    legendRow([
+      'Cache — the ',
+      { code: 'Hits / Misses / TTL-remaining' },
+      ' trio counts warm lookups, cold lookups, and ticks left per entry. Ring 3 ',
+      { code: 'site' },
+      " chips are the compact browsers' mini-IPs; click one to expand it.",
+    ]),
+  );
+  document.querySelector('.camera-hud').after(panel);
+  return panel;
+}
