@@ -0,0 +1,189 @@
+import { describe, it, expect } from 'vitest';
+import { describeSnapshot } from '../../js/panel/model.js';
+import { componentTitle, formatComponentState } from '../../js/panel/inspector-state.js';
+
+// Stage 6 trace-shape pins (stage6a brief §5). A snapshot here is the same
+// shape the engine emits; the narrative builders are pure, so the unit
+// suite pins the branch conditions directly. The three negative-case
+// contracts live at the bottom of this file.
+const baseSnapshot = (trace) => ({
+  stage: 6,
+  tick: 3,
+  users: 5,
+  serverAddress: '10.1',
+  queueDepth: 0,
+  served: 1,
+  avgLatencyTicks: 1,
+  servers: [
+    { address: '10.11', queueDepth: 1, served: 1, queue: [] },
+    { address: '10.12', queueDepth: 0, served: 0, queue: [] },
+  ],
+  loadBalancer: { address: '10.1', nextBackend: '10.12', perBackend: { 10.11: 1, 10.12: 0 } },
+  workerQueue: { workerAddress: '10.41' },
+  cache: { address: '10.20' },
+  database: { primaryAddress: '10.30', replicaAddress: '10.31', replicationLagTicks: 3 },
+  dns: { address: '10.60', ttlTicks: 300, lookups: 1, cachedHits: 0, authoritative: 1, cache: [] },
+  router: { leftAddress: '10.65', rightAddress: '20.1', routed: 0, lastFrame: null },
+  browserDisplay: {
+    from: '10.2',
+    to: '10.1',
+    request: 'GET /about',
+    response: '200 This is the about page',
+    status: 200,
+    body: 'This is the about page',
+  },
+  trace,
+});
+
+describe('stage 6 hop narratives', () => {
+  it('stage 6 host-less GET /about keeps the stage-5 hop story byte-identical', () => {
+    // Named counter-example (stage6a brief §Negative-case 1): a host-less
+    // path carries no host, so the narrative and its denominators stay the
+    // stage-5 strings — no DNS hop is inserted anywhere.
+    const labels = describeSnapshot(
+      baseSnapshot({
+        hop: 4,
+        kind: 'plain',
+        totalHops: 8,
+        method: 'GET',
+        path: '/about',
+        request: 'GET /about',
+        targetServer: '10.11',
+        cacheStatus: 'MISS',
+        dbOp: 'SELECT',
+        dbStale: false,
+        status: 200,
+        response: '200 This is the about page',
+      }),
+    );
+    expect(labels.totalHops).toBe(8);
+    // Stage 5's hop 4 is the database hop; the host-less stage-6 sentence
+    // is byte-identical to it (the walk below pins all eight).
+    expect(labels.hopStatus).toBe('Hop 4/8: Database SELECT @ Replica (10.31) — fresh');
+    // Walk every hop and compare against the stage-5 sentences verbatim.
+    for (let hop = 1; hop <= 8; hop++) {
+      const snap = baseSnapshot({
+        hop,
+        kind: 'plain',
+        totalHops: 8,
+        request: 'GET /about',
+        targetServer: '10.11',
+        cacheStatus: 'MISS',
+        dbOp: 'SELECT',
+        dbStale: false,
+        status: 200,
+        response: '200 This is the about page',
+      });
+      const stage5 = describeSnapshot({ ...snap, stage: 5, trace: { ...snap.trace } });
+      expect(describeSnapshot(snap).hopStatus).toBe(stage5.hopStatus);
+    }
+  });
+
+  it('stage 6 hosted example.com/about adds exactly two DNS hops to the stage-5 story', () => {
+    const labels = describeSnapshot(
+      baseSnapshot({
+        hop: 3,
+        kind: 'hosted',
+        totalHops: 10,
+        method: 'GET',
+        path: '/about',
+        request: 'GET example.com/about',
+        dns: { host: 'example.com', path: '/about', status: 'MISS', target: '10.1' },
+        targetServer: null,
+        status: null,
+        response: null,
+      }),
+    );
+    expect(labels.totalHops).toBe(10);
+    expect(labels.hopStatus).toBe(
+      'Hop 3/10: DNS (10.60) answers example.com = 10.1 (authoritative)',
+    );
+    // Hop 2 is the ask; the ledger-hit variant names the cache, and the
+    // chain hops pick the stage-5 bodies back up two hops later.
+    const ask = describeSnapshot(
+      baseSnapshot({
+        hop: 2,
+        kind: 'hosted',
+        totalHops: 10,
+        request: 'GET example.com/about',
+        dns: { host: 'example.com', path: '/about', status: null, target: null },
+      }),
+    );
+    expect(ask.hopStatus).toBe('Hop 2/10: Browser (10.2) asks DNS (10.60) — example.com = ?');
+    const hit = describeSnapshot(
+      baseSnapshot({
+        hop: 3,
+        kind: 'hosted',
+        totalHops: 10,
+        request: 'GET example.com/about',
+        dns: { host: 'example.com', path: '/about', status: 'HIT', target: '10.1' },
+      }),
+    );
+    expect(hit.hopStatus).toBe('Hop 3/10: DNS (10.60) answers example.com = 10.1 (cache HIT)');
+    const chain = describeSnapshot(
+      baseSnapshot({
+        hop: 5,
+        kind: 'hosted',
+        totalHops: 10,
+        request: 'GET example.com/about',
+        path: '/about',
+        dns: { host: 'example.com', path: '/about', status: 'HIT', target: '10.1' },
+        targetServer: '10.11',
+        status: 200,
+        response: '200 This is the about page',
+        cacheStatus: 'MISS',
+      }),
+    );
+    expect(chain.hopStatus).toBe('Hop 5/10: LoadBalancer (10.1) -> 10.11 queue');
+  });
+
+  it('stage 6 NX trace never emits a GET and renders the NX card', () => {
+    // Named counter-example (stage6a brief §Negative-case 3): the trace is
+    // the DNS ask plus the NX answer, 3 hops total — no served exchange
+    // exists, and the browser card renders the NX record.
+    const nx = describeSnapshot({
+      ...baseSnapshot({
+        hop: 3,
+        kind: 'hosted',
+        totalHops: 3,
+        request: 'GET nope.example/about',
+        dns: { host: 'nope.example', path: '/about', status: 'NX', target: null },
+      }),
+      browserDisplay: {
+        from: '10.2',
+        to: '10.60',
+        request: 'GET nope.example/about',
+        response: 'NX no record for nope.example',
+        status: 'NX',
+        body: 'no record for nope.example',
+      },
+    });
+    expect(nx.totalHops).toBe(3);
+    expect(nx.hopStatus).toBe('Hop 3/3: DNS (10.60) answers NX no record for nope.example');
+    expect(nx.browserStatus).toBe('NX (GET nope.example/about)');
+    expect(nx.browserBody).toBe('no record for nope.example');
+  });
+
+  it('derives the DNS and Router inspector headlines and live state from the snapshot', () => {
+    const snapshot = baseSnapshot({ hop: 0, kind: 'plain', totalHops: 8 });
+    expect(componentTitle(snapshot, 'dns')).toBe('DNS — mini-IP 10.60');
+    expect(componentTitle(snapshot, 'router')).toBe('Router — 10.65 ⇄ 20.1');
+    const dnsState = JSON.parse(formatComponentState(snapshot, 'dns'));
+    expect(dnsState).toEqual({
+      address: '10.60',
+      ttlTicks: 300,
+      lookups: 1,
+      cachedHits: 0,
+      authoritative: 1,
+      lastLookup: null,
+      cache: [],
+    });
+    const routerState = JSON.parse(formatComponentState(snapshot, 'router'));
+    expect(routerState).toEqual({
+      leftAddress: '10.65',
+      rightAddress: '20.1',
+      routed: 0,
+      lastFrame: null,
+    });
+  });
+});
