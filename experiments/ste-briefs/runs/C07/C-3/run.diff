new file mode 100644
index 0000000..4b0c0a5
--- /dev/null
+++ b/js/sim/trace-dns.js
@@ -0,0 +1,52 @@
+// DOCUMENTS: the Stage 6 DNS segment of the hop-by-hop trace machine — the
+// three hosted-path hops before the Stage 5 chain takes over (emit, ask,
+// answer) and the NX dead-end that ends a trace with no GET on the wire.
+// Split from trace.js by responsibility (guard-file-size): the segment owns
+// no state of its own — it mutates the trace record the machine hands in
+// and consults the real DNS component's lookup() ledger.
+//
+// CHECKS: the host/path split fires only on a path that carries a host
+// ("<host>/<path>", first-slash grammar); a plain "/<path>" stays host-less
+// and the machine keeps the Stage 5 story hop for hop.
+
+// Returns { host, suffix } for a hosted path ("example.com/about"), or null
+// when the path is host-less ("/about") and no DNS hop may be inserted.
+export function splitHostPath(path = '') {
+  const raw = String(path);
+  if (raw.startsWith('/')) return null;
+  const slashAt = raw.indexOf('/');
+  if (slashAt === -1) return { host: raw, suffix: '/' };
+  return { host: raw.slice(0, slashAt), suffix: raw.slice(slashAt) };
+}
+
+// Hop 2: the browser asks DNS; the ledger lookup runs here, so the counters
+// move once per hosted trace. An unknown name pins the trace to the 3-hop
+// NX dead-end (ask + answer, nothing else).
+export function stepDnsAsk(trace, { dns, getTick }) {
+  const answer = dns.lookup(trace.dns.host, getTick());
+  // The trace narrates the ledger outcome: a live entry answered from the
+  // ledger is a HIT, an authoritative consult (or an unknown name) is a
+  // MISS / NX.
+  trace.dns.status = answer.status === 'NX' ? 'NX' : answer.source === 'ledger' ? 'HIT' : 'MISS';
+  trace.dns.target = answer.target ?? null;
+  if (answer.status === 'NX') trace.totalHops = 3;
+  return `${trace.from} -> ${dns.address} | ${trace.dns.host} ?`;
+}
+
+// Hop 3: the DNS answer rides back to the browser. A hit names the ledger
+// state ("cache HIT") versus the authoritative consult; an NX answer is
+// delivered to the browser as the rendered record — no GET follows it.
+export function stepDnsAnswer(trace, { dns, onFinish }) {
+  if (trace.dns.status === 'NX') {
+    const response = `NX no record for ${trace.dns.host}`;
+    onFinish({
+      from: trace.from,
+      to: dns.address,
+      request: trace.request,
+      response,
+    });
+    return `${dns.address} -> ${trace.from} | ${response}`;
+  }
+  const how = trace.dns.status === 'HIT' ? 'cache HIT' : 'authoritative';
+  return `${dns.address} -> ${trace.from} | ${trace.dns.host} = ${trace.dns.target} (${how})`;
+}
