new file mode 100644
index 0000000..04cf64e
--- /dev/null
+++ b/js/sim/trace-hops.js
@@ -0,0 +1,53 @@
+// DOCUMENTS: shared per-hop actions for the trace machine (trace.js) —
+// drain the target's queue until the learner's own request comes back,
+// apply a served record to the trace, finish a run, pick a backend, and
+// build the shared database-op frame text. Split from trace.js by
+// responsibility (guard-file-size): trace.js owns the hop state machine,
+// this module the primitive actions each hop performs.
+
+// Serve from the front of the target's queue until the trace's own
+// request (isYou) comes back, or the queue runs dry this tick.
+export function drainUntilYou(targetServer, getTick) {
+  for (;;) {
+    const batch = targetServer.step(getTick());
+    const you = batch.find((item) => item.isYou);
+    if (you || batch.length === 0) return you;
+  }
+}
+
+export function backendFor(servers, targetAddress) {
+  return servers.find((s) => s.address === targetAddress) ?? servers[0];
+}
+
+// Apply a served record to the trace and hand it to the engine's onServe
+// callback (the engine records the exchange and matched route from it).
+export function applyServe(trace, you, onServe) {
+  trace.response = you.response;
+  trace.status = you.status;
+  trace.body = you.body;
+  trace.routeId = you.routeId;
+  onServe(you);
+}
+
+// Final hop: the rendered response lands on the browser the trace
+// originated from (the engine routes it into the right browser state).
+export function finishTrace(trace, toAddress, request, onFinish) {
+  onFinish({
+    from: trace.from ?? '10.2',
+    to: toAddress,
+    request,
+    response: trace.response,
+  });
+}
+
+// The WRITE / SELECT / SKIP frame text shared by the Stage 4 and Stage 5
+// database hops — one builder so both stages narrate identically.
+export function dbOpFrame(trace, database, cache) {
+  if (trace.dbOp === 'WRITE') {
+    return `Database WRITE ${trace.path} @ ${database.primaryAddress} (replica ${database.replicaAddress} lags ${database.replicationLagTicks}t)`;
+  }
+  if (trace.dbOp === 'SELECT') {
+    return `Database SELECT ${trace.path} @ ${database.replicaAddress} (${trace.dbStale ? 'STALE' : 'fresh'})`;
+  }
+  return `Database SKIP ${trace.path} (warm cache HIT @ ${cache.address})`;
+}
