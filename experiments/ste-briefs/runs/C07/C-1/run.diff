diff --git a/js/sim/router.js b/js/sim/router.js
new file mode 100644
index 0000000..f7325e6
--- /dev/null
+++ b/js/sim/router.js
@@ -0,0 +1,68 @@
+// DOCUMENTS: the Stage 6 cross-subnet Router — joins two Network instances
+// (the 10.x fabric and the 20.x fabric) so a frame addressed outside its own
+// subnet crosses exactly one router hop: the near network hands the record
+// to the router's gateway closure, the router counts it in `routed`, and the
+// far network delivers it locally. `isYou` rides through untouched on queue
+// deliveries. In Stage 6a nothing lives in subnet 20 besides the router's
+// own presence: its 20-side interface (20.1) is the only reachable target,
+// and an unregistered 20.x host (20.9) fails loud through the far network's
+// resolve.
+//
+// CHECKS: the constructor rejects a non two-number mini-IP interface and two
+// interfaces on the same subnet (a router between one subnet is not a
+// router).
+const MINI_IP = /^\d+\.\d+$/;
+
+export function createRouter({ leftAddress = '10.65', rightAddress = '20.1' } = {}) {
+  for (const [name, addr] of [
+    ['leftAddress', leftAddress],
+    ['rightAddress', rightAddress],
+  ]) {
+    if (!MINI_IP.test(addr)) {
+      throw new Error(`router: invalid mini-IP address ${name}=${addr}`);
+    }
+  }
+  const leftNet = String(leftAddress).split('.')[0];
+  const rightNet = String(rightAddress).split('.')[0];
+  if (leftNet === rightNet) {
+    throw new Error(`router: both interfaces live in subnet ${leftNet}`);
+  }
+  let routed = 0;
+  let lastRoute = null;
+
+  // The router's own interface answer — in Stage 6a the 20.1 side is the
+  // only thing alive in subnet 20 (Stage 6b occupies it with the CDN edge).
+  const handleRequest = () => `200 router ${rightAddress}`;
+
+  // CHECKS: one forward call per cross-subnet frame — `routed` counts frames
+  // entering the router, so a delivery that then fails loud in the far
+  // subnet still counted its single hop (pinned in test/sim/router.test.js).
+  function forward(record, farNetwork) {
+    routed += 1;
+    lastRoute = `${record.from} -> ${record.to} via ${leftAddress} ⇄ ${rightAddress}`;
+    return farNetwork.receiveCrossSubnet(record);
+  }
+
+  return {
+    get leftAddress() {
+      return leftAddress;
+    },
+    get rightAddress() {
+      return rightAddress;
+    },
+
+    handleRequest,
+
+    join(leftNetwork, rightNetwork) {
+      leftNetwork.attachGateway((record) => forward(record, rightNetwork));
+      rightNetwork.attachGateway((record) => forward(record, leftNetwork));
+      leftNetwork.registerServer(leftAddress, { handleRequest });
+      rightNetwork.registerServer(rightAddress, { handleRequest });
+      return this;
+    },
+
+    snapshot() {
+      return { leftAddress, rightAddress, routed, lastRoute };
+    },
+  };
+}
diff --git a/js/sim/trace-stage6.js b/js/sim/trace-stage6.js
new file mode 100644
index 0000000..12a747d
--- /dev/null
+++ b/js/sim/trace-stage6.js
@@ -0,0 +1,169 @@
+// DOCUMENTS: the Stage 6 trace wrapper around the hop-by-hop machine. A
+// hosted browser path ("<host>/<path>") prepends two DNS hops — Browser ->
+// DNS 10.60 ask, then the DNS answer — before the resolved path is handed to
+// an inner Stage 5 machine unmodified, so the Stage 6 host-less story stays
+// byte-identical to Stage 5's (named counter-example: GET /about on Stage 6
+// keeps the Stage 5 hop count and hop texts). A name the resolver answers NX
+// short-circuits: DNS ask + "NX no record" answer + the browser rendering
+// the NX card, and no GET is emitted.
+//
+// CHECKS: the wrapper fails loud at construction unless the stage is 6 and a
+// DNS component is attached. Hosted runs delegate to a fresh inner machine
+// per run, so a trace abandoned mid-flight (host-less then hosted) starts
+// clean instead of riding the previous run's hop state.
+import { createTraceMachine } from './trace.js';
+
+export function createStage6Trace({ stage, dns, ...config }) {
+  if (stage !== 6) {
+    throw new Error(`trace-stage6: stage must be 6, got ${stage}`);
+  }
+  if (!dns) {
+    throw new Error('trace-stage6: no DNS component attached');
+  }
+  const inner = createTraceMachine({ ...config, stage: 5 });
+
+  // Host split on the first "/": "example.com/about" -> { host, rest }.
+  // A path starting with "/" (or any string with no leading host token) is
+  // host-less; a bare name ("example.com") resolves against the root path.
+  function splitHost(path) {
+    const raw = String(path ?? '');
+    const slashAt = raw.indexOf('/');
+    if (slashAt <= 0) return null;
+    return { host: raw.slice(0, slashAt), rest: raw.slice(slashAt) };
+  }
+
+  // Per-run hosted state; null means the current trace is host-less and the
+  // inner machine owns everything. `next` names the NEXT action; `hop` is
+  // the hop the snapshot reports (the one just executed).
+  let run = null;
+
+  function startRun(split, method, from) {
+    return {
+      host: split.host,
+      rest: split.rest,
+      method,
+      from,
+      next: 'ask',
+      hop: 0,
+      nx: false,
+      done: false,
+      answer: null,
+      inner: createTraceMachine({ ...config, stage: 5 }),
+    };
+  }
+
+  function hostTrace(response, status, body) {
+    return {
+      hop: run.hop,
+      method: run.method,
+      path: `${run.host}${run.rest}`,
+      request: `${run.method} ${run.host}${run.rest}`,
+      from: run.from,
+      targetServer: null,
+      cacheStatus: null,
+      dbOp: null,
+      dbStale: false,
+      asyncJob: false,
+      response,
+      status,
+      body,
+      routeId: null,
+      hosted: true,
+      nx: run.nx,
+      dnsName: run.host,
+      dnsAddress: dns.address,
+      dnsAnswer: run.answer,
+    };
+  }
+
+  return {
+    // One hop per call, mirroring the inner machine's contract: the hop's
+    // lastFrame string, or null when nothing moved. An in-flight hosted run
+    // continues on its own state (the caller's path argument only matters
+    // when the next trace starts), the same way the inner machine owns its
+    // state mid-trace.
+    step({ method = 'GET', path = '/about', from = '10.2' } = {}) {
+      if (!run || run.done) {
+        const split = splitHost(path);
+        if (!split) {
+          run = null;
+          return inner.step({ method, path, from });
+        }
+        run = startRun(split, method, from);
+      }
+      if (run.next === 'ask') {
+        run.next = 'answer';
+        run.hop = 1;
+        // The consult happens when the ask lands: the answer hop narrates
+        // the stored result, so an NX verdict is known from hop 1 on and
+        // the trace's total reads 3, not 10.
+        const result = dns.lookup(run.host, config.getTick());
+        if (result.status === 'NX') {
+          run.nx = true;
+          run.answer = 'NX no record';
+        } else {
+          const how = result.status === 'HIT' ? 'cache HIT' : 'authoritative';
+          run.answer = `${run.host} is ${result.target} (${how})`;
+        }
+        return `${run.from} -> ${dns.address} | resolve ${run.host}`;
+      }
+      if (run.next === 'answer') {
+        run.hop = 2;
+        if (run.nx) {
+          run.next = 'nx-render';
+        } else {
+          run.next = 'delegate';
+        }
+        return `${dns.address} -> ${run.from} | ${run.answer}`;
+      }
+      if (run.next === 'nx-render') {
+        run.next = 'done';
+        run.hop = 3;
+        run.done = true;
+        // The NX record is what the browser card renders; no GET is emitted,
+        // so nothing is served and no queue row exists.
+        config.onFinish({
+          from: run.from,
+          to: run.from,
+          request: `${run.method} ${run.host}${run.rest}`,
+          response: 'NX no record',
+        });
+        return `Browser ${run.from} renders NX — no record for ${run.host}`;
+      }
+      // delegate: the browser emits the GET with the resolved target; the
+      // inner Stage 5 machine runs the tail of the story unmodified.
+      const frame = run.inner.step({ method: run.method, path: run.rest, from: run.from });
+      run.hop = 2 + run.inner.snapshot().hop;
+      if (run.hop >= 10) run.done = true;
+      return frame;
+    },
+
+    snapshot() {
+      if (!run) {
+        return {
+          ...inner.snapshot(),
+          hosted: false,
+          nx: false,
+          dnsName: null,
+          dnsAddress: dns.address,
+          dnsAnswer: null,
+        };
+      }
+      if (run.next === 'delegate') {
+        return {
+          ...run.inner.snapshot(),
+          hop: run.hop,
+          hosted: true,
+          nx: false,
+          dnsName: run.host,
+          dnsAddress: dns.address,
+          dnsAnswer: run.answer,
+        };
+      }
+      // NX carries its answer as the rendered record from hop 2 onward; the
+      // ask and answer hops report no served exchange yet.
+      const nx = run.nx && run.hop >= 2;
+      return hostTrace(nx ? 'NX no record' : null, nx ? 'NX' : null, nx ? 'no record' : null);
+    },
+  };
+}
