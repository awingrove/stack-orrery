+// DOCUMENTS: the Stage 6 DNS resolver — an authoritative name table plus a
+// resolver cache with tick-based TTL, mirroring the Cache ledger pattern
+// (js/sim/cache.js): a lookup consults the authoritative table only on a
+// cache miss or an expired entry; a hit inside ttlTicks increments
+// cachedHits with no authoritative consult. Deterministic by construction:
+// no clock, no RNG — time arrives as the `currentTick` argument.
+//
+// CHECKS: the constructor rejects an address that is not a two-number
+// mini-IP and a ttlTicks that is not a positive integer (fail-loud over
+// silent mis-configuration). An unknown name answers { status: 'NX' } — the
+// NX case is a normal answer at the DNS layer, not a throw (the fail-loud
+// throw rule applies to cross-subnet addresses in network.js).
+export function createDns({ address = '10.60', ttlTicks = 300 } = {}) {
+  if (!/^\d+\.\d+$/.test(address)) {
+    throw new Error(`dns: invalid mini-IP address ${address}`);
+  }
+  if (!Number.isInteger(ttlTicks) || ttlTicks < 1) {
+    throw new Error(`dns: ttlTicks must be a positive integer, got ${ttlTicks}`);
+  }
+  // Authoritative table lives in-component: Stage 6a resolves example.com;
+  // Stage 6b adds the CDN name.
+  const AUTHORITATIVE = new Map([['example.com', '10.1']]);
+  const cache = new Map(); // name -> { name, target, expiresAtTick }
+  let lookups = 0;
+  let cachedHits = 0;
+  let authoritative = 0;
+  let evictions = 0;
+  let lastLookup = null;
+
+  // CHECKS: an expired entry is deleted before it can answer — the named
+  // counter-example (an expired entry answered from the ledger) is pinned in
+  // test/sim/dns.test.js.
+  function evictExpired(currentTick = 0) {
+    for (const entry of cache.values()) {
+      if (currentTick >= entry.expiresAtTick) {
+        cache.delete(entry.name);
+        evictions += 1;
+      }
+    }
+  }
+
+  function lookup(name, currentTick = 0) {
+    lookups += 1;
+    const entry = cache.get(name);
+    if (entry && currentTick < entry.expiresAtTick) {
+      cachedHits += 1;
+      lastLookup = { name, status: 'HIT', target: entry.target, atTick: currentTick };
+      return { status: 'HIT', target: entry.target };
+    }
+    if (entry) {
+      cache.delete(name);
+      evictions += 1;
+    }
+    authoritative += 1;
+    const record = AUTHORITATIVE.get(name);
+    if (!record) {
+      lastLookup = { name, status: 'NX', atTick: currentTick };
+      return { status: 'NX' };
+    }
+    cache.set(name, { name, target: record, expiresAtTick: currentTick + ttlTicks });
+    lastLookup = { name, status: 'MISS', target: record, atTick: currentTick };
+    return { status: 'MISS', target: record };
+  }
+
+  function snapshot(currentTick = 0) {
+    evictExpired(currentTick);
+    return {
+      address,
+      ttlTicks,
+      lookups,
+      cachedHits,
+      authoritative,
+      evictions,
+      lastLookup,
+      cache: [...cache.values()].map((e) => ({
+        name: e.name,
+        target: e.target,
+        expiresAtTick: e.expiresAtTick,
+        ttlRemaining: e.expiresAtTick - currentTick,
+      })),
+    };
+  }
+
