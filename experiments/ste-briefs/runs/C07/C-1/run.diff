+++ b/js/panel/lanes.js
@@ -0,0 +1,48 @@
+// DOCUMENTS: wire-lane anchoring config, split from viewport.js by
+// responsibility (guard-file-size: viewport.js sits at its 300-line cap and
+// Stage 6 adds the DNS and Router lanes). Each stage maps a lane element id
+// to the wire it sits on (optionally at a fraction t down that wire —
+// Stage 5 anchors the cache→db lane at t = 0.3 so it clears the queue→worker
+// crossing); LANES_BETWEEN anchors a lane between two parallel wires, with
+// an optional cap toward a card the lane would otherwise clip.
+export const LANE_WIRES = {
+  1: { 'wire-col-left': 'wire-browser-network', 'wire-col-right': 'wire-network-webserver' },
+  2: { 'wire-col-left': 'wire-browser-network', 'wire-col-right': 'wire-network-lb' },
+  3: { 'wire-col-left': 'wire-browser-network', 'wire-col-right': 'wire-network-lb' },
+  4: {
+    'wire-col-left': 'wire-browser-network',
+    'wire-col-right': 'wire-network-lb',
+    'wire-cache-db': 'wire-cache-db',
+  },
+  5: {
+    'wire-col-left': 'wire-browser-network',
+    'wire-col-right': 'wire-network-lb',
+    'wire-cache-db': ['wire-cache-db', 0.3],
+    'wire-cache-queue': 'wire-cache-queue',
+    'wire-queue-worker': 'wire-queue-worker',
+  },
+  6: {
+    'wire-col-left': 'wire-browser-network',
+    'wire-col-right': 'wire-network-lb',
