--- /dev/null
+++ b/js/panel/layout-stage6.js
@@ -0,0 +1,44 @@
+// DOCUMENTS: Stage 6 orrery additions — the 8-ring registry (DNS 10.60 on
+// Ring 7, the Router side-card beside the 10.x hub on Ring 6) and the two
+// wires the stage adds (browser -> DNS ask, Network -> Router). Split from
+// layout.js by responsibility (guard-file-size: layout.js sits at its
+// 300-line cap); layout.js hands in its geometry helpers so the Stage 1-5
+// outputs stay byte-identical.
+export function stage6RingSpecs(stage) {
+  if (stage !== 6) return null;
+  return [
+    ['ring-db', 'RING 1 · DATABASE'],
+    ['ring-workers', 'RING 2 · WORKERS'],
+    ['ring-cache', 'RING 3 · CACHE'],
+    ['ring-compute', 'RING 4 · WEBSERVERS'],
+    ['ring-lb', 'RING 5 · LOADBALANCER'],
+    ['ring-network', 'RING 6 · NETWORK'],
+    ['ring-dns', 'RING 7 · DNS'],
+    ['ring-clients', 'RING 8 · BROWSERS'],
+  ];
+}
+
+export function addStage6Nodes({ rings, nodes, wires, pos, makeWire }) {
+  const dnsRing = rings.find((ring) => ring.id === 'ring-dns');
+  const networkRing = rings.find((ring) => ring.id === 'ring-network');
+  nodes['node-dns'] = pos('node-dns', 'ring-dns', dnsRing.radius, 180);
+  // The Router renders as a side-card on the Network ring, off the 10.x
+  // hub's 180° seat, with its own chord wire.
+  nodes['node-router'] = pos('node-router', 'ring-network', networkRing.radius, 160);
+  wires.push(
+    makeWire(
+      'wire-browser-dns',
+      'node-browser',
+      'node-dns',
+      nodes['node-browser'],
+      nodes['node-dns'],
+    ),
+    makeWire(
+      'wire-network-router',
+      'node-network',
+      'node-router',
+      nodes['node-network'],
+      nodes['node-router'],
+    ),
+  );
+}
