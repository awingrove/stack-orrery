diff --git a/js/panel/layout-satellites.js b/js/panel/layout-satellites.js
new file mode 100644
index 0000000..4357a06
--- /dev/null
+++ b/js/panel/layout-satellites.js
@@ -0,0 +1,26 @@
+// DOCUMENTS: browser-slot arc geometry, split from layout.js by
+// responsibility (guard-file-size: layout.js sits at its 300-line cap and
+// Stage 6 needs room for its 8-ring registry). The satellite arcs place the
+// non-expanded browsers around the outer client ring; slot 0 keeps the
+// expanded card's 180° seat by construction.
+export function computeSatellites(users, outerRadius) {
+  const count = Math.max(0, Math.round(users));
+  const leftCount = Math.ceil(count / 2);
+  const rightCount = count - leftCount;
+  const satellites = [];
+  const place = (arcCount, startAngle) => {
+    for (let j = 0; j < arcCount; j += 1) {
+      const angleDeg = startAngle + ((j + 1) / (arcCount + 1)) * 37;
+      const { x, y } = polarToWorld(outerRadius, angleDeg);
+      satellites.push({ index: satellites.length, x, y, angleDeg });
+    }
+  };
+  place(leftCount, 135);
+  place(rightCount, 188);
+  return satellites;
+}
+
+export function polarToWorld(radius, angleDeg) {
+  const rad = (angleDeg * Math.PI) / 180;
+  return { x: Math.round(radius * Math.cos(rad)), y: Math.round(radius * Math.sin(rad)) };
+}
diff --git a/js/panel/layout-stage6.js b/js/panel/layout-stage6.js
new file mode 100644
