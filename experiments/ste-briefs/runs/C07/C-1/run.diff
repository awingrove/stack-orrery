index 0000000..cf51293
--- /dev/null
+++ b/e2e/panel-stage6.spec.js
@@ -0,0 +1,145 @@
+import { test, expect } from '@playwright/test';
+
+// Stage 6 — DNS (10.60, tick-TTL ledger) + cross-subnet Router (10.65 ⇄
+// 20.1). These assertions live in their own spec (guard-file-size splits
+// e2e by responsibility, as with orrery-plane.spec.js — panel.spec.js sits
+// at its 450-line cap). The sim runs from a fixed seed, so the trace
+// sequences — and therefore these pins — are identical on every run.
+
+// The full hosted story: stage 6 renders 8 rings with the DNS card and the
+// Router side-card, a 10-hop "example.com/about" trace resolves through
+// DNS 10.60 (ask, answer, then the Stage 5 chain), warms the ledger entry,
+// and the DNS code + live TTL ledger open in the inspector.
+test('should switch to Stage 6, resolve example.com through DNS 10.60, and inspect DNS code + TTL ledger', async ({
+  page,
+}) => {
+  await page.goto('/panel.html?stage=6');
+
+  await expect(page.getByTestId('stage-pill-6')).toHaveAttribute('aria-current', 'true');
+  await expect(page.getByTestId('node-dns')).toBeVisible();
+  await expect(page.getByTestId('node-router')).toBeVisible();
+  await expect(page.getByTestId('node-queue')).toBeVisible();
+  await expect(page.locator('.orrery-ring')).toHaveCount(8);
+  await expect(page.locator('.orrery-ring').first()).toHaveAttribute('r', '400');
+  await expect(page.locator('.orrery-ring').last()).toHaveAttribute('r', '3200');
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 0 · Cached hits: 0 · TTL: 300t');
+  await expect(page.getByTestId('router-stats')).toHaveText('Routed: 0 · 10.65 ⇄ 20.1');
+
+  await page.getByTestId('url-input').fill('example.com/about');
+  for (let hop = 0; hop < 10; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText('Hop 10/10');
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 1 · Cached hits: 0 · TTL: 300t');
+  await expect(page.getByTestId('dns-entries-list')).toContainText('example.com -> 10.1 · ttl');
+
+  await page.getByTestId('node-dns').click();
+  await expect(page.getByTestId('inspector-code')).toContainText('createDns');
+  await expect(page.getByTestId('inspector-state')).toContainText('"lookups": 1');
+  await expect(page.getByTestId('node-router').locator('.ip-chip')).toHaveText('10.65 ⇄ 20.1');
+});
+
+// The two DNS hops are their own narrated hops: the ask, the answer naming
+// the resolved mini-IP, and then the browser emits the GET — and a second
+// hosted trace answers from the ledger (Cached hits 1, no new consult).
+test('should trace example.com/about with DNS ask + answer hops', async ({ page }) => {
+  await page.goto('/panel.html?stage=6');
+
+  await page.getByTestId('url-input').fill('example.com/about');
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 1/10: Browser (10.2) asks DNS (10.60) for example.com',
+  );
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 2/10: DNS (10.60) -> 10.2 | example.com is 10.1 (authoritative)',
+  );
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 3/10: Browser (10.2) emits "GET /about"',
+  );
+  for (let hop = 0; hop < 7; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText('Hop 10/10');
+
+  await page.getByTestId('btn-url-go').click();
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 2 · Cached hits: 1 · TTL: 300t');
+  await expect(page.getByTestId('dns-entries-list')).toContainText('example.com -> 10.1');
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+});
+
+// Negative-case pin (the brief's named counter-example): a host-less GET
+// /about on Stage 6 produces the Stage 5 hop story byte-identical — same 8
+// hop sentences, and the DNS ledger stays untouched (no ask, no consult).
+test('should keep GET /about on Stage 6 at the Stage 5 hop story', async ({ page }) => {
+  const collectHops = async (count) => {
+    const sentences = [];
+    for (let hop = 0; hop < count; hop++) {
+      await page.getByTestId('btn-next-hop').click();
+      sentences.push(await page.getByTestId('hop-status').textContent());
+    }
+    return sentences;
+  };
+
+  await page.goto('/panel.html?stage=6');
+  await page.getByTestId('url-input').fill('/about');
+  const stage6Hops = await collectHops(8);
+  expect(stage6Hops[0]).toBe('Hop 1/8: Browser (10.2) emits "GET /about"');
+  expect(stage6Hops[7]).toBe('Hop 8/8: Worker (10.41) idle — no async jobs in this trace');
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 0 · Cached hits: 0 · TTL: 300t');
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+
+  // The same 8 sentences on Stage 5 — the two stages' stories match exactly.
+  await page.getByTestId('stage-pill-5').click();
+  await page.getByTestId('url-input').fill('/about');
+  const stage5Hops = await collectHops(8);
+  expect(stage5Hops).toEqual(stage6Hops);
+});
+
+// Negative-case pin: an unknown name ends the trace at hop 3/3 — DNS ask,
+// "NX no record" answer, the browser renders the NX card — and no GET ever
+// reaches the load balancer's backends.
+test('should render NX no record for nope.example without emitting a GET', async ({ page }) => {
+  await page.goto('/panel.html?stage=6');
+
+  await page.getByTestId('url-input').fill('nope.example/about');
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 1/3: Browser (10.2) asks DNS (10.60) for nope.example',
+  );
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 2/3: DNS (10.60) -> 10.2 | NX no record',
+  );
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 3/3: Browser (10.2) renders NX — no record for nope.example',
+  );
+  await expect(page.getByTestId('browser-status-badge')).toContainText('NX');
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('no record');
+  // No GET was queued: both backends still show 0 served.
+  await expect(page.getByTestId('lb-backend-1')).toHaveText('10.11 WebServer-1 (0)');
+  await expect(page.getByTestId('lb-backend-2')).toHaveText('10.12 WebServer-2 (0)');
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 1 · Cached hits: 0 · TTL: 300t');
+});
+
+// Negative-case pin: the deep-link live set extends to 6 (?stage=6 boots the
+// Stage 6 topology) and unknown values still fall back to Stage 1.
+test('should extend the ?stage deep-link live set to 6 and still fall back to 1 on unknowns', async ({
+  page,
+}) => {
+  const errors = [];
+  page.on('pageerror', (error) => errors.push(error));
+  page.on('console', (msg) => {
+    if (msg.type() === 'error') errors.push(msg.text());
+  });
+
+  await page.goto('/panel.html?stage=6&users=3');
+  await expect(page.getByTestId('stage-pill-6')).toHaveAttribute('aria-current', 'true');
+  await expect(page.getByTestId('node-dns')).toBeVisible();
+  await expect(page.getByTestId('user-dots').locator('> *')).toHaveCount(3);
+
+  await page.goto('/panel.html?stage=9');
+  await expect(page.getByTestId('stage-pill-1')).toHaveAttribute('aria-current', 'true');
+  await expect(page.getByTestId('server-address')).toHaveText('10.1');
+  await expect(page.getByTestId('node-dns')).toBeHidden();
+  expect(errors).toEqual([]);
+});
