+import { describe, it, expect } from 'vitest';
+import { createNetwork } from '../../js/sim/network.js';
+import { createRouter } from '../../js/sim/router.js';
+import { createWebServer } from '../../js/sim/webserver.js';
+
+describe('createRouter', () => {
+  // PINS: the same-subnet contract is untouched by the router's presence —
+  // send/deliverToQueue resolve locally, `routed` stays 0, and isYou marks
+  // the queue row exactly as before.
+  it('same-subnet sends keep the send and deliverToQueue contract unchanged', () => {
+    const left = createNetwork();
+    const server = createWebServer({ address: '10.1' });
+    left.registerServer('10.1', server);
+    const router = createRouter();
+    router.join(left, createNetwork({ subnet: '20' }));
+
+    expect(left.send({ from: '10.2', to: '10.1', request: 'GET /about' })).toEqual({
+      from: '10.2',
+      to: '10.1',
+      request: 'GET /about',
+      response: '200 This is the about page',
+    });
+    left.deliverToQueue({
+      id: 'q:1',
+      from: '10.2',
+      to: '10.1',
+      request: 'GET /about',
+      atTick: 1,
+      isYou: true,
+    });
+    expect(server.queueSnapshot()).toEqual([
+      { id: 'q:1', atTick: 1, from: '10.2', to: '10.1', request: 'GET /about', isYou: true },
+    ]);
+    expect(router.snapshot()).toMatchObject({ routed: 0, lastRoute: null });
+  });
+
+  // PINS: a cross-subnet frame crosses exactly one router hop — `routed`
+  // counts 1 — and the router's own 20-side interface is the reachable
+  // target in subnet 20 (Stage 6a's only tenant there).
+  it('cross-subnet frames take exactly one router hop through 10.65 ⇄ 20.1', () => {
+    const left = createNetwork();
+    const right = createNetwork({ subnet: '20' });
+    const router = createRouter();
+    router.join(left, right);
+
+    const reply = left.send({ from: '10.2', to: '20.1', request: 'GET /' });
+    expect(reply).toEqual({
+      from: '10.2',
+      to: '20.1',
+      request: 'GET /',
+      response: '200 router 20.1',
+    });
+    const snap = router.snapshot();
+    expect(snap.routed).toBe(1);
+    expect(snap.lastRoute).toBe('10.2 -> 20.1 via 10.65 ⇄ 20.1');
+
+    // The router's left interface answers same-subnet sends locally, with
+    // no routed hop.
+    expect(left.send({ from: '10.2', to: '10.65', request: 'GET /' })).toMatchObject({
+      to: '10.65',
+      response: '200 router 20.1',
+    });
+    expect(router.snapshot().routed).toBe(1);
+  });
+
+  // PINS: negative-case contract — a send into subnet 20 to an unregistered
+  // host throws (fail-loud, mirroring network.js's resolve); the error
+  // surfaces from the far network, and the frame still counted its single
+  // router hop on the way in.
+  it('a send into subnet 20 to an unregistered host 20.9 throws', () => {
+    const left = createNetwork();
+    const router = createRouter();
+    router.join(left, createNetwork({ subnet: '20' }));
+    expect(() => left.send({ from: '10.2', to: '20.9', request: 'GET /' })).toThrow(
+      /no server at 20\.9/,
+    );
+    expect(() =>
+      left.deliverToQueue({ id: 'q:1', from: '10.2', to: '20.9', request: 'GET /', atTick: 1 }),
+    ).toThrow(/no server at 20\.9/);
+    expect(router.snapshot().routed).toBe(2);
+  });
+
+  // PINS: `isYou` rides through the router untouched on cross-subnet queue
+  // delivery — the far network's enqueue receives the same record shape.
+  it('isYou rides through the router on cross-subnet queue delivery', () => {
+    const left = createNetwork();
+    const right = createNetwork({ subnet: '20' });
+    const router = createRouter();
+    router.join(left, right);
+    let received = null;
+    right.registerServer('20.5', {
+      handleRequest: () => '200 edge',
+      enqueue: (record) => {
+        received = record;
+      },
+    });
+    left.deliverToQueue({
+      id: 'you:1',
+      from: '10.2',
+      to: '20.5',
+      request: 'GET /edge',
+      atTick: 1,
+      isYou: true,
+    });
+    expect(received).toEqual({
+      id: 'you:1',
+      atTick: 1,
+      from: '10.2',
+      to: '20.5',
+      request: 'GET /edge',
+      isYou: true,
+    });
+    expect(router.snapshot().routed).toBe(1);
+  });
+
+  // CHECKS: the constructor rejects a non two-number mini-IP interface and
+  // two interfaces on the same subnet (fail-loud over silent misconfig).
+  it('rejects invalid mini-IP interfaces and a same-subnet pair', () => {
+    expect(() => createRouter({ leftAddress: '1065' })).toThrow(/mini-IP/);
+    expect(() => createRouter({ leftAddress: '10.65', rightAddress: '10.66' })).toThrow(
+      /both interfaces/,
+    );
+  });
+});
diff --git a/test/sim/stage6.test.js b/test/sim/stage6.test.js
new file mode 100644
index 0000000..8b63f60
--- /dev/null
+++ b/test/sim/stage6.test.js
@@ -0,0 +1,115 @@
+import { describe, it, expect } from 'vitest';
+import { createEngine } from '../../js/sim/engine.js';
+
+describe('stage 6 engine — DNS ledger + hosted traces', () => {
+  // CHECKS: stage 6 instantiates DNS 10.60 and the Router (10.65 ⇄ 20.1)
+  // and exposes both on the snapshot; the stage range now validates 1-6
+  // with the same error shape.
+  it('stage 6 engine exposes DNS 10.60 and Router 10.65 ⇄ 20.1 in the snapshot', () => {
+    const snap = createEngine({ stage: 6 }).snapshot();
+    expect(snap.dns).toMatchObject({ address: '10.60', ttlTicks: 300, lookups: 0 });
+    expect(snap.router).toMatchObject({
+      leftAddress: '10.65',
+      rightAddress: '20.1',
+      routed: 0,
+    });
+    expect(createEngine({ stage: 5 }).snapshot().dns).toBe(null);
+    expect(createEngine({ stage: 5 }).snapshot().router).toBe(null);
+    expect(() => createEngine({ stage: 7 })).toThrow(/stage must be 1, 2, 3, 4, 5, or 6, got 7/);
+  });
+
+  // PINS: the hosted grammar — the browser URL splits host/path on the
+  // first "/", the ask rides Browser -> DNS, the answer rides DNS ->
+  // Browser, and only then does the browser emit the GET with the resolved
+  // target; the trace totals 10 hops (Stage 5's 8 + 2) and the ledger
+  // counts the authoritative consult.
+  it('hosted example.com/about adds exactly 2 DNS hops to the stage-5 story', () => {
+    const engine = createEngine({ stage: 6 });
+    engine.traceHop({ method: 'GET', path: 'example.com/about' });
+    let snap = engine.snapshot();
+    expect(snap.trace.hop).toBe(1);
+    expect(snap.trace.hosted).toBe(true);
+    expect(snap.lastFrame).toBe('10.2 -> 10.60 | resolve example.com');
+
+    engine.traceHop();
+    snap = engine.snapshot();
+    expect(snap.trace.hop).toBe(2);
+    expect(snap.lastFrame).toBe('10.60 -> 10.2 | example.com is 10.1 (authoritative)');
+
+    engine.traceHop();
+    snap = engine.snapshot();
+    expect(snap.trace.hop).toBe(3);
+    expect(snap.lastFrame).toBe('10.2 -> 10.1 | GET /about');
+
+    for (let i = 0; i < 7; i++) engine.traceHop();
+    snap = engine.snapshot();
+    expect(snap.trace.hop).toBe(10);
+    expect(snap.browserDisplay.body).toBe('This is the about page');
+    expect(snap.dns).toMatchObject({ lookups: 1, cachedHits: 0, authoritative: 1 });
+    expect(snap.dns.cache[0]).toMatchObject({ name: 'example.com', target: '10.1' });
+
+    // The second hosted trace's answer rides the ledger: cachedHits +1, no
+    // new authoritative consult.
+    engine.traceHop({ method: 'GET', path: 'example.com/about' });
+    engine.traceHop();
+    snap = engine.snapshot();
+    expect(snap.lastFrame).toBe('10.60 -> 10.2 | example.com is 10.1 (cache HIT)');
+    expect(snap.dns).toMatchObject({ lookups: 2, cachedHits: 1, authoritative: 1 });
+  });
+
+  // PINS: negative-case contract — an unknown name never emits a GET: the
+  // trace is the DNS ask plus the "NX no record" answer, the browser
+  // renders the NX card, no server queue row exists, and the NX answer
+  // writes no ledger entry.
+  it('nope.example/about never emits a GET — DNS ask plus NX answer only', () => {
+    const engine = createEngine({ stage: 6 });
+    engine.traceHop({ method: 'GET', path: 'nope.example/about' });
+    expect(engine.snapshot().lastFrame).toBe('10.2 -> 10.60 | resolve nope.example');
+    engine.traceHop();
+    expect(engine.snapshot().lastFrame).toBe('10.60 -> 10.2 | NX no record');
+    engine.traceHop();
+    const snap = engine.snapshot();
+    expect(snap.lastFrame).toBe('Browser 10.2 renders NX — no record for nope.example');
+    expect(snap.trace).toMatchObject({ hop: 3, hosted: true, nx: true, status: 'NX' });
+    expect(snap.browserDisplay).toMatchObject({ status: 'NX', body: 'no record' });
+    expect(snap.servers.every((s) => s.queueDepth === 0)).toBe(true);
+    expect(snap.served).toBe(0);
+    expect(snap.dns.cache).toEqual([]);
+  });
+
+  // PINS: negative-case contract — a host-less path on Stage 6 keeps the
+  // Stage 5 hop story byte-identical, frame for frame, and the DNS ledger
+  // is left untouched (no ask, no consult).
+  it('GET /about on stage 6 keeps the stage-5 hop story byte-identical — no DNS hop', () => {
+    const frames = (stage) => {
+      const engine = createEngine({ stage });
+      const out = [];
+      for (let i = 0; i < 8; i++) {
+        engine.traceHop({ method: 'GET', path: '/about' });
+        out.push(engine.snapshot().lastFrame);
+      }
+      return out;
+    };
+    const stage5 = frames(5);
+    const stage6 = frames(6);
+    expect(stage6).toEqual(stage5);
+    expect(stage6[0]).toBe('10.2 -> 10.1 | GET /about');
+    const snap = createEngine({ stage: 6 }).snapshot();
+    expect(snap.trace).toMatchObject({ hosted: false, hop: 0 });
+    expect(snap.dns.lookups).toBe(0);
+  });
+
+  // Stage 6 keeps the whole Stage 5 async story for a hosted POST too: the
+  // 2 DNS hops ride ahead, the 202 path and the worker commit stay intact.
+  it('hosted POST /jobs keeps the async story behind the 2 DNS hops', () => {
+    const engine = createEngine({ stage: 6 });
+    engine.traceHop({ method: 'POST', path: 'example.com/jobs' });
+    engine.traceHop();
+    for (let i = 0; i < 8; i++) engine.traceHop();
+    const snap = engine.snapshot();
+    expect(snap.trace.hop).toBe(10);
+    expect(snap.trace.asyncJob).toBe(true);
+    expect(snap.browserDisplay.body).toBe('{"jobId": 1, "status": "queued"}');
+    expect(snap.workerQueue.enqueued).toBe(1);
+  });
+});
