+import { describe, it, expect } from 'vitest';
+import { describeSnapshot, totalHopsFor } from '../../js/panel/model.js';
+import { formatComponentState, componentTitle } from '../../js/panel/inspector-state.js';
+import { computeStageLayout } from '../../js/panel/layout.js';
+
+// Stage-boundary extraction (guard-file-size): the Stage 6 DNS/Router
+// narrative-branch pins live here so model.test.js keeps its Stage 1/2
+// scope. All three brief contracts are pinned with their named
+// counter-examples.
+const baseTrace = {
+  method: 'GET',
+  path: '/about',
+  request: 'GET /about',
+  from: '10.2',
+  targetServer: '10.11',
+  cacheStatus: 'HIT',
+  dbOp: null,
+  dbStale: false,
+  asyncJob: false,
+  response: '200 This is the about page',
+  status: 200,
+  body: 'This is the about page',
+  routeId: 'about',
+};
+
+const stage5Snapshot = (trace) => ({
+  stage: 5,
+  tick: 1,
+  users: 5,
+  serverAddress: '10.1',
+  queueDepth: 0,
+  served: 1,
+  avgLatencyTicks: 1,
+  workerQueue: {
+    address: '10.40',
+    workerAddress: '10.41',
+    jobDurationTicks: 2,
+    enqueued: 0,
+    completed: 0,
+    activeJob: null,
+    pendingJobs: [],
+    lastJobResult: null,
+  },
+  trace,
+});
+
+const stage6Snapshot = (trace) => ({
+  ...stage5Snapshot(trace),
+  stage: 6,
+  dns: {
+    address: '10.60',
+    ttlTicks: 300,
+    lookups: 1,
+    cachedHits: 0,
+    authoritative: 1,
+    evictions: 0,
+    lastLookup: { name: 'example.com', status: 'MISS', target: '10.1', atTick: 0 },
+    cache: [{ name: 'example.com', target: '10.1', expiresAtTick: 300, ttlRemaining: 300 }],
+  },
+  router: { leftAddress: '10.65', rightAddress: '20.1', routed: 0, lastRoute: null },
+});
+
+const hopAt = (snapshot, hop) =>
+  describeSnapshot({ ...snapshot, trace: { ...snapshot.trace, hop } }).hopStatus;
+
+describe('stage 6 narrative branches', () => {
+  // PINS: negative-case contract — GET /about on Stage 6 keeps the Stage 5
+  // hop story byte-identical, sentence for sentence, and totals 8 hops.
+  it('GET /about on stage 6 keeps the stage-5 hop story byte-identical — no DNS hop', () => {
+    const trace = { ...baseTrace, hosted: false, nx: false };
+    const stage6 = describeSnapshot(stage6Snapshot(trace));
+    expect(stage6.totalHops).toBe(8);
+    for (let hop = 1; hop <= 8; hop++) {
+      expect(hopAt(stage6Snapshot(trace), hop)).toBe(hopAt(stage5Snapshot(trace), hop));
+    }
+    expect(hopAt(stage6Snapshot(trace), 1)).toBe('Hop 1/8: Browser (10.2) emits "GET /about"');
+    expect(hopAt(stage6Snapshot(trace), 8)).toBe(
+      'Hop 8/8: Worker (10.41) idle — no async jobs in this trace',
+    );
+    expect(totalHopsFor(6, { hosted: false })).toBe(8);
+  });
+
+  // PINS: the hosted grammar — hop 1 is the DNS ask, hop 2 the answer, and
+  // the Stage 5 sentences repeat renumbered onto 10 hops; the total is
+  // Stage 5's 8 + exactly 2 DNS hops.
+  it('hosted example.com/about adds exactly 2 DNS hops to the stage-5 story', () => {
+    const trace = {
+      ...baseTrace,
+      path: 'example.com/about',
+      hosted: true,
+      nx: false,
+      dnsName: 'example.com',
+      dnsAddress: '10.60',
+      dnsAnswer: 'example.com is 10.1 (authoritative)',
+    };
+    const snap = stage6Snapshot(trace);
+    expect(describeSnapshot(snap).totalHops).toBe(10);
+    expect(hopAt(snap, 1)).toBe('Hop 1/10: Browser (10.2) asks DNS (10.60) for example.com');
+    expect(hopAt(snap, 2)).toBe(
+      'Hop 2/10: DNS (10.60) -> 10.2 | example.com is 10.1 (authoritative)',
+    );
+    expect(hopAt(snap, 3)).toBe('Hop 3/10: Browser (10.2) emits "GET /about"');
+    expect(hopAt(snap, 10)).toBe('Hop 10/10: Worker (10.41) idle — no async jobs in this trace');
+    expect(totalHopsFor(6, { hosted: true })).toBe(10);
+  });
+
+  // PINS: negative-case contract — the NX path never emits a GET: the
+  // narrative is ask, "NX no record" answer, and the browser rendering the
+  // NX card; the total is 3.
+  it('nope.example/about renders NX without emitting a GET', () => {
+    const trace = {
+      ...baseTrace,
+      path: 'nope.example/about',
+      request: 'GET nope.example/about',
+      response: 'NX no record',
+      status: 'NX',
+      body: 'no record',
+      hosted: true,
+      nx: true,
+      dnsName: 'nope.example',
+      dnsAddress: '10.60',
+      dnsAnswer: 'NX no record',
+      targetServer: null,
+    };
+    const snap = stage6Snapshot(trace);
+    expect(describeSnapshot(snap).totalHops).toBe(3);
+    expect(hopAt(snap, 1)).toBe('Hop 1/3: Browser (10.2) asks DNS (10.60) for nope.example');
+    expect(hopAt(snap, 2)).toBe('Hop 2/3: DNS (10.60) -> 10.2 | NX no record');
+    expect(hopAt(snap, 3)).toBe('Hop 3/3: Browser (10.2) renders NX — no record for nope.example');
+    expect(totalHopsFor(6, { hosted: true, nx: true })).toBe(3);
+    // Stage 5 has no NX branch: its total stays 8 whatever the trace says.
+    expect(totalHopsFor(5, { hosted: true, nx: true })).toBe(8);
+  });
+
+  it('exposes the DNS ledger and Router counters as labels and inspector state', () => {
+    const snap = stage6Snapshot({ ...baseTrace, hosted: false });
+    const labels = describeSnapshot(snap);
+    expect(labels.dnsStatsLabel).toBe('Lookups: 1 · Cached hits: 0 · TTL: 300t');
+    expect(labels.dnsEntries).toEqual(snap.dns.cache);
+    expect(labels.routerLabel).toBe('Routed: 0 · 10.65 ⇄ 20.1');
+
+    const dnsState = JSON.parse(formatComponentState(snap, 'dns'));
+    expect(dnsState).toEqual(snap.dns);
+    expect(componentTitle(snap, 'dns')).toBe('DNS — mini-IP 10.60');
+    const routerState = JSON.parse(formatComponentState(snap, 'router'));
+    expect(routerState).toEqual(snap.router);
+    expect(componentTitle(snap, 'router')).toBe('Router — 10.65 ⇄ 20.1');
+    const networkState = JSON.parse(formatComponentState(snap, 'network'));
+    expect(networkState.interfaces['10.60']).toBe('DNS');
+    expect(networkState.interfaces['10.65']).toBe('Router (left)');
+    expect(networkState.interfaces['20.1']).toBe('Router (right)');
+  });
+
+  it('lays out the eight-ring Stage 6 orrery with DNS on Ring 7 and the Router on Ring 6', () => {
+    const stage6 = computeStageLayout(6, 5);
+    expect(stage6.rings.map((r) => r.id)).toEqual([
+      'ring-db',
+      'ring-workers',
+      'ring-cache',
+      'ring-compute',
+      'ring-lb',
+      'ring-network',
+      'ring-dns',
+      'ring-clients',
+    ]);
+    expect(stage6.rings.map((r) => r.radius)).toEqual([
+      400, 800, 1200, 1600, 2000, 2400, 2800, 3200,
+    ]);
+    expect(stage6.nodes['node-dns']).toMatchObject({ x: -2800, y: 0, ring: 'ring-dns' });
+    expect(stage6.nodes['node-router']).toMatchObject({ ring: 'ring-network' });
+    expect(stage6.nodes['node-browser']).toMatchObject({ x: -3200, y: 0, ring: 'ring-clients' });
+    expect(stage6.wires.map((w) => w.id)).toEqual([
+      'wire-browser-network',
+      'wire-network-lb',
+      'wire-lb-webserver',
+      'wire-lb-webserver-2',
+      'wire-webserver-cache',
+      'wire-webserver-2-cache',
+      'wire-cache-db',
+      'wire-cache-queue',
+      'wire-queue-worker',
+      'wire-worker-db',
+      'wire-browser-dns',
+      'wire-network-router',
+    ]);
+    expect(stage6.bounds).toEqual({ minX: -3380, maxX: 120, minY: -540, maxY: 540 });
+  });
+});
