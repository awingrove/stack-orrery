+++ b/js/panel/inspector-source-stage6.js
@@ -0,0 +1,76 @@
+// DOCUMENTS: the Stage 6 inspector entries — DNS resolver and cross-subnet
+// Router code mirrors, split from inspector-source.js by responsibility
+// (guard-file-size: that module sits near its 300-line cap). js/sim/dns.js
+// and js/sim/router.js are the executable truth; these strings render the
+// same logic for learners.
+export const STAGE6_SOURCE = {
+  dns: {
+    file: 'js/sim/dns.js',
+    code: `createDns({ address = '10.60', ttlTicks = 300 } = {}) {
+  // address must be "<net>.<host>" — a two-number mini-IP
+  const AUTHORITATIVE = new Map([['example.com', '10.1']]); // Stage 6b adds a CDN name
+  const cache = new Map();  // name -> { name, target, expiresAtTick }
+  let lookups = 0, cachedHits = 0, authoritative = 0, evictions = 0, lastLookup = null;
+  function evictExpired(currentTick = 0) {
+    for (const entry of cache.values()) {
+      if (currentTick >= entry.expiresAtTick) {  // TTL elapsed
+        cache.delete(entry.name);
+        evictions += 1;
+      }
+    }
+  }
+  function lookup(name, currentTick = 0) {
+    lookups += 1;
+    const entry = cache.get(name);
+    if (entry && currentTick < entry.expiresAtTick) {  // live ledger entry
+      cachedHits += 1;
+      lastLookup = { name, status: 'HIT', target: entry.target, atTick: currentTick };
+      return { status: 'HIT', target: entry.target };
+    }
+    if (entry) { cache.delete(name); evictions += 1; }  // expired: miss, not a stale hit
+    authoritative += 1;   // the cache branch above skips this consult
+    const record = AUTHORITATIVE.get(name);
+    if (!record) {  // NX is a normal answer here, not a throw
+      lastLookup = { name, status: 'NX', atTick: currentTick };
+      return { status: 'NX' };
+    }
+    cache.set(name, { name, target: record, expiresAtTick: currentTick + ttlTicks });
+    lastLookup = { name, status: 'MISS', target: record, atTick: currentTick };
+    return { status: 'MISS', target: record };
+  }
+  function snapshot(currentTick = 0) {
+    evictExpired(currentTick);
+    return { address, ttlTicks, lookups, cachedHits, authoritative, evictions, lastLookup,
+      cache: [...cache.values()].map((e) => ({ ...e,
+        ttlRemaining: e.expiresAtTick - currentTick })) };
+  }
+  return { get address() { return address; }, lookup, evictExpired, snapshot };
+}`,
+  },
+  router: {
+    file: 'js/sim/router.js',
+    code: `createRouter({ leftAddress = '10.65', rightAddress = '20.1' } = {}) {
+  // both interfaces must be two-number mini-IPs on different subnets
+  let routed = 0, lastRoute = null;
+  const handleRequest = () => \`200 router \${rightAddress}\`;
+  function forward(record, farNetwork) {
+    routed += 1;   // exactly one router hop per cross-subnet frame
+    lastRoute = \`\${record.from} -> \${record.to} via \${leftAddress} ⇄ \${rightAddress}\`;
+    return farNetwork.receiveCrossSubnet(record);
+  }
+  return {
+    get leftAddress() { return leftAddress; },
+    get rightAddress() { return rightAddress; },
+    handleRequest,
+    join(leftNetwork, rightNetwork) {
+      leftNetwork.attachGateway((record) => forward(record, rightNetwork));
+      rightNetwork.attachGateway((record) => forward(record, leftNetwork));
+      leftNetwork.registerServer(leftAddress, { handleRequest });
+      rightNetwork.registerServer(rightAddress, { handleRequest });
+      return this;
+    },
+    snapshot() { return { leftAddress, rightAddress, routed, lastRoute }; },
+  };
+}`,
+  },
+};
