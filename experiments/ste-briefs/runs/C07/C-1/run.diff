+// DOCUMENTS: Stage 6 DOM additions — the #node-dns and #node-router
+// inspector cards, the DNS and Router wire lanes, the live stage-pill-6
+// button, and the dns/router inspector tabs. Built here rather than in
+// panel.html because that page sits at its 550-line cap (the same pattern
+// as teaching-drawer.js); every node reuses the classes DESIGN.md already
+// tokens, panel.js owns all event wiring, and nothing here sets inline
+// styles (CSP).
+function el(tag, { className, id, testId, text, hidden, aria } = {}) {
+  const node = document.createElement(tag);
+  if (className) node.className = className;
+  if (id) node.id = id;
+  if (testId) node.dataset.testid = testId;
+  if (text !== undefined) node.textContent = text;
+  if (hidden) node.hidden = true;
+  if (aria) node.setAttribute('aria-label', aria);
+  return node;
+}
+
+function wireLane(id, text, reverse) {
+  return el('div', { id, className: `wire-lane${reverse ? ' reverse' : ''}`, text });
+}
+
+function buildLane(id, outbound, inbound) {
+  const column = el('div', {
+    id,
+    className: 'wire-column',
+    hidden: true,
+    aria: 'Wire directions',
+  });
+  column.append(wireLane(outbound.id, outbound.text), wireLane(inbound.id, inbound.text, true));
+  document.getElementById('orrery-world').append(column);
+}
+
+function buildCard({
+  id,
+  component,
+  roleName,
+  subtitle,
+  chip,
+  statsId,
+  statsText,
+  listId,
+  listAria,
+}) {
+  const card = el('article', {
+    id,
+    className: 'node-card',
+    testId: id,
+    hidden: true,
+  });
+  card.dataset.component = component;
+  const head = el('header', { className: 'node-head' });
+  const name = el('div', { className: 'node-name' });
+  name.append(el('span', { className: 'role-name', text: roleName }));
+  name.append(el('span', { className: 'node-subtitle', text: subtitle }));
+  head.append(name, el('span', { className: 'ip-chip', text: chip }));
+  head.append(el('span', { className: 'code-chip', text: '</> Code' }));
+  card.append(head);
+  card.append(
+    el('p', { id: statsId, testId: statsId, className: 'mono last-frame', text: statsText }),
+  );
+  if (listAria) {
+    card.append(
+      el('ul', {
+        id: listId,
+        testId: listId,
+        className: 'route-list',
+        aria: listAria,
+      }),
+    );
+  }
+  document.getElementById('orrery-world').append(card);
+}
+
+// The ladder's stage-6 rung ships as a disabled span (pages at the 550-line
+// cap); it promotes to the live button here so stage 6 is clickable like
+// every other stage pill.
+function promoteStage6Pill() {
+  const span = document.querySelector('.stage-ladder .stage-pill:not([data-stage])');
+  if (!span || !span.textContent.trim().startsWith('6')) return;
+  const button = el('button', {
+    className: 'stage-pill',
+    testId: 'stage-pill-6',
+    text: span.textContent.trim(),
+  });
+  button.type = 'button';
+  button.dataset.stage = '6';
+  span.replaceWith(button);
+}
+
+function buildStage6Tabs() {
+  const tabs = document.querySelector('.comp-tabs');
+  if (!tabs) return;
+  for (const name of ['dns', 'router']) {
+    const tab = el('button', { className: 'comp-tab', text: name });
+    tab.type = 'button';
+    tab.dataset.select = name;
+    tabs.append(tab);
+  }
+}
+
+// CHECKS: buildStage6Nodes runs once at panel boot, before render-stage.js
+// reads the stage-6 lane ids and before panel.js wires .node-card and
+// .comp-tab clicks — calling it twice would duplicate cards, so it is
+// idempotent on the pill and the cards' fixed ids.
+export function buildStage6Nodes() {
+  promoteStage6Pill();
+  buildLane(
+    'wire-col-dns',
+    { id: 'packet-req-dns', text: 'ask =>' },
+    { id: 'packet-res-dns', text: '<- answer' },
+  );
+  buildLane(
+    'wire-col-router',
+    { id: 'packet-req-router', text: 'forward =>' },
+    { id: 'packet-res-router', text: '<- return' },
+  );
+  buildCard({
+    id: 'node-dns',
+    component: 'dns',
+    roleName: 'DNS',
+    subtitle: 'resolver · tick-TTL ledger',
+    chip: '10.60',
+    statsId: 'dns-stats',
+    statsText: 'Lookups: 0 · Cached hits: 0 · TTL: 300t',
+    listId: 'dns-entries-list',
+    listAria: 'DNS ledger entries',
+  });
+  buildCard({
+    id: 'node-router',
+    component: 'router',
+    roleName: 'Router',
+    subtitle: 'cross-subnet gateway',
+    chip: '10.65 ⇄ 20.1',
+    statsId: 'router-stats',
+    statsText: 'Routed: 0 · 10.65 ⇄ 20.1',
+    listId: null,
+    listAria: null,
+  });
+  buildStage6Tabs();
+}
