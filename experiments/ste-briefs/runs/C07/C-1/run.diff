new file mode 100644
index 0000000..427c65d
--- /dev/null
+++ b/test/sim/dns.test.js
@@ -0,0 +1,85 @@
+import { describe, it, expect } from 'vitest';
+import { createDns } from '../../js/sim/dns.js';
+
+describe('createDns', () => {
+  it('resolves example.com authoritatively on miss and records the ledger entry', () => {
+    const dns = createDns({ address: '10.60', ttlTicks: 300 });
+    const miss = dns.lookup('example.com', 0);
+    expect(miss).toEqual({ status: 'MISS', target: '10.1' });
+    expect(dns.snapshot(0)).toMatchObject({
+      address: '10.60',
+      ttlTicks: 300,
+      lookups: 1,
+      cachedHits: 0,
+      authoritative: 1,
+    });
+    expect(dns.snapshot(0).cache).toEqual([
+      { name: 'example.com', target: '10.1', expiresAtTick: 300, ttlRemaining: 300 },
+    ]);
+    expect(dns.snapshot(5).lastLookup).toEqual({
+      name: 'example.com',
+      status: 'MISS',
+      target: '10.1',
+      atTick: 0,
+    });
+  });
+
+  // PINS: negative-case contract — a hit inside ttlTicks increments
+  // cachedHits with NO authoritative consult (the authoritative counter
+  // stays at 1 after two lookups).
+  it('a DNS cache hit inside ttlTicks increments cachedHits with no authoritative consult', () => {
+    const dns = createDns({ ttlTicks: 300 });
+    dns.lookup('example.com', 0);
+    const hit = dns.lookup('example.com', 299);
+    expect(hit).toEqual({ status: 'HIT', target: '10.1' });
+    const snap = dns.snapshot(299);
+    expect(snap).toMatchObject({ lookups: 2, cachedHits: 1, authoritative: 1 });
+    expect(snap.lastLookup).toEqual({
+      name: 'example.com',
+      status: 'HIT',
+      target: '10.1',
+      atTick: 299,
+    });
+  });
+
+  // PINS: negative-case contract — an expired entry is dropped before it
+  // can answer, so the next lookup is an authoritative MISS, not a stale
+  // ledger hit; the in-TTL hit before it proves the branch order.
+  it('an expired entry never answers from the ledger', () => {
+    const dns = createDns({ ttlTicks: 10 });
+    dns.lookup('example.com', 0);
+    expect(dns.lookup('example.com', 5)).toEqual({ status: 'HIT', target: '10.1' });
+    // Tick 10 is the first tick the entry is gone (expiresAtTick = 10).
+    expect(dns.lookup('example.com', 10)).toEqual({ status: 'MISS', target: '10.1' });
+    const snap = dns.snapshot(10);
+    expect(snap).toMatchObject({ lookups: 3, cachedHits: 1, authoritative: 2, evictions: 1 });
+    expect(snap.cache).toEqual([
+      { name: 'example.com', target: '10.1', expiresAtTick: 20, ttlRemaining: 10 },
+    ]);
+    // A lookup past expiry inside the same call cannot double-evict.
+    dns.lookup('example.com', 25);
+    expect(dns.snapshot(25).evictions).toBe(2);
+  });
+
+  // PINS: negative-case contract — an unknown name answers { status: 'NX' }
+  // at the DNS layer (the browser renders the NX card); the DNS component
+  // itself does not throw, and the NX answer writes no ledger entry.
+  it('unknown names answer NX instead of throwing at the DNS layer', () => {
+    const dns = createDns();
+    expect(() => dns.lookup('nope.example', 0)).not.toThrow();
+    expect(dns.lookup('nope.example', 0)).toEqual({ status: 'NX' });
+    expect(dns.lookup('nope.example', 1)).toEqual({ status: 'NX' });
+    const snap = dns.snapshot(1);
+    expect(snap).toMatchObject({ lookups: 3, cachedHits: 0, authoritative: 3 });
+    expect(snap.cache).toEqual([]);
+    expect(snap.lastLookup).toEqual({ name: 'nope.example', status: 'NX', atTick: 1 });
+  });
+
+  // CHECKS: the constructor rejects a non-mini-IP address and a
+  // non-positive or non-integer ttlTicks (fail-loud over silent misconfig).
+  it('rejects a non mini-IP address and a non-positive or non-integer ttlTicks', () => {
+    expect(() => createDns({ address: '1060' })).toThrow(/invalid mini-IP/);
+    expect(() => createDns({ ttlTicks: 0 })).toThrow(/ttlTicks/);
+    expect(() => createDns({ ttlTicks: 2.5 })).toThrow(/ttlTicks/);
+  });
+});
