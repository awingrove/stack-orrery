diff --git a/test/sim/router.test.js b/test/sim/router.test.js
new file mode 100644
index 0000000..99bce93
--- /dev/null
+++ b/test/sim/router.test.js
@@ -0,0 +1,109 @@
+import { describe, it, expect } from 'vitest';
+import { createRouter } from '../../js/sim/router.js';
+import { createNetwork } from '../../js/sim/network.js';
+import { createWebServer } from '../../js/sim/webserver.js';
+
+// A wired two-subnet fixture: 10.x runs a web server, 20.x holds only the
+// router's own interface at 20.1 (the Stage 6a topology — nothing else
+// lives there until Stage 6b's CDN edge).
+function buildWired() {
+  const left = createNetwork();
+  const right = createNetwork();
+  left.registerServer('10.1', createWebServer({ address: '10.1' }));
+  const router = createRouter();
+  router.join(left, right);
+  left.attachRouter(router);
+  right.attachRouter(router);
+  right.registerServer('20.1', router);
+  return { left, right, router };
+}
+
+describe('createRouter', () => {
+  it('leaves same-subnet sends unchanged — the routed counter never moves', () => {
+    const { left, router } = buildWired();
+    expect(left.send({ from: '10.2', to: '10.1', request: 'GET /about' })).toEqual({
+      from: '10.2',
+      to: '10.1',
+      request: 'GET /about',
+      response: '200 This is the about page',
+    });
+    expect(router.snapshot().routed).toBe(0);
+    expect(router.snapshot().lastRoute).toBe(null);
+  });
+
+  it('routes a cross-subnet frame in exactly one hop to the router 20-side', () => {
+    const { left, router } = buildWired();
+    expect(left.send({ from: '10.2', to: '20.1', request: 'GET /' })).toEqual({
+      from: '10.2',
+      to: '20.1',
+      request: 'GET /',
+      response: '200 Router interface 20.1',
+    });
+    expect(router.snapshot().routed).toBe(1);
+    expect(router.snapshot().lastRoute).toEqual({
+      from: '10.2',
+      to: '20.1',
+      request: 'GET /',
+      atTick: null,
+    });
+  });
+
+  it('fails loud on an unregistered 20.x host (20.9), mirroring network.js', () => {
+    const { left } = buildWired();
+    expect(() => left.send({ from: '10.2', to: '20.9', request: 'GET /' })).toThrow(
+      /no server at 20\.9/,
+    );
+    expect(() =>
+      left.deliverToQueue({ id: '1:1', from: '10.2', to: '20.9', request: 'GET /', atTick: 1 }),
+    ).toThrow(/no server at 20\.9/);
+  });
+
+  it('rides isYou through on a cross-subnet queue delivery', () => {
+    const { left, right, router } = buildWired();
+    // Register a plain queue target on the 20-side to observe the delivery.
+    let enqueued = null;
+    right.registerServer('20.5', {
+      enqueue(record) {
+        enqueued = record;
+      },
+      handleRequest() {
+        return '200 20.5';
+      },
+    });
+    left.deliverToQueue({
+      id: 'you:4',
+      from: '10.2',
+      to: '20.5',
+      request: 'GET /',
+      atTick: 4,
+      isYou: true,
+    });
+    expect(enqueued).toEqual({
+      id: 'you:4',
+      from: '10.2',
+      to: '20.5',
+      request: 'GET /',
+      atTick: 4,
+      isYou: true,
+    });
+    expect(router.snapshot().routed).toBe(1);
+  });
+
+  it('rejects invalid mini-IPs, a same-subnet interface pair, and a route before join', () => {
+    expect(() => createRouter({ leftAddress: '10.65.0' })).toThrow(/invalid mini-IP/);
+    expect(() => createRouter({ rightAddress: '2.1.0' })).toThrow(/invalid mini-IP/);
+    expect(() => createRouter({ leftAddress: '10.65', rightAddress: '10.9' })).toThrow(
+      /must sit in different subnets/,
+    );
+    const detached = createRouter();
+    expect(() => detached.route({ from: '10.2', to: '20.1', request: 'GET /' })).toThrow(
+      /no networks joined/,
+    );
+    expect(() => detached.join(null, createNetwork())).toThrow(/join needs both/);
+    // A frame addressed outside the two joined subnets has no route.
+    const { left } = buildWired();
+    expect(() => left.send({ from: '10.2', to: '30.1', request: 'GET /' })).toThrow(
+      /no route to 30\.1/,
+    );
+  });
+});
diff --git a/test/sim/trace-stage6.test.js b/test/sim/trace-stage6.test.js
new file mode 100644
index 0000000..7ba22c0
--- /dev/null
+++ b/test/sim/trace-stage6.test.js
@@ -0,0 +1,107 @@
+import { describe, it, expect } from 'vitest';
+import { createEngine } from '../../js/sim/engine.js';
+
+// Stage 6a trace contracts (docs/plans/2026-10-24-stage6a-dns-crossnet.md):
+// the trace branches on whether the browser path carries a host, the DNS
+// ledger answers only warm names, and an unknown name answers NX without
+// emitting a GET.
+describe('stage 6 traceHop', () => {
+  // Named counter-example: a stage-6 host-less path must keep the stage-5
+  // hop count and hop texts byte-identical — no DNS hop, no cross-subnet hop.
+  it('keeps a host-less GET /about at the stage-5 hop story byte-identical', () => {
+    const run = (stage) => {
+      const engine = createEngine({ stage, seed: 3, users: 2 });
+      const frames = [];
+      for (let hop = 0; hop < 8; hop += 1) {
+        engine.traceHop({ method: 'GET', path: '/about' });
+        frames.push(engine.snapshot().lastFrame);
+      }
+      return frames;
+    };
+    expect(run(6)).toEqual(run(5));
+  });
+
+  it('adds exactly 2 DNS hops for a hosted path and emits the GET with the resolved target', () => {
+    const engine = createEngine({ stage: 6, seed: 3, users: 2 });
+    const frames = [];
+    const hop = (path) => {
+      engine.traceHop({ method: 'GET', path });
+      frames.push(engine.snapshot().lastFrame);
+      return engine.snapshot();
+    };
+    expect(hop('example.com/about').trace.hop).toBe(1);
+    expect(frames[0]).toBe('10.2 -> 10.1 | GET example.com/about');
+    expect(hop('example.com/about').trace.hop).toBe(2);
+    expect(frames[1]).toBe('10.2 -> 10.60 | resolve example.com');
+    expect(hop('example.com/about').trace.hop).toBe(3);
+    expect(frames[2]).toBe('10.60 -> 10.2 | 10.1 (cache MISS)');
+    expect(hop('example.com/about').trace.hop).toBe(4);
+    // The GET rides on with the resolved target and the plain path.
+    expect(frames[3]).toBe('routed 10.2 -> 10.1 (GET /about) to LoadBalancer');
+    for (let remaining = 0; remaining < 6; remaining += 1) hop('example.com/about');
+    expect(engine.snapshot().trace.hop).toBe(10);
+    expect(frames[9]).toBe('Worker 10.41 idle — no async jobs in this trace');
+    expect(engine.snapshot().trace.totalHops).toBe(10);
+    // The lookup ran once against the resolver: a cold MISS that filled the
+    // tick-TTL ledger (300t), with no router involvement on this path.
+    expect(engine.snapshot().dns.lookups).toBe(1);
+    expect(engine.snapshot().dns.cachedHits).toBe(0);
+    expect(engine.snapshot().router.routed).toBe(0);
+  });
+
+  it('answers a warm name from the ledger on the next hosted trace', () => {
+    const engine = createEngine({ stage: 6, seed: 3, users: 2 });
+    for (let hop = 0; hop < 10; hop += 1) engine.traceHop({ path: 'example.com/about' });
+    for (let hop = 0; hop < 3; hop += 1) engine.traceHop({ path: 'example.com/about' });
+    expect(engine.snapshot().lastFrame).toBe('10.60 -> 10.2 | 10.1 (cache HIT)');
+    expect(engine.snapshot().dns.cachedHits).toBe(1);
+    expect(engine.snapshot().dns.lookups).toBe(2);
+  });
+
+  it('never emits a GET for an unknown name — DNS ask plus NX no record only', () => {
+    const engine = createEngine({ stage: 6, seed: 3, users: 2 });
+    engine.traceHop({ method: 'GET', path: 'nope.example/about' });
+    engine.traceHop({ method: 'GET', path: 'nope.example/about' });
+    engine.traceHop({ method: 'GET', path: 'nope.example/about' });
+    const snap = engine.snapshot();
+    expect(snap.trace.hop).toBe(3);
+    expect(snap.trace.totalHops).toBe(3);
+    expect(snap.lastFrame).toBe('10.60 -> 10.2 | NX no record (no GET emitted)');
+    // The browser renders the NX card; the server pool served nothing.
+    expect(snap.browserDisplay).toEqual({
+      from: '10.2',
+      to: '10.60',
+      request: 'GET nope.example/about',
+      response: 'NX no record',
+      status: 'NX',
+      body: 'no record',
+    });
+    expect(snap.served).toBe(0);
+    expect(snap.dns.lookups).toBe(1);
+    // A further hop restarts the trace instead of advancing a phantom chain.
+    engine.traceHop({});
+    expect(engine.snapshot().trace.hop).toBe(1);
+  });
+
+  it('instantiates DNS 10.60 and the cross-subnet router on the snapshot', () => {
+    const engine = createEngine({ stage: 6, seed: 1 });
+    expect(engine.snapshot().dns).toEqual({
+      address: '10.60',
+      ttlTicks: 300,
+      lookups: 0,
+      cachedHits: 0,
+      authoritative: { 'example.com': '10.1' },
+      lastLookup: null,
+      cache: [],
+    });
+    expect(engine.snapshot().router).toEqual({
+      leftAddress: '10.65',
+      rightAddress: '20.1',
+      routed: 0,
+      lastRoute: null,
+    });
+    // Stages 1-5 keep the null component slots.
+    expect(createEngine({ stage: 5 }).snapshot().dns).toBe(null);
+    expect(createEngine({ stage: 5 }).snapshot().router).toBe(null);
+  });
+});
