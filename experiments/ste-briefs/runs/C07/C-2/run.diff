+import { describe, it, expect } from 'vitest';
+import { describeSnapshot } from '../../js/panel/model.js';
+import { componentTitle, formatComponentState } from '../../js/panel/inspector-state.js';
+
+// Stage-boundary extraction from model.test.js (guard-file-size): the
+// Stage 6 DNS/router narratives are pinned here — hosted 10 hops, host-less
+// byte-identical to the Stage 5 story, and the NX path that answers without
+// emitting a GET (docs/plans/2026-10-24-stage6a-dns-crossnet.md §Tests).
+function stage6Snapshot(traceOver = {}) {
+  return {
+    stage: 6,
+    tick: 2,
+    users: 5,
+    serverAddress: '10.1',
+    queueDepth: 0,
+    served: 1,
