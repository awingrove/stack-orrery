diff --git a/e2e/panel-stage6.spec.js b/e2e/panel-stage6.spec.js
new file mode 100644
index 0000000..37782ef
--- /dev/null
+++ b/e2e/panel-stage6.spec.js
@@ -0,0 +1,94 @@
+import { test, expect } from '@playwright/test';
+
+// Stage 6a (docs/plans/2026-10-24-stage6a-dns-crossnet.md): DNS 10.60 with a
+// tick-TTL ledger, the cross-subnet Router (10.65 ⇄ 20.1), an 8-ring orrery,
+// and the host-grammar trace branch. This spec is split from panel.spec.js
+// by responsibility — that file sits at its 450-line cap. Titles are the
+// brief's manifest pins (SIM-6 / PANEL-6); do not reword. The sim runs from
+// a fixed seed, so every threshold below is identical on every run.
+
+// SIM-6/PANEL-6: switching to Stage 6 reveals DNS and Router on 8 rings; a
+// hosted path resolves example.com through DNS 10.60 (a cold MISS that fills
+// the ledger), renders the about page, and the DNS code + live ledger open
+// in the inspector. The ?stage=6 deep link selects the stage directly.
+test('should switch to Stage 6, resolve example.com through DNS 10.60, and inspect DNS code + TTL ledger', async ({
+  page,
+}) => {
+  await page.goto('/panel.html?stage=6');
+  await expect(page.getByTestId('stage-pill-6')).toHaveAttribute('aria-current', 'true');
+  await expect(page.getByTestId('node-dns')).toBeVisible();
+  await expect(page.getByTestId('node-router')).toBeVisible();
+  await expect(page.getByTestId('node-queue')).toBeVisible();
+  await expect(page.locator('.orrery-ring')).toHaveCount(8);
+  await expect(page.locator('.orrery-ring').last()).toHaveAttribute('r', '3200');
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 0 · Cached hits: 0 · TTL: 300t');
+  await expect(page.getByTestId('router-stats')).toHaveText('Routed: 0 · 10.65 ⇄ 20.1');
+
+  await page.getByTestId('url-input').fill('example.com/about');
+  for (let hop = 0; hop < 10; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText('Hop 10/10');
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+  await expect(page.getByTestId('browser-status-badge')).toContainText('200');
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 1 · Cached hits: 0 · TTL: 300t');
+  await expect(page.getByTestId('dns-entries-list')).toContainText('example.com -> 10.1 · ttl');
+
+  await page.getByTestId('node-dns').click();
+  await expect(page.getByTestId('inspector-code')).toContainText('createDns');
+  await expect(page.getByTestId('inspector-state')).toContainText('"cachedHits": 0');
+  await expect(page.getByTestId('inspector-state')).toContainText('"example.com": "10.1"');
+
+  await page.getByTestId('node-router').click();
+  await expect(page.getByTestId('inspector-code')).toContainText('createRouter');
+  await expect(page.getByTestId('inspector-state')).toContainText('"routed": 0');
+});
+
+// PANEL-6: the hosted trace carries the DNS ask + answer as its own hops —
+// hop 2/10 asks the resolver, hop 3/10 answers with the resolved target, and
+// the second hosted trace is answered by the warm ledger (cache HIT).
+test('should trace example.com/about with DNS ask + answer hops', async ({ page }) => {
+  await page.goto('/panel.html?stage=6');
+
+  await page.getByTestId('url-input').fill('example.com/about');
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText('Hop 1/10');
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText(
+    'Hop 2/10: Browser (10.2) asks DNS (10.60) to resolve example.com',
+  );
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText(
+    'Hop 3/10: DNS (10.60) answers 10.1 (cache MISS)',
+  );
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText(
+    'Hop 4/10: Network (10.x) routes to LoadBalancer (10.1)',
+  );
+  for (let hop = 0; hop < 6; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+
+  // Second hosted trace inside the 300t TTL: the ledger answers warm.
+  await page.getByTestId('url-input').fill('example.com/about');
+  for (let hop = 0; hop < 3; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText(
+    'Hop 3/10: DNS (10.60) answers 10.1 (cache HIT)',
+  );
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 2 · Cached hits: 1 · TTL: 300t');
+});
+
+// Negative-case pin (the named counter-example): a plain /about path on
+// Stage 6 keeps the Stage 5 hop story — 8 hops, hop 2 routes to the LB, no
+// DNS hop anywhere, and the resolver counters stay flat.
+test('should keep GET /about on Stage 6 at the Stage 5 hop story', async ({ page }) => {
+  await page.goto('/panel.html?stage=6');
+
+  await page.getByTestId('url-input').fill('/about');
+  await page.getByTestId('btn-next-hop').click();
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText(
+    'Hop 2/8: Network (10.x) routes to LoadBalancer (10.1)',
+  );
+  for (let hop = 0; hop < 6; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText('Hop 8/8');
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 0 · Cached hits: 0 · TTL: 300t');
+});
