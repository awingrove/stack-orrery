+      lastTarget: '10.11',
+      perBackend: { 10.11: 1, 10.12: 0 },
+    },
+    dns: {
+      address: '10.60',
+      ttlTicks: 300,
+      lookups: 1,
+      cachedHits: 0,
+      authoritative: { 'example.com': '10.1' },
+      lastLookup: { name: 'example.com', status: 'MISS', target: '10.1', atTick: 2 },
+      cache: [{ name: 'example.com', target: '10.1', expiresAtTick: 302, ttlRemaining: 300 }],
+    },
+    router: {
+      leftAddress: '10.65',
+      rightAddress: '20.1',
+      routed: 0,
+      lastRoute: null,
+    },
+    trace: {
+      hop: 3,
+      method: 'GET',
+      path: 'example.com/about',
+      request: 'GET /about',
+      from: '10.2',
+      targetServer: null,
+      cacheStatus: 'MISS',
+      dbOp: 'SELECT',
+      dbStale: false,
+      asyncJob: false,
+      response: null,
+      status: null,
+      body: null,
+      routeId: null,
+      hosted: true,
+      host: 'example.com',
+      pathOnly: '/about',
+      dnsStatus: 'MISS',
+      dnsTarget: '10.1',
+      nx: false,
+      totalHops: 10,
+      ...traceOver,
+    },
+  };
+}
+
+describe('describeSnapshot — Stage 6 DNS/router traces', () => {
+  it('describes Stage 6 hosted 10-hop DNS trace labels and dns inspector state', () => {
+    const snap = stage6Snapshot({ hop: 7, response: '200 This is the about page', status: 200 });
+    const labels = describeSnapshot(snap);
+    expect(labels.stage).toBe(6);
+    expect(labels.totalHops).toBe(10);
+    expect(labels.hopStatus).toBe(
+      'Hop 7/10: WebServer (10.11) -> "200 This is the about page" (cache MISS)',
+    );
+
+    const hopLabels = (hop, over = {}) =>
+      describeSnapshot({ ...snap, trace: { ...snap.trace, hop, ...over } }).hopStatus;
+    expect(hopLabels(1, { request: 'GET example.com/about' })).toBe(
+      'Hop 1/10: Browser (10.2) emits "GET example.com/about"',
+    );
+    expect(hopLabels(2)).toBe('Hop 2/10: Browser (10.2) asks DNS (10.60) to resolve example.com');
+    expect(hopLabels(3)).toBe('Hop 3/10: DNS (10.60) answers 10.1 (cache MISS)');
+    expect(hopLabels(4)).toBe('Hop 4/10: Network (10.x) routes to LoadBalancer (10.1)');
+    expect(hopLabels(5)).toBe('Hop 5/10: LoadBalancer (10.1) -> 10.11 queue');
+    expect(hopLabels(6)).toBe('Hop 6/10: Database SELECT @ Replica (10.31) — fresh');
+    expect(hopLabels(8)).toBe('Hop 8/10: Network delivers 200 response to 10.2');
+    expect(hopLabels(9)).toBe('Hop 9/10: Browser (10.2) received and displayed 200');
+    expect(hopLabels(10)).toBe('Hop 10/10: Worker (10.41) idle — no async jobs in this trace');
+    expect(hopLabels(11)).toBe('Idle — type a path and click Go or Step 1 Hop ->');
+
+    expect(labels.dnsStatsLabel).toBe('Lookups: 1 · Cached hits: 0 · TTL: 300t');
+    expect(labels.dnsEntries).toEqual(snap.dns.cache);
+    expect(labels.routerStatsLabel).toBe('Routed: 0 · 10.65 ⇄ 20.1');
+
+    const dnsState = JSON.parse(formatComponentState(snap, 'dns'));
+    expect(dnsState).toEqual({
+      address: '10.60',
+      ttlTicks: 300,
+      lookups: 1,
+      cachedHits: 0,
+      authoritative: { 'example.com': '10.1' },
+      lastLookup: snap.dns.lastLookup,
+      cache: snap.dns.cache,
+    });
+    const routerState = JSON.parse(formatComponentState(snap, 'router'));
+    expect(routerState).toEqual({
+      leftAddress: '10.65',
+      rightAddress: '20.1',
+      routed: 0,
+      lastRoute: null,
+    });
+    const networkState = JSON.parse(formatComponentState(snap, 'network'));
+    expect(networkState.interfaces['10.60']).toBe('DNS');
+    expect(networkState.interfaces['10.65']).toBe('Router (10.x side)');
+    expect(networkState.interfaces['20.1']).toBe('Router (20.x side)');
+  });
+
+  // Named counter-example: a host-less path keeps the Stage 5 hop count and
+  // hop texts byte-identical — no DNS hop, no cross-subnet hop.
+  it('keeps a host-less stage-6 trace at the byte-identical stage-5 hop story', () => {
+    const hostedTrace = {
+      hop: 4,
+      method: 'GET',
+      path: '/about',
+      request: 'GET /about',
+      from: '10.2',
+      targetServer: '10.11',
+      cacheStatus: 'MISS',
+      dbOp: 'SELECT',
+      dbStale: true,
+      asyncJob: false,
+      response: null,
+      status: null,
+      body: null,
+      routeId: null,
+      hosted: false,
+      host: null,
+      pathOnly: '/about',
+      dnsStatus: null,
+      dnsTarget: null,
+      nx: false,
+      totalHops: 8,
+    };
+    const stage5 = describeSnapshot({ ...stage6Snapshot(hostedTrace), stage: 5 });
+    const stage6 = describeSnapshot(stage6Snapshot(hostedTrace));
+    for (let hop = 1; hop <= 8; hop += 1) {
+      const trace = { ...hostedTrace, hop };
+      expect(describeSnapshot({ ...stage6Snapshot(trace), stage: 6 }).hopStatus).toBe(
+        describeSnapshot({ ...stage6Snapshot(trace), stage: 5 }).hopStatus,
+      );
+    }
+    expect(stage6.totalHops).toBe(10); // the stage constant; the trace rides 8
+    expect(stage5.hopStatus).toBe(stage6.hopStatus);
+  });
+
+  it('never emits a GET for the NX path — DNS ask, NX answer, NX card', () => {
+    const snap = stage6Snapshot({
+      hop: 3,
+      request: 'GET nope.example/about',
+      path: 'nope.example/about',
+      host: 'nope.example',
+      dnsStatus: 'NX',
+      dnsTarget: null,
+      nx: true,
+      totalHops: 3,
+      response: 'NX no record',
+      status: 'NX',
+      body: 'no record',
+    });
+    const labels = describeSnapshot(snap);
+    expect(labels.hopStatus).toBe(
+      'Hop 3/3: DNS (10.60) answers NX — no record for nope.example, the browser renders the NX card (no GET emitted)',
+    );
+    expect(describeSnapshot({ ...snap, trace: { ...snap.trace, hop: 1 } }).hopStatus).toBe(
+      'Hop 1/3: Browser (10.2) emits "GET nope.example/about"',
+    );
+    expect(describeSnapshot({ ...snap, trace: { ...snap.trace, hop: 2 } }).hopStatus).toBe(
+      'Hop 2/3: Browser (10.2) asks DNS (10.60) to resolve nope.example',
+    );
+  });
+
+  it('derives the DNS and Router inspector headlines from the live snapshot', () => {
+    const snap = stage6Snapshot();
+    expect(componentTitle(snap, 'dns')).toBe('DNS — mini-IP 10.60');
+    expect(componentTitle(snap, 'router')).toBe('Router — 10.65 ⇄ 20.1');
+    expect(componentTitle({ stage: 6 }, 'dns')).toBe('DNS — mini-IP 10.60');
+    expect(componentTitle({ stage: 6 }, 'router')).toBe('Router — 10.65 ⇄ 20.1');
+    expect(() => componentTitle(snap, 'nope')).toThrow(/unknown component/);
+  });
+});
