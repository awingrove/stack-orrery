+// DOCUMENTS: Stage 6 node cards (#node-dns, #node-router) built in js rather
+// than panel.html because that page sits at its 550-line cap (guard-file-size
+// split-by-responsibility precedent: teaching-drawer.js). Same .node-card
+// markup the other components use — role name, subtitle, mini-IP badge,
+// code badge, live-state line — appended to #orrery-world before panel.js
+// wires clicks, so the cards select in the inspector and highlight on hops
+// exactly like their static siblings. Zero inline handlers, zero inline
+// styles (AGENTS.md CSP rule); all text rides textContent.
+function el(tag, className, text) {
+  const node = document.createElement(tag);
+  if (className) node.className = className;
+  if (text !== undefined) node.textContent = text;
+  return node;
+}
+
+function idEl(tag, id, className, text) {
+  const node = el(tag, className, text);
+  node.id = id;
+  node.dataset.testid = id;
+  return node;
+}
+
+function nodeHead(role, subtitle, ipChip) {
+  const head = el('header', 'node-head');
+  const name = el('div', 'node-name');
+  name.append(el('span', 'role-name', role), el('span', 'node-subtitle', subtitle));
+  head.append(name, el('span', 'ip-chip', ipChip), el('span', 'code-chip', '</> Code'));
+  return head;
+}
+
+function dnsCard() {
+  const card = idEl('article', 'node-dns', 'node-card');
+  card.dataset.component = 'dns';
+  card.hidden = true;
+  const stats = idEl(
+    'p',
+    'dns-stats',
