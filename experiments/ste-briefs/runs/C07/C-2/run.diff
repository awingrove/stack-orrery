@@ -0,0 +1,84 @@
+// DOCUMENTS: the Stage 6 component — an authoritative DNS resolver with a
+// tick-TTL cache ledger, mirroring the Cache's tick-based TTL pattern
+// (js/sim/cache.js): a real Map lookup on the request path rather than a
+// probability. The authoritative table lives in-component
+// (`example.com -> 10.1` in 6a; Stage 6b adds a CDN name); `lookup` consults
+// it only on a cache miss or an expired entry, and an entry answered inside
+// ttlTicks is an incrementing cachedHits with no authoritative consult.
+// Deterministic by construction: no clock, no RNG — time arrives as the
+// `currentTick` argument.
+//
+// CHECKS: the constructor rejects an address that is not a two-number
+// mini-IP and a ttlTicks that is not a positive integer (fail-loud over
+// silent mis-configuration). An unknown name answers `{ status: 'NX' }` —
+// never a throw at the DNS layer (the browser renders the NX card; the
+// throw rule applies to cross-subnet addresses, not to names).
+export function createDns({ address = '10.60', ttlTicks = 300 } = {}) {
+  if (!/^\d+\.\d+$/.test(address)) {
+    throw new Error(`dns: invalid mini-IP address ${address}`);
+  }
+  if (!Number.isInteger(ttlTicks) || ttlTicks < 1) {
+    throw new Error(`dns: ttlTicks must be a positive integer, got ${ttlTicks}`);
+  }
+  const authoritative = new Map([['example.com', '10.1']]);
+  const cache = new Map(); // name -> { name, target, expiresAtTick }
+  let lookups = 0;
+  let cachedHits = 0;
+  let lastLookup = null;
+
+  // An entry is stale the moment the current tick reaches its expiry:
+  // cached at tick T with ttlTicks = 300 means alive through tick T + 299.
+  function evictExpired(currentTick = 0) {
+    for (const entry of cache.values()) {
+      if (currentTick >= entry.expiresAtTick) cache.delete(entry.name);
+    }
+  }
+
+  function lookup(name, currentTick = 0) {
+    lookups += 1;
+    evictExpired(currentTick);
+    const entry = cache.get(name);
+    if (entry) {
+      // CHECKS: a hit inside ttlTicks increments cachedHits and never
+      // consults the authoritative table; an expired entry is already
+      // evicted above, so it can never be answered from the ledger.
+      cachedHits += 1;
+      lastLookup = { name, status: 'HIT', target: entry.target, atTick: currentTick };
+      return { status: 'HIT', target: entry.target };
+    }
+    const target = authoritative.get(name);
+    if (target === undefined) {
+      lastLookup = { name, status: 'NX', target: null, atTick: currentTick };
+      return { status: 'NX' };
+    }
+    cache.set(name, { name, target, expiresAtTick: currentTick + ttlTicks });
+    lastLookup = { name, status: 'MISS', target, atTick: currentTick };
+    return { status: 'MISS', target };
+  }
+
+  function snapshot(currentTick = 0) {
+    evictExpired(currentTick);
+    return {
+      address,
+      ttlTicks,
+      lookups,
+      cachedHits,
+      authoritative: Object.fromEntries(authoritative),
+      lastLookup,
+      cache: [...cache.values()].map((e) => ({
+        name: e.name,
+        target: e.target,
+        expiresAtTick: e.expiresAtTick,
+        ttlRemaining: e.expiresAtTick - currentTick,
+      })),
+    };
+  }
+
+  return {
+    get address() {
+      return address;
+    },
+    lookup,
+    snapshot,
+  };
+}
