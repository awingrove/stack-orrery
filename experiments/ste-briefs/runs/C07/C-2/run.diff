index 0000000..499d2e5
--- /dev/null
+++ b/js/sim/trace-chain.js
@@ -0,0 +1,209 @@
+// DOCUMENTS: the Stage 2-6 request chain — every hop after the browser's
+// emit that the network/LB/queue/cache machinery answers (it does not fake
+// a shortcut). Stage 2 adds the LB's round-robin pick; Stage 3 splits the
+// backend serve into the cache-aside lookup and the response emission;
+// Stage 4 inserts the Database hop (the WRITE to Primary 10.30, the fresh
+// or stale SELECT from Replica 10.31, or the SKIP a warm cache HIT earns);
+// Stage 5 adds the async queue tail. Stage 6 rides the exact same chain —
+// in place for a host-less path (byte-identical story) and shifted by its
+// 2 DNS hops for a hosted one.
+//
+// `state` is the { trace, served } box the caller owns; the chain mutates
+// the trace's hop/request fields and holds the drained response record
+// between the cache check and the response emit.
+//
+// CHECKS: chain positions are keyed in Stage 5 chain space (q), so a
+// hosted Stage 6 trace advances the same positions at trace hop q + 3 —
+// the frames and hop texts stay identical to the chain the crowd uses.
+export function chainStep(state, ctx) {
+  const { trace } = state;
+  const {
+    stage,
+    serverAddress,
+    servers,
+    lb = null,
+    cache = null,
+    database = null,
+    workerQueue = null,
+    bumpTick,
+    getTick,
+    onServe,
+    onFinish,
+  } = ctx;
+  const hosted6 = stage === 6 && trace.hosted;
+  const q = hosted6 ? trace.hop - 2 : trace.hop; // position in chain space
+  // Advancing to chain position n lands on trace hop n (host-less) or
+  // n + 2 (hosted — the DNS ask and answer ride ahead of the chain).
+  const next = (n) => (state.trace.hop = n + (hosted6 ? 2 : 0));
+  let frame = null;
+
+  // Serve from the front of the target's queue until the trace's own
+  // request (isYou) comes back, or the queue runs dry this tick.
+  function drainUntilYou(targetServer) {
+    for (;;) {
+      const batch = targetServer.step(getTick());
+      const you = batch.find((item) => item.isYou);
+      if (you || batch.length === 0) return you;
+    }
+  }
+
+  function backendFor(targetAddress) {
+    return servers.find((s) => s.address === targetAddress) ?? servers[0];
+  }
+
+  function serve(you) {
+    trace.response = you.response;
+    trace.status = you.status;
+    trace.body = you.body;
+    trace.routeId = you.routeId;
+    onServe(you);
