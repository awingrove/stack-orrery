new file mode 100644
index 0000000..2b366bf
--- /dev/null
+++ b/test/sim/dns.test.js
@@ -0,0 +1,62 @@
+import { describe, it, expect } from 'vitest';
+import { createDns } from '../../js/sim/dns.js';
+
+describe('createDns', () => {
+  it('answers a cache hit inside ttlTicks with no authoritative consult', () => {
+    const dns = createDns({ address: '10.60', ttlTicks: 300 });
+    // Cold lookup: the authoritative table answers and fills the ledger.
+    expect(dns.lookup('example.com', 0)).toEqual({ status: 'MISS', target: '10.1' });
+    // Warm lookup one tick before expiry: the ledger answers, and the
+    // lastLookup record proves no second authoritative consult happened.
+    expect(dns.lookup('example.com', 299)).toEqual({ status: 'HIT', target: '10.1' });
+    const snap = dns.snapshot(299);
+    expect(snap.lookups).toBe(2);
+    expect(snap.cachedHits).toBe(1);
+    expect(snap.lastLookup).toEqual({
+      name: 'example.com',
+      status: 'HIT',
+      target: '10.1',
+      atTick: 299,
+    });
+    expect(snap.authoritative).toEqual({ 'example.com': '10.1' });
+    expect(snap.cache).toEqual([
+      { name: 'example.com', target: '10.1', expiresAtTick: 300, ttlRemaining: 1 },
+    ]);
+  });
+
+  it('never answers an expired entry from the ledger', () => {
+    const dns = createDns({ address: '10.60', ttlTicks: 300 });
+    dns.lookup('example.com', 0);
+    // At tick 300 the entry is exactly expired: the ledger must not answer,
+    // so the lookup consults the authoritative table (a MISS, not a HIT)
+    // and refills the entry with a fresh expiry.
+    const expired = dns.lookup('example.com', 300);
+    expect(expired).toEqual({ status: 'MISS', target: '10.1' });
+    const snap = dns.snapshot(300);
+    expect(snap.cachedHits).toBe(0);
+    expect(snap.cache).toEqual([
+      { name: 'example.com', target: '10.1', expiresAtTick: 600, ttlRemaining: 300 },
+    ]);
+  });
+
+  it('answers NX for an unknown name without throwing and caches nothing', () => {
+    const dns = createDns({ address: '10.60' });
+    expect(dns.lookup('nope.example', 5)).toEqual({ status: 'NX' });
+    const snap = dns.snapshot(5);
+    expect(snap.lookups).toBe(1);
+    expect(snap.cachedHits).toBe(0);
+    expect(snap.cache).toEqual([]);
+    expect(snap.lastLookup).toEqual({
+      name: 'nope.example',
+      status: 'NX',
+      target: null,
+      atTick: 5,
+    });
+  });
+
+  it('rejects a non mini-IP address and a non positive integer ttlTicks', () => {
+    expect(() => createDns({ address: '10.60.1' })).toThrow(/mini-IP address 10\.60\.1/);
+    expect(() => createDns({ ttlTicks: 0 })).toThrow(/ttlTicks must be a positive integer/);
+    expect(() => createDns({ ttlTicks: 1.5 })).toThrow(/ttlTicks must be a positive integer/);
+  });
+});
