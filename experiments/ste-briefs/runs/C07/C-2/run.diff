diff --git a/js/sim/router.js b/js/sim/router.js
new file mode 100644
index 0000000..fc7cc4c
--- /dev/null
+++ b/js/sim/router.js
@@ -0,0 +1,96 @@
+// DOCUMENTS: the Stage 6 component — a cross-subnet router joining the 10.x
+// and 20.x network instances at two interfaces (left 10.65, right 20.1). Any
+// frame whose from/to subnets differ takes exactly one router hop
+// (`routed` counter, the trace shows the hop); same-subnet sends are the
+// network's own job and do not touch the router. Nothing lives in subnet 20
+// in 6a besides the router's own presence: 20.1 (the router's 20-side) is
+// the only reachable target — the engine registers the router there — while
+// sends to an unregistered 20.x host (20.9) fail loud at the destination
+// network's resolve, mirroring network.js's fail-loud contract.
+//
+// CHECKS: the constructor rejects an address that is not a two-number
+// mini-IP, a pair whose two interfaces share a subnet, and a route before
+// join(leftNetwork, rightNetwork) — fail-loud over silent mis-wiring.
+const MINI_IP = /^\d+\.\d+$/;
+
+const subnetOf = (addr) => String(addr).split('.')[0];
+
+export function createRouter({ leftAddress = '10.65', rightAddress = '20.1' } = {}) {
+  if (!MINI_IP.test(leftAddress)) {
+    throw new Error(`router: invalid mini-IP address ${leftAddress}`);
+  }
+  if (!MINI_IP.test(rightAddress)) {
+    throw new Error(`router: invalid mini-IP address ${rightAddress}`);
+  }
+  if (subnetOf(leftAddress) === subnetOf(rightAddress)) {
+    throw new Error(
+      `router: interfaces ${leftAddress} / ${rightAddress} must sit in different subnets`,
+    );
+  }
+  let left = null;
+  let right = null;
+  let routed = 0;
+  let lastRoute = null;
+
+  // The router joins two network instances once, at engine construction.
+  function join(leftNetwork, rightNetwork) {
+    if (!leftNetwork || !rightNetwork) {
+      throw new Error('router: join needs both network instances');
+    }
+    left = leftNetwork;
+    right = rightNetwork;
+  }
+
+  function networkFor(to) {
+    if (!left || !right) throw new Error('router: no networks joined');
+    const toSubnet = subnetOf(to);
+    if (toSubnet === subnetOf(rightAddress)) return right;
+    if (toSubnet === subnetOf(leftAddress)) return left;
+    throw new Error(`router: no route to ${to}`);
+  }
+
+  // One router hop: the frame crosses subnets exactly once, then the
+  // destination subnet's own network delivers it (its resolve fails loud on
+  // an unregistered host). `isYou` rides through untouched, like the
+  // network's own deliverToQueue contract.
+  function route({ from, to, request, isYou = false, id = null, atTick = null }) {
+    if (!MINI_IP.test(from)) {
+      throw new Error(`router: invalid mini-IP address ${from}`);
+    }
+    if (!MINI_IP.test(to)) {
+      throw new Error(`router: invalid mini-IP address ${to}`);
+    }
+    const remote = networkFor(to);
+    routed += 1;
+    lastRoute = { from, to, request, atTick };
+    if (id !== null) {
+      remote.resolve(to).enqueue({ id, from, to, request, atTick, isYou });
+      return { from, to, request, routed: true };
+    }
+    const response = remote.resolve(to).handleRequest(request);
+    return { from, to, request, response };
+  }
+
+  // The router's own 20-side presence answers its interface at 20.1 —
+  // the only reachable target in subnet 20 until Stage 6b's CDN edge.
+  function handleRequest() {
+    return `200 Router interface ${rightAddress}`;
+  }
+
+  function snapshot() {
+    return { leftAddress, rightAddress, routed, lastRoute };
+  }
+
+  return {
+    get leftAddress() {
+      return leftAddress;
+    },
+    get rightAddress() {
+      return rightAddress;
+    },
+    join,
+    route,
+    handleRequest,
+    snapshot,
+  };
+}
