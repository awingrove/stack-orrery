new file mode 100644
index 0000000..cf19002
--- /dev/null
+++ b/js/sim/trace-stage1.js
@@ -0,0 +1,45 @@
+// DOCUMENTS: the Stage 1 hop trio of the trace machine — emit already
+// happened (hop 1), so these are the queue delivery, the serve, and the
+// render. Split from trace.js by responsibility (guard-file-size), like
+// trace-stage6.js: the multi-stage machine hands over its stage-1 branches
+// and this module owns the single-server story.
+//
+// CHECKS: the machine guards `stage === 1 && trace.hop <= 3` before handing
+// over; these handlers cover hops 2-4 exactly and mutate the trace record
+// in place, returning the hop's frame (or null when the queue ran dry).
+export function stage1Hops({
+  trace,
+  network,
+  serverAddress,
+  servers,
+  bumpTick,
+  serve,
+  drainUntilYou,
+  finish,
+}) {
+  if (trace.hop === 1) {
+    trace.hop = 2;
+    const atTick = bumpTick();
+    network.deliverToQueue({
+      id: `you:${atTick}`,
+      from: trace.from,
+      to: serverAddress,
+      request: trace.request,
+      atTick,
+      isYou: true,
+    });
+    return `routed ${trace.from} -> ${serverAddress} (${trace.request}) into queue`;
+  }
+  if (trace.hop === 2) {
+    trace.hop = 3;
+    const you = drainUntilYou(servers[0]);
+    if (you) {
+      serve(you);
+      return `${serverAddress} -> ${trace.from} | ${you.response}`;
+    }
+    return null;
+  }
+  trace.hop = 4;
+  finish(serverAddress);
+  return null;
+}
diff --git a/js/sim/trace-stage6.js b/js/sim/trace-stage6.js
new file mode 100644
index 0000000..e51f44b
--- /dev/null
+++ b/js/sim/trace-stage6.js
@@ -0,0 +1,65 @@
+// DOCUMENTS: the Stage 6 DNS hop pair + hosted-path grammar — the two hops
+// the trace machine inserts between the browser emit and the Stage 5 chain
+// when the browser path carries a host (`<host>/<path>`). Split from
+// trace.js by responsibility (guard-file-size): this module owns the host
+// split and the DNS ask/answer frame narration; trace.js owns the state
+// machine and every other stage's hops.
+//
+// CHECKS: the host split takes the first '/' — `example.com/about` becomes
+// host example.com + path /about, while a path starting with '/' (or with
+// none at all) is host-less and never touches DNS.
+export function splitHostPath(url) {
+  const raw = String(url);
+  const slash = raw.indexOf('/');
+  if (slash <= 0) return { host: null, path: raw };
+  return { host: raw.slice(0, slash), path: raw.slice(slash) };
+}
+
+// The machine's two DNS hops, mutating the trace record in place exactly
+// like the machine's own branches. Returns the hop's frame. trace.hop is 1
+// (ask) or 2 (answer); the caller guards that before handing over.
+export function stepDnsHops({ dnsHops, dns, trace, finish }) {
+  if (trace.hop === 1) {
+    trace.hop = 2;
+    const ask = dnsHops.ask({ from: trace.from, host: trace.host });
+    trace.dnsResult = ask.result;
+    // An NX answer ends this trace at hop 3: the browser renders the NX
+    // card and the Stage 5 chain cannot run — no GET is emitted.
+    if (ask.result.status === 'NX') trace.totalHops = 3;
+    return ask.frame;
+  }
+  trace.hop = 3;
+  const result = trace.dnsResult;
+  if (result.status === 'NX') {
+    trace.response = 'NX no record';
+    trace.status = 'NX';
+    trace.body = 'no record';
+    finish(dns.address);
+    return dnsHops.nxAnswer({ from: trace.from, host: trace.host });
+  }
+  // The browser emits the GET with the resolved target: the request on the
+  // wire to the LB carries the path, the target rides in dnsTarget.
+  trace.dnsTarget = result.target;
+  trace.request = `${trace.method} ${trace.path}`;
+  return dnsHops.answer({ from: trace.from, host: trace.host, target: result.target });
+}
+
+// CHECKS: the ask hop performs exactly one ledger lookup — the engine's
+// tick advances first (a resolver roundtrip costs a tick, like a queue
+// delivery) and the answer hop narrates the held result without consulting
+// the DNS component again.
+export function createDnsHops({ dns, bumpTick }) {
+  return {
+    ask({ from, host }) {
+      const atTick = bumpTick();
+      const result = dns.lookup(host, atTick);
+      return { atTick, result, frame: `${from} -> ${dns.address} | ask ${host}` };
+    },
+    answer({ from, host, target }) {
+      return `${dns.address} -> ${from} | ${host} is ${target}`;
+    },
+    nxAnswer({ from }) {
+      return `${dns.address} -> ${from} | NX no record`;
+    },
+  };
+}
