diff --git a/test/sim/dns.test.js b/test/sim/dns.test.js
new file mode 100644
index 0000000..cb52834
--- /dev/null
+++ b/test/sim/dns.test.js
@@ -0,0 +1,168 @@
+import { describe, it, expect } from 'vitest';
+import { createDns } from '../../js/sim/dns.js';
+import { createEngine } from '../../js/sim/engine.js';
+
+describe('createDns', () => {
+  // Negative-case pin (brief §Negative-case, DNS TTL branch): a hit inside
+  // ttlTicks increments cachedHits with NO authoritative consult — the
+  // authoritativeHits counter moves only on the miss that filled the entry.
+  it('a cache hit inside ttlTicks answers from the ledger without an authoritative consult', () => {
+    const dns = createDns({ address: '10.60', ttlTicks: 300 });
+
+    // Cold lookup: the ledger misses and the authoritative table answers.
+    expect(dns.lookup('example.com', 1)).toEqual({
+      status: 'OK',
+      name: 'example.com',
+      target: '10.1',
+      source: 'authoritative',
+      atTick: 1,
+    });
+    let snap = dns.snapshot(1);
+    expect(snap).toMatchObject({ lookups: 1, cachedHits: 0, authoritativeHits: 1 });
+    expect(snap.cache).toEqual([
+      {
+        name: 'example.com',
+        target: '10.1',
+        cachedAtTick: 1,
+        expiresAtTick: 301,
+        ttlRemaining: 300,
+      },
+    ]);
+
+    // Warm lookup at tick 50 (well inside the 300t TTL): the ledger answers
+    // and the authoritative table is not consulted again.
+    expect(dns.lookup('example.com', 50)).toEqual({
+      status: 'OK',
+      name: 'example.com',
+      target: '10.1',
+      source: 'cache',
+      atTick: 50,
+    });
+    snap = dns.snapshot(50);
+    expect(snap).toMatchObject({ lookups: 2, cachedHits: 1, authoritativeHits: 1 });
+    expect(snap.lastLookup).toEqual({
+      name: 'example.com',
+      status: 'OK',
+      source: 'cache',
+      atTick: 50,
+    });
+  });
+
+  // PINS: negative-case pin (brief §Negative-case, DNS TTL branch): an
+  // expired entry is never answered from the cache ledger — the lookup
+  // evicts it and consults the authoritative table again.
+  it('an expired entry is never answered from the cache ledger', () => {
+    const dns = createDns({ address: '10.60', ttlTicks: 300 });
+    dns.lookup('example.com', 1); // fills the ledger, cached at tick 1
+
+    // At tick 301 the entry is expired: the ledger answers nothing and the
+    // authoritative table re-fills it.
+    expect(dns.lookup('example.com', 301)).toEqual({
+      status: 'OK',
+      name: 'example.com',
+      target: '10.1',
+      source: 'authoritative',
+      atTick: 301,
+    });
+    const snap = dns.snapshot(301);
+    expect(snap).toMatchObject({ lookups: 2, cachedHits: 0, authoritativeHits: 2 });
+    expect(snap.cache).toEqual([
+      {
+        name: 'example.com',
+        target: '10.1',
+        cachedAtTick: 301,
+        expiresAtTick: 601,
+        ttlRemaining: 300,
+      },
+    ]);
+  });
+
+  // PINS: negative-case pin (brief §1): an unknown name answers
+  // { status: 'NX' } and never throws at the DNS layer; no ledger row is
+  // created.
+  it('unknown names answer NX, never throw, and leave no ledger row', () => {
+    const dns = createDns({ address: '10.60', ttlTicks: 300 });
+    const answer = dns.lookup('nope.example', 7);
+    expect(answer).toEqual({ status: 'NX', name: 'nope.example', atTick: 7 });
+    const snap = dns.snapshot(7);
+    expect(snap).toMatchObject({ lookups: 1, cachedHits: 0, authoritativeHits: 0 });
+    expect(snap.cache).toEqual([]);
+    expect(snap.authoritative).toEqual({ 'example.com': '10.1' });
+  });
+
+  // CHECKS: the constructor rejects a non-mini-IP address and a
+  // non-positive or non-integer ttlTicks (fail-loud over silent misconfig).
+  it('rejects a non mini-IP address and a non-positive ttlTicks', () => {
+    expect(() => createDns({ address: '1060' })).toThrow(/invalid mini-IP/);
+    expect(() => createDns({ ttlTicks: 0 })).toThrow(/ttlTicks/);
+    expect(() => createDns({ ttlTicks: 2.5 })).toThrow(/ttlTicks/);
+  });
+});
+
+describe('stage 6 engine wiring', () => {
+  it('stage 6 engine instantiates DNS 10.60 + Router and drives hosted, NX, and host-less traces', () => {
+    const engine = createEngine({ stage: 6 });
+    let snap = engine.snapshot();
+    expect(snap.dns.address).toBe('10.60');
+    expect(snap.router).toEqual({
+      leftAddress: '10.65',
+      rightAddress: '20.1',
+      routed: 0,
+      received: [],
+    });
+
+    // Hosted trace: exactly 10 hops — emit, DNS ask, DNS answer, then the
+    // Stage 5 chain — with the ledger filled from the authoritative table.
+    for (let hop = 0; hop < 10; hop++)
+      engine.traceHop({ method: 'GET', path: 'example.com/about' });
+    snap = engine.snapshot();
+    expect(snap.trace.hop).toBe(10);
+    expect(snap.trace.totalHops).toBe(10);
+    expect(snap.trace.dnsTarget).toBe('10.1');
+    expect(snap.dns).toMatchObject({ lookups: 1, cachedHits: 0, authoritativeHits: 1 });
+    expect(snap.browserDisplay.body).toBe('This is the about page');
+
+    // Second hosted trace: the ledger answers (cachedHits +1) and the
+    // authoritative table is NOT consulted again.
+    for (let hop = 0; hop < 10; hop++)
+      engine.traceHop({ method: 'GET', path: 'example.com/about' });
+    snap = engine.snapshot();
+    expect(snap.dns).toMatchObject({ lookups: 2, cachedHits: 1, authoritativeHits: 1 });
+
+    // NX trace: 3 hops total, the browser renders the NX card, and no GET
+    // is emitted (the served total does not move).
+    const servedBefore = engine.snapshot().served;
+    for (let hop = 0; hop < 3; hop++)
+      engine.traceHop({ method: 'GET', path: 'nope.example/about' });
+    snap = engine.snapshot();
+    expect(snap.trace.hop).toBe(3);
+    expect(snap.trace.totalHops).toBe(3);
+    expect(snap.trace.status).toBe('NX');
+    expect(snap.browserDisplay).toMatchObject({ status: 'NX', body: 'no record' });
+    expect(snap.dns).toMatchObject({ lookups: 3, cachedHits: 1, authoritativeHits: 1 });
+    expect(snap.served).toBe(servedBefore);
+
+    // Host-less trace: the Stage 5 story verbatim — 8 hops, no DNS lookup
+    // at all (the named counter-example: GET /about keeps the Stage 5 hop
+    // count without a DNS consult).
+    for (let hop = 0; hop < 8; hop++) engine.traceHop({ method: 'GET', path: '/about' });
+    snap = engine.snapshot();
+    expect(snap.trace.hop).toBe(8);
+    expect(snap.trace.totalHops).toBe(8);
+    expect(snap.trace.hosted).toBe(false);
+    expect(snap.dns).toMatchObject({ lookups: 3, cachedHits: 1 });
+    expect(snap.browserDisplay.body).toBe('This is the about page');
+
+    // Stages 1-5 expose no DNS or Router at all.
+    for (const stage of [1, 2, 3, 4, 5]) {
+      const plain = createEngine({ stage }).snapshot();
+      expect(plain.dns).toBe(null);
+      expect(plain.router).toBe(null);
+    }
+  });
+
+  it('rejects a stage outside 1-6', () => {
+    expect(() => createEngine({ stage: 0 })).toThrow(/stage must be 1, 2, 3, 4, 5, or 6/);
+    expect(() => createEngine({ stage: 7 })).toThrow(/stage must be 1, 2, 3, 4, 5, or 6/);
+  });
+});
