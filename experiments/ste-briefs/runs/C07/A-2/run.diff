+++ b/js/panel/inspector-source-stage6.js
@@ -0,0 +1,63 @@
+// DOCUMENTS: the Stage 6 inspector code entries — the readable, hand-edited
+// mirror of js/sim/dns.js and js/sim/router.js (the sim files are the
+// executable truth). Split from inspector-source.js by responsibility
+// (guard-file-size): that module merges this map into COMPONENT_SOURCE.
+export const COMPONENT_SOURCE_STAGE6 = {
+  dns: {
+    file: 'js/sim/dns.js',
+    code: `createDns({ address = '10.60', ttlTicks = 300 } = {}) {
+  // address must be "<net>.<host>" — a two-number mini-IP
+  const authoritative = new Map([['example.com', '10.1']]);
+  const entries = new Map(); // name -> { target, cachedAtTick, expiresAtTick }
+  let lookups = 0, cachedHits = 0, authoritativeHits = 0, lastLookup = null;
+  function evictExpired(currentTick = 0) {
+    for (const entry of entries.values()) {
+      if (currentTick >= entry.expiresAtTick) {  // TTL elapsed
+        entries.delete(entry.name);
+      }
+    }
+  }
+  function lookup(name, currentTick = 0) {
+    lookups += 1;
+    evictExpired(currentTick);
+    const entry = entries.get(name);
+    if (entry) {
+      cachedHits += 1;  // ledger hit: the table is not touched at all
+      lastLookup = { name, status: 'OK', source: 'cache', atTick: currentTick };
+      return { status: 'OK', name, target: entry.target, source: 'cache' };
+    }
+    // miss or expired entry: the only path that consults the table
+    const target = authoritative.get(name) ?? null;
+    if (target === null) {
+      lastLookup = { name, status: 'NX', atTick: currentTick };
+      return { status: 'NX', name, atTick: currentTick };  // never throws
+    }
+    authoritativeHits += 1;
+    entries.set(name, { name, target,
+      cachedAtTick: currentTick, expiresAtTick: currentTick + ttlTicks });
+    lastLookup = { name, status: 'OK', source: 'authoritative' };
+    return { status: 'OK', name, target, source: 'authoritative' };
+  }
+  function snapshot(currentTick = 0) { /* counters + live ledger rows */ }
+  return { address, evictExpired, lookup, snapshot };
+}`,
+  },
+  router: {
+    file: 'js/sim/router.js',
+    code: `createRouter({ leftAddress = '10.65', rightAddress = '20.1' } = {}) {
+  // both legs must be mini-IPs in different subnets
+  let routed = 0;
+  const received = [];  // frames terminated at the router's own interface
+  return {
+    leftAddress, rightAddress,
+    hop() { routed += 1; },  // one hop per cross-subnet frame
+    handleRequest() {  // frames addressed to the router itself
+      return \`200 Router \${leftAddress} ⇄ \${rightAddress}\`;
+    },
+    enqueue(record) { received.push(record); return record; },
+    lastReceived() { return received[received.length - 1] ?? null; },
+    snapshot() { return { leftAddress, rightAddress, routed, received: [...received] }; },
+  };
+}`,
+  },
+};
