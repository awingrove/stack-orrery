diff --git a/test/sim/router.test.js b/test/sim/router.test.js
new file mode 100644
index 0000000..f973d05
--- /dev/null
+++ b/test/sim/router.test.js
@@ -0,0 +1,118 @@
+import { describe, it, expect } from 'vitest';
+import { createRouter } from '../../js/sim/router.js';
+import { createNetwork } from '../../js/sim/network.js';
+import { createWebServer } from '../../js/sim/webserver.js';
+
+// A two-network rig mirroring the engine's Stage 6 wiring: left network is
+// subnet 10.x with the router's 10.65 leg, right network is subnet 20.x
+// with the router's 20.1 leg, and each side's gateway hops frames for the
+// other subnet into its peer.
+function buildRig() {
+  const left = createNetwork({ subnet: '10' });
+  const right = createNetwork({ subnet: '20' });
+  const router = createRouter();
+  left.registerServer('10.65', router);
+  right.registerServer('20.1', router);
+  left.registerServer('10.1', createWebServer({ address: '10.1' }));
+  left.setGateway({ router, remoteAddress: router.rightAddress, peer: right });
+  right.setGateway({ router, remoteAddress: router.leftAddress, peer: left });
+  return { left, right, router };
+}
+
+describe('createRouter', () => {
+  it('rejects non mini-IP legs and same-subnet legs', () => {
+    expect(() => createRouter({ leftAddress: '1065' })).toThrow(/invalid mini-IP/);
+    expect(() => createRouter({ rightAddress: 'x.y' })).toThrow(/invalid mini-IP/);
+    expect(() => createRouter({ leftAddress: '10.65', rightAddress: '10.9' })).toThrow(
+      /both legs sit in subnet 10\.x/,
+    );
+  });
+});
+
+describe('cross-subnet routing', () => {
+  it('same-subnet sends keep the send and deliverToQueue contract unchanged', () => {
+    const { left, router } = buildRig();
+    // The wire answers exactly as it did before Stage 6.
+    expect(left.send({ from: '10.2', to: '10.1', request: 'GET /about' })).toEqual({
+      from: '10.2',
+      to: '10.1',
+      request: 'GET /about',
+      response: '200 This is the about page',
+    });
+    left.deliverToQueue({
+      id: '1:1',
+      from: '10.2',
+      to: '10.1',
+      request: 'GET /',
+      atTick: 1,
+      isYou: true,
+    });
+    // No router hop ever happened for same-subnet traffic.
+    expect(router.snapshot().routed).toBe(0);
+    expect(router.snapshot().received).toEqual([]);
+    // An unknown same-subnet host still fails loud with the same shape.
+    expect(() => left.send({ from: '10.2', to: '10.99', request: 'GET /' })).toThrow(
+      /no server at 10\.99/,
+    );
+  });
+
+  it('a cross-subnet frame takes exactly one router hop and isYou rides through', () => {
+    const { left, router } = buildRig();
+    // The only reachable target in subnet 20 in 6a is the router's own
+    // 20.1 interface; it answers with its slim diagnostic.
+    expect(left.send({ from: '10.2', to: '20.1', request: 'GET /' })).toEqual({
+      from: '10.2',
+      to: '20.1',
+      request: 'GET /',
+      response: '200 Router 10.65 ⇄ 20.1',
+    });
+    expect(router.snapshot().routed).toBe(1);
+
+    // deliverToQueue rides through: the record (isYou included) lands on
+    // the router's 20-side, one hop counted.
+    left.deliverToQueue({
+      id: '2:1',
+      from: '10.2',
+      to: '20.1',
+      request: 'GET /about',
+      atTick: 2,
+      isYou: true,
+    });
+    const snap = router.snapshot();
+    expect(snap.routed).toBe(2);
+    expect(snap.received).toEqual([
+      { id: '2:1', from: '10.2', to: '20.1', request: 'GET /about', atTick: 2, isYou: true },
+    ]);
+    expect(router.lastReceived().isYou).toBe(true);
+  });
+
+  // Negative-case pin (brief §Negative-case, cross-subnet fail-loud): a
+  // send into subnet 20 to an unregistered host (20.9) throws — DL-1
+  // fail-loud, mirrored from the network's own unknown-host throw.
+  it('a send to unregistered 20.9 fails loud after the one router hop', () => {
+    const { left, router } = buildRig();
+    expect(() => left.send({ from: '10.2', to: '20.9', request: 'GET /' })).toThrow(
+      /no server at 20\.9/,
+    );
+    expect(() =>
+      left.deliverToQueue({ id: '3:1', from: '10.2', to: '20.9', request: 'GET /', atTick: 3 }),
+    ).toThrow(/no server at 20\.9/);
+    // The hop was still taken — the router forwarded before the far side
+    // rejected the frame.
+    expect(router.snapshot().routed).toBe(2);
+  });
+
+  it('a subnet-scoped network rejects foreign-subnet registrations and senders', () => {
+    const left = createNetwork({ subnet: '10' });
+    expect(() => left.registerServer('20.5', createWebServer())).toThrow(/outside subnet 10\.x/);
+    expect(() => left.send({ from: '20.2', to: '10.1', request: 'GET /' })).toThrow(
+      /outside subnet 10\.x/,
+    );
+    // Without a subnet (Stages 1-5) nothing changes.
+    const plain = createNetwork();
+    plain.registerServer('20.5', createWebServer({ address: '20.5' }));
+    expect(plain.send({ from: '10.2', to: '20.5', request: 'GET /' }).response).toBe(
+      '200 Welcome to the home page',
+    );
+  });
+});
