diff --git a/js/sim/router.js b/js/sim/router.js
new file mode 100644
index 0000000..6f96f99
--- /dev/null
+++ b/js/sim/router.js
@@ -0,0 +1,66 @@
+// DOCUMENTS: the Stage 6 component — a Router that joins the 10.x and 20.x
+// network instances. Any cross-subnet frame takes exactly one router hop
+// (routed += 1); frames addressed to the router's own interfaces are the
+// frames it terminates itself, so the 20-side (20.1) is the only reachable
+// target in subnet 20 in Stage 6a — Stage 6b occupies it with the CDN edge.
+// Same-subnet sends stay entirely inside their Network and do not see the
+// Router at all.
+//
+// CHECKS: both interface addresses are validated as two-number mini-IPs and
+// must sit in different subnets — a router with both legs in one subnet is a
+// mis-configuration that fails loud.
+export function createRouter({ leftAddress = '10.65', rightAddress = '20.1' } = {}) {
+  for (const addr of [leftAddress, rightAddress]) {
+    if (!/^\d+\.\d+$/.test(addr)) {
+      throw new Error(`router: invalid mini-IP address ${addr}`);
+    }
+  }
+  if (leftAddress.split('.')[0] === rightAddress.split('.')[0]) {
+    throw new Error(
+      `router: both legs sit in subnet ${leftAddress.split('.')[0]}.x (${leftAddress}, ${rightAddress})`,
+    );
+  }
+  let routed = 0;
+  const received = []; // frames terminated at the router's own interface
+
+  return {
+    get leftAddress() {
+      return leftAddress;
+    },
+    get rightAddress() {
+      return rightAddress;
+    },
+
+    // One cross-subnet hop: the Network hands frames here before the peer
+    // network resolves them, so 20.9's fail-loud throw still happens on the
+    // far side — after the hop was counted.
+    hop() {
+      routed += 1;
+    },
+
+    // Frames the router terminates at its own interface. The slim protocol
+    // answer names both legs; it is the only body 20.1 serves in 6a.
+    handleRequest() {
+      return `200 Router ${leftAddress} ⇄ ${rightAddress}`;
+    },
+
+    // deliverToQueue's cross-subnet record, isYou riding through untouched.
+    enqueue(record) {
+      received.push(record);
+      return record;
+    },
+
+    lastReceived() {
+      return received[received.length - 1] ?? null;
+    },
+
+    snapshot() {
+      return {
+        leftAddress,
+        rightAddress,
+        routed,
+        received: [...received],
+      };
+    },
+  };
+}
