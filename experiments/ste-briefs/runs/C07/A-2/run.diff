@@ -0,0 +1,195 @@
+// DOCUMENTS: per-hop highlight targets — which node card executes the hop
+// and which wire lane carries it, per stage's trace shape. Split from
+// render-stage.js by responsibility (guard-file-size): the renderer reads
+// the resolved { cardId, laneId }; this module owns the per-stage owner and
+// lane tables. Zero engine knowledge: the snapshot's trace record in,
+// highlight target out.
+export function activeHopTarget(snapshot) {
+  const hop = snapshot.trace?.hop ?? 0;
+  if (snapshot.stage === 6) {
+    const t = snapshot.trace ?? {};
+    const backendCard = t.targetServer === '10.12' ? 'node-webserver-2' : 'node-webserver';
+    const dbLane = t.dbOp === 'WRITE' ? 'packet-req-db' : 'packet-res-db';
+    // Host-less paths keep the Stage 5 highlight story verbatim.
+    if (!t.hosted) {
+      const owners = {
+        1: 'node-browser',
+        2: 'node-network',
+        3: 'node-lb',
+        4: t.asyncJob ? 'node-queue' : 'node-db',
+        5: backendCard,
+        6: 'node-network',
+        7: 'node-browser',
+        8: 'node-worker',
+      };
+      const lanes = {
+        1: 'packet-req-left',
+        2: 'packet-req-right',
+        3: 'packet-req-lb',
+        4: t.asyncJob ? 'packet-req-queue' : dbLane,
+        5: 'packet-res-cache',
+        6: 'packet-res-right',
+        7: 'packet-res-left',
+        8: t.asyncJob ? 'packet-res-db' : 'packet-res-worker',
+      };
+      return { cardId: owners[hop] ?? 'node-browser', laneId: lanes[hop] ?? 'packet-req-left' };
+    }
+    // NX: the trace ends at the DNS answer — the browser renders the NX
+    // card, and no Stage 5 card lights up.
+    if (t.status === 'NX') {
+      const owners = { 1: 'node-browser', 2: 'node-dns', 3: 'node-dns' };
+      const lanes = { 1: 'packet-req-left', 2: 'packet-req-dns', 3: 'packet-res-dns' };
+      return { cardId: owners[hop] ?? 'node-browser', laneId: lanes[hop] ?? 'packet-req-left' };
+    }
+    // Hosted paths shift the Stage 5 story two hops later (the two DNS hops
+    // ask + answer in between).
+    const owners = {
+      1: 'node-browser',
+      2: 'node-dns',
+      3: 'node-dns',
+      4: 'node-network',
+      5: 'node-lb',
+      6: t.asyncJob ? 'node-queue' : 'node-db',
+      7: backendCard,
+      8: 'node-network',
+      9: 'node-browser',
+      10: 'node-worker',
+    };
+    const lanes = {
+      1: 'packet-req-left',
+      2: 'packet-req-dns',
+      3: 'packet-res-dns',
+      4: 'packet-req-right',
+      5: 'packet-req-lb',
+      6: t.asyncJob ? 'packet-req-queue' : dbLane,
+      7: 'packet-res-cache',
+      8: 'packet-res-right',
+      9: 'packet-res-left',
+      10: t.asyncJob ? 'packet-res-db' : 'packet-res-worker',
+    };
+    return { cardId: owners[hop] ?? 'node-browser', laneId: lanes[hop] ?? 'packet-req-left' };
+  }
+  if (snapshot.stage === 5) {
+    // Async POST /jobs walks browser -> lb -> enqueue -> 202 -> worker
+    // commit; every other request keeps the Stage 4 cache/db story and the
+    // worker reads idle on the tail hop.
+    const backendCard =
+      snapshot.trace?.targetServer === '10.12' ? 'node-webserver-2' : 'node-webserver';
+    const dbLane = snapshot.trace?.dbOp === 'WRITE' ? 'packet-req-db' : 'packet-res-db';
+    const owners = snapshot.trace?.asyncJob
+      ? {
+          1: 'node-browser',
+          2: 'node-network',
+          3: 'node-lb',
+          4: 'node-queue',
+          5: 'node-webserver',
+          6: 'node-network',
+          7: 'node-browser',
+          8: 'node-worker',
+        }
+      : {
+          1: 'node-browser',
+          2: 'node-network',
+          3: 'node-lb',
+          4: 'node-db',
+          5: backendCard,
+          6: 'node-network',
+          7: 'node-browser',
+          8: 'node-worker',
+        };
+    const lanes = snapshot.trace?.asyncJob
+      ? {
+          1: 'packet-req-left',
+          2: 'packet-req-right',
+          3: 'packet-req-lb',
+          4: 'packet-req-queue',
+          5: 'packet-res-cache',
+          6: 'packet-res-right',
+          7: 'packet-res-left',
+          8: 'packet-res-db',
+        }
+      : {
+          1: 'packet-req-left',
+          2: 'packet-req-right',
+          3: 'packet-req-lb',
+          4: dbLane,
+          5: 'packet-res-cache',
+          6: 'packet-res-right',
+          7: 'packet-res-left',
+          8: 'packet-res-worker',
+        };
+    return { cardId: owners[hop] ?? 'node-browser', laneId: lanes[hop] ?? 'packet-req-left' };
+  }
+  if (snapshot.stage === 4) {
+    const backendCard =
+      snapshot.trace?.targetServer === '10.12' ? 'node-webserver-2' : 'node-webserver';
+    const dbLane = snapshot.trace?.dbOp === 'WRITE' ? 'packet-req-db' : 'packet-res-db';
+    const owners = {
+      1: 'node-browser',
+      2: 'node-network',
+      3: 'node-lb',
+      4: 'node-cache',
+      5: 'node-db',
+      6: backendCard,
+      7: 'node-browser',
+    };
+    const lanes = {
+      1: 'packet-req-left',
+      2: 'packet-req-right',
+      3: 'packet-req-lb',
+      4: 'packet-req-cache',
+      5: dbLane,
+      6: 'packet-res-cache',
+      7: 'packet-res-left',
+    };
+    return { cardId: owners[hop], laneId: lanes[hop] };
+  }
+  if (snapshot.stage === 3) {
+    const backendCard =
+      snapshot.trace?.targetServer === '10.12' ? 'node-webserver-2' : 'node-webserver';
+    const owners = {
+      1: 'node-browser',
+      2: 'node-network',
+      3: 'node-lb',
+      4: 'node-cache',
+      5: backendCard,
+      6: 'node-browser',
+    };
+    const lanes = {
+      1: 'packet-req-left',
+      2: 'packet-req-right',
+      3: 'packet-req-lb',
+      4: 'packet-req-cache',
+      5: 'packet-res-cache',
+      6: 'packet-res-left',
+    };
+    return { cardId: owners[hop], laneId: lanes[hop] };
+  }
+  if (snapshot.stage === 2) {
+    const backendCard =
+      snapshot.trace?.targetServer === '10.12' ? 'node-webserver-2' : 'node-webserver';
+    const owners = {
+      1: 'node-browser',
+      2: 'node-network',
+      3: 'node-lb',
+      4: backendCard,
+      5: 'node-browser',
+    };
+    const lanes = {
+      1: 'packet-req-left',
+      2: 'packet-req-right',
+      3: 'packet-req-lb',
+      4: 'packet-res-lb',
+      5: 'packet-res-left',
+    };
+    return { cardId: owners[hop], laneId: lanes[hop] };
+  }
+  const owners = { 1: 'node-browser', 2: 'node-network', 3: 'node-webserver', 4: 'node-browser' };
+  const lanes = {
+    1: 'packet-req-left',
+    2: 'packet-req-right',
+    3: 'packet-res-right',
+    4: 'packet-res-left',
+  };
+  return { cardId: owners[hop], laneId: lanes[hop] };
+}
