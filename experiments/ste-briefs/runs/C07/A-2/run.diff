diff --git a/js/panel/legend-drawer.js b/js/panel/legend-drawer.js
new file mode 100644
index 0000000..c29a7fd
--- /dev/null
+++ b/js/panel/legend-drawer.js
@@ -0,0 +1,52 @@
+// DOCUMENTS: the legend drawer's content — the app's own glossary (tick
+// clock, cache stats trio, Ring 3 site chips, wire-lane direction labels).
+// Built in js rather than panel.html because that page sits at its 550-line
+// cap (the teaching-drawer.js precedent); the empty #legend-panel aside
+// stays in the HTML and this module fills it at boot, before the teaching
+// drawer attaches next to it.
+//
+// CHECKS: every node is created with createElement + textContent only — no
+// innerHTML, no inline styles, no inline handlers (CSP).
+export function initLegendDrawer() {
+  const panel = document.getElementById('legend-panel');
+  if (!panel) return;
+
+  const row = (parts) => {
+    const p = document.createElement('p');
+    p.className = 'legend-row';
+    for (const [tag, text] of parts) {
+      if (tag === 'text') p.append(text);
+      else {
+        const code = document.createElement('code');
+        code.textContent = text;
+        p.append(code);
+      }
+    }
+    return p;
+  };
+
+  panel.replaceChildren(
+    row([
+      ['text', 'Clock — tick = 100 ms (sim time advances in explicit ticks, '],
+      ['code', 'TICK_MS = 100'],
+      ['text', ' in '],
+      ['code', 'js/panel/model.js'],
+      ['text', '). Wire lanes name the direction: '],
+      ['code', 'request =>'],
+      ['text', ', '],
+      ['code', '<- response'],
+      ['text', ', '],
+      ['code', 'enqueue =>'],
+      ['text', ', '],
+      ['code', 'write =>'],
+      ['text', '.'],
+    ]),
+    row([
+      ['text', 'Cache — the '],
+      ['code', 'Hits / Misses / TTL-remaining'],
+      ['text', ' trio counts warm lookups, cold lookups, and ticks left per entry. Ring 3 '],
+      ['code', 'site'],
+      ['text', " chips are the compact browsers' mini-IPs; click one to expand it."],
+    ]),
+  );
+}
