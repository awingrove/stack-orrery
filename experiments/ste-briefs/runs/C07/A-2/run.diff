+++ b/e2e/panel-stage6.spec.js
@@ -0,0 +1,138 @@
+import { test, expect } from '@playwright/test';
+
+// Stage 6a (stage6a brief): DNS 10.60 with a tick-TTL ledger + the
+// cross-subnet Router 10.65 ⇄ 20.1 on the 8-ring orrery. These assertions
+// live in their own spec (guard-file-size splits e2e by responsibility —
+// panel.spec.js sits at its 450-line cap). Titles are manifest pins
+// (SIM-6 / PANEL-6): do not reword.
+
+// The Stage 6 orrery: 8 rings, the DNS card on Ring 7 with its live TTL
+// ledger, and the Router side-card beside the 10.x hub. A hosted URL
+// resolves through DNS 10.60 — first trace fills the ledger from the
+// authoritative table, the second answers from it — and the DNS code +
+// ledger state open in the bottom inspector.
+test('should switch to Stage 6, resolve example.com through DNS 10.60, and inspect DNS code + TTL ledger', async ({
+  page,
+}) => {
+  await page.goto('/panel.html');
+
+  await page.getByTestId('stage-pill-6').click();
+  await expect(page.getByTestId('node-dns')).toBeVisible();
+  await expect(page.getByTestId('node-router')).toBeVisible();
+  await expect(page.locator('.orrery-ring')).toHaveCount(8);
+  await expect(page.locator('.orrery-ring').first()).toHaveAttribute('r', '400');
+  await expect(page.locator('.orrery-ring').last()).toHaveAttribute('r', '3200');
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 0 · Cached hits: 0 · TTL: 300t');
+  await expect(page.getByTestId('router-stats')).toHaveText('Routed: 0 · 10.65 ⇄ 20.1');
+
+  // First hosted trace: 10 hops; the ledger misses and the authoritative
+  // table fills it (Lookups 1, Cached hits 0, a live ledger row).
+  await page.getByTestId('url-input').fill('example.com/about');
+  for (let hop = 0; hop < 10; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText('Hop 10/10');
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 1 · Cached hits: 0 · TTL: 300t');
+  await expect(page.getByTestId('dns-entries-list')).toContainText('example.com · 10.1 · ttl');
+
+  // Second hosted trace: the ledger answers — Cached hits 1, still only
+  // one authoritative consult.
+  await page.getByTestId('btn-url-go').click();
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 2 · Cached hits: 1 · TTL: 300t');
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+
+  // The DNS code and its live ledger state open in the inspector.
+  await page.getByTestId('node-dns').click();
+  await expect(page.getByTestId('inspector-code')).toContainText('createDns');
+  await expect(page.getByTestId('inspector-state')).toContainText('"cachedHits": 1');
+  await expect(page.getByTestId('inspector-state')).toContainText('"authoritativeHits": 1');
+  await expect(page.getByTestId('inspector-title')).toHaveText('DNS — mini-IP 10.60');
+
+  // The Router card carries its two legs and its routed counter (no
+  // cross-subnet frame moved in 6a's teaching path).
+  await page.getByTestId('node-router').click();
+  await expect(page.getByTestId('inspector-code')).toContainText('createRouter');
+  await expect(page.getByTestId('inspector-state')).toContainText('"routed": 0');
+  await expect(page.getByTestId('inspector-title')).toHaveText('Router — 10.65 ⇄ 20.1');
+});
+
+// The hosted trace narrates the DNS ask + answer hops: hop 2 asks DNS 10.60
+// for example.com, hop 3 answers `example.com is 10.1`, then the Stage 5
+// chain runs at hops 4-10. An unknown name (nope.example/about) stops the
+// trace at the NX answer — the browser renders the NX card and no GET runs.
+test('should trace example.com/about with DNS ask + answer hops', async ({ page }) => {
+  await page.goto('/panel.html');
+
+  await page.getByTestId('stage-pill-6').click();
+  await page.getByTestId('url-input').fill('example.com/about');
+  await page.getByTestId('btn-next-hop').click();
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText(
+    'Hop 2/10: Browser (10.2) asks DNS (10.60) for example.com',
+  );
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText(
+    'Hop 3/10: DNS (10.60) -> 10.2: example.com is 10.1',
+  );
+  for (let hop = 0; hop < 7; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText(
+    'Hop 10/10: Worker (10.41) idle — no async jobs in this trace',
+  );
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+
+  // Unknown host: DNS ask, then NX — the trace ends at hop 3 with the NX
+  // card rendered, and the DNS ledger gained no row for it.
+  await page.getByTestId('url-input').fill('nope.example/about');
+  await page.getByTestId('btn-next-hop').click();
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText(
+    'Hop 2/3: Browser (10.2) asks DNS (10.60) for nope.example',
+  );
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText(
+    'Hop 3/3: DNS (10.60) -> 10.2: NX no record for nope.example',
+  );
+  await expect(page.getByTestId('browser-status-badge')).toContainText('NX');
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('no record');
+  await expect(page.getByTestId('dns-entries-list')).not.toContainText('nope.example');
+});
+
+// Negative-case pin (brief §Negative-case, trace branch): a host-less
+// `GET /about` on Stage 6 keeps the Stage 5 hop story — 8 hops, the same
+// hop texts, and no DNS consult at all.
+test('should keep GET /about on Stage 6 at the Stage 5 hop story', async ({ page }) => {
+  await page.goto('/panel.html');
+
+  await page.getByTestId('stage-pill-6').click();
+  await page.getByTestId('url-input').fill('/about');
+  for (let hop = 0; hop < 2; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText(
+    'Hop 2/8: Network (10.x) routes to LoadBalancer (10.1)',
+  );
+  for (let hop = 0; hop < 6; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText(
+    'Hop 8/8: Worker (10.41) idle — no async jobs in this trace',
+  );
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+  // Plain paths skip DNS entirely: the ledger still reads untouched.
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 0 · Cached hits: 0 · TTL: 300t');
+});
+
+// Negative-case pin (brief §Negative-case, deep-link): the live-stage set
+// extends to 6, and unknown values still fall back to Stage 1 without
+// errors.
+test('should deep-link ?stage=6 and fall back to stage 1 on unknown ?stage=7', async ({ page }) => {
+  const errors = [];
+  page.on('pageerror', (error) => errors.push(error));
+  page.on('console', (msg) => {
+    if (msg.type() === 'error') errors.push(msg.text());
+  });
+
+  await page.goto('/panel.html?stage=6');
+  await expect(page.getByTestId('stage-pill-6')).toHaveAttribute('aria-current', 'true');
+  await expect(page.getByTestId('node-dns')).toBeVisible();
+
+  await page.goto('/panel.html?stage=7');
+  await expect(page.getByTestId('stage-pill-1')).toHaveAttribute('aria-current', 'true');
+  await expect(page.getByTestId('server-address')).toHaveText('10.1');
+  expect(errors).toEqual([]);
+});
