+// DOCUMENTS: Stage 6 orrery cards — the DNS resolver card (#node-dns with
+// its stats line and TTL-ledger list), the cross-subnet Router card
+// (#node-router), and the DNS wire lane. Built in js rather than panel.html
+// because that page sits at its 550-line cap (the teaching-drawer.js
+// precedent); behavior stays addEventListener-only — these cards are plain
+// click targets that panel.js wires after initStage6Nodes() runs.
+//
+// CHECKS: every node is created with createElement + textContent/attributes
+// only — no innerHTML, no inline styles, no inline handlers (CSP).
+
+// renderStageTopology toggles these cards' visibility; the stats lines and
+// the ledger list update from the live snapshot on every render.
+export function initStage6Nodes() {
+  const dnsCard = document.createElement('article');
+  dnsCard.className = 'node-card';
+  dnsCard.id = 'node-dns';
+  dnsCard.dataset.testid = 'node-dns';
+  dnsCard.dataset.component = 'dns';
+  dnsCard.hidden = true;
+
+  const dnsHead = document.createElement('header');
+  dnsHead.className = 'node-head';
+  const dnsName = document.createElement('div');
+  dnsName.className = 'node-name';
+  const dnsRole = document.createElement('span');
+  dnsRole.className = 'role-name';
+  dnsRole.textContent = 'DNS';
+  const dnsSub = document.createElement('span');
+  dnsSub.className = 'node-subtitle';
+  dnsSub.textContent = 'name resolver';
+  dnsName.append(dnsRole, dnsSub);
+  const dnsChip = document.createElement('span');
+  dnsChip.className = 'ip-chip';
+  dnsChip.textContent = '10.60';
+  const dnsCode = document.createElement('span');
+  dnsCode.className = 'code-chip';
+  dnsCode.textContent = '</> Code';
+  dnsHead.append(dnsName, dnsChip, dnsCode);
+
+  const dnsStats = document.createElement('p');
+  dnsStats.id = 'dns-stats';
+  dnsStats.dataset.testid = 'dns-stats';
+  dnsStats.className = 'mono last-frame';
+  dnsStats.textContent = 'Lookups: 0 · Cached hits: 0 · TTL: 300t';
+
+  const dnsList = document.createElement('ul');
+  dnsList.id = 'dns-entries-list';
+  dnsList.dataset.testid = 'dns-entries-list';
+  dnsList.className = 'route-list';
+  dnsList.setAttribute('aria-label', 'DNS TTL ledger');
+  dnsCard.append(dnsHead, dnsStats, dnsList);
+
+  const routerCard = document.createElement('article');
+  routerCard.className = 'node-card';
+  routerCard.id = 'node-router';
+  routerCard.dataset.testid = 'node-router';
+  routerCard.dataset.component = 'router';
+  routerCard.hidden = true;
+
+  const routerHead = document.createElement('header');
+  routerHead.className = 'node-head';
+  const routerName = document.createElement('div');
+  routerName.className = 'node-name';
+  const routerRole = document.createElement('span');
+  routerRole.className = 'role-name';
+  routerRole.textContent = 'Router';
+  const routerSub = document.createElement('span');
+  routerSub.className = 'node-subtitle';
+  routerSub.textContent = 'cross-subnet gateway';
+  routerName.append(routerRole, routerSub);
+  const routerChip = document.createElement('span');
+  routerChip.className = 'ip-chip';
+  routerChip.textContent = '10.65 ⇄ 20.1';
+  const routerCode = document.createElement('span');
+  routerCode.className = 'code-chip';
+  routerCode.textContent = '</> Code';
+  routerHead.append(routerName, routerChip, routerCode);
+
+  const routerStats = document.createElement('p');
+  routerStats.id = 'router-stats';
+  routerStats.dataset.testid = 'router-stats';
+  routerStats.className = 'mono last-frame';
+  routerStats.textContent = 'Routed: 0 · 10.65 ⇄ 20.1';
+  routerCard.append(routerHead, routerStats);
+
+  const dnsLane = document.createElement('div');
+  dnsLane.id = 'wire-dns';
+  dnsLane.className = 'wire-column';
+  dnsLane.setAttribute('aria-hidden', 'true');
+  dnsLane.hidden = true;
+  const reqLane = document.createElement('div');
+  reqLane.id = 'packet-req-dns';
+  reqLane.className = 'wire-lane';
+  reqLane.textContent = 'ask =>';
+  const resLane = document.createElement('div');
+  resLane.id = 'packet-res-dns';
+  resLane.className = 'wire-lane reverse';
+  resLane.textContent = '<- answer';
+  dnsLane.append(reqLane, resLane);
+
+  const dnsTab = document.createElement('button');
+  dnsTab.className = 'comp-tab';
+  dnsTab.type = 'button';
+  dnsTab.dataset.select = 'dns';
+  dnsTab.textContent = 'dns';
+  const routerTab = document.createElement('button');
+  routerTab.className = 'comp-tab';
+  routerTab.type = 'button';
+  routerTab.dataset.select = 'router';
+  routerTab.textContent = 'router';
+
+  document.getElementById('orrery-world').append(dnsCard, routerCard, dnsLane);
+  document.querySelector('.comp-tabs').append(dnsTab, routerTab);
+}
+
+export function renderStage6(snapshot) {
+  if (snapshot.stage < 6) return;
+  const dnsStats = document.getElementById('dns-stats');
+  const dnsList = document.getElementById('dns-entries-list');
+  const routerStats = document.getElementById('router-stats');
+  if (dnsStats && snapshot.dns) {
+    dnsStats.textContent = `Lookups: ${snapshot.dns.lookups} · Cached hits: ${snapshot.dns.cachedHits} · TTL: ${snapshot.dns.ttlTicks}t`;
+    dnsList.replaceChildren(
+      ...snapshot.dns.cache.map((entry) => {
+        const item = document.createElement('li');
+        item.className = 'route-item';
+        item.textContent = `${entry.name} · ${entry.target} · ttl ${entry.ttlRemaining}t`;
+        return item;
+      }),
+    );
+  }
+  if (routerStats && snapshot.router) {
+    routerStats.textContent = `Routed: ${snapshot.router.routed} · ${snapshot.router.leftAddress} ⇄ ${snapshot.router.rightAddress}`;
+  }
+}
