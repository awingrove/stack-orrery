@@ -0,0 +1,194 @@
+import { describe, it, expect } from 'vitest';
+import { describeSnapshot } from '../../js/panel/model.js';
+import { componentTitle, formatComponentState } from '../../js/panel/inspector-state.js';
+
+// Stage-boundary extraction from model.test.js (guard-file-size): the
+// Stage 6 DNS/Router narrative branches are pinned here so model.test.js
+// stays inside the 450-line test cap. The three negative-case contracts of
+// the brief live in these pins.
+const baseSnapshot = (trace) => ({
+  stage: 6,
+  tick: 3,
+  users: 5,
+  serverAddress: '10.1',
+  queueDepth: 0,
+  served: 1,
+  avgLatencyTicks: 1,
+  loadBalancer: {
+    address: '10.1',
+    nextBackend: '10.12',
+    forwarded: 1,
+    lastTarget: '10.11',
+    perBackend: { 10.11: 1, 10.12: 0 },
+  },
+  cache: { address: '10.20', ttlTicks: 10, hits: 1, misses: 0, entries: [] },
+  database: { primaryAddress: '10.30', replicaAddress: '10.31', replicationLagTicks: 3, rows: [] },
+  workerQueue: { workerAddress: '10.41', pendingJobs: [] },
+  browserDisplay: {
+    from: '10.2',
+    to: '10.1',
+    request: 'GET /about',
+    response: '200 This is the about page',
+    status: 200,
+    body: 'This is the about page',
+  },
+  dns: {
+    address: '10.60',
+    ttlTicks: 300,
+    lookups: 1,
+    cachedHits: 0,
+    authoritativeHits: 1,
+    cache: [{ name: 'example.com', target: '10.1', ttlRemaining: 298 }],
+  },
+  router: { leftAddress: '10.65', rightAddress: '20.1', routed: 0, received: [] },
+  trace,
+});
+
+describe('describeSnapshot stage 6', () => {
+  // Negative-case pin (brief §Negative-case, trace branch): a host-less
+  // `GET /about` on stage 6 keeps the stage-5 hop count and hop texts
+  // byte-identical — no DNS hop, no cross-subnet hop.
+  it('stage 6 host-less GET /about keeps the stage-5 hop story byte-identical', () => {
+    const snap = baseSnapshot({
+      hop: 4,
+      method: 'GET',
+      path: '/about',
+      request: 'GET /about',
+      from: '10.2',
+      targetServer: '10.11',
+      dbOp: null,
+      dbStale: false,
+      cacheStatus: 'HIT',
+      response: '200 This is the about page',
+      status: 200,
+      totalHops: 8,
+    });
+    const labels = describeSnapshot(snap);
+    expect(labels.stage).toBe(6);
+    expect(labels.totalHops).toBe(8);
+    expect(labels.hopStatus).toBe('Hop 4/8: Database SKIP — warm cache HIT (10.20)');
+
+    const hopLabels = (hop, over = {}) =>
+      describeSnapshot({ ...snap, trace: { ...snap.trace, hop, ...over } }).hopStatus;
+    // The eight sentences must match the Stage 5 strings exactly.
+    expect(hopLabels(1)).toBe('Hop 1/8: Browser (10.2) emits "GET /about"');
+    expect(hopLabels(2)).toBe('Hop 2/8: Network (10.x) routes to LoadBalancer (10.1)');
+    expect(hopLabels(3)).toBe('Hop 3/8: LoadBalancer (10.1) -> 10.11 queue');
+    expect(hopLabels(4)).toBe('Hop 4/8: Database SKIP — warm cache HIT (10.20)');
+    expect(hopLabels(5)).toBe(
+      'Hop 5/8: WebServer (10.11) -> "200 This is the about page" (cache HIT)',
+    );
+    expect(hopLabels(6)).toBe('Hop 6/8: Network delivers 200 response to 10.2');
+    expect(hopLabels(7)).toBe('Hop 7/8: Browser (10.2) received and displayed 200');
+    expect(hopLabels(8)).toBe('Hop 8/8: Worker (10.41) idle — no async jobs in this trace');
+  });
+
+  // Negative-case pin (brief §3): a hosted trace adds exactly 2 DNS hops —
+  // the ask and the answer — before the Stage 5 chain, at /10 denominators.
+  it('a hosted stage-6 trace adds exactly 2 DNS hops to the stage-5 story', () => {
+    const snap = baseSnapshot({
+      hop: 3,
+      method: 'GET',
+      path: 'example.com/about',
+      request: 'GET example.com/about',
+      from: '10.2',
+      host: 'example.com',
+      hosted: true,
+      dnsTarget: '10.1',
+      targetServer: '10.11',
+      dbOp: 'SELECT',
+      dbStale: false,
+      cacheStatus: 'MISS',
+      response: '200 This is the about page',
+      status: 200,
+      totalHops: 10,
+    });
+    const labels = describeSnapshot(snap);
+    expect(labels.totalHops).toBe(10);
+    expect(labels.hopStatus).toBe('Hop 3/10: DNS (10.60) -> 10.2: example.com is 10.1');
+
+    const hopLabels = (hop) =>
+      describeSnapshot({ ...snap, trace: { ...snap.trace, hop } }).hopStatus;
+    expect(hopLabels(1)).toBe('Hop 1/10: Browser (10.2) emits "GET example.com/about"');
+    expect(hopLabels(2)).toBe('Hop 2/10: Browser (10.2) asks DNS (10.60) for example.com');
+    // Hops 4-10 are the Stage 5 chain verbatim, two hops later.
+    expect(hopLabels(4)).toBe('Hop 4/10: Network (10.x) routes to LoadBalancer (10.1)');
+    expect(hopLabels(5)).toBe('Hop 5/10: LoadBalancer (10.1) -> 10.11 queue');
+    expect(hopLabels(9)).toBe('Hop 9/10: Browser (10.2) received and displayed 200');
+    expect(hopLabels(10)).toBe('Hop 10/10: Worker (10.41) idle — no async jobs in this trace');
+  });
+
+  // Negative-case pin (brief §Negative-case, unknown-name branch): the NX
+  // path is DNS ask + NX answer only — the trace ends at hop 3, the browser
+  // renders the NX card, and no GET sentence exists to run.
+  it('an unknown-host NX trace answers DNS ask + NX and never emits a GET', () => {
+    const snap = baseSnapshot({
+      hop: 3,
+      method: 'GET',
+      path: 'nope.example/about',
+      request: 'GET nope.example/about',
+      from: '10.2',
+      host: 'nope.example',
+      hosted: true,
+      dnsTarget: null,
+      targetServer: null,
+      response: 'NX no record',
+      status: 'NX',
+      body: 'no record',
+      totalHops: 3,
+    });
+    // The browser card renders the NX record the DNS answer delivered.
+    snap.browserDisplay = {
+      from: '10.2',
+      to: '10.60',
+      request: 'GET nope.example/about',
+      response: 'NX no record',
+      status: 'NX',
+      body: 'no record',
+    };
+    const labels = describeSnapshot(snap);
+    expect(labels.totalHops).toBe(3);
+    expect(labels.hopStatus).toBe('Hop 3/3: DNS (10.60) -> 10.2: NX no record for nope.example');
+
+    // Beyond the NX answer there is no Stage 5 chain to narrate: the trace
+    // is over, so the hop-status line falls back to the idle sentence.
+    expect(describeSnapshot({ ...snap, trace: { ...snap.trace, hop: 4 } }).hopStatus).toBe(
+      'Idle — type a path and click Go or Step 1 Hop ->',
+    );
+    const all = JSON.stringify(labels);
+    expect(all).toContain('NX no record for nope.example');
+    // The Stage 5 chain sentences are absent from the NX trace's story.
+    expect(all).not.toContain('LoadBalancer (10.1) -> 10.11 queue');
+    expect(labels.browserStatus).toBe('NX (GET nope.example/about)');
+    expect(labels.browserBody).toBe('no record');
+  });
+
+  it('maps the DNS and Router live state to the inspector as JSON', () => {
+    const snap = baseSnapshot({
+      hop: 0,
+      request: 'GET /about',
+      status: null,
+      response: null,
+    });
+    const dnsState = JSON.parse(formatComponentState(snap, 'dns'));
+    expect(dnsState).toEqual({
+      address: '10.60',
+      ttlTicks: 300,
+      lookups: 1,
+      cachedHits: 0,
+      authoritativeHits: 1,
+      lastLookup: null,
+      authoritative: { 'example.com': '10.1' },
+      cache: [{ name: 'example.com', target: '10.1', ttlRemaining: 298 }],
+    });
+    expect(componentTitle(snap, 'dns')).toBe('DNS — mini-IP 10.60');
+    const routerState = JSON.parse(formatComponentState(snap, 'router'));
+    expect(routerState).toEqual({
+      leftAddress: '10.65',
+      rightAddress: '20.1',
+      routed: 0,
+      received: [],
+    });
+    expect(componentTitle(snap, 'router')).toBe('Router — 10.65 ⇄ 20.1');
+  });
+});
