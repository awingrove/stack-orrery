new file mode 100644
index 0000000..c636ff9
--- /dev/null
+++ b/js/sim/dns.js
@@ -0,0 +1,98 @@
+// DOCUMENTS: the Stage 6 component — a DNS resolver with a tick-TTL ledger
+// that mirrors the Cache's ledger pattern (js/sim/cache.js). The
+// authoritative table lives in-component (example.com -> 10.1; Stage 6b adds
+// a CDN name); lookup() consults it only on a cache miss or an expired
+// entry, and a hit inside ttlTicks increments cachedHits with NO
+// authoritative consult. Determinism: no clock, no RNG — time arrives as
+// the `currentTick` argument, the same way the Cache keeps time.
+//
+// CHECKS: the constructor rejects an address that is not a two-number
+// mini-IP and a ttlTicks that is not a positive integer (fail-loud over
+// silent mis-configuration), while an unknown name answers { status: 'NX' }
+// and never throws at the DNS layer (the fail-loud throw rule belongs to
+// cross-subnet addresses in network.js).
+const MINI_IP = /^\d+\.\d+$/;
+
+export function createDns({ address = '10.60', ttlTicks = 300 } = {}) {
+  if (!MINI_IP.test(address)) {
+    throw new Error(`dns: invalid mini-IP address ${address}`);
+  }
+  if (!Number.isInteger(ttlTicks) || ttlTicks < 1) {
+    throw new Error(`dns: ttlTicks must be a positive integer, got ${ttlTicks}`);
+  }
+  const authoritative = new Map([['example.com', '10.1']]);
+  const entries = new Map(); // name -> { name, target, cachedAtTick, expiresAtTick }
+  let lookups = 0;
+  let cachedHits = 0;
+  let authoritativeHits = 0;
+  let evictions = 0;
+  let lastLookup = null;
+
+  // An entry is stale the moment the current tick reaches its expiry —
+  // the same tick math as the Cache (cached at T, alive through T + ttl - 1).
+  function evictExpired(currentTick = 0) {
+    for (const entry of entries.values()) {
+      if (currentTick >= entry.expiresAtTick) {
+        entries.delete(entry.name);
+        evictions += 1;
+      }
+    }
+  }
+
+  function lookup(name, currentTick = 0) {
+    lookups += 1;
+    evictExpired(currentTick);
+    const entry = entries.get(name);
+    if (entry) {
+      // Ledger hit: the authoritative table is not touched at all.
+      cachedHits += 1;
+      lastLookup = { name, status: 'OK', source: 'cache', atTick: currentTick };
+      return { status: 'OK', name, target: entry.target, source: 'cache', atTick: currentTick };
+    }
+    // Miss or expired entry: the only path that consults the table.
+    const target = authoritative.get(name) ?? null;
+    if (target === null) {
+      lastLookup = { name, status: 'NX', atTick: currentTick };
+      return { status: 'NX', name, atTick: currentTick };
+    }
+    authoritativeHits += 1;
+    entries.set(name, {
+      name,
+      target,
+      cachedAtTick: currentTick,
+      expiresAtTick: currentTick + ttlTicks,
+    });
+    lastLookup = { name, status: 'OK', source: 'authoritative', atTick: currentTick };
+    return { status: 'OK', name, target, source: 'authoritative', atTick: currentTick };
+  }
+
+  function snapshot(currentTick = 0) {
+    evictExpired(currentTick);
+    return {
+      address,
+      ttlTicks,
+      lookups,
+      cachedHits,
+      authoritativeHits,
+      evictions,
+      lastLookup,
+      authoritative: Object.fromEntries(authoritative),
+      cache: [...entries.values()].map((e) => ({
+        name: e.name,
+        target: e.target,
+        cachedAtTick: e.cachedAtTick,
+        expiresAtTick: e.expiresAtTick,
+        ttlRemaining: e.expiresAtTick - currentTick,
+      })),
+    };
+  }
+
+  return {
+    get address() {
+      return address;
+    },
+    evictExpired,
+    lookup,
+    snapshot,
+  };
+}
