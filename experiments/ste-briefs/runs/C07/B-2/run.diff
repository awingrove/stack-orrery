+// and rejects a pair on the same subnet (a "cross"-subnet router that
+// connects one subnet to itself is a mis-wiring, not a topology). Sends into
+// subnet 20 to an unregistered host (20.9) fail loud through the target
+// network's own resolve — mirrors network.js — and a queued frame to an
+// endpoint that cannot accept one fails loud instead of throwing a raw
+// TypeError.
+const MINI_IP = /^\d+\.\d+$/;
+
+const netOf = (address) => String(address).split('.')[0];
+
+export function createRouter({ leftAddress = '10.65', rightAddress = '20.1' } = {}) {
+  if (!MINI_IP.test(leftAddress)) {
+    throw new Error(`router: invalid mini-IP address ${leftAddress}`);
+  }
+  if (!MINI_IP.test(rightAddress)) {
+    throw new Error(`router: invalid mini-IP address ${rightAddress}`);
+  }
+  if (netOf(leftAddress) === netOf(rightAddress)) {
+    throw new Error(
+      `router: interfaces must join two different subnets, got ${leftAddress} and ${rightAddress}`,
+    );
+  }
+  let leftNetwork = null;
+  let rightNetwork = null;
+  let routed = 0;
+
+  // The router's own 20-side presence: the one address in subnet 20 that
+  // answers in Stage 6a (a bare interface reply; Stage 6b replaces it with
+  // the CDN edge server).
+  const interfaceEndpoint = {
+    handleRequest: () => `200 router interface ${rightAddress}`,
+  };
+
+  function networkFor(to) {
+    if (!leftNetwork || !rightNetwork) {
+      throw new Error('router: not joined to both networks');
+    }
+    const net = netOf(to);
+    if (net === netOf(rightAddress)) return rightNetwork;
+    if (net === netOf(leftAddress)) return leftNetwork;
+    throw new Error(`router: no interface for subnet ${net}`);
+  }
+
+  return {
+    get address() {
+      return leftAddress;
+    },
+
+    get leftAddress() {
+      return leftAddress;
+    },
+
+    get rightAddress() {
+      return rightAddress;
+    },
+
+    // Wiring: both networks learn the gateway, and the far network learns
+    // the router's own right-side address as its one reachable endpoint.
+    join(left, right) {
+      leftNetwork = left;
+      rightNetwork = right;
+      left.attachRouter(this);
+      right.attachRouter(this);
+      right.registerServer(rightAddress, interfaceEndpoint);
+    },
+
+    // One counted hop for a synchronous request/response crossing.
+    forwardRequest(frame) {
+      const response = networkFor(frame.to).send(frame).response;
+      routed += 1;
+      return response;
+    },
+
+    // One counted hop for a queued frame crossing.
+    forwardToQueue(frame) {
+      const server = networkFor(frame.to).resolve(frame.to);
+      if (typeof server.enqueue !== 'function') {
+        throw new Error(`router: ${frame.to} does not accept queued frames`);
+      }
+      networkFor(frame.to).deliverToQueue(frame);
+      routed += 1;
+    },
+
+    snapshot() {
+      return { leftAddress, rightAddress, routed };
+    },
+  };
+}
