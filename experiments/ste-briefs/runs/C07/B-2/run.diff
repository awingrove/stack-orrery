+import { test, expect } from '@playwright/test';
+
+// Stage 6 (DNS 10.60 + cross-subnet Router 10.65 ⇄ 20.1) on the real page
+// served by the real static server. The sim runs from a fixed seed, so
+// hop stories and counter readings are identical on every run.
+test('should switch to Stage 6, resolve example.com through DNS 10.60, and inspect DNS code + TTL ledger', async ({
+  page,
+}) => {
+  await page.goto('/panel.html');
+
+  await page.getByTestId('stage-pill-6').click();
+  await expect(page.getByTestId('node-dns')).toBeVisible();
+  await expect(page.getByTestId('node-router')).toBeVisible();
+  await expect(page.locator('.orrery-ring')).toHaveCount(8);
+  await expect(page.locator('.orrery-ring').last()).toHaveAttribute('r', '3200');
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 0 · Cached: 0 · Authority: 0');
+  await expect(page.getByTestId('router-stats')).toHaveText('Routed: 0 · 10.65 ⇄ 20.1');
+
+  // First hosted trace: the cold lookup consults the authority and warms
+  // the ledger (example.com -> 10.1, ttl 300t).
+  await page.getByTestId('url-input').fill('example.com/about');
+  await page.getByTestId('btn-url-go').click();
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 1 · Cached: 0 · Authority: 1');
+  await expect(page.getByTestId('dns-entries-list')).toHaveText('example.com -> 10.1 · ttl 299t');
+
+  // Second hosted trace: the ledger answers — a hit inside ttlTicks
+  // increments Cached while Authority holds still (no consult).
+  await page.getByTestId('btn-url-go').click();
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 2 · Cached: 1 · Authority: 1');
+
+  await page.getByTestId('node-dns').click();
+  await expect(page.getByTestId('inspector-code')).toContainText('createDns');
+  await expect(page.getByTestId('inspector-state')).toContainText('"cachedHits": 1');
+  await page.getByTestId('node-router').click();
+  await expect(page.getByTestId('inspector-code')).toContainText('createRouter');
+  await expect(page.getByTestId('inspector-state')).toContainText('"routed": 0');
+});
+
+test('should trace example.com/about with DNS ask + answer hops', async ({ page }) => {
+  await page.goto('/panel.html');
+
+  await page.getByTestId('stage-pill-6').click();
+  await page.getByTestId('url-input').fill('example.com/about');
+  // Hops 1-3: the emit, the DNS ask, and the authoritative answer.
+  await page.getByTestId('btn-next-hop').click();
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 2/10: Browser (10.2) asks DNS (10.60) for "example.com"',
+  );
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 3/10: DNS (10.60) answers "example.com -> 10.1" (authoritative)',
+  );
+  // Hops 4-10 ride the Stage 5 chain.
+  for (let hop = 0; hop < 7; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 10/10: Worker (10.41) idle — no async jobs in this trace',
+  );
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+
+  // The journey log carries the 10-hop run, ask and answer included.
+  const labels = await page.getByTestId('journey-log').locator('.journey-entry').allTextContents();
+  const hopRows = labels.map((text) => text.match(/^(hop \d+\/10)/)?.[1]);
+  expect(hopRows.slice(0, 10)).toEqual([
+    'hop 1/10',
+    'hop 2/10',
+    'hop 3/10',
+    'hop 4/10',
+    'hop 5/10',
+    'hop 6/10',
+    'hop 7/10',
+    'hop 8/10',
+    'hop 9/10',
+    'hop 10/10',
+  ]);
+});
+
+// Negative-case pin: a host-less GET on Stage 6 keeps the Stage 5 hop
+// story — no DNS hop, 8 hops, and the resolver ledger stays empty.
+test('should keep GET /about on Stage 6 at the Stage 5 hop story', async ({ page }) => {
+  await page.goto('/panel.html');
+
+  await page.getByTestId('stage-pill-6').click();
+  await page.getByTestId('url-input').fill('/about');
+  await page.getByTestId('btn-url-go').click();
+
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 8/8: Worker (10.41) idle — no async jobs in this trace',
+  );
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+  // No DNS hop: zero lookups reached the resolver.
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 0 · Cached: 0 · Authority: 0');
+  await expect(page.getByTestId('dns-entries-list')).toBeEmpty();
+});
+
+// Negative-case pin: the unknown-name trace answers NX — the browser card
+// renders it and no GET reaches the stack.
+test('should render the NX card for nope.example/about without emitting a GET', async ({
+  page,
+}) => {
+  await page.goto('/panel.html');
+
+  await page.getByTestId('stage-pill-6').click();
+  await page.getByTestId('url-input').fill('nope.example/about');
+  await page.getByTestId('btn-url-go').click();
+
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 4/4: Browser (10.2) renders NX — no GET emitted',
+  );
+  await expect(page.getByTestId('browser-status-badge')).toContainText('NX');
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('no record');
+  await expect(page.getByTestId('served')).toHaveText('0');
+  // The journey log carries the 4-hop NX run. The first two labels read
+  // the hosted denominator (/10) because the run's shape is only known at
+  // the DNS answer — the reveal flips it to /4 exactly when NX lands.
+  const labels = await page.getByTestId('journey-log').locator('.journey-entry').allTextContents();
+  expect(labels.slice(0, 4).map((text) => text.match(/^(hop \d+\/\d+)/)?.[1])).toEqual([
+    'hop 1/10',
+    'hop 2/10',
+    'hop 3/4',
+    'hop 4/4',
+  ]);
+});
+
+// The deep-link live-stage set extends to 6.
+test('should deep-link ?stage=6 to the live Stage 6 registry', async ({ page }) => {
+  await page.goto('/panel.html?stage=6');
+  await expect(page.getByTestId('stage-pill-6')).toHaveAttribute('aria-current', 'true');
+  await expect(page.getByTestId('node-dns')).toBeVisible();
+  await expect(page.getByTestId('node-router')).toBeVisible();
+});
