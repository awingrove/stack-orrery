@@ -0,0 +1,42 @@
+// DOCUMENTS: the Stage 1 single-server hop program of the trace machine —
+// route into the one queue, drain until the learner's own request comes
+// back, render on the browser — split from trace.js by responsibility
+// (guard-file-size). The machine's shared helpers (serve, finish,
+// drainUntilYou) are handed in as closures; the trace record is mutated in
+// place, one hop per call, exactly as the inline branches did.
+export function stage1Hop({
+  trace,
+  serverAddress,
+  network,
+  servers,
+  bumpTick,
+  serve,
+  finish,
+  drainUntilYou,
+}) {
+  if (trace.hop === 1) {
+    trace.hop = 2;
+    const atTick = bumpTick();
+    network.deliverToQueue({
+      id: `you:${atTick}`,
+      from: trace.from,
+      to: serverAddress,
+      request: trace.request,
+      atTick,
+      isYou: true,
+    });
+    return `routed ${trace.from} -> ${serverAddress} (${trace.request}) into queue`;
+  }
+  if (trace.hop === 2) {
+    trace.hop = 3;
+    const you = drainUntilYou(servers[0]);
+    if (you) {
+      serve(you);
+      return `${serverAddress} -> ${trace.from} | ${you.response}`;
+    }
+    return null;
+  }
+  trace.hop = 4;
+  finish(serverAddress);
+  return null;
+}
