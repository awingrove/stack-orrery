index 0000000..c365116
--- /dev/null
+++ b/js/sim/dns.js
@@ -0,0 +1,82 @@
+// DOCUMENTS: the Stage 6 component — a DNS resolver at mini-IP 10.60 with a
+// tick-TTL ledger. The authoritative name table lives in-component
+// (example.com -> 10.1; Stage 6b adds the CDN edge name) and a resolver
+// cache answers repeat lookups until each entry's TTL runs out. It is a
+// real Map lookup on the resolution path, not a probability: a cached name
+// answers from the ledger, a miss (or an entry past its expiry) consults
+// the authority and re-warms the ledger. Determinism follows the repo rule:
+// time arrives as the `currentTick` argument, the same way the WebServer
+// and Cache keep time.
+//
+// CHECKS: the constructor rejects an address that is not a two-number
+// mini-IP and a ttlTicks that is not a positive integer (fail-loud over
+// silent mis-configuration). An unknown name answers NX at this layer —
+// the throw rule belongs to cross-subnet addresses (router.js), so the
+// browser can render the NX card instead of crashing.
+export function createDns({ address = '10.60', ttlTicks = 300 } = {}) {
+  if (!/^\d+\.\d+$/.test(address)) {
+    throw new Error(`dns: invalid mini-IP address ${address}`);
+  }
+  if (!Number.isInteger(ttlTicks) || ttlTicks < 1) {
+    throw new Error(`dns: ttlTicks must be a positive integer, got ${ttlTicks}`);
+  }
+  const authority = new Map([['example.com', '10.1']]);
+  const cache = new Map(); // name -> { name, target, cachedAtTick, expiresAtTick }
+  let lookups = 0;
+  let cachedHits = 0;
+  let authoritative = 0;
+
+  // The TTL branch: a live ledger entry answers with `cachedHits` counting
+  // and the authority untouched; a miss or an expired entry (currentTick
+  // reaching expiresAtTick) consults the authority table instead — an
+  // expired entry is not answered from the ledger.
+  function lookup(name, currentTick = 0) {
+    lookups += 1;
+    const entry = cache.get(name);
+    if (entry && currentTick < entry.expiresAtTick) {
+      cachedHits += 1;
+      return { status: 'OK', name, target: entry.target, source: 'cache' };
+    }
+    authoritative += 1;
+    const target = authority.get(name) ?? null;
+    if (target === null) {
+      cache.delete(name);
+      return { status: 'NX', name };
+    }
+    cache.set(name, {
+      name,
+      target,
+      cachedAtTick: currentTick,
+      expiresAtTick: currentTick + ttlTicks,
+    });
+    return { status: 'OK', name, target, source: 'authoritative' };
+  }
+
+  function snapshot(currentTick = 0) {
+    for (const [name, entry] of cache) {
+      if (currentTick >= entry.expiresAtTick) cache.delete(name);
+    }
+    return {
+      address,
+      ttlTicks,
+      lookups,
+      cachedHits,
+      authoritative,
+      cache: [...cache.values()].map((e) => ({
+        name: e.name,
+        target: e.target,
+        cachedAtTick: e.cachedAtTick,
+        expiresAtTick: e.expiresAtTick,
+        ttlRemaining: e.expiresAtTick - currentTick,
+      })),
+    };
+  }
+
+  return {
+    get address() {
+      return address;
+    },
+    lookup,
+    snapshot,
+  };
+}
