+import { describe, it, expect } from 'vitest';
+import { createNetwork } from '../../js/sim/network.js';
+import { createRouter } from '../../js/sim/router.js';
+import { createWebServer } from '../../js/sim/webserver.js';
+
+describe('createRouter', () => {
+  // PINS: same-subnet frames are the networks' own business — with a
+  // router joined, a send inside 10.x keeps today's send contract and the
+  // routed counter holds at 0.
+  it('same-subnet sends keep the send and queue contract unchanged', () => {
+    const left = createNetwork();
+    const right = createNetwork({ subnet: '20' });
+    const router = createRouter();
+    router.join(left, right);
+    left.registerServer('10.1', createWebServer({ address: '10.1' }));
+
+    expect(left.send({ from: '10.2', to: '10.1', request: 'GET /about' })).toEqual({
+      from: '10.2',
+      to: '10.1',
+      request: 'GET /about',
+      response: '200 This is the about page',
+    });
+    left.deliverToQueue({
+      id: 'you:1',
+      from: '10.2',
+      to: '10.1',
+      request: 'GET /about',
+      atTick: 1,
+      isYou: true,
+    });
+    expect(router.snapshot()).toMatchObject({
+      leftAddress: '10.65',
+      rightAddress: '20.1',
+      routed: 0,
+    });
+  });
+
+  // PINS: the cross-subnet branch — a frame into subnet 20 takes exactly
+  // one counted router hop (the router's 20.1 side is the one reachable
+  // target in 6a), and an unregistered 20.x host fails loud through the
+  // target network's resolve (named counter-example: 20.9 throws, routed
+  // counts no hop for the failed frame).
+  it('cross-subnet frames take exactly one router hop and unregistered 20.x hosts fail loud', () => {
+    const left = createNetwork();
+    const right = createNetwork({ subnet: '20' });
+    const router = createRouter();
+    router.join(left, right);
+
+    expect(left.send({ from: '10.2', to: '20.1', request: 'GET /' })).toEqual({
+      from: '10.2',
+      to: '20.1',
+      request: 'GET /',
+      response: '200 router interface 20.1',
+    });
+    expect(router.snapshot().routed).toBe(1);
+
+    // CHECKS: 20.9 is unregistered in subnet 20 — the failure is loud and
+    // the counter counts no hop for it.
+    expect(() => left.send({ from: '10.2', to: '20.9', request: 'GET /' })).toThrow(
+      /no server at 20\.9/,
+    );
+    expect(router.snapshot().routed).toBe(1);
+
+    // A queued frame to an endpoint that cannot accept one fails loud too.
+    expect(() =>
+      left.deliverToQueue({ id: 'q:1', from: '10.2', to: '20.1', request: 'GET /', atTick: 1 }),
+    ).toThrow(/does not accept queued frames/);
+    expect(router.snapshot().routed).toBe(1);
+
+    // Without a router attached, a foreign address fails the old way.
+    const detached = createNetwork();
+    expect(() => detached.send({ from: '10.2', to: '20.1', request: 'GET /' })).toThrow(
+      /no server at 20\.1/,
+    );
+  });
+
+  // CHECKS: the constructor validates both interfaces as two-number
+  // mini-IPs and rejects a pair on the same subnet (fail-loud mis-wiring).
+  it('rejects malformed interfaces and same-subnet pairs', () => {
+    expect(() => createRouter({ leftAddress: '1065' })).toThrow(/invalid mini-IP/);
+    expect(() => createRouter({ rightAddress: 'x.1' })).toThrow(/invalid mini-IP/);
+    expect(() => createRouter({ leftAddress: '10.65', rightAddress: '10.9' })).toThrow(
+      /two different subnets/,
+    );
+  });
+});
