@@ -0,0 +1,81 @@
+// DOCUMENTS: the Stage 6 inspector code entries (DNS, Router), split from
+// inspector-source.js by responsibility (guard-file-size). js/sim/dns.js
+// and js/sim/router.js are the executable truth; these are the readable
+// mirrors rendered into #inspector-code.
+export const STAGE6_COMPONENT_SOURCE = {
+  dns: {
+    file: 'js/sim/dns.js',
+    code: `createDns({ address = '10.60', ttlTicks = 300 } = {}) {
+  // address must be "<net>.<host>" — a two-number mini-IP
+  const authority = new Map([['example.com', '10.1']]); // 6b adds the CDN name
+  const cache = new Map(); // name -> { name, target, cachedAtTick, expiresAtTick }
+  let lookups = 0, cachedHits = 0, authoritative = 0;
+  function lookup(name, currentTick = 0) {
+    lookups += 1;
+    const entry = cache.get(name);
+    if (entry && currentTick < entry.expiresAtTick) {  // live ledger entry
+      cachedHits += 1;  // the authority table is NOT consulted on a hit
+      return { status: 'OK', name, target: entry.target, source: 'cache' };
+    }
+    // miss or expired entry: the ledger does not answer, ask the authority
+    authoritative += 1;
+    const target = authority.get(name) ?? null;
+    if (target === null) {
+      cache.delete(name);
+      return { status: 'NX', name };  // NX at this layer — the browser renders it
+    }
+    cache.set(name, { name, target, cachedAtTick: currentTick,
+      expiresAtTick: currentTick + ttlTicks });
+    return { status: 'OK', name, target, source: 'authoritative' };
+  }
+  function snapshot(currentTick = 0) {
+    for (const [name, entry] of cache) {
+      if (currentTick >= entry.expiresAtTick) cache.delete(name);
+    }
+    return { address, ttlTicks, lookups, cachedHits, authoritative,
+      cache: [...cache.values()].map((e) => ({ ...e,
+        ttlRemaining: e.expiresAtTick - currentTick })) };
+  }
+  return { address, lookup, snapshot };
+}`,
+  },
+  router: {
+    file: 'js/sim/router.js',
+    code: `createRouter({ leftAddress = '10.65', rightAddress = '20.1' } = {}) {
+  // both interfaces must be "<net>.<host>" mini-IPs on DIFFERENT subnets
+  let leftNetwork = null, rightNetwork = null, routed = 0;
+  // the router's own 20-side presence: the one reachable 20.x address (6b
+  // replaces it with the CDN edge server)
+  const interfaceEndpoint = { handleRequest: () => \`200 router interface \${rightAddress}\` };
+  function networkFor(to) {
+    if (!leftNetwork || !rightNetwork) throw new Error('router: not joined to both networks');
+    const net = String(to).split('.')[0];
+    if (net === String(rightAddress).split('.')[0]) return rightNetwork;
+    if (net === String(leftAddress).split('.')[0]) return leftNetwork;
+    throw new Error(\`router: no interface for subnet \${net}\`);
+  }
+  return {
+    address: leftAddress, leftAddress, rightAddress,
+    join(left, right) {  // both networks learn the gateway
+      leftNetwork = left; rightNetwork = right;
+      left.attachRouter(this); right.attachRouter(this);
+      right.registerServer(rightAddress, interfaceEndpoint);
+    },
+    forwardRequest(frame) {  // one counted hop, request/response
+      const response = networkFor(frame.to).send(frame).response;
+      routed += 1;
+      return response;
+    },
+    forwardToQueue(frame) {  // one counted hop, queued frame
+      const server = networkFor(frame.to).resolve(frame.to);
+      if (typeof server.enqueue !== 'function') {
+        throw new Error(\`router: \${frame.to} does not accept queued frames\`);
+      }
+      networkFor(frame.to).deliverToQueue(frame);
+      routed += 1;
+    },
+    snapshot() { return { leftAddress, rightAddress, routed }; },
+  };
+}`,
+  },
+};
