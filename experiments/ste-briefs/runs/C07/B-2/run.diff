+// DOCUMENTS: Stage 6 inspector registry entries — the #node-dns and
+// #node-router node cards, the live `6 · Multi-Net / CDN` stage pill, and
+// the two inspector tabs — mounted with createElement only (no innerHTML,
+// no inline handlers/styles — CSP). guard-file-size keeps panel.html under
+// 550 lines, so the Stage 6 registry builds here instead of in the static
+// page; the cards behave like every other .node-card (click to select,
+// renderStageTopology toggles visibility).
+function ipChip(text) {
+  const chip = document.createElement('span');
+  chip.className = 'ip-chip';
+  chip.textContent = text;
+  return chip;
+}
+
+function nodeHead(role, subtitle, chipText) {
+  const head = document.createElement('header');
+  head.className = 'node-head';
+  const name = document.createElement('div');
+  name.className = 'node-name';
+  const roleName = document.createElement('span');
+  roleName.className = 'role-name';
+  roleName.textContent = role;
+  const sub = document.createElement('span');
+  sub.className = 'node-subtitle';
+  sub.textContent = subtitle;
+  name.replaceChildren(roleName, sub);
+  const code = document.createElement('span');
+  code.className = 'code-chip';
+  code.textContent = '</> Code';
+  head.replaceChildren(name, ipChip(chipText), code);
+  return head;
+}
+
+function nodeCard({ id, component, role, subtitle, chipText, statsId, statsTestId, statsText }) {
+  const card = document.createElement('article');
+  card.className = 'node-card';
+  card.id = id;
+  card.dataset.testid = component === 'dns' ? 'node-dns' : 'node-router';
+  card.dataset.component = component;
+  card.hidden = true;
+  card.replaceChildren(nodeHead(role, subtitle, chipText));
+  const stats = document.createElement('p');
+  stats.id = statsId;
+  stats.dataset.testid = statsTestId;
+  stats.className = 'mono last-frame';
+  stats.textContent = statsText;
+  card.append(stats);
+  if (component === 'dns') {
+    const list = document.createElement('ul');
+    list.id = 'dns-entries-list';
+    list.dataset.testid = 'dns-entries-list';
+    list.className = 'route-list';
+    list.setAttribute('aria-label', 'Resolver cache entries');
+    card.append(list);
+  }
+  return card;
+}
+
+export function mountStage6Nodes() {
+  const ladder = document.querySelector('.stage-ladder');
+  const pill = document.createElement('button');
+  pill.type = 'button';
+  pill.dataset.testid = 'stage-pill-6';
+  pill.dataset.stage = '6';
+  pill.className = 'stage-pill';
+  pill.textContent = '6 · Multi-Net / CDN';
+  ladder.append(pill);
+
+  const world = document.getElementById('orrery-world');
+  world.append(
+    nodeCard({
+      id: 'node-dns',
+      component: 'dns',
+      role: 'DNS',
+      subtitle: 'tick-TTL resolver',
+      chipText: '10.60',
+      statsId: 'dns-stats',
+      statsTestId: 'dns-stats',
+      statsText: 'Lookups: 0 · Cached: 0 · Authority: 0',
+    }),
+    nodeCard({
+      id: 'node-router',
+      component: 'router',
+      role: 'Router',
+      subtitle: 'cross-subnet gateway',
+      chipText: '10.65 ⇄ 20.1',
+      statsId: 'router-stats',
+      statsTestId: 'router-stats',
+      statsText: 'Routed: 0 · 10.65 ⇄ 20.1',
+    }),
+  );
+
+  const tabs = document.querySelector('.comp-tabs');
+  for (const name of ['dns', 'router']) {
+    const tab = document.createElement('button');
+    tab.type = 'button';
+    tab.className = 'comp-tab';
+    tab.dataset.select = name;
+    tab.textContent = name;
+    tabs.append(tab);
+  }
+}
