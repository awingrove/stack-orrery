new file mode 100644
index 0000000..87842af
--- /dev/null
+++ b/test/sim/dns.test.js
@@ -0,0 +1,95 @@
+import { describe, it, expect } from 'vitest';
+import { createDns } from '../../js/sim/dns.js';
+
+describe('createDns', () => {
+  // PINS: the TTL branch — a lookup consults the authoritative table only
+  // on a cache miss or an expired entry; a hit inside ttlTicks increments
+  // cachedHits and the authority counter holds still.
+  it('resolves through the authority on a miss and serves cache hits inside ttlTicks without consulting the authority', () => {
+    const dns = createDns({ address: '10.60', ttlTicks: 300 });
+
+    // Cold lookup: a real Map miss, answered by the authority table.
+    expect(dns.lookup('example.com', 1)).toEqual({
+      status: 'OK',
+      name: 'example.com',
+      target: '10.1',
+      source: 'authoritative',
+    });
+    expect(dns.snapshot(1)).toMatchObject({
+      address: '10.60',
+      ttlTicks: 300,
+      lookups: 1,
+      cachedHits: 0,
+      authoritative: 1,
+    });
+    expect(dns.snapshot(1).cache).toEqual([
+      {
+        name: 'example.com',
+        target: '10.1',
+        cachedAtTick: 1,
+        expiresAtTick: 301,
+        ttlRemaining: 300,
+      },
+    ]);
+
+    // Warm lookup inside ttlTicks: the ledger answers, cachedHits counts,
+    // and the authority is NOT consulted again (authoritative stays 1).
+    expect(dns.lookup('example.com', 100)).toEqual({
+      status: 'OK',
+      name: 'example.com',
+      target: '10.1',
+      source: 'cache',
+    });
+    expect(dns.snapshot(100)).toMatchObject({ lookups: 2, cachedHits: 1, authoritative: 1 });
+  });
+
+  // PINS: the named counter-example — an expired entry is NOT answered
+  // from the cache ledger; the tick that reaches expiresAtTick hands the
+  // lookup back to the authority and re-warms the entry.
+  it('an expired entry is not answered from the ledger — the authority re-answers and the entry re-warms', () => {
+    const dns = createDns({ address: '10.60', ttlTicks: 300 });
+    dns.lookup('example.com', 1);
+    // Tick 300 is still inside the TTL (cached at 1, alive through 300):
+    // the ledger answers.
+    expect(dns.lookup('example.com', 300).source).toBe('cache');
+    // Tick 301 has reached expiresAtTick: the ledger must not answer —
+    // the authority re-answers and the entry re-warms for a fresh TTL.
+    const answer = dns.lookup('example.com', 301);
+    expect(answer).toEqual({
+      status: 'OK',
+      name: 'example.com',
+      target: '10.1',
+      source: 'authoritative',
+    });
+    const snap = dns.snapshot(301);
+    expect(snap).toMatchObject({ lookups: 3, cachedHits: 1, authoritative: 2 });
+    expect(snap.cache).toEqual([
+      {
+        name: 'example.com',
+        target: '10.1',
+        cachedAtTick: 301,
+        expiresAtTick: 601,
+        ttlRemaining: 300,
+      },
+    ]);
+  });
+
+  // PINS: the NX branch — an unknown name answers { status: 'NX' } at the
+  // DNS layer (a throw belongs to cross-subnet addresses, not here), and
+  // the ledger records nothing for a name it cannot resolve.
+  it('unknown names answer NX without a throw and leave the ledger untouched', () => {
+    const dns = createDns({ address: '10.60', ttlTicks: 300 });
+    expect(dns.lookup('nope.example', 5)).toEqual({ status: 'NX', name: 'nope.example' });
+    const snap = dns.snapshot(5);
+    expect(snap).toMatchObject({ lookups: 1, cachedHits: 0, authoritative: 1 });
+    expect(snap.cache).toEqual([]);
+  });
+
+  // CHECKS: the constructor rejects a non-mini-IP address and a
+  // non-positive or non-integer ttlTicks (fail-loud over silent misconfig).
+  it('rejects a non mini-IP address and a non-positive ttlTicks', () => {
+    expect(() => createDns({ address: '1060' })).toThrow(/invalid mini-IP/);
+    expect(() => createDns({ ttlTicks: 0 })).toThrow(/ttlTicks/);
+    expect(() => createDns({ ttlTicks: 1.5 })).toThrow(/ttlTicks/);
+  });
+});
