+// DOCUMENTS: the Stage 6 DNS phase of the trace machine — the ask, the
+// answer, and the NX tail, split from trace.js by responsibility
+// (guard-file-size). A hosted path (`example.com/about`) splits host/path
+// on the first "/"; the browser asks DNS 10.60 on hop 2, the answer hop
+// performs the lookup (a live ledger entry answers from the cache, a miss
+// or an expired entry consults the authority table), and an unknown name
+// arms the NX tail: the browser renders the NX card and the GET is skipped
+// outright.
+export function splitHostPath(path) {
+  if (path.startsWith('/')) return { host: null, path };
+  const slashAt = path.indexOf('/');
+  const host = slashAt === -1 ? path : path.slice(0, slashAt);
+  return { host, path: slashAt === -1 ? '/' : path.slice(slashAt) };
+}
+
+// Total hops for the current run's shape: hosted = stage-5 count + 2 DNS
+// hops; NX = 4; host-less = 8.
+export function finalHop6(trace) {
+  return trace.nx ? 4 : trace.hosted ? 10 : 8;
+}
+
+export function dnsAskHop(trace, dns) {
+  return `${trace.from} -> DNS ${dns.address} | ask ${trace.host}`;
+}
+
+export function dnsAnswerHop({ trace, dns, getTick }) {
+  const answer = dns.lookup(trace.host, getTick());
+  if (answer.status === 'NX') {
+    trace.nx = true;
+    trace.dnsStatus = 'NX';
+    return `DNS ${dns.address} -> ${trace.from} | NX no record for ${trace.host}`;
+  }
+  trace.dnsStatus = answer.source;
+  trace.resolvedTarget = answer.target;
+  trace.wireRequest = `${trace.method} ${trace.path}`;
+  return `DNS ${dns.address} -> ${trace.from} | ${trace.host} -> ${answer.target} (${answer.source})`;
+}
+
+export function nxRenderHop({ trace, dns, onFinish }) {
+  trace.response = 'NX no record';
+  trace.status = 'NX';
+  trace.body = 'no record';
+  onFinish({
+    from: trace.from,
+    to: dns.address,
+    request: trace.request,
+    response: trace.response,
+  });
+  return `Browser ${trace.from} renders NX — no GET emitted`;
+}
