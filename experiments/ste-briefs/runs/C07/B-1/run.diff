diff --git a/test/sim/dns.test.js b/test/sim/dns.test.js
new file mode 100644
index 0000000..b89b137
--- /dev/null
+++ b/test/sim/dns.test.js
@@ -0,0 +1,157 @@
+import { describe, it, expect } from 'vitest';
+import { createDns } from '../../js/sim/dns.js';
+import { createEngine } from '../../js/sim/engine.js';
+
+describe('createDns', () => {
+  it('answers a cache hit inside ttlTicks without consulting the authority, and an expired entry only from the authority', () => {
+    // CHECKS: the named counter-example pair — a hit inside ttlTicks
+    // increments cachedHits with NO authoritative consult, and an entry at
+    // its expiry is answered from the authority, not the stale ledger row.
+    const dns = createDns({ address: '10.60', ttlTicks: 5 });
+
+    // Cold lookup: the authority answers and the ledger fills (tick 0 ->
+    // expiresAtTick 5, alive through tick 4).
+    const miss = dns.lookup('example.com', 0);
+    expect(miss).toEqual({
+      status: 'OK',
+      name: 'example.com',
+      target: '10.1',
+      source: 'authoritative',
+    });
+    expect(dns.snapshot(0)).toMatchObject({
+      lookups: 1,
+      cachedHits: 0,
+      authoritativeLookups: 1,
+      entries: [{ name: 'example.com', target: '10.1', expiresAtTick: 5, ttlRemaining: 5 }],
+    });
+
+    // Warm lookup inside the TTL: cachedHits climbs, the authority stays
+    // untouched (authoritativeLookups pinned at 1), and the target is the
+    // ledger's own row.
+    const hit = dns.lookup('example.com', 4);
+    expect(hit).toEqual({ status: 'OK', name: 'example.com', target: '10.1', source: 'cache' });
+    expect(dns.snapshot(4)).toMatchObject({
+      lookups: 2,
+      cachedHits: 1,
+      authoritativeLookups: 1,
+      lastLookup: { name: 'example.com', source: 'cache', atTick: 4 },
+    });
+
+    // CHECKS: tick 5 IS the expiry — the ledger row does not answer; the
+    // authority is consulted again and the row refreshes.
+    const expired = dns.lookup('example.com', 5);
+    expect(expired.source).toBe('authoritative');
+    expect(dns.snapshot(5)).toMatchObject({
+      lookups: 3,
+      cachedHits: 1,
+      authoritativeLookups: 2,
+      entries: [{ name: 'example.com', target: '10.1', expiresAtTick: 10, ttlRemaining: 5 }],
+    });
+  });
+
+  it('answers an unknown name with NX, never a throw, and caches no negative row', () => {
+    const dns = createDns({ address: '10.60', ttlTicks: 300 });
+    expect(dns.lookup('nope.example', 0)).toEqual({ status: 'NX' });
+    // A second unknown lookup consults the authority again — NX is not a
+    // cacheable answer, so the ledger stays empty.
+    expect(dns.lookup('nope.example', 1)).toEqual({ status: 'NX' });
+    const snap = dns.snapshot(1);
+    expect(snap.entries).toEqual([]);
+    expect(snap.authoritativeLookups).toBe(2);
+    expect(snap.authoritative).toEqual({ 'example.com': '10.1' });
+    expect(snap.lastLookup).toEqual({ name: 'nope.example', source: 'NX', atTick: 1 });
+  });
+
+  it('rejects a non-mini-IP address and a non-positive or non-integer ttlTicks', () => {
+    expect(() => createDns({ address: '1060' })).toThrow(/invalid mini-IP/);
+    expect(() => createDns({ ttlTicks: 0 })).toThrow(/ttlTicks/);
+    expect(() => createDns({ ttlTicks: 2.5 })).toThrow(/ttlTicks/);
+  });
+});
+
+describe('stage 6 DNS wiring', () => {
+  it('stage 6 engine resolves example.com through DNS 10.60 and exposes the ledger in the snapshot', () => {
+    const engine = createEngine({ stage: 6 });
+    let snap = engine.snapshot();
+    expect(snap.dns.address).toBe('10.60');
+    expect(snap.router).toMatchObject({ leftAddress: '10.65', rightAddress: '20.1', routed: 0 });
+
+    // First hosted trace: DNS ask + answer, then the Stage 5 story on the
+    // resolved target — 10 hops, one authoritative lookup.
+    for (let hop = 0; hop < 10; hop++)
+      engine.traceHop({ method: 'GET', path: 'example.com/about' });
+    snap = engine.snapshot();
+    expect(snap.trace.hop).toBe(10);
+    expect(snap.trace.hosted).toBe(true);
+    expect(snap.trace.dnsTarget).toBe('10.1');
+    expect(snap.dns).toMatchObject({ lookups: 1, cachedHits: 0, authoritativeLookups: 1 });
+    // The snapshot is taken at tick 1 (the trace's LB hop bumped the clock),
+    // so the row read out one tick into its TTL.
+    expect(snap.dns.entries).toEqual([
+      { name: 'example.com', target: '10.1', expiresAtTick: 300, ttlRemaining: 299 },
+    ]);
+    expect(snap.browserDisplay.body).toBe('This is the about page');
+
+    // Second hosted trace: the ledger answers inside the TTL — cachedHits
+    // climbs, no second authoritative consult.
+    for (let hop = 0; hop < 10; hop++)
+      engine.traceHop({ method: 'GET', path: 'example.com/about' });
+    snap = engine.snapshot();
+    expect(snap.trace.dnsSource).toBe('cache');
+    expect(snap.dns).toMatchObject({ lookups: 2, cachedHits: 1, authoritativeLookups: 1 });
+  });
+
+  it('NX hosted path never emits a GET — the trace is the DNS ask and the NX answer only', () => {
+    const engine = createEngine({ stage: 6 });
+
+    engine.traceHop({ method: 'GET', path: 'nope.example/about' });
+    let snap = engine.snapshot();
+    expect(snap.trace.hop).toBe(1);
+    expect(snap.lastFrame).toBe('10.2 -> 10.60 | DNS ask nope.example');
+
+    engine.traceHop({ method: 'GET', path: 'nope.example/about' });
+    snap = engine.snapshot();
+    expect(snap.trace.hop).toBe(2);
+    expect(snap.trace.nx).toBe(true);
+    expect(snap.lastFrame).toBe('10.60 -> 10.2 | NX no record');
+    // The browser renders the NX card; nothing was served anywhere.
+    expect(snap.browserDisplay).toMatchObject({ status: 'NX', body: 'no record' });
+    expect(snap.served).toBe(0);
+    expect(snap.lastExchange).toBe(null);
+
+    // A further hop starts a fresh trace, not a phantom GET.
+    engine.traceHop({ method: 'GET', path: 'nope.example/about' });
+    snap = engine.snapshot();
+    expect(snap.trace.hop).toBe(1);
+    expect(snap.lastFrame).toBe('10.2 -> 10.60 | DNS ask nope.example');
+  });
+
+  it('a host-less stage 6 trace replays the stage 5 frames byte-identically', () => {
+    const frames = (stage) => {
+      const engine = createEngine({ stage });
+      const run = [];
+      for (let hop = 0; hop < 8; hop++) {
+        engine.traceHop({ method: 'GET', path: '/about' });
+        run.push(engine.snapshot().lastFrame);
+      }
+      return { run, snap: engine.snapshot() };
+    };
+    const stage5 = frames(5);
+    const stage6 = frames(6);
+    // CHECKS: the named counter-example — GET /about on Stage 6 keeps the
+    // stage-5 hop story byte-identical: no DNS hop, no cross-subnet hop.
+    expect(stage6.run).toEqual(stage5.run);
+    expect(stage6.snap.trace.hosted).toBe(false);
+    expect(stage6.run.join('\n')).not.toContain('10.60');
+    expect(stage6.snap.dns).toMatchObject({ lookups: 0, cachedHits: 0 });
+    expect(stage6.snap.browserDisplay.body).toBe('This is the about page');
+  });
+
+  it('stages 1-5 expose no DNS or Router', () => {
+    for (const stage of [1, 2, 3, 4, 5]) {
+      const snap = createEngine({ stage }).snapshot();
+      expect(snap.dns).toBe(null);
+      expect(snap.router).toBe(null);
+    }
+  });
+});
