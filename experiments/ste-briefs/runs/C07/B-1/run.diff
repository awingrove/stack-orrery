new file mode 100644
index 0000000..dfc7217
--- /dev/null
+++ b/js/sim/router.js
@@ -0,0 +1,68 @@
+// DOCUMENTS: the Stage 6 component — a cross-subnet Router joining the 10.x
+// and 20.x network instances through its two interfaces (left 10.65 on the
+// 10.x side, right 20.1 in subnet 20). Any cross-subnet frame takes exactly
+// one router hop and increments routed; isYou rides through untouched. In
+// Stage 6a nothing lives in subnet 20 besides the router's own presence, so
+// a send addressed to any other 20.x host fails loud — DL-1 fail-loud,
+// mirroring the network's unregistered-host error.
+//
+// CHECKS: the constructor rejects an interface that is not a two-number
+// mini-IP and a router whose two interfaces sit on one subnet (nothing to
+// join). An address not on the remote subnet is refused by handles() so the
+// network keeps its same-subnet resolve contract byte-identical.
+export function createRouter({ leftAddress = '10.65', rightAddress = '20.1' } = {}) {
+  for (const [name, address] of [
+    ['leftAddress', leftAddress],
+    ['rightAddress', rightAddress],
+  ]) {
+    if (!/^\d+\.\d+$/.test(address)) {
+      throw new Error(`router: invalid mini-IP address ${name}=${address}`);
+    }
+  }
+  const leftNet = String(leftAddress).split('.')[0];
+  const rightNet = String(rightAddress).split('.')[0];
+  if (leftNet === rightNet) {
+    throw new Error(`router: both interfaces sit on subnet ${leftNet} — nothing to join`);
+  }
+
+  let routed = 0;
+
+  // True for the addresses this router can forward into its remote subnet —
+  // the network consults this before its own server table.
+  function handles(address) {
+    return /^\d+\.\d+$/.test(address) && String(address).split('.')[0] === rightNet;
+  }
+
+  // One router hop: the frame leaves the 10.x side and arrives in subnet 20.
+  // Delivered frames increment routed; an unroutable host throws before the
+  // counter moves, so routed counts frames the router actually delivered.
+  function route({ from, to, request, isYou = false }) {
+    if (!/^\d+\.\d+$/.test(from)) {
+      throw new Error(`router: invalid mini-IP address ${from}`);
+    }
+    if (!handles(to)) {
+      throw new Error(`router: ${to} is not on subnet ${rightNet}`);
+    }
+    if (to !== rightAddress) {
+      throw new Error(`router: no host at ${to} in subnet ${rightNet}`);
+    }
+    routed += 1;
+    return { from, to, request, response: `200 Router ${rightAddress}`, isYou };
+  }
+
+  function snapshot() {
+    return { leftAddress, rightAddress, routed };
+  }
+
+  return {
+    get leftAddress() {
+      return leftAddress;
+    },
+    get rightAddress() {
+      return rightAddress;
+    },
+    handles,
+    route,
+    snapshot,
+  };
+}
