diff --git a/js/panel/inspector-stage6.js b/js/panel/inspector-stage6.js
new file mode 100644
index 0000000..453f6d2
--- /dev/null
+++ b/js/panel/inspector-stage6.js
@@ -0,0 +1,80 @@
+// DOCUMENTS: the Stage 6 inspector contract — the DNS and Router code
+// mirrors plus their live-state builders, in one module (split by
+// responsibility, guard-file-size). js/sim is the executable truth; these
+// mirrors render the same logic for learners, and the state builders derive
+// every field from the engine snapshot (nothing faked).
+export const STAGE6_COMPONENT_SOURCE = {
+  dns: {
+    file: 'js/sim/dns.js',
+    code: `createDns({ address = '10.60', ttlTicks = 300,
+  records = { 'example.com': '10.1' } } = {}) {
+  // address must be "<net>.<host>" — a two-number mini-IP
+  const authoritative = new Map(Object.entries(records));
+  const cache = new Map(); // name -> { target, expiresAtTick }
+  let lookups = 0, cachedHits = 0, authoritativeLookups = 0;
+  function lookup(name, currentTick = 0) {
+    lookups += 1;
+    const cached = cache.get(name);
+    if (cached && currentTick < cached.expiresAtTick) {
+      cachedHits += 1;  // ledger hit: no authoritative consult
+      return { status: 'OK', name, target: cached.target, source: 'cache' };
+    }
+    authoritativeLookups += 1;  // miss or expired entry
+    const target = authoritative.get(name);
+    if (target === undefined) {
+      return { status: 'NX' };  // unknown name — the browser renders NX
+    }
+    cache.set(name, { name, target, expiresAtTick: currentTick + ttlTicks });
+    return { status: 'OK', name, target, source: 'authoritative' };
+  }
+  function snapshot(currentTick = 0) {
+    return { address, ttlTicks, lookups, cachedHits, authoritativeLookups,
+      authoritative: Object.fromEntries(authoritative),
+      entries: [...cache.values()].map((e) => ({ ...e,
+        ttlRemaining: e.expiresAtTick - currentTick })) };
+  }
+  return { address, lookup, snapshot };
+}`,
+  },
+  router: {
+    file: 'js/sim/router.js',
+    code: `createRouter({ leftAddress = '10.65', rightAddress = '20.1' } = {}) {
+  // both interfaces must be "<net>.<host>" on different subnets
+  const leftNet = leftAddress.split('.')[0];
+  const rightNet = rightAddress.split('.')[0];
+  let routed = 0;
+  function handles(address) {  // true only for the remote subnet
+    return /^\\d+\\.\\d+$/.test(address) && address.split('.')[0] === rightNet;
+  }
+  function route({ from, to, request, isYou = false }) {
+    if (!handles(to)) throw new Error(\`not on subnet \${rightNet}\`);
+    if (to !== rightAddress) {
+      // DL-1 fail-loud: nothing else lives in subnet 20 in Stage 6a
+      throw new Error(\`no host at \${to} in subnet \${rightNet}\`);
+    }
+    routed += 1;  // exactly one router hop per cross-subnet frame
+    return { from, to, request, response: \`200 Router \${rightAddress}\`, isYou };
+  }
+  function snapshot() { return { leftAddress, rightAddress, routed }; }
+  return { leftAddress, rightAddress, handles, route, snapshot };
+}`,
+  },
+};
+
+export const STAGE6_STATE_BUILDERS = {
+  dns: (snapshot) => ({
+    address: snapshot.dns?.address ?? '10.60',
+    ttlTicks: snapshot.dns?.ttlTicks ?? 300,
+    lookups: snapshot.dns?.lookups ?? 0,
+    cachedHits: snapshot.dns?.cachedHits ?? 0,
+    authoritativeLookups: snapshot.dns?.authoritativeLookups ?? 0,
+    authoritative: snapshot.dns?.authoritative ?? { 'example.com': '10.1' },
+    lastLookup: snapshot.dns?.lastLookup ?? null,
+    entries: snapshot.dns?.entries ?? [],
+  }),
+  router: (snapshot) => ({
+    leftAddress: snapshot.router?.leftAddress ?? '10.65',
+    rightAddress: snapshot.router?.rightAddress ?? '20.1',
+    routed: snapshot.router?.routed ?? 0,
+  }),
+};
