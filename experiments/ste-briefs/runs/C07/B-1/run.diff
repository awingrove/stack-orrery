@@ -0,0 +1,114 @@
+import { test, expect } from '@playwright/test';
+
+// Stage 6 (stage6a brief): DNS 10.60 with a tick-TTL ledger, the cross-
+// subnet Router 10.65 ⇄ 20.1, and the hosted-URL grammar. These assertions
+// live in their own spec (guard-file-size splits e2e by responsibility —
+// panel.spec.js sits at its 450-line cap). The sim runs from a fixed seed,
+// so every hop count and counter here is identical on every run.
+
+// The DNS resolver answers hosted paths through its authoritative table and
+// then its TTL ledger; the DNS code and live ledger state open in the
+// bottom inspector.
+test('should switch to Stage 6, resolve example.com through DNS 10.60, and inspect DNS code + TTL ledger', async ({
+  page,
+}) => {
+  await page.goto('/panel.html');
+
+  await page.getByTestId('stage-pill-6').click();
+  await expect(page.getByTestId('stage-pill-6')).toHaveAttribute('aria-current', 'true');
+  await expect(page.getByTestId('node-dns')).toBeVisible();
+  await expect(page.getByTestId('node-router')).toBeVisible();
+  await expect(page.locator('.orrery-ring')).toHaveCount(8);
+  await expect(page.locator('.orrery-ring').first()).toHaveAttribute('r', '400');
+  await expect(page.locator('.orrery-ring').last()).toHaveAttribute('r', '3200');
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 0 · Cached hits: 0 · TTL: 300t');
+  await expect(page.getByTestId('router-stats')).toHaveText('Routed: 0');
+
+  // First hosted trace: the cold lookup misses, the authority answers, and
+  // the ledger row appears with its full TTL.
+  await page.getByTestId('url-input').fill('example.com/about');
+  await page.getByTestId('btn-url-go').click();
+  await expect(page.getByTestId('hop-status')).toContainText('Hop 10/10');
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 1 · Cached hits: 0 · TTL: 300t');
+  await expect(page.getByTestId('dns-entries-list')).toContainText('example.com');
+
+  // Second hosted trace: the ledger answers inside the TTL — cachedHits
+  // climbs while the authoritative table stays untouched.
+  await page.getByTestId('btn-url-go').click();
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 2 · Cached hits: 1 · TTL: 300t');
+
+  await page.getByTestId('node-dns').click();
+  await expect(page.getByTestId('inspector-code')).toContainText('createDns');
+  await expect(page.getByTestId('inspector-state')).toContainText('"cachedHits": 1');
+  await expect(page.getByTestId('inspector-state')).toContainText('"authoritativeLookups": 1');
+  await page.getByTestId('node-router').click();
+  await expect(page.getByTestId('inspector-code')).toContainText('createRouter');
+  await expect(page.getByTestId('inspector-state')).toContainText('"rightAddress": "20.1"');
+});
+
+// The hosted grammar narrates the two DNS hops before the Stage 5 story:
+// hop 1 is the browser's ask, hop 2 the resolver's answer carrying the
+// resolved target.
+test('should trace example.com/about with DNS ask + answer hops', async ({ page }) => {
+  await page.goto('/panel.html?stage=6');
+
+  await page.getByTestId('url-input').fill('example.com/about');
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 1/10: Browser (10.2) asks DNS (10.60) for "example.com"',
+  );
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 2/10: DNS (10.60) answers example.com -> 10.1 (authoritative)',
+  );
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 3/10: Browser (10.2) emits "GET /about"',
+  );
+  // The resolved GET runs the Stage 5 story to its idle-worker tail.
+  for (let hop = 3; hop < 10; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 10/10: Worker (10.41) idle — no async jobs in this trace',
+  );
+  await expect(page.getByTestId('browser-status-badge')).toContainText('200');
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+
+  // The journey log carries the DNS hops inside the same run.
+  const entries = await page
+    .getByTestId('journey-log')
+    .locator('.journey-entry')
+    .first()
+    .textContent();
+  expect(entries).toContain('DNS ask example.com');
+});
+
+// Negative-case pin (DL-3): a host-less path on Stage 6 keeps the Stage 5
+// hop story byte-identically — 8 hops, no DNS ask anywhere, and the resolver
+// counters stay at zero.
+test('should keep GET /about on Stage 6 at the Stage 5 hop story', async ({ page }) => {
+  await page.goto('/panel.html?stage=6');
+
+  await page.getByTestId('url-input').fill('/about');
+  for (let hop = 0; hop < 8; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 8/8: Worker (10.41) idle — no async jobs in this trace',
+  );
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+
+  const journey = await page.getByTestId('journey-log').textContent();
+  expect(journey).not.toContain('10.60');
+  expect(journey).not.toContain('DNS ask');
+  const labels = await page.getByTestId('journey-log').locator('.journey-entry').allTextContents();
+  expect(labels.map((text) => text.match(/^(hop \d\/\d)/)?.[1]).slice(0, 8)).toEqual([
+    'hop 1/8',
+    'hop 2/8',
+    'hop 3/8',
+    'hop 4/8',
+    'hop 5/8',
+    'hop 6/8',
+    'hop 7/8',
+    'hop 8/8',
+  ]);
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 0 · Cached hits: 0 · TTL: 300t');
+});
