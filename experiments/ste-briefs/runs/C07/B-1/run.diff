+// DOCUMENTS: the per-hop story bodies behind the trace machine — given the
+// story coordinate (s, h) of the stage and pre-hop counter, this module runs
+// what actually happens on that hop across the real components (queue
+// delivery, LB round-robin pick, cache-aside lookup, database read/write,
+// async worker) and builds the hop frame from what actually moved. Split
+// from trace.js by responsibility: trace.js owns the trace lifecycle and the
+// Stage 6 hosted DNS grammar; this module owns the served-request story the
+// stages share (the Stage 6 host-less flow reuses the Stage 5 bodies
+// verbatim, so every Stage 1-5 frame text is produced here and nowhere else).
+//
+// CHECKS: a Stage 5 GET keeps the cache/database narrative the served record
+// carries and reports the worker idle on the tail hop — no phantom async job
+// (DL-4): the branch reads the record, not the request string.
+export function createStoryRunner({
+  network,
+  lb,
+  servers,
+  cache,
+  database,
+  workerQueue,
+  serverAddress,
+  bumpTick,
+  getTick,
+  onServe,
+  onFinish,
+}) {
+  // The drained response record, held between the backend-story hop and the
+  // answer hop so the learner watches the cache lookup first.
+  let served = null;
+
+  // Serve from the front of the target's queue until the trace's own
+  // request (isYou) comes back, or the queue runs dry this tick.
+  function drainUntilYou(targetServer) {
+    for (;;) {
+      const batch = targetServer.step(getTick());
+      const you = batch.find((item) => item.isYou);
+      if (you || batch.length === 0) return you;
+    }
+  }
+
+  function backendFor(targetAddress) {
+    return servers.find((s) => s.address === targetAddress) ?? servers[0];
+  }
+
+  function serve(trace, you) {
+    trace.response = you.response;
+    trace.status = you.status;
+    trace.body = you.body;
+    trace.routeId = you.routeId;
+    onServe(you);
+  }
+
+  // Final hop: the rendered response lands on the browser the trace
+  // originated from (the engine routes it into the right browser state).
+  function finish(trace, toAddress) {
+    onFinish({
+      from: trace.from ?? '10.2',
+      to: toAddress,
+      request: trace.request,
+      response: trace.response,
+    });
+  }
+
+  // One story hop: s is the story stage, h the current trace.hop (the hop
+  // bookkeeping itself stays in trace.js, which advances it by one).
+  function hop(s, h, trace) {
+    let frame = null;
+    if (s === 1 && h === 1) {
+      const atTick = bumpTick();
