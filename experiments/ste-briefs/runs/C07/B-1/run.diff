index 0000000..da20cb2
--- /dev/null
+++ b/js/sim/dns.js
@@ -0,0 +1,82 @@
+// DOCUMENTS: the Stage 6 component — a resolver with an in-component
+// authoritative table (example.com -> 10.1; Stage 6b adds a CDN name) and a
+// resolver cache with tick-based TTL. A lookup is a real Map lookup on the
+// request path, not a probability: a hit inside ttlTicks increments
+// cachedHits, and only a miss or an expired entry consults the authority —
+// the expired counter-example is answered from the authority, not the stale
+// ledger row. Unknown names answer { status: 'NX' } and are not cached.
+// Deterministic by construction: no clock, no RNG — time arrives as the
+// `currentTick` argument, the same way the Cache keeps time.
+//
+// CHECKS: the constructor rejects an address that is not a two-number
+// mini-IP and a ttlTicks that is not a positive integer (fail-loud over
+// silent mis-configuration). Unknown names never throw at the DNS layer —
+// the browser renders the NX card; the throw rule belongs to cross-subnet
+// addresses (router.js).
+export function createDns({
+  address = '10.60',
+  ttlTicks = 300,
+  records = { 'example.com': '10.1' },
+} = {}) {
+  if (!/^\d+\.\d+$/.test(address)) {
+    throw new Error(`dns: invalid mini-IP address ${address}`);
+  }
+  if (!Number.isInteger(ttlTicks) || ttlTicks < 1) {
+    throw new Error(`dns: ttlTicks must be a positive integer, got ${ttlTicks}`);
+  }
+  // Authoritative table: the source of truth the resolver itself consults.
+  const authoritative = new Map(Object.entries(records));
+  const cache = new Map(); // name -> { name, target, expiresAtTick }
+  let lookups = 0;
+  let cachedHits = 0;
+  let authoritativeLookups = 0;
+  let lastLookup = null;
+
+  // CHECKS: a cache hit requires a live entry — currentTick < expiresAtTick.
+  // An entry at or past its expiry never answers: the lookup falls through
+  // to the authoritative table and refreshes the ledger row.
+  function lookup(name, currentTick = 0) {
+    lookups += 1;
+    const cached = cache.get(name);
+    if (cached && currentTick < cached.expiresAtTick) {
+      cachedHits += 1;
+      lastLookup = { name, source: 'cache', atTick: currentTick };
+      return { status: 'OK', name, target: cached.target, source: 'cache' };
+    }
+    authoritativeLookups += 1;
+    const target = authoritative.get(name);
+    if (target === undefined) {
+      lastLookup = { name, source: 'NX', atTick: currentTick };
+      return { status: 'NX' };
+    }
+    cache.set(name, { name, target, expiresAtTick: currentTick + ttlTicks });
+    lastLookup = { name, source: 'authoritative', atTick: currentTick };
+    return { status: 'OK', name, target, source: 'authoritative' };
+  }
+
+  function snapshot(currentTick = 0) {
+    return {
+      address,
+      ttlTicks,
+      lookups,
+      cachedHits,
+      authoritativeLookups,
+      authoritative: Object.fromEntries(authoritative),
+      lastLookup,
+      entries: [...cache.values()].map((entry) => ({
+        name: entry.name,
+        target: entry.target,
+        expiresAtTick: entry.expiresAtTick,
+        ttlRemaining: entry.expiresAtTick - currentTick,
+      })),
+    };
+  }
+
+  return {
+    get address() {
+      return address;
+    },
+    lookup,
+    snapshot,
+  };
+}
