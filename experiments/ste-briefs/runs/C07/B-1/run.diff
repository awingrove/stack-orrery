--- /dev/null
+++ b/js/sim/hosted-path.js
@@ -0,0 +1,18 @@
+// DOCUMENTS: the hosted-URL grammar for Stage 6 — the branch condition the
+// trace narrative splits on (DL-3). A browser path carries a host when a
+// name appears before the first "/": "example.com/about" splits into host
+// "example.com" plus path "/about", and a bare "example.com" resolves with
+// the root path "/". A leading slash means host-less: the path skips DNS
+// entirely and keeps the earlier stages' story.
+//
+// CHECKS: empty input and leading-slash paths return null (host-less), so
+// the named counter-example — GET /about on Stage 6 — cannot produce a DNS
+// ask, and the go/play controls can size their hop budget from the grammar.
+export function splitHostedPath(raw) {
+  const value = String(raw ?? '');
+  if (value === '') return null;
+  const slashAt = value.indexOf('/');
+  if (slashAt === 0) return null;
+  if (slashAt === -1) return { host: value, path: '/' };
+  return { host: value.slice(0, slashAt), path: value.slice(slashAt) };
+}
