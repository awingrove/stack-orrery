+// DOCUMENTS: Stage 6 orrery furniture — the DNS and Router node cards, their
+// wire lanes, the live stage-pill-6, and the two inspector tabs. Built in js
+// rather than panel.html because that page sits at its 550-line cap (the
+// teaching-drawer split precedent); behavior stays addEventListener-only
+// (AGENTS.md CSP rule) and content comes from textContent/attributes — no
+// inline styles, no innerHTML.
+//
+// CHECKS: the cards and lanes land inside #orrery-world so viewport.js
+// positions them in world coordinates like every other node card, and the
+// pill lands in .stage-ladder so the stage-pill[data-stage] wiring picks it
+// up. Cards and lanes start hidden; renderStageTopology reveals them on
+// stage 6.
+function el(tag, className, text) {
+  const node = document.createElement(tag);
+  if (className) node.className = className;
+  if (text !== undefined) node.textContent = text;
+  return node;
+}
+
+function wireColumn(id, laneSuffix, reqText, resText) {
+  const column = el('div', 'wire-column');
+  column.id = id;
+  column.setAttribute('aria-hidden', 'true');
+  column.hidden = true;
+  const req = el('div', 'wire-lane', reqText);
+  req.id = `packet-req-${laneSuffix}`;
+  const res = el('div', 'wire-lane reverse', resText);
+  res.id = `packet-res-${laneSuffix}`;
+  column.append(req, res);
+  return column;
+}
+
+function nodeCard(id, component, role, subtitle, chip) {
+  const card = el('article', 'node-card');
+  card.id = id;
+  card.dataset.testid = id;
+  card.dataset.component = component;
+  card.hidden = true;
+  const head = el('header', 'node-head');
+  const name = el('div', 'node-name');
+  name.append(el('span', 'role-name', role), el('span', 'node-subtitle', subtitle));
+  head.append(name, el('span', 'ip-chip', chip), el('span', 'code-chip', '</> Code'));
+  card.append(head);
+  return card;
+}
+
+export function initStage6Nodes() {
+  const dnsCard = nodeCard('node-dns', 'dns', 'DNS', 'resolver · tick-TTL ledger', '10.60');
+  const dnsStats = el('p', 'mono last-frame', 'Lookups: 0 · Cached hits: 0 · TTL: 300t');
+  dnsStats.id = 'dns-stats';
+  dnsStats.dataset.testid = 'dns-stats';
+  const dnsEntries = el('ul', 'route-list');
+  dnsEntries.id = 'dns-entries-list';
+  dnsEntries.dataset.testid = 'dns-entries-list';
+  dnsEntries.setAttribute('aria-label', 'Resolver cache');
+  dnsCard.append(dnsStats, dnsEntries);
+
+  const routerCard = nodeCard(
+    'node-router',
+    'router',
+    'Router',
+    'cross-subnet 10.x ⇄ 20.x',
+    '10.65 ⇄ 20.1',
+  );
+  const routerStats = el('p', 'mono last-frame', 'Routed: 0');
+  routerStats.id = 'router-stats';
+  routerStats.dataset.testid = 'router-stats';
+  routerCard.append(routerStats);
+
+  document
+    .getElementById('node-worker')
+    .after(
+      wireColumn('wire-browser-dns', 'dns', 'DNS ask =>', '<- answer'),
+      dnsCard,
+      wireColumn('wire-network-router', 'router', 'route =>', '<- back'),
+      routerCard,
+    );
+
+  const pill = el('button', 'stage-pill', '6 · Multi-Net / CDN');
+  pill.type = 'button';
+  pill.dataset.testid = 'stage-pill-6';
+  pill.dataset.stage = '6';
+  document.querySelector('.stage-ladder').append(pill);
+
+  const tabs = document.querySelector('.comp-tabs');
+  for (const [select, label] of [
+    ['dns', 'dns'],
+    ['router', 'router'],
+  ]) {
+    const tab = el('button', 'comp-tab', label);
+    tab.type = 'button';
+    tab.dataset.select = select;
+    tabs.append(tab);
+  }
+}
