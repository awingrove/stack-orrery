+++ b/test/panel/model-stage6.test.js
@@ -0,0 +1,137 @@
+import { describe, it, expect } from 'vitest';
+import { describeSnapshot, totalHopsFor } from '../../js/panel/model.js';
+
+// Stage-boundary extraction (guard-file-size): the Stage 6 narrative-branch
+// pins — the DL-3 counter-example (host-less = Stage 5 story byte-identical,
+// no DNS hop), the hosted +2 DNS hops shape, and the NX path that ends at
+// the DNS answer without emitting a GET.
+const baseTrace = {
+  hop: 1,
+  method: 'GET',
+  path: '/about',
+  request: 'GET /about',
+  hosted: false,
+  host: null,
+  nx: false,
+  dnsTarget: null,
+  dnsSource: null,
+  targetServer: '10.11',
+  asyncJob: false,
+  cacheStatus: 'MISS',
+  dbOp: 'SELECT',
+  dbStale: false,
+  response: '200 This is the about page',
+  status: 200,
+  body: 'This is the about page',
+  routeId: 'about',
+};
+const baseSnap = (stage) => ({
+  stage,
+  tick: 2,
+  users: 5,
+  serverAddress: '10.1',
+  queueDepth: 0,
+  served: 1,
+  avgLatencyTicks: 1,
+  dns: stage === 6 ? { address: '10.60', ttlTicks: 300, lookups: 0, cachedHits: 0 } : null,
+  trace: { ...baseTrace },
+});
+
+describe('describeSnapshot stage 6 narrative branches', () => {
+  it('a host-less GET on stage 6 keeps the stage 5 hop story byte-identical — no DNS hop', () => {
+    // CHECKS: the named counter-example (DL-3). Every one of the 8 hop
+    // sentences must equal the Stage 5 sentence verbatim, denominators
+    // included, and no sentence may carry the DNS hop or the /10 shape.
+    for (let hop = 1; hop <= 8; hop++) {
+      const stage5 = describeSnapshot({ ...baseSnap(5), trace: { ...baseTrace, hop } });
+      const stage6 = describeSnapshot({
+        ...baseSnap(6),
+        trace: { ...baseTrace, hop, hosted: false },
+      });
+      expect(stage6.hopStatus).toBe(stage5.hopStatus);
+      expect(stage6.hopStatus).toContain(`Hop ${hop}/8`);
+    }
+    const sentences = [1, 2, 3, 4, 5, 6, 7, 8].map(
+      (hop) => describeSnapshot({ ...baseSnap(6), trace: { ...baseTrace, hop } }).hopStatus,
+    );
+    expect(sentences.join('\n')).not.toMatch(/DNS|10\.60|\/10/);
+    expect(describeSnapshot(baseSnap(6)).totalHops).toBe(8);
+  });
+
+  it('a hosted example.com/about path adds exactly 2 DNS hops to the stage 5 story', () => {
+    const snap = baseSnap(6);
+    snap.trace = {
+      ...baseTrace,
+      hop: 3,
+      hosted: true,
+      host: 'example.com',
+      request: 'GET /about',
+      dnsTarget: '10.1',
+      dnsSource: 'authoritative',
+    };
+    expect(describeSnapshot(snap).totalHops).toBe(10);
+    const sentence = (hop) =>
+      describeSnapshot({ ...snap, trace: { ...snap.trace, hop } }).hopStatus;
+    expect(sentence(1)).toBe('Hop 1/10: Browser (10.2) asks DNS (10.60) for "example.com"');
+    expect(sentence(2)).toBe('Hop 2/10: DNS (10.60) answers example.com -> 10.1 (authoritative)');
+    expect(sentence(3)).toBe('Hop 3/10: Browser (10.2) emits "GET /about"');
+    // Hops 4-10 renumber the Stage 5 story bodies at /10, starting at its
+    // hop 2 (the DNS answer replaced the emission as hop 1-2).
+    expect(sentence(4)).toBe('Hop 4/10: Network (10.x) routes to LoadBalancer (10.1)');
+    expect(sentence(5)).toBe('Hop 5/10: LoadBalancer (10.1) -> 10.11 queue');
+    expect(sentence(6)).toBe('Hop 6/10: Database SELECT @ Replica (10.31) — fresh');
+    expect(sentence(10)).toBe('Hop 10/10: Worker (10.41) idle — no async jobs in this trace');
+
+    // A warm ledger read names the cache hit, not the authority.
+    const warm = describeSnapshot({
+      ...snap,
+      trace: { ...snap.trace, hop: 2, dnsSource: 'cache' },
+    });
+    expect(warm.hopStatus).toBe('Hop 2/10: DNS (10.60) answers example.com -> 10.1 (cache hit)');
+  });
+
+  it('an NX lookup ends the trace at the DNS answer — no GET sentence exists', () => {
+    // CHECKS: the named counter-example — nope.example/about emits a DNS ask
+    // and the "NX no record" answer only; the trace never carries an emit or
+    // served-response sentence, and the hop total is 2.
+    const snap = baseSnap(6);
+    snap.trace = {
+      ...baseTrace,
+      hop: 2,
+      hosted: true,
+      host: 'nope.example',
+      nx: true,
+      request: 'GET nope.example/about',
+      response: null,
+      status: null,
+      body: null,
+      routeId: null,
+    };
+    const labels = describeSnapshot(snap);
+    expect(labels.totalHops).toBe(2);
+    expect(labels.hop).toBe(2);
+    expect(labels.hopStatus).toBe('Hop 2/2: DNS (10.60) answers NX no record — no GET emitted');
+    expect(describeSnapshot({ ...snap, trace: { ...snap.trace, hop: 1 } }).hopStatus).toBe(
+      'Hop 1/2: Browser (10.2) asks DNS (10.60) for "nope.example"',
+    );
+    // The full sentence set names the ask and the answer — nothing else.
+    const all = [1, 2].map(
+      (hop) => describeSnapshot({ ...snap, trace: { ...snap.trace, hop } }).hopStatus,
+    );
+    expect(all.join('\n')).not.toMatch(/emits|rendered|200/);
+  });
+
+  it('stages 1-5 keep their static hop totals whatever the trace carries', () => {
+    expect(totalHopsFor(1)).toBe(4);
+    expect(totalHopsFor(2)).toBe(5);
+    expect(totalHopsFor(3)).toBe(6);
+    expect(totalHopsFor(4)).toBe(7);
+    expect(totalHopsFor(5)).toBe(8);
+    // Stage 6 is per-lookup, and a trace-less snapshot reads host-less.
+    expect(totalHopsFor(6)).toBe(8);
+    expect(totalHopsFor(6, { hosted: true })).toBe(10);
+    expect(totalHopsFor(6, { hosted: true, nx: true })).toBe(2);
+    // Unknown stages fall back to the Stage 1 shape.
+    expect(totalHopsFor(9)).toBe(4);
+  });
+});
