diff --git a/test/sim/router.test.js b/test/sim/router.test.js
new file mode 100644
index 0000000..6ccc4c7
--- /dev/null
+++ b/test/sim/router.test.js
@@ -0,0 +1,74 @@
+import { describe, it, expect } from 'vitest';
+import { createRouter } from '../../js/sim/router.js';
+import { createNetwork } from '../../js/sim/network.js';
+import { createWebServer } from '../../js/sim/webserver.js';
+
+describe('createRouter', () => {
+  it('same-subnet sends pass through unchanged when a router is attached', () => {
+    // PINS: attaching the Router leaves the send contract byte-identical —
+    // a 10.x frame resolves the server table as always and routed stays 0.
+    const network = createNetwork();
+    network.registerServer('10.1', createWebServer({ address: '10.1' }));
+    const router = createRouter({ leftAddress: '10.65', rightAddress: '20.1' });
+    network.attachRouter(router);
+
+    expect(network.send({ from: '10.2', to: '10.1', request: 'GET /about' })).toEqual({
+      from: '10.2',
+      to: '10.1',
+      request: 'GET /about',
+      response: '200 This is the about page',
+    });
+    expect(router.snapshot()).toEqual({ leftAddress: '10.65', rightAddress: '20.1', routed: 0 });
+    // An address outside both subnets still fails loud at the network, not
+    // at the router.
+    expect(() => network.send({ from: '10.2', to: '11.1', request: 'GET /' })).toThrow(
+      /no server at 11\.1/,
+    );
+  });
+
+  it('a cross-subnet frame takes exactly one router hop to 20.1 and isYou rides through', () => {
+    const router = createRouter({ leftAddress: '10.65', rightAddress: '20.1' });
+    const exchange = router.route({ from: '10.2', to: '20.1', request: 'GET /', isYou: true });
+    expect(exchange).toEqual({
+      from: '10.2',
+      to: '20.1',
+      request: 'GET /',
+      response: '200 Router 20.1',
+      isYou: true,
+    });
+    expect(router.snapshot().routed).toBe(1);
+    // One frame, one hop: a second delivery makes it 2, nothing else does.
+    router.route({ from: '10.2', to: '20.1', request: 'GET /' });
+    expect(router.snapshot().routed).toBe(2);
+  });
+
+  it('a send into subnet 20 to an unregistered host (20.9) throws loud (DL-1)', () => {
+    // CHECKS: the named counter-example — 20.9 is on the router's remote
+    // subnet but unregistered, so the failure is a throw, not a silent drop,
+    // and the routed counter does not count undelivered frames.
+    const network = createNetwork();
+    const router = createRouter({ leftAddress: '10.65', rightAddress: '20.1' });
+    network.attachRouter(router);
+    expect(() => network.send({ from: '10.2', to: '20.9', request: 'GET /' })).toThrow(
+      /router: no host at 20\.9 in subnet 20/,
+    );
+    expect(router.snapshot().routed).toBe(0);
+    // No FIFO queue lives across the router in 6a either.
+    expect(() =>
+      network.deliverToQueue({ id: '1:1', from: '10.2', to: '20.9', request: 'GET /', atTick: 1 }),
+    ).toThrow(/no queue across the router at 20\.9/);
+  });
+
+  it('rejects non-mini-IP interfaces, one-subnet joins, and a routerless wire contract', () => {
+    expect(() => createRouter({ leftAddress: '1065' })).toThrow(/mini-IP/);
+    expect(() => createRouter({ rightAddress: '201' })).toThrow(/mini-IP/);
+    expect(() => createRouter({ leftAddress: '10.65', rightAddress: '10.66' })).toThrow(
+      /nothing to join/,
+    );
+    // CHECKS: the network only routes cross-subnet frames through a router
+    // that exposes handles()/route() — anything else fails loud.
+    const network = createNetwork();
+    expect(() => network.attachRouter({})).toThrow(/handles\(\) and route\(\)/);
+    expect(() => network.attachRouter(null)).toThrow(/handles\(\) and route\(\)/);
+  });
+});
