diff --git a/test/panel/model-stage6.test.js b/test/panel/model-stage6.test.js
new file mode 100644
index 0000000..e1a59bf
--- /dev/null
+++ b/test/panel/model-stage6.test.js
@@ -0,0 +1,96 @@
+import { describe, it, expect } from 'vitest';
+import { createEngine } from '../../js/sim/engine.js';
+import { describeSnapshot } from '../../js/panel/model.js';
+
+// Stage-6 narrative-branch pins (brief §Negative-case contracts): the trace
+// story branches on whether the browser path carries a host. Driven through
+// the real engine so the frames and counters are the components' own
+// messages, not a hardcoded story.
+const traceFrames = (engine, path, hops) => {
+  const frames = [];
+  for (let i = 0; i < hops; i++) {
+    const before = engine.snapshot().trace.hop ?? 0;
+    engine.traceHop({ method: 'GET', path });
+    const snap = engine.snapshot();
+    if (snap.trace.hop !== before) frames.push(snap.lastFrame);
+  }
+  return frames;
+};
+
+describe('stage 6 trace narratives', () => {
+  it('keeps the Stage 6 host-less GET /about trace byte-identical to the Stage 5 story', () => {
+    // PINS: the named counter-example — no DNS hop, no cross-subnet hop,
+    // same 8-hop shape, same texts; plain paths never touch the resolver.
+    const stage5 = createEngine({ stage: 5 });
+    const stage6 = createEngine({ stage: 6 });
+    const frames5 = traceFrames(stage5, '/about', 8);
+    const frames6 = traceFrames(stage6, '/about', 8);
+    expect(frames6).toEqual(frames5);
+    expect(frames6).toHaveLength(8);
+    expect(stage6.snapshot().dns).toMatchObject({ lookups: 0, cachedHits: 0 });
+
+    // The hop sentences read byte-identically too, denominator included.
+    const labels6 = describeSnapshot(stage6.snapshot());
+    expect(labels6.totalHops).toBe(8);
+    expect(labels6.hopStatus).toBe('Hop 8/8: Worker (10.41) idle — no async jobs in this trace');
+  });
+
+  it('adds exactly 2 DNS hops to the hosted example.com/about trace (10 hops total)', () => {
+    const engine = createEngine({ stage: 6 });
+    const frames = traceFrames(engine, 'example.com/about', 10);
+    expect(frames).toHaveLength(10);
+    // Hops 2-3 are the DNS round-trip; the resolver's own lookup ran.
+    expect(frames[1]).toBe('10.2 -> 10.60 | example.com?');
+    expect(frames[2]).toBe('10.60 -> 10.2 | example.com = 10.1');
+    expect(engine.snapshot().dns).toMatchObject({ lookups: 1, cachedHits: 0, authoritative: 1 });
+    // From hop 4 on, the Stage 5 chain replays: frames 4..10 equal Stage 5's
+    // frames 2..8 (the resolved "GET /about" rides the wire).
+    const stage5 = createEngine({ stage: 5 });
+    const frames5 = traceFrames(stage5, '/about', 8);
+    expect(frames.slice(3)).toEqual(frames5.slice(1));
+    expect(frames[3]).toContain('routed 10.2 -> 10.1 (GET /about) to LoadBalancer');
+
+    // Hop sentences: exactly 2 DNS hops inserted, then the Stage 5 story.
+    const labels = describeSnapshot(engine.snapshot());
+    expect(labels.totalHops).toBe(10);
+    const hopSentence = (n) =>
+      describeSnapshot({ ...engine.snapshot(), trace: { ...engine.snapshot().trace, hop: n } })
+        .hopStatus;
+    expect(hopSentence(2)).toBe('Hop 2/10: Browser (10.2) asks DNS (10.60) for example.com');
+    expect(hopSentence(3)).toBe('Hop 3/10: DNS (10.60) -> 10.2: "example.com = 10.1" (dns MISS)');
+    expect(hopSentence(6)).toBe('Hop 6/10: Database SELECT @ Replica (10.31) — fresh');
+    expect(hopSentence(10)).toBe('Hop 10/10: Worker (10.41) idle — no async jobs in this trace');
+  });
+
+  it('the NX path never emits a GET — DNS ask + NX no record answer only', () => {
+    const engine = createEngine({ stage: 6 });
+    const frames = traceFrames(engine, 'nope.example/about', 3);
+    expect(frames).toEqual([
+      '10.2 -> 10.1 | GET nope.example/about',
+      '10.2 -> 10.60 | nope.example?',
+      '10.60 -> 10.2 | NX no record',
+    ]);
+    // Nothing was served and no GET crossed the wire to the server pool.
+    const snap = engine.snapshot();
+    expect(snap.served).toBe(0);
+    expect(snap.lastExchange).toBe(null);
+    expect(snap.dns).toMatchObject({ lookups: 1, cachedHits: 0, authoritative: 0 });
+    // The browser renders the NX card instead of a page.
+    expect(snap.browserDisplay).toMatchObject({
+      response: 'NX no record',
+      status: 'NX',
+      body: 'no record',
+    });
+    // The machine stamped the run done: the next hop starts a fresh run.
+    expect(snap.trace.done).toBe(true);
+    const next = engine.traceHop({ method: 'GET', path: '/about' });
+    expect(engine.snapshot().trace.hop).toBe(1);
+    expect(next.lastFrame).toContain('GET /about');
+
+    // The hop sentence names the NX answer and that no GET was emitted.
+    const nxTrace = { ...snap.trace, hop: 3 };
+    expect(describeSnapshot({ ...snap, trace: nxTrace }).hopStatus).toBe(
+      'Hop 3/10: DNS (10.60) -> Browser (10.2): NX no record — no GET emitted',
+    );
+  });
+});
