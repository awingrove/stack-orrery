@@ -0,0 +1,91 @@
+// DOCUMENTS: the Stage 6 cross-subnet Router — one gateway object joining
+// two createNetwork() instances (the 10.x wire and the 20.x wire). A frame
+// addressed to the other subnet takes exactly one router hop: the source
+// network forwards it here, the hop counts in `routed`, and the frame is
+// delivered into the destination network with every field (isYou included)
+// riding through untouched. The router's own interfaces are the only
+// residents of 6a's otherwise empty 20.x side — Stage 6b puts the CDN edge
+// there, and this component keeps the fail-loud story in the meantime.
+//
+// CHECKS: the constructor rejects an interface that is not a two-number
+// mini-IP and both interfaces living in the same network number (a router
+// joins two subnets, not one).
+const MINI_IP = /^\d+\.\d+$/;
+const netOf = (addr) => String(addr).split('.')[0];
+
+export function createRouter({ leftAddress = '10.65', rightAddress = '20.1' } = {}) {
+  if (!MINI_IP.test(leftAddress)) {
+    throw new Error(`router: invalid mini-IP address ${leftAddress}`);
+  }
+  if (!MINI_IP.test(rightAddress)) {
+    throw new Error(`router: invalid mini-IP address ${rightAddress}`);
+  }
+  if (netOf(leftAddress) === netOf(rightAddress)) {
+    throw new Error(
+      `router: both interfaces live in network ${netOf(leftAddress)} — a router joins two subnets`,
+    );
+  }
+  let left = null;
+  let right = null;
+  let routed = 0;
+
+  function networkFor(address) {
+    const net =
+      netOf(address) === netOf(rightAddress)
+        ? right
+        : netOf(address) === netOf(leftAddress)
+          ? left
+          : null;
+    if (!net) {
+      throw new Error(`router: no route to ${address} (joins ${leftAddress} ⇄ ${rightAddress})`);
+    }
+    return net;
+  }
+
+  return {
+    get leftAddress() {
+      return leftAddress;
+    },
+    get rightAddress() {
+      return rightAddress;
+    },
+
+    attach(leftNetwork, rightNetwork) {
+      left = leftNetwork;
+      right = rightNetwork;
+    },
+
+    // The router's 20.x interface answers as the subnet boundary: in 6a no
+    // host lives behind it, so a direct frame to rightAddress earns the
+    // gateway receipt instead of a served page (Stage 6b swaps this for the
+    // CDN edge server).
+    handleRequest() {
+      return `200 gateway ${rightAddress} (no 20.x hosts yet — Stage 6b adds the CDN edge)`;
+    },
+
+    // CHECKS: the gateway interface has no request queue behind it in 6a —
+    // a queue delivery into 20.x fails loud naming the missing edge instead
+    // of crashing on a missing method.
+    enqueue() {
+      throw new Error(
+        `router: no host behind ${rightAddress} accepts queue delivery (Stage 6b adds the CDN edge)`,
+      );
+    },
+
+    // One hop per cross-subnet frame: counted before delivery so the trace
+    // shows the router hop whatever the destination network answers.
+    forward({ from, to, request }) {
+      routed += 1;
+      return networkFor(to).send({ from, to, request });
+    },
+
+    forwardToQueue(message) {
+      routed += 1;
+      return networkFor(message.to).deliverToQueue(message);
+    },
+
+    snapshot() {
+      return { leftAddress, rightAddress, routed };
+    },
+  };
+}
