diff --git a/js/sim/dns.js b/js/sim/dns.js
new file mode 100644
index 0000000..6111541
--- /dev/null
+++ b/js/sim/dns.js
@@ -0,0 +1,94 @@
+// DOCUMENTS: the Stage 6 component — a DNS resolver with a tick-TTL ledger.
+// It mirrors the Cache's tick-based TTL pattern (js/sim/cache.js): the
+// authoritative table (name -> mini-IP) warms a ledger entry on a miss, a
+// lookup inside ttlTicks is answered from the ledger (a real Map lookup on
+// the request path, not a probability), and an entry whose expiry tick has
+// arrived is consulted from the authoritative table again. Deterministic by
+// construction: no clock, no RNG — time arrives as the `currentTick`
+// argument, the same way the Cache and the WebServer keep time.
+//
+// Unknown names answer NX at the DNS layer: the resolver reports the miss,
+// the browser renders the NX card, and no GET is emitted (the fail-loud
+// throw rule belongs to cross-subnet addresses, not to names).
+//
+// CHECKS: the constructor rejects an address that is not a two-number
+// mini-IP and a ttlTicks that is not a positive integer (fail-loud over
+// silent mis-configuration).
+const MINI_IP = /^\d+\.\d+$/;
+
+export function createDns({
+  address = '10.60',
+  ttlTicks = 300,
+  records = { 'example.com': '10.1' },
+} = {}) {
+  if (!MINI_IP.test(address)) {
+    throw new Error(`dns: invalid mini-IP address ${address}`);
+  }
+  if (!Number.isInteger(ttlTicks) || ttlTicks < 1) {
+    throw new Error(`dns: ttlTicks must be a positive integer, got ${ttlTicks}`);
+  }
+  const ledger = new Map(); // name -> { name, target, expiresAtTick }
+  let lookups = 0;
+  let cachedHits = 0;
+  let authoritative = 0;
+  let lastLookup = null;
+
+  // An entry is stale the moment the current tick reaches its expiry:
+  // resolved at tick T with ttlTicks = 300 means alive through tick T + 299.
+  function evictExpired(currentTick = 0) {
+    for (const [name, entry] of ledger) {
+      if (currentTick >= entry.expiresAtTick) {
+        ledger.delete(name);
+      }
+    }
+  }
+
+  function lookup(name, currentTick = 0) {
+    lookups += 1;
+    evictExpired(currentTick);
+    const entry = ledger.get(name);
+    if (entry) {
+      cachedHits += 1;
+      lastLookup = { name, status: 'HIT', target: entry.target, atTick: currentTick };
+      return { status: 'HIT', name, target: entry.target };
+    }
+    const target = records[name] ?? null;
+    if (target) {
+      authoritative += 1;
+      ledger.set(name, { name, target, expiresAtTick: currentTick + ttlTicks });
+      lastLookup = { name, status: 'MISS', target, atTick: currentTick };
+      return { status: 'MISS', name, target };
+    }
+    lastLookup = { name, status: 'NX', atTick: currentTick };
+    return { status: 'NX', name };
+  }
+
+  function snapshot(currentTick = 0) {
+    evictExpired(currentTick);
+    return {
+      address,
+      ttlTicks,
+      lookups,
+      cachedHits,
+      authoritative,
+      lastLookup,
+      cache: [...ledger.values()].map((e) => ({
+        name: e.name,
+        target: e.target,
+        expiresAtTick: e.expiresAtTick,
+        ttlRemaining: e.expiresAtTick - currentTick,
+      })),
+    };
+  }
+
+  return {
+    get address() {
+      return address;
+    },
+    get ttlTicks() {
+      return ttlTicks;
+    },
+    lookup,
+    snapshot,
+  };
+}
