diff --git a/test/sim/dns.test.js b/test/sim/dns.test.js
new file mode 100644
index 0000000..ffe36ff
--- /dev/null
+++ b/test/sim/dns.test.js
@@ -0,0 +1,85 @@
+import { describe, it, expect } from 'vitest';
+import { createDns } from '../../js/sim/dns.js';
+import { createEngine } from '../../js/sim/engine.js';
+
+describe('createDns', () => {
+  it('answers the authoritative table on a miss and counts ledger hits inside ttlTicks', () => {
+    const dns = createDns({ address: '10.60', ttlTicks: 300 });
+
+    // Cold lookup: the authoritative table answers and warms the ledger
+    // (expiresAtTick = 5 + 300; a real Map entry, not a probability).
+    const miss = dns.lookup('example.com', 5);
+    expect(miss).toEqual({ status: 'MISS', name: 'example.com', target: '10.1' });
+    let snap = dns.snapshot(5);
+    expect(snap).toMatchObject({ lookups: 1, cachedHits: 0, authoritative: 1 });
+    expect(snap.cache).toEqual([
+      { name: 'example.com', target: '10.1', expiresAtTick: 305, ttlRemaining: 300 },
+    ]);
+
+    // PINS: a hit inside ttlTicks increments cachedHits with NO
+    // authoritative consult — the named counter-example is this second
+    // lookup: authoritative holds at 1 while cachedHits climbs.
+    const hit = dns.lookup('example.com', 304);
+    expect(hit).toEqual({ status: 'HIT', name: 'example.com', target: '10.1' });
+    snap = dns.snapshot(304);
+    expect(snap).toMatchObject({ lookups: 2, cachedHits: 1, authoritative: 1 });
+
+    // CHECKS: an expired entry is NOT answered from the ledger — at tick
+    // 305 (its expiresAtTick) the lookup consults the authoritative table
+    // again (authoritative 2) and the cachedHits count stays put.
+    const expired = dns.lookup('example.com', 305);
+    expect(expired.status).toBe('MISS');
+    snap = dns.snapshot(305);
+    expect(snap).toMatchObject({ lookups: 3, cachedHits: 1, authoritative: 2 });
+    expect(snap.cache[0]).toMatchObject({ expiresAtTick: 605, ttlRemaining: 300 });
+  });
+
+  it('unknown names answer NX without a throw and never touch the authoritative counters', () => {
+    // The NX rule lives at the DNS layer (the browser renders the card);
+    // the fail-loud throw rule belongs to cross-subnet addresses.
+    const dns = createDns();
+    expect(() => dns.lookup('nope.example', 1)).not.toThrow();
+    const answer = dns.lookup('nope.example', 1);
+    expect(answer).toEqual({ status: 'NX', name: 'nope.example' });
+    const snap = dns.snapshot(1);
+    expect(snap).toMatchObject({ lookups: 2, cachedHits: 0, authoritative: 0 });
+    expect(snap.cache).toEqual([]);
+    expect(snap.lastLookup).toEqual({ name: 'nope.example', status: 'NX', atTick: 1 });
+  });
+
+  it('rejects a non mini-IP address and a non-positive ttlTicks (fail-loud)', () => {
+    expect(() => createDns({ address: '1060' })).toThrow(/mini-IP/);
+    expect(() => createDns({ ttlTicks: 0 })).toThrow(/ttlTicks/);
+    expect(() => createDns({ ttlTicks: 1.5 })).toThrow(/ttlTicks/);
+  });
+});
+
+describe('stage 6 DNS wiring', () => {
+  it('resolves example.com through DNS 10.60 across two hosted traces (ledger hit) and validates the stage range', () => {
+    const engine = createEngine({ stage: 6 });
+    let snap = engine.snapshot();
+    expect(snap.dns).toMatchObject({
+      address: '10.60',
+      ttlTicks: 300,
+      lookups: 0,
+      cachedHits: 0,
+    });
+    expect(snap.router).toMatchObject({ leftAddress: '10.65', rightAddress: '20.1', routed: 0 });
+    // Earlier stages expose neither component.
+    expect(createEngine({ stage: 5 }).snapshot().dns).toBe(null);
+    expect(createEngine({ stage: 5 }).snapshot().router).toBe(null);
+
+    // Two hosted traces: the first consults the authoritative table (1),
+    // the second is answered from the ledger inside ttlTicks — no second
+    // consult (the trace drives the same lookup() the crowd would).
+    for (let i = 0; i < 10; i++) engine.traceHop({ method: 'GET', path: 'example.com/about' });
+    for (let i = 0; i < 10; i++) engine.traceHop({ method: 'GET', path: 'example.com/about' });
+    snap = engine.snapshot();
+    expect(snap.dns).toMatchObject({ lookups: 2, cachedHits: 1, authoritative: 1 });
+    expect(snap.dns.cache.map((e) => `${e.name} -> ${e.target}`)).toEqual(['example.com -> 10.1']);
+
+    // CHECKS: the stage range grew to 6 in the same slice as the resolver;
+    // 7 is not a shipped stage and still rejects with the updated message.
+    expect(() => createEngine({ stage: 7 })).toThrow(/stage must be 1, 2, 3, 4, 5, or 6, got 7/);
+  });
+});
