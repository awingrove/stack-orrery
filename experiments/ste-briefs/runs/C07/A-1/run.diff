diff --git a/js/panel/lane-anchors.js b/js/panel/lane-anchors.js
new file mode 100644
index 0000000..72062d1
--- /dev/null
+++ b/js/panel/lane-anchors.js
@@ -0,0 +1,52 @@
+// DOCUMENTS: wire-lane anchor geometry, split from viewport.js by
+// responsibility (guard-file-size): which world-space wire each lane chip
+// sits on, per stage. A value may pin a lane at a fraction t down its wire.
+// PINS: each lane sits on its wire in world coordinates (col-left on
+// browser↔network, col-right on network↔webserver/lb, lb-backends centered
+// between the two backend wires, servers-cache centered between the two
+// cache wires). Stage 5 anchors the cache→db lane at t=0.3 so it clears
+// the queue→worker crossing; Stage 6 adds the DNS ask/answer column on
+// browser↔dns and the router column on network↔router.
