+// DOCUMENTS: Stage 6 dynamic chrome — the DNS resolver card, the cross-subnet
+// Router card, their wire-lane columns, the two inspector tabs, and the live
+// stage-pill-6 button. Built in js rather than panel.html because that page
+// sits at its 550-line guard cap (the teaching-drawer.js precedent); the
+// cards carry the same .node-card structure as the static markup, position
+// through viewport.js like every other card, and select in the inspector
+// through the same data-component contract. Text goes in via textContent
+// only — no inline handlers, no inline styles (AGENTS.md CSP rule).
+const $ = (id) => document.getElementById(id);
+
+function el(tag, className, id, testId) {
+  const node = document.createElement(tag);
+  if (className) node.className = className;
+  if (id) node.id = id;
+  if (testId) node.dataset.testid = testId;
+  return node;
+}
+
+// One .node-card header: role name + subtitle, the mini-IP chip, and the
+// code badge, mirroring the static cards' markup.
+function nodeHead(roleName, subtitle, chipText) {
+  const head = el('header', 'node-head');
+  const name = el('div', 'node-name');
+  const role = el('span', 'role-name');
+  role.textContent = roleName;
+  const sub = el('span', 'node-subtitle');
+  sub.textContent = subtitle;
+  name.append(role, sub);
+  const chip = el('span', 'ip-chip');
+  chip.textContent = chipText;
+  const code = el('span', 'code-chip');
+  code.textContent = '</> Code';
+  head.append(name, chip, code);
+  return head;
+}
+
+function dnsCard() {
+  const card = el('article', 'node-card', 'node-dns', 'node-dns');
+  card.dataset.component = 'dns';
+  card.hidden = true;
+  card.append(nodeHead('DNS', 'resolver + tick-TTL ledger', '10.60'));
+  const stats = el('p', 'mono last-frame', 'dns-stats', 'dns-stats');
+  stats.textContent = 'Lookups: 0 · Cached hits: 0 · Authoritative: 0';
+  const list = el('ul', 'route-list', 'dns-entries-list', 'dns-entries-list');
+  list.setAttribute('aria-label', 'Resolver ledger');
+  card.append(stats, list);
+  return card;
+}
+
+function routerCard() {
+  const card = el('article', 'node-card', 'node-router', 'node-router');
+  card.dataset.component = 'router';
+  card.hidden = true;
+  card.append(nodeHead('Router', 'cross-subnet gateway', '10.65 ⇄ 20.1'));
+  const stats = el('p', 'mono last-frame', 'router-stats', 'router-stats');
+  stats.textContent = 'Routed: 0';
+  card.append(stats);
+  return card;
+}
+
+// A wire column holds the two direction labels of one wire (request =>
+// / <- response), absolutely positioned by viewport.js.
+function laneColumn(id, forwardText, reverseText, forwardId, reverseId) {
+  const col = el('div', 'wire-column', id);
+  col.setAttribute('aria-hidden', 'true');
+  col.hidden = true;
+  const forward = el('div', 'wire-lane', forwardId);
+  forward.textContent = forwardText;
+  const reverse = el('div', 'wire-lane reverse', reverseId);
+  reverse.textContent = reverseText;
+  col.append(forward, reverse);
+  return col;
+}
+
+function compTab(component) {
+  const tab = el('button', 'comp-tab');
+  tab.type = 'button';
+  tab.dataset.select = component;
+  tab.textContent = component;
+  return tab;
+}
+
+// CHECKS: the chrome builds exactly once per page load (idempotent on
+// #node-dns), and it must run before render-stage.js resolves its LANES map
+// and before panel.js binds the stage-pill listeners — both happen at module
+// load, so this is invoked at stage6-chrome import time.
+export function ensureStage6Chrome() {
+  if ($('node-dns')) return;
+  $('node-worker').after(routerCard(), dnsCard());
+  $('wire-queue-worker').after(
+    laneColumn('wire-col-dns', 'dns ask =>', '<- answer', 'packet-req-dns', 'packet-res-dns'),
+    laneColumn('wire-col-router', 'route =>', '<- back', 'packet-req-router', 'packet-res-router'),
+  );
+  const tabs = document.querySelector('.comp-tabs');
+  tabs.append(compTab('dns'), compTab('router'));
+  // CHECKS: the sixth ladder pill becomes a live button — unknown ?stage=
+  // values still fall back to 1 (the deep-link counter-example stays pinned).
+  const pill = el('button', 'stage-pill', undefined, 'stage-pill-6');
+  pill.type = 'button';
+  pill.dataset.stage = '6';
+  pill.textContent = '6 · Multi-Net / CDN';
+  document.querySelector('[data-testid="stage-pill-5"]').after(pill);
+}
