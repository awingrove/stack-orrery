diff --git a/test/sim/router.test.js b/test/sim/router.test.js
new file mode 100644
index 0000000..0152e9f
--- /dev/null
+++ b/test/sim/router.test.js
@@ -0,0 +1,94 @@
+import { describe, it, expect } from 'vitest';
+import { createRouter } from '../../js/sim/router.js';
+import { createNetwork } from '../../js/sim/network.js';
+import { createWebServer } from '../../js/sim/webserver.js';
+import { createEngine } from '../../js/sim/engine.js';
+
+// Two joined wires, as the engine wires Stage 6: the 10.x side carries the
+// web server pool, the 20.x side holds only the router's own interface.
+function joinedWires() {
+  const net10 = createNetwork({ subnet: '10' });
+  const net20 = createNetwork({ subnet: '20' });
+  const router = createRouter();
+  router.attach(net10, net20);
+  net10.attachRouter(router);
+  net20.attachRouter(router);
+  net10.registerServer('10.1', createWebServer({ address: '10.1' }));
+  net20.registerServer('20.1', router);
+  return { net10, net20, router };
+}
+
+describe('createRouter', () => {
+  it('same-subnet sends and queue deliveries pass through unchanged (routed stays 0)', () => {
+    const { net10, router } = joinedWires();
+    const frame = net10.send({ from: '10.2', to: '10.1', request: 'GET /about' });
+    expect(frame.response).toBe('200 This is the about page');
+    expect(router.snapshot()).toMatchObject({
+      leftAddress: '10.65',
+      rightAddress: '20.1',
+      routed: 0,
+    });
+
+    // Queue deliveries ride the same path with isYou intact.
+    net10.deliverToQueue({
+      id: '1:1',
+      from: '10.2',
+      to: '10.1',
+      request: 'GET /',
+      atTick: 1,
+      isYou: true,
+    });
+    expect(net10.resolve('10.1').queueSnapshot()[0]).toMatchObject({ isYou: true });
+    expect(router.snapshot().routed).toBe(0);
+  });
+
+  it('cross-subnet frames take exactly one router hop and increment routed', () => {
+    const { net10, net20, router } = joinedWires();
+
+    // 10.x -> 20.x: the frame lands on the router's 20.1 interface (the
+    // only subnet-20 resident in 6a) and earns the gateway receipt.
+    const out = net10.send({ from: '10.2', to: '20.1', request: 'GET /' });
+    expect(out).toEqual({
+      from: '10.2',
+      to: '20.1',
+      request: 'GET /',
+      response: '200 gateway 20.1 (no 20.x hosts yet — Stage 6b adds the CDN edge)',
+    });
+    expect(router.snapshot().routed).toBe(1);
+
+    // 20.x -> 10.x: the reverse hop forwards into the server pool.
+    const back = net20.send({ from: '20.1', to: '10.1', request: 'GET /about' });
+    expect(back.response).toBe('200 This is the about page');
+    expect(router.snapshot().routed).toBe(2);
+  });
+
+  it('an unregistered subnet-20 host fails loud and 20.1 stays the only reachable target', () => {
+    const { net10 } = joinedWires();
+    expect(() => net10.send({ from: '10.2', to: '20.9', request: 'GET /' })).toThrow(
+      /no server at 20\.9/,
+    );
+    expect(() =>
+      net10.deliverToQueue({ id: '1:1', from: '10.2', to: '20.9', request: 'GET /', atTick: 1 }),
+    ).toThrow(/no server at 20\.9/);
+    // A third network number has no route at all — the router names the
+    // pair it joins instead of silently mis-forwarding.
+    expect(() => net10.send({ from: '10.2', to: '30.1', request: 'GET /' })).toThrow(
+      /no route to 30\.1/,
+    );
+  });
+
+  it('rejects a non mini-IP interface and both interfaces in one network (fail-loud)', () => {
+    expect(() => createRouter({ leftAddress: '1065' })).toThrow(/mini-IP/);
+    expect(() => createRouter({ rightAddress: '201' })).toThrow(/mini-IP/);
+    expect(() => createRouter({ leftAddress: '10.65', rightAddress: '10.66' })).toThrow(
+      /joins two subnets/,
+    );
+  });
+});
+
+describe('stage 6 router wiring', () => {
+  it('exposes the Router snapshot with routed at 0 on a fresh Stage 6 engine', () => {
+    const snap = createEngine({ stage: 6 }).snapshot();
+    expect(snap.router).toEqual({ leftAddress: '10.65', rightAddress: '20.1', routed: 0 });
+  });
+});
