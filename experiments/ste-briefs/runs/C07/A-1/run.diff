diff --git a/js/panel/inspector-source-net.js b/js/panel/inspector-source-net.js
new file mode 100644
index 0000000..39880e6
--- /dev/null
+++ b/js/panel/inspector-source-net.js
@@ -0,0 +1,140 @@
+// DOCUMENTS: the bottom inspector's code side — the wire-side components
+// (browser, network, DNS resolver, cross-subnet Router). A readable,
+// hand-edited mirror of each sim component's real implementation (js/sim/*
+// is the executable truth; this module renders the same logic for
+// learners). Split from inspector-source.js by responsibility
+// (guard-file-size); the origin-tier components (loadbalancer, webserver,
+// cache, database, workerqueue) stay there, and inspector-state.js owns
+// the live-state builders and the inspector headline.
+export const NET_COMPONENT_SOURCE = {
+  browser: {
+    file: 'js/sim/browser.js',
+    code: `createBrowser({ name, address, network }) {
+  // address must be "<net>.<host>" — a two-number mini-IP
+  let lastDisplay = null;
+  return {
+    createRequest(path = '/', method = 'GET') { return \`\${method} \${path}\`; },
+    parseResponse(raw) {  // slim HTTP: no version, no headers
+      const [statusToken, ...body] = String(raw).trim().split(' ');
+      return { status: Number(statusToken), body: body.join(' ') };
+    },
+    // render an arriving wire record: parse and store viewport state
+    receiveResponse({ from, to, request, response }) {
+      lastDisplay = { from, to, request, response, ...this.parseResponse(response) };
+      return lastDisplay;
+    },
+    get(targetAddress, path = '/', method = 'GET') {
+      const request = this.createRequest(path, method);
+      const { response } = network.send({ from: address, to: targetAddress, request });
+      return this.receiveResponse({ from: address, to: targetAddress, request, response });
+    },
+    last() { return lastDisplay; },
+  };
+}`,
+  },
+  network: {
+    file: 'js/sim/network.js',
+    title: 'Network — routing fabric',
+    code: `createNetwork({ subnet = null } = {}) {
+  const servers = new Map();
+  let router = null;
+  function resolve(address) {
+    if (!/^\\d+\\.\\d+$/.test(address)) throw new Error(\`invalid mini-IP \${address}\`);
+    const server = servers.get(address);
+    if (!server) throw new Error(\`no server at \${address}\`);
+    return server;
+  }
+  return {
+    registerServer(address, server) { servers.set(address, server); },
+    attachRouter(attached) { router = attached; },
+    // same-subnet: the wire is synchronous, request in, response out;
+    // a frame to another network number takes exactly one router hop
+    send({ from, to, request }) {
+      const server = servers.get(to);
+      if (server) return { from, to, request, response: server.handleRequest(request) };
+      if (router && subnet !== null && netOf(to) !== subnet) {
+        return router.forward({ from, to, request });
+      }
+      throw new Error(\`no server at \${to}\`);
+    },
+    deliverToQueue({ id, from, to, request, atTick, isYou = false }) {
+      const server = servers.get(to);
+      if (server) return server.enqueue({ id, from, to, request, atTick, isYou });
+      if (router && subnet !== null && netOf(to) !== subnet) {
+        return router.forwardToQueue({ id, from, to, request, atTick, isYou });
+      }
+      throw new Error(\`no server at \${to}\`);
+    },
+  };
+}`,
+  },
+  dns: {
+    file: 'js/sim/dns.js',
+    code: `createDns({ address = '10.60', ttlTicks = 300, records = { 'example.com': '10.1' } } = {}) {
+  // address must be "<net>.<host>"; ttlTicks must be a positive integer
+  const ledger = new Map(); // name -> { name, target, expiresAtTick }
+  let lookups = 0, cachedHits = 0, authoritative = 0, lastLookup = null;
+  function evictExpired(currentTick = 0) {
+    for (const [name, entry] of ledger) {
+      if (currentTick >= entry.expiresAtTick) ledger.delete(name);
+    }
+  }
+  function lookup(name, currentTick = 0) {
+    lookups += 1;
+    evictExpired(currentTick);
+    const entry = ledger.get(name);
+    if (entry) {  // hit inside ttlTicks: the ledger answers, no consult
+      cachedHits += 1;
+      lastLookup = { name, status: 'HIT', target: entry.target, atTick: currentTick };
+      return { status: 'HIT', name, target: entry.target };
+    }
+    const target = records[name] ?? null;
+    if (target) {  // miss or expired entry: the authoritative table answers
+      authoritative += 1;
+      ledger.set(name, { name, target, expiresAtTick: currentTick + ttlTicks });
+      lastLookup = { name, status: 'MISS', target, atTick: currentTick };
+      return { status: 'MISS', name, target };
+    }
+    lastLookup = { name, status: 'NX', atTick: currentTick };  // unknown name
+    return { status: 'NX', name };
+  }
+  function snapshot(currentTick = 0) {
+    evictExpired(currentTick);
+    return { address, ttlTicks, lookups, cachedHits, authoritative, lastLookup,
+      cache: [...ledger.values()].map((e) => ({ ...e,
+        ttlRemaining: e.expiresAtTick - currentTick })) };
+  }
+  return { address, ttlTicks, lookup, snapshot };
+}`,
+  },
+  router: {
+    file: 'js/sim/router.js',
+    code: `createRouter({ leftAddress = '10.65', rightAddress = '20.1' } = {}) {
+  // both interfaces must be mini-IPs in different network numbers
+  let left = null, right = null, routed = 0;
+  function networkFor(address) {
+    const net = netOf(address) === netOf(rightAddress) ? right
+      : netOf(address) === netOf(leftAddress) ? left : null;
+    if (!net) throw new Error(\`no route to \${address}\`);
+    return net;
+  }
+  return {
+    attach(leftNetwork, rightNetwork) { left = leftNetwork; right = rightNetwork; },
+    // the 20.x interface answers as the subnet boundary (Stage 6b swaps
+    // this receipt for the CDN edge server)
+    handleRequest() { return \`200 gateway \${rightAddress} ...\`; },
+    // one hop per cross-subnet frame: counted, then delivered into the
+    // destination network (isYou rides through untouched)
+    forward({ from, to, request }) {
+      routed += 1;
+      return networkFor(to).send({ from, to, request });
+    },
+    forwardToQueue(message) {
+      routed += 1;
+      return networkFor(message.to).deliverToQueue(message);
+    },
+    snapshot() { return { leftAddress, rightAddress, routed }; },
+  };
+}`,
+  },
+};
