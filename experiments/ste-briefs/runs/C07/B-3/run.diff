index 0000000..3153e75
--- /dev/null
+++ b/js/sim/dns.js
@@ -0,0 +1,82 @@
+// DOCUMENTS: the Stage 6 component — a DNS resolver with a tick-TTL ledger.
+// An authoritative table (example.com -> 10.1; Stage 6b adds the CDN name)
+// answers only a cache miss or an expired entry; a hit inside ttlTicks is
+// served from the ledger without touching the authority — a real Map lookup
+// on the ask path, not a hit probability. Deterministic by construction: no
+// clock, no RNG — time arrives as the currentTick argument, the same way the
+// Cache keeps time.
+//
+// CHECKS: the constructor rejects an address that is not a two-number
+// mini-IP and a ttlTicks that is not a positive integer (fail-loud over
+// silent mis-configuration).
+const AUTHORITATIVE = new Map([['example.com', '10.1']]);
+
+export function createDns({ address = '10.60', ttlTicks = 300 } = {}) {
+  if (!/^\d+\.\d+$/.test(address)) {
+    throw new Error(`dns: invalid mini-IP address ${address}`);
+  }
+  if (!Number.isInteger(ttlTicks) || ttlTicks < 1) {
+    throw new Error(`dns: ttlTicks must be a positive integer, got ${ttlTicks}`);
+  }
+  const entries = new Map(); // name -> { name, target, expiresAtTick }
+  let lookups = 0;
+  let cachedHits = 0;
+  let authoritative = 0;
+
+  function evictExpired(currentTick = 0) {
+    for (const entry of entries.values()) {
+      if (currentTick >= entry.expiresAtTick) {
+        entries.delete(entry.name);
+      }
+    }
+  }
+
+  // CHECKS: the TTL branch — an entry inside ttlTicks is answered from the
+  // ledger (cachedHits increments, the authority is not consulted); a miss
+  // or an expired entry consults the authoritative table instead (named
+  // counter-example: the expired entry is not answered from the ledger).
+  // An unknown name answers NX — no throw at the DNS layer; the fail-loud
+  // rule lives at the cross-subnet network boundary (20.9), and the browser
+  // renders the NX card without emitting a GET.
+  function lookup(name, currentTick = 0) {
+    lookups += 1;
+    evictExpired(currentTick);
+    const hit = entries.get(name);
+    if (hit) {
+      cachedHits += 1;
+      return { status: 'OK', target: hit.target, source: 'cache' };
+    }
+    authoritative += 1;
+    const target = AUTHORITATIVE.get(name);
+    if (!target) {
+      return { status: 'NX' };
+    }
+    entries.set(name, { name, target, expiresAtTick: currentTick + ttlTicks });
+    return { status: 'OK', target, source: 'authority' };
+  }
+
+  function snapshot(currentTick = 0) {
+    evictExpired(currentTick);
+    return {
+      address,
+      ttlTicks,
+      lookups,
+      cachedHits,
+      authoritative,
+      cache: [...entries.values()].map((entry) => ({
+        name: entry.name,
+        target: entry.target,
+        expiresAtTick: entry.expiresAtTick,
+        ttlRemaining: entry.expiresAtTick - currentTick,
+      })),
+    };
+  }
+
+  return {
+    get address() {
+      return address;
+    },
+    lookup,
+    snapshot,
+  };
+}
