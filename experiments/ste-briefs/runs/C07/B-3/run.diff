@@ -0,0 +1,138 @@
+import { test, expect } from '@playwright/test';
+
+// Stage 6 assertions live in their own spec (guard-file-size splits e2e by
+// responsibility — panel.spec.js sits at its 450-line cap). The sim runs
+// from a fixed seed, so the tick sequence — and therefore these counts —
+// are identical on every run.
+
+// Stage 6 adds DNS 10.60 (Ring 7) and the cross-subnet Router side-card
+// (beside the 10.x hub) on 8 rings; a hosted path resolves through the
+// ledger (authority on the first ask, cache hit on the second) and the
+// DNS code + TTL ledger open in the inspector.
+test('should switch to Stage 6, resolve example.com through DNS 10.60, and inspect DNS code + TTL ledger', async ({
+  page,
+}) => {
+  await page.goto('/panel.html');
+
+  await page.getByTestId('stage-pill-6').click();
+  await expect(page.getByTestId('stage-pill-6')).toHaveAttribute('aria-current', 'true');
+  await expect(page.getByTestId('node-dns')).toBeVisible();
+  await expect(page.getByTestId('node-router')).toBeVisible();
+  await expect(page.locator('.orrery-ring')).toHaveCount(8);
+  await expect(page.locator('.orrery-ring').first()).toHaveAttribute('r', '400');
+  await expect(page.locator('.orrery-ring').last()).toHaveAttribute('r', '3200');
+  await expect(page.getByTestId('dns-stats')).toHaveText(
+    'Lookups: 0 · Cached: 0 · Authority: 0 · TTL: 300t',
+  );
+  await expect(page.getByTestId('router-stats')).toHaveText('Routed: 0 · 10.65 ⇄ 20.1');
+
+  // First hosted trace: the ask consults the authority and the ledger row
+  // appears; the resolved GET renders the about page.
+  await page.getByTestId('url-input').fill('example.com/about');
+  await page.getByTestId('btn-url-go').click();
+  await expect(page.getByTestId('dns-stats')).toHaveText(
+    'Lookups: 1 · Cached: 0 · Authority: 1 · TTL: 300t',
+  );
+  await expect(page.getByTestId('dns-entries-list')).toContainText('example.com -> 10.1');
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+
+  // Second hosted trace at tick 3 (inside the 300t TTL): the ledger
+  // answers — Cached increments, Authority does not.
+  await page.getByTestId('btn-url-go').click();
+  await expect(page.getByTestId('dns-stats')).toHaveText(
+    'Lookups: 2 · Cached: 1 · Authority: 1 · TTL: 300t',
+  );
+
+  // The Router stayed idle: every 6a send lives inside subnet 10.
+  await expect(page.getByTestId('router-stats')).toHaveText('Routed: 0 · 10.65 ⇄ 20.1');
+
+  await page.getByTestId('node-dns').click();
+  await expect(page.getByTestId('inspector-code')).toContainText('createDns');
+  await expect(page.getByTestId('inspector-state')).toContainText('"cachedHits": 1');
+  await expect(page.getByTestId('inspector-state')).toContainText('"authoritative": 1');
+  await page.getByTestId('node-router').click();
+  await expect(page.getByTestId('inspector-code')).toContainText('createRouter');
+  await expect(page.getByTestId('inspector-state')).toContainText('"routed": 0');
+});
+
+// The hosted trace walks ask -> answer -> the Stage 5 chain: hop 1 asks the
+// resolver by name, hop 2 hands the resolved mini-IP back with its source,
+// and hop 3 emits the GET with the resolved path.
+test('should trace example.com/about with DNS ask + answer hops', async ({ page }) => {
+  await page.goto('/panel.html?stage=6');
+
+  await page.getByTestId('url-input').fill('example.com/about');
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 1/10: Browser (10.2) asks DNS (10.60) for "example.com"',
+  );
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 2/10: DNS (10.60) answers example.com is 10.1 (authority)',
+  );
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 3/10: Browser (10.2) emits "GET /about"',
+  );
+  for (let hop = 0; hop < 7; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 10/10: Worker (10.41) idle — no async jobs in this trace',
+  );
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+
+  // CHECKS: an unknown host renders NX on the browser card and no GET is
+  // emitted: the trace is ask (3rd lookup), NX answer, and the NX card.
+  await page.getByTestId('url-input').fill('nope.example/about');
+  for (let hop = 0; hop < 3; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 3/3: Browser (10.2) rendered NX — no GET emitted',
+  );
+  await expect(page.getByTestId('browser-status-badge')).toHaveText('NX (ask nope.example)');
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('no record');
+  await expect(page.getByTestId('dns-stats')).toHaveText(
+    'Lookups: 2 · Cached: 0 · Authority: 2 · TTL: 300t',
+  );
+});
+
+// CHECKS: the named counter-example — a host-less GET /about on Stage 6
+// keeps the Stage 5 hop story byte-identical (8 hops, same sentences) and
+// the resolver never sees it.
+test('should keep GET /about on Stage 6 at the Stage 5 hop story', async ({ page }) => {
+  await page.goto('/panel.html?stage=6');
+
+  await page.getByTestId('url-input').fill('/about');
+  await page.getByTestId('btn-url-go').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 8/8: Worker (10.41) idle — no async jobs in this trace',
+  );
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+  await expect(page.getByTestId('dns-stats')).toHaveText(
+    'Lookups: 0 · Cached: 0 · Authority: 0 · TTL: 300t',
+  );
+  const labels = await page.getByTestId('journey-log').locator('.journey-entry').allTextContents();
+  const hopRows = labels.map((text) => text.match(/^(hop \d\/\d)/)?.[1]);
+  expect(hopRows.slice(0, 8)).toEqual([
+    'hop 1/8',
+    'hop 2/8',
+    'hop 3/8',
+    'hop 4/8',
+    'hop 5/8',
+    'hop 6/8',
+    'hop 7/8',
+    'hop 8/8',
+  ]);
+});
+
+// CHECKS: the deep-link live set extended to 6 — ?stage=6 opens the live
+// Stage 6 directly (cards, pill, resolver state).
+test('should deep-link ?stage=6 to the live Stage 6 pills and cards', async ({ page }) => {
+  await page.goto('/panel.html?stage=6&users=12');
+  await expect(page.getByTestId('stage-pill-6')).toHaveAttribute('aria-current', 'true');
+  await expect(page.getByTestId('node-dns')).toBeVisible();
+  await expect(page.getByTestId('node-router')).toBeVisible();
+  await expect(page.getByTestId('dns-stats')).toHaveText(
+    'Lookups: 0 · Cached: 0 · Authority: 0 · TTL: 300t',
+  );
+  await page.getByTestId('stage-pill-2').click(); // URL tracks the switch
+  await expect(page).toHaveURL(/stage=2&users=12/);
+});
