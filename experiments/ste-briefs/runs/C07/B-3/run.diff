diff --git a/test/sim/dns.test.js b/test/sim/dns.test.js
new file mode 100644
index 0000000..72ec83e
--- /dev/null
+++ b/test/sim/dns.test.js
@@ -0,0 +1,91 @@
+import { describe, it, expect } from 'vitest';
+import { createDns } from '../../js/sim/dns.js';
+import { createEngine } from '../../js/sim/engine.js';
+
+describe('createDns', () => {
+  it('serves ledger hits inside ttlTicks without consulting the authority and re-consults on miss or expiry', () => {
+    const dns = createDns({ address: '10.60', ttlTicks: 300 });
+    expect(dns.address).toBe('10.60');
+
+    // Cold ask: the authority answers and the ledger fills (expiresAtTick =
+    // 301 with ttlTicks 300 — alive through tick 300, gone at 301).
+    expect(dns.lookup('example.com', 1)).toEqual({
+      status: 'OK',
+      target: '10.1',
+      source: 'authority',
+    });
+    expect(dns.snapshot(1)).toMatchObject({ lookups: 1, cachedHits: 0, authoritative: 1 });
+
+    // CHECKS: a hit inside ttlTicks is answered from the ledger — cachedHits
+    // increments and the authority is not consulted again (named
+    // counter-example: an in-TTL ask must not re-read the table).
+    expect(dns.lookup('example.com', 150)).toEqual({
+      status: 'OK',
+      target: '10.1',
+      source: 'cache',
+    });
+    expect(dns.snapshot(150)).toMatchObject({ lookups: 2, cachedHits: 1, authoritative: 1 });
+    expect(dns.snapshot(150).cache).toEqual([
+      { name: 'example.com', target: '10.1', expiresAtTick: 301, ttlRemaining: 151 },
+    ]);
+
+    // CHECKS: the expired entry is not answered from the ledger — at tick
+    // 301 the row is gone and the authority consult count increments.
+    expect(dns.lookup('example.com', 301)).toEqual({
+      status: 'OK',
+      target: '10.1',
+      source: 'authority',
+    });
+    expect(dns.snapshot(301)).toMatchObject({ lookups: 3, cachedHits: 1, authoritative: 2 });
+
+    // CHECKS: the constructor rejects a non-mini-IP address and a
+    // non-positive or non-integer ttlTicks (fail-loud over silent misconfig).
+    expect(() => createDns({ address: '1060' })).toThrow(/invalid mini-IP/);
+    expect(() => createDns({ ttlTicks: 0 })).toThrow(/ttlTicks/);
+    expect(() => createDns({ ttlTicks: 1.5 })).toThrow(/ttlTicks/);
+  });
+
+  it('answers unknown names with NX and keeps the ask off the HTTP path', () => {
+    const dns = createDns();
+    // CHECKS: NX is a plain answer, not a throw — the browser renders the NX
+    // card and no GET is emitted (the fail-loud rule is the cross-subnet
+    // network's, not the resolver's).
+    expect(dns.lookup('nope.example', 5)).toEqual({ status: 'NX' });
+    const snap = dns.snapshot(5);
+    expect(snap).toMatchObject({ lookups: 1, authoritative: 1, cachedHits: 0 });
+    expect(snap.cache).toEqual([]); // a failed ask leaves no ledger row
+  });
+});
+
+describe('stage 6 DNS wiring', () => {
+  it('stage 6 engine exposes DNS 10.60 and the Router, and drives hosted traces through the resolver', () => {
+    const engine = createEngine({ stage: 6 });
+    let snap = engine.snapshot();
+    expect(snap.dns.address).toBe('10.60');
+    expect(snap.router).toEqual({ leftAddress: '10.65', rightAddress: '20.1', routed: 0 });
+    // Stages 1-5 expose neither component.
+    expect(createEngine({ stage: 5 }).snapshot().dns).toBe(null);
+    expect(createEngine({ stage: 5 }).snapshot().router).toBe(null);
+
+    // First hosted trace: 10 hops; the ask consults the authority once.
+    for (let hop = 0; hop < 10; hop++)
+      engine.traceHop({ method: 'GET', path: 'example.com/about' });
+    snap = engine.snapshot();
+    expect(snap.trace.hop).toBe(10);
+    expect(snap.trace.host).toBe('example.com');
+    expect(snap.browserDisplay.body).toBe('This is the about page');
+    expect(snap.dns).toMatchObject({ lookups: 1, cachedHits: 0, authoritative: 1 });
+
+    // Second hosted ask at tick 3: the ledger answers inside ttlTicks.
+    for (let hop = 0; hop < 10; hop++)
+      engine.traceHop({ method: 'GET', path: 'example.com/about' });
+    snap = engine.snapshot();
+    expect(snap.dns).toMatchObject({ lookups: 2, cachedHits: 1, authoritative: 1 });
+
+    // A host-less path leaves the resolver untouched (8 hops, as Stage 5).
+    for (let hop = 0; hop < 8; hop++) engine.traceHop({ method: 'GET', path: '/about' });
+    snap = engine.snapshot();
+    expect(snap.trace.hop).toBe(8);
+    expect(snap.dns).toMatchObject({ lookups: 2, cachedHits: 1, authoritative: 1 });
+  });
+});
