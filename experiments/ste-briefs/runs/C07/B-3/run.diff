+// DOCUMENTS: Stage 6 DOM injection — panel.html sits at its 550-line cap
+// (guard-file-size), so the two Stage 6 node cards, their inspector tabs,
+// and the live stage-pill-6 button are built here with createElement only
+// (textContent/attributes — no inline handlers, no inline styles, CSP-safe)
+// and injected before panel.js wires its listeners. Render code addresses
+// them by id exactly like the static cards.
+function nodeHead(roleName, subtitle, chipText) {
+  const head = document.createElement('header');
+  head.className = 'node-head';
+  const name = document.createElement('div');
+  name.className = 'node-name';
+  const role = document.createElement('span');
+  role.className = 'role-name';
+  role.textContent = roleName;
+  const sub = document.createElement('span');
+  sub.className = 'node-subtitle';
+  sub.textContent = subtitle;
+  name.append(role, sub);
+  const chip = document.createElement('span');
+  chip.className = 'ip-chip';
+  chip.textContent = chipText;
+  const code = document.createElement('span');
+  code.className = 'code-chip';
+  code.textContent = '</> Code';
+  head.append(name, chip, code);
+  return head;
+}
+
+export function initStage6Nodes() {
+  // stage-pill-6 replaces the static "6 · Multi-Net / CDN" placeholder span
+  // so the deep-link live set and the ladder stay one list of real pills.
+  const placeholder = [...document.querySelectorAll('.stage-ladder .stage-pill')].find((el) =>
+    el.textContent.includes('6 ·'),
+  );
+  if (placeholder) {
+    const pill = document.createElement('button');
+    pill.type = 'button';
+    pill.className = 'stage-pill';
+    pill.dataset.testid = 'stage-pill-6';
+    pill.dataset.stage = '6';
+    pill.textContent = '6 · Multi-Net / CDN';
+    placeholder.replaceWith(pill);
+  }
+
+  // CHECKS: the resolver card shows its counters and the live ledger rows
+  // (#dns-stats, #dns-entries-list) — the Map on screen, not a hit rate.
+  const dnsCard = document.createElement('article');
+  dnsCard.className = 'node-card';
+  dnsCard.id = 'node-dns';
+  dnsCard.dataset.testid = 'node-dns';
+  dnsCard.dataset.component = 'dns';
+  dnsCard.hidden = true;
+  const dnsStats = document.createElement('p');
+  dnsStats.id = 'dns-stats';
+  dnsStats.dataset.testid = 'dns-stats';
+  dnsStats.className = 'mono last-frame';
+  dnsStats.textContent = 'Lookups: 0 · Cached: 0 · Authority: 0 · TTL: 300t';
+  const dnsEntries = document.createElement('ul');
+  dnsEntries.id = 'dns-entries-list';
+  dnsEntries.dataset.testid = 'dns-entries-list';
+  dnsEntries.className = 'route-list';
+  dnsEntries.setAttribute('aria-label', 'Resolver ledger');
+  dnsCard.append(nodeHead('DNS', 'name -> mini-IP resolver', '10.60'), dnsStats, dnsEntries);
+
+  // CHECKS: the router side-card names both interfaces (10.65 ⇄ 20.1) and
+  // counts its one-hop cross-subnet forwards (#router-stats).
+  const routerCard = document.createElement('article');
+  routerCard.className = 'node-card';
+  routerCard.id = 'node-router';
+  routerCard.dataset.testid = 'node-router';
+  routerCard.dataset.component = 'router';
+  routerCard.hidden = true;
+  const routerStats = document.createElement('p');
+  routerStats.id = 'router-stats';
+  routerStats.dataset.testid = 'router-stats';
+  routerStats.className = 'mono last-frame';
+  routerStats.textContent = 'Routed: 0 · 10.65 ⇄ 20.1';
+  routerCard.append(nodeHead('Router', 'cross-subnet hop', '10.65 ⇄ 20.1'), routerStats);
+
+  const world = document.getElementById('orrery-world');
+  world.append(dnsCard, routerCard);
+
+  const tabs = document.querySelector('.comp-tabs');
+  for (const name of ['dns', 'router']) {
+    const tab = document.createElement('button');
+    tab.type = 'button';
+    tab.className = 'comp-tab';
+    tab.dataset.select = name;
+    tab.textContent = name;
+    tabs.append(tab);
+  }
+}
