diff --git a/test/sim/router.test.js b/test/sim/router.test.js
new file mode 100644
index 0000000..41d09a5
--- /dev/null
+++ b/test/sim/router.test.js
@@ -0,0 +1,74 @@
+import { describe, it, expect } from 'vitest';
+import { createRouter } from '../../js/sim/router.js';
+import { createNetwork } from '../../js/sim/network.js';
+import { createWebServer } from '../../js/sim/webserver.js';
+
+describe('createRouter', () => {
+  it('passes same-subnet sends through unchanged and takes exactly one router hop cross-subnet', () => {
+    const left = createNetwork('10');
+    const right = createNetwork('20');
+    left.registerServer('10.1', createWebServer({ address: '10.1' }));
+    const router = createRouter();
+    router.join(left, right);
+    right.registerServer(router.rightAddress, router.rightInterface);
+    left.attachRouter(router);
+
+    // Same-subnet: today's send contract, no router involvement.
+    expect(left.send({ from: '10.2', to: '10.1', request: 'GET /about' })).toEqual({
+      from: '10.2',
+      to: '10.1',
+      request: 'GET /about',
+      response: '200 This is the about page',
+    });
+    expect(router.snapshot().routed).toBe(0);
+
+    // Cross-subnet: exactly one router hop; the router's 20-side interface
+    // is the only reachable target in subnet 20 in Stage 6a.
+    expect(left.send({ from: '10.2', to: '20.1', request: 'GET /' })).toEqual({
+      from: '10.2',
+      to: '20.1',
+      request: 'GET /',
+      response: '200 Router 20.1',
+    });
+    expect(router.snapshot()).toEqual({
+      leftAddress: '10.65',
+      rightAddress: '20.1',
+      routed: 1,
+    });
+
+    // The router's interface addresses ride the snapshot for the inspector.
+    expect(router.leftAddress).toBe('10.65');
+    expect(router.rightAddress).toBe('20.1');
+  });
+
+  it('fails loud on a send into subnet 20 to an unregistered host 20.9', () => {
+    const left = createNetwork('10');
+    const right = createNetwork('20');
+    const router = createRouter();
+    router.join(left, right);
+    right.registerServer(router.rightAddress, router.rightInterface);
+    left.attachRouter(router);
+    // CHECKS: the far fabric's own registry rejects the unknown host — the
+    // failure surfaces as a throw at the send site (DL-1 fail-loud), not a
+    // silent drop; the frame did take its one router hop before that.
+    expect(() => left.send({ from: '10.2', to: '20.9', request: 'GET /' })).toThrow(
+      /no server at 20\.9/,
+    );
+    expect(router.snapshot().routed).toBe(1);
+  });
+
+  it('fails loud on misconfigured interfaces and forwards with no joined fabric', () => {
+    expect(() => createRouter({ leftAddress: '10.65.1' })).toThrow(/mini-IP/);
+    expect(() => createRouter({ rightAddress: 'bad' })).toThrow(/mini-IP/);
+    expect(() => createRouter({ leftAddress: '10.65', rightAddress: '10.9' })).toThrow(
+      /different subnets/,
+    );
+    const detached = createRouter();
+    expect(() => detached.forward({ from: '10.2', to: '20.1', request: 'GET /' })).toThrow(
+      /no joined fabric/,
+    );
+    expect(() =>
+      detached.forwardToQueue({ id: '1:0', from: '10.2', to: '20.1', request: 'GET /', atTick: 1 }),
+    ).toThrow(/no joined fabric/);
+  });
+});
