+const SYNC_GET_TRACE = {
+  hop: 8,
+  method: 'GET',
+  path: '/about',
+  request: 'GET /about',
+  from: '10.2',
+  targetServer: '10.11',
+  asyncJob: false,
+  cacheStatus: 'MISS',
+  dbOp: 'SELECT',
+  dbStale: false,
+  response: '200 This is the about page',
+  status: 200,
+  body: 'This is the about page',
