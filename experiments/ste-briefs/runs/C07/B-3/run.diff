diff --git a/js/sim/router.js b/js/sim/router.js
new file mode 100644
index 0000000..56579f0
--- /dev/null
+++ b/js/sim/router.js
@@ -0,0 +1,84 @@
+// DOCUMENTS: the Stage 6 component — a cross-subnet Router joining the 10.x
+// and 20.x network fabrics. A frame whose destination sits on the other
+// side takes exactly one router hop (the routed counter increments) and is
+// then delivered by the far fabric's own send/deliverToQueue contract;
+// same-subnet frames are the stage 1-5 concern and bypass the router.
+//
+// CHECKS: both interface addresses are validated as two-number mini-IPs on
+// different subnets (a same-subnet router is a mis-wiring, not a feature),
+// and a forward into a subnet that no joined fabric owns fails loud.
+export function createRouter({ leftAddress = '10.65', rightAddress = '20.1' } = {}) {
+  for (const [name, addr] of [
+    ['leftAddress', leftAddress],
+    ['rightAddress', rightAddress],
+  ]) {
+    if (!/^\d+\.\d+$/.test(addr)) {
+      throw new Error(`router: invalid mini-IP address ${name}=${addr}`);
+    }
+  }
+  const netOf = (addr) => String(addr).split('.')[0];
+  if (netOf(leftAddress) === netOf(rightAddress)) {
+    throw new Error(
+      `router: left and right interfaces must sit on different subnets, got ${leftAddress} and ${rightAddress}`,
+    );
+  }
+  let routed = 0;
+  let left = null;
+  let right = null;
+
+  // The 20-side interface answers a frame addressed to rightAddress so the
+  // one-hop route is demonstrable while subnet 20 is otherwise empty
+  // (Stage 6b replaces it with the CDN edge at 20.1).
+  const rightInterface = {
+    handleRequest: () => `200 Router ${rightAddress}`,
+  };
+
+  function farFabric(address) {
+    const net = netOf(address);
+    if (right && net === netOf(rightAddress)) return right;
+    if (left && net === netOf(leftAddress)) return left;
+    return null;
+  }
+
+  return {
+    get leftAddress() {
+      return leftAddress;
+    },
+    get rightAddress() {
+      return rightAddress;
+    },
+    rightInterface,
+
+    // CHECKS: join wires both fabrics in; the engine registers the 20-side
+    // interface at rightAddress in the far fabric so 20.1 stays the one
+    // reachable target and 20.9 keeps failing loud at the fabric boundary.
+    join(leftNetwork, rightNetwork) {
+      left = leftNetwork;
+      right = rightNetwork;
+    },
+
+    // CHECKS: a cross-subnet frame takes exactly one router hop — routed
+    // increments once, then the far fabric delivers by its own contract.
+    forward({ from, to, request }) {
+      const fabric = farFabric(to);
+      if (!fabric) {
+        throw new Error(`router: no joined fabric for ${to}`);
+      }
+      routed += 1;
+      return fabric.send({ from, to, request });
+    },
+
+    forwardToQueue({ id, from, to, request, atTick, isYou = false }) {
+      const fabric = farFabric(to);
+      if (!fabric) {
+        throw new Error(`router: no joined fabric for ${to}`);
+      }
+      routed += 1;
+      fabric.deliverToQueue({ id, from, to, request, atTick, isYou });
+    },
+
+    snapshot() {
+      return { leftAddress, rightAddress, routed };
+    },
+  };
+}
