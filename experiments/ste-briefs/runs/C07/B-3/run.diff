+
+const stage5Sentences = (stage, trace) =>
+  [1, 2, 3, 4, 5, 6, 7, 8].map(
+    (hop) =>
+      describeSnapshot({
+        stage,
+        tick: 2,
+        users: 5,
+        serverAddress: '10.1',
+        trace: { ...trace, hop },
+      }).hopStatus,
+  );
+
+describe('describeSnapshot — Stage 6 narrative branches', () => {
+  // CHECKS: the named counter-example — a host-less GET /about on Stage 6
+  // keeps the Stage 5 hop story byte-identical: same 8 sentences, same
+  // counts, no DNS hop anywhere in the trace.
+  it('keeps a Stage 6 host-less GET /about trace byte-identical to the Stage 5 hop story', () => {
+    const stage5 = stage5Sentences(5, SYNC_GET_TRACE);
+    const stage6 = stage5Sentences(6, { ...SYNC_GET_TRACE, host: null, totalHops: 8 });
+    expect(stage6).toEqual(stage5);
+    expect(stage6[0]).toBe('Hop 1/8: Browser (10.2) emits "GET /about"');
+    expect(stage6[7]).toBe('Hop 8/8: Worker (10.41) idle — no async jobs in this trace');
+    expect(JSON.stringify(stage6)).not.toContain('DNS');
+
+    // The published total stays 8 for the host-less shape.
+    const labels = describeSnapshot({
+      stage: 6,
+      tick: 2,
+      users: 5,
+      serverAddress: '10.1',
+      trace: { ...SYNC_GET_TRACE, host: null, totalHops: 8 },
+    });
+    expect(labels.totalHops).toBe(8);
+  });
+
+  // CHECKS: the hosted grammar adds exactly two DNS hops ahead of the
+  // unchanged Stage 5 sentences — Browser -> DNS ask, then the answer that
+  // names the resolved target, then the Stage 5 chain renumbered /10.
+  it('adds exactly two DNS hops to the hosted Stage 6 trace for example.com/about', () => {
+    const hostedTrace = {
+      ...SYNC_GET_TRACE,
+      hop: 1,
+      path: 'example.com/about',
+      host: 'example.com',
+      dnsSource: 'authority',
+      dnsTarget: '10.1',
+      totalHops: 10,
+    };
+    const labels = describeSnapshot({
+      stage: 6,
+      tick: 1,
+      users: 5,
+      serverAddress: '10.1',
+      trace: hostedTrace,
+    });
+    expect(labels.totalHops).toBe(10);
+    expect(labels.hopStatus).toBe('Hop 1/10: Browser (10.2) asks DNS (10.60) for "example.com"');
+    expect(describeSnapshot({ ...labelsBase(), trace: { ...hostedTrace, hop: 2 } }).hopStatus).toBe(
+      'Hop 2/10: DNS (10.60) answers example.com is 10.1 (authority)',
+    );
+
+    // Hops 3..10 are the Stage 5 sentences at +2 with the /10 denominator.
+    const tail = [3, 4, 5, 6, 7, 8, 9, 10].map(
+      (hop) => describeSnapshot({ ...labelsBase(), trace: { ...hostedTrace, hop } }).hopStatus,
+    );
+    const stage5 = stage5Sentences(5, SYNC_GET_TRACE);
+    expect(tail[0]).toBe('Hop 3/10: Browser (10.2) emits "GET /about"');
+    expect(tail).toEqual(
+      stage5.map((sentence) =>
+        sentence.replace(/^Hop (\d)\/8/, (m, n) => `Hop ${Number(n) + 2}/10`),
+      ),
+    );
+  });
+
+  // CHECKS: the unknown-name branch — the trace is DNS ask + NX answer +
+  // the rendered NX card, and no GET hop exists anywhere in it.
+  it('renders NX without emitting a GET for unknown hosts on Stage 6', () => {
+    const nxTrace = {
+      hop: 3,
+      method: 'GET',
+      path: 'nope.example/about',
+      request: 'ask nope.example',
+      from: '10.2',
+      host: 'nope.example',
+      nx: true,
+      totalHops: 3,
+      response: 'NX no record',
+      status: 'NX',
+      body: 'no record',
+    };
+    const snap = { stage: 6, tick: 1, users: 5, serverAddress: '10.1', trace: nxTrace };
+    expect(describeSnapshot(snap).totalHops).toBe(3);
+    const sentences = [1, 2, 3].map(
+      (hop) => describeSnapshot({ ...snap, trace: { ...nxTrace, hop } }).hopStatus,
+    );
+    expect(sentences).toEqual([
+      'Hop 1/3: Browser (10.2) asks DNS (10.60) for "nope.example"',
+      'Hop 2/3: DNS (10.60) answers NX — no record for "nope.example"',
+      'Hop 3/3: Browser (10.2) rendered NX — no GET emitted',
+    ]);
+    expect(JSON.stringify(sentences)).not.toContain('GET /about');
+
+    // The browser card renders the NX answer verbatim — status token kept
+    // as the literal 'NX', not parsed into NaN.
+    const display = { status: 'NX', request: 'ask nope.example', body: 'no record' };
+    expect(describeSnapshot({ ...snap, browserDisplay: display }).browserStatus).toBe(
+      'NX (ask nope.example)',
+    );
+  });
+
+  it('maps Stage 6 snapshots to the DNS and Router inspector state and titles', () => {
+    const snap = {
+      stage: 6,
+      tick: 2,
+      users: 5,
+      serverAddress: '10.1',
+      dns: {
+        address: '10.60',
+        ttlTicks: 300,
+        lookups: 2,
+        cachedHits: 1,
+        authoritative: 1,
+        cache: [{ name: 'example.com', target: '10.1', expiresAtTick: 302, ttlRemaining: 300 }],
+      },
+      router: { leftAddress: '10.65', rightAddress: '20.1', routed: 0 },
+      trace: { ...SYNC_GET_TRACE, host: null, totalHops: 8 },
+    };
+    expect(JSON.parse(formatComponentState(snap, 'dns'))).toEqual({
+      address: '10.60',
+      ttlTicks: 300,
+      lookups: 2,
+      cachedHits: 1,
+      authoritative: 1,
+      cache: [{ name: 'example.com', target: '10.1', expiresAtTick: 302, ttlRemaining: 300 }],
+    });
+    expect(JSON.parse(formatComponentState(snap, 'router'))).toEqual({
+      leftAddress: '10.65',
+      rightAddress: '20.1',
+      routed: 0,
+    });
+    expect(componentTitle(snap, 'dns')).toBe('DNS — mini-IP 10.60');
+    expect(componentTitle(snap, 'router')).toBe('Router — 10.65 ⇄ 20.1');
+    // The Stage 6 network interface table names the resolver and both
+    // Router sides.
+    const networkState = JSON.parse(formatComponentState(snap, 'network'));
+    expect(networkState.interfaces['10.60']).toBe('DNS');
+    expect(networkState.interfaces['10.65']).toBe('Router (10-side)');
+    expect(networkState.interfaces['20.1']).toBe('Router (20-side)');
+  });
+
+  it('lays out the eight-ring Stage 6 orrery with DNS on Ring 7 and the Router beside the hub', () => {
+    const stage6 = computeStageLayout(6, 5);
+    expect(stage6.rings.map((r) => r.radius)).toEqual([
+      400, 800, 1200, 1600, 2000, 2400, 2800, 3200,
+    ]);
+    expect(stage6.rings.map((r) => r.id)).toEqual([
+      'ring-db',
+      'ring-workers',
+      'ring-cache',
+      'ring-compute',
+      'ring-lb',
+      'ring-network',
+      'ring-dns',
+      'ring-clients',
+    ]);
+    expect(stage6.nodes['node-dns']).toMatchObject({ radius: 2800, ring: 'ring-dns' });
+    expect(stage6.nodes['node-router']).toMatchObject({ radius: 2400, ring: 'ring-network' });
+    expect(stage6.nodes['node-browser']).toMatchObject({ radius: 3200, ring: 'ring-clients' });
+    expect(stage6.wires.map((w) => w.id)).toEqual([
+      'wire-browser-network',
+      'wire-network-lb',
+      'wire-lb-webserver',
+      'wire-lb-webserver-2',
+      'wire-webserver-cache',
+      'wire-webserver-2-cache',
+      'wire-cache-db',
+      'wire-cache-queue',
+      'wire-queue-worker',
+      'wire-worker-db',
+      'wire-network-dns',
+      'wire-network-router',
+    ]);
+    expect(stage6.bounds).toEqual({ minX: -3380, maxX: 120, minY: -540, maxY: 540 });
+  });
+});
+
+function labelsBase() {
+  return {
+    stage: 6,
+    tick: 1,
+    users: 5,
+    serverAddress: '10.1',
+  };
+}
