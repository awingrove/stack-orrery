+// DOCUMENTS: the Stage 6 entries of the bottom inspector's code side — a
+// readable, hand-edited mirror of js/sim/dns.js and js/sim/router.js (the
+// sim files are the executable truth). Split from inspector-source.js by
+// responsibility (guard-file-size); that module spreads this map into
+// COMPONENT_SOURCE.
+export const COMPONENT_SOURCE_STAGE6 = {
+  dns: {
+    file: 'js/sim/dns.js',
+    code: `createDns({ address = '10.60', ttlTicks = 300 } = {}) {
+  // address must be "<net>.<host>" — a two-number mini-IP
+  const AUTHORITATIVE = new Map([['example.com', '10.1']]);
+  const entries = new Map(); // name -> { name, target, expiresAtTick }
+  let lookups = 0, cachedHits = 0, authoritative = 0;
+  function evictExpired(currentTick = 0) {
+    for (const entry of entries.values()) {
+      if (currentTick >= entry.expiresAtTick) entries.delete(entry.name);
+    }
+  }
+  function lookup(name, currentTick = 0) {
+    lookups += 1;
+    evictExpired(currentTick);
+    const hit = entries.get(name);
+    if (hit) {  // inside ttlTicks: the ledger answers, no authority consult
+      cachedHits += 1;
+      return { status: 'OK', target: hit.target, source: 'cache' };
+    }
+    authoritative += 1;  // miss or expired entry: the table answers
+    const target = AUTHORITATIVE.get(name);
+    if (!target) return { status: 'NX' };  // no throw; the browser renders NX
+    entries.set(name, { name, target, expiresAtTick: currentTick + ttlTicks });
+    return { status: 'OK', target, source: 'authority' };
+  }
+  function snapshot(currentTick = 0) {
+    evictExpired(currentTick);
+    return { address, ttlTicks, lookups, cachedHits, authoritative,
+      cache: [...entries.values()].map((e) => ({ ...e,
+        ttlRemaining: e.expiresAtTick - currentTick })) };
+  }
+  return { address, lookup, snapshot };
+}`,
+  },
+  router: {
+    file: 'js/sim/router.js',
+    code: `createRouter({ leftAddress = '10.65', rightAddress = '20.1' } = {}) {
+  // interfaces must be "<net>.<host>" on different subnets (fail-loud)
+  const netOf = (addr) => String(addr).split('.')[0];
+  let routed = 0, left = null, right = null;
+  const rightInterface = { handleRequest: () => \`200 Router \${rightAddress}\` };
+  function farFabric(address) {
+    const net = netOf(address);
+    if (right && net === netOf(rightAddress)) return right;
+    if (left && net === netOf(leftAddress)) return left;
+    return null;
+  }
+  return {
+    leftAddress, rightAddress, rightInterface,
+    join(leftNetwork, rightNetwork) { left = leftNetwork; right = rightNetwork; },
+    forward({ from, to, request }) {  // exactly one router hop
+      const fabric = farFabric(to);
+      if (!fabric) throw new Error(\`router: no joined fabric for \${to}\`);
+      routed += 1;
+      return fabric.send({ from, to, request });
+    },
+    forwardToQueue({ id, from, to, request, atTick, isYou = false }) {
+      const fabric = farFabric(to);
+      if (!fabric) throw new Error(\`router: no joined fabric for \${to}\`);
+      routed += 1;
+      fabric.deliverToQueue({ id, from, to, request, atTick, isYou });
+    },
+    snapshot() { return { leftAddress, rightAddress, routed }; },
+  };
+}`,
+  },
+};
