new file mode 100644
index 0000000..1b605fc
--- /dev/null
+++ b/js/sim/trace-stage6.js
@@ -0,0 +1,194 @@
+// DOCUMENTS: the Stage 6 trace machine — the Stage 5 hop machine plus a DNS
+// preamble. A browser path that carries a host (`example.com/about`, split
+// on the first `/`) spends two hops at the resolver — ask, then answer —
+// before the Stage 5 chain takes over with the resolved target, so the
+// hosted total is the Stage 5 count + 2. A host-less path (`/about`)
+// delegates to the Stage 5 machine unchanged, keeping the Stage 5 hop story
+// byte-identical. An unknown host answers `NX no record`: the trace is ask
+// + answer + the browser rendering the NX card, and no GET is emitted.
+//
+// CHECKS: the wrapper validates the stage it is created for (6) and
+// consults the real resolver's ledger (dns.lookup at the answer hop's tick)
+// — the narration consumes the resolver's actual answer, not a story.
+import { createTraceMachine } from './trace.js';
+
+export function createStage6Trace({
+  stage,
+  serverAddress,
+  servers,
+  lb = null,
+  network,
+  cache = null,
+  database = null,
+  workerQueue = null,
+  dns,
+  bumpTick,
+  getTick,
+  onServe,
+  onFinish,
+}) {
+  if (stage !== 6) {
+    throw new Error(`trace: stage 6 machine created for stage ${stage}`);
+  }
+  // The Stage 5 chain runs inside with its own hop numbering; the wrapper
+  // shifts the published hop count by the DNS preamble length.
+  const chain = createTraceMachine({
+    stage: 5,
+    serverAddress,
+    servers,
+    lb,
+    network,
+    cache,
+    database,
+    workerQueue,
+    bumpTick,
+    getTick,
+    onServe,
+    onFinish,
+  });
+  const CHAIN_TOTAL = 8;
+  const HOSTED_TOTAL = CHAIN_TOTAL + 2;
+  const NX_TOTAL = 3;
+
+  // mode: idle (no trace yet) | hostless | hosted | nx. phase advances the
+  // DNS preamble inside hosted ('dns' -> 'chain') and nx ('render'), and
+  // every mode settles in 'done' when its last hop runs.
+  let mode = 'idle';
+  let phase = 'idle';
+  let host = null;
+  let pathPart = null;
+  let method = 'GET';
+  let from = '10.2';
+  let source = null; // 'authority' | 'cache' — the answer the ledger gave
+  let target = null;
+
+  function splitHostPath(rawPath) {
+    const path = String(rawPath);
+    if (path.startsWith('/')) return null;
+    const slash = path.indexOf('/');
+    return slash === -1
+      ? { host: path, pathPart: '/' }
+      : { host: path.slice(0, slash), pathPart: path.slice(slash) };
+  }
+
+  function newTrace(nextMethod, rawPath, nextFrom) {
+    method = nextMethod;
+    from = nextFrom;
+    source = null;
+    target = null;
+    const split = splitHostPath(rawPath);
+    if (!split) {
+      // Host-less: the Stage 5 machine owns the whole story unchanged.
+      host = null;
+      pathPart = null;
+      mode = 'hostless';
+      phase = 'chain';
+      return chain.step({ method, path: rawPath, from });
+    }
+    host = split.host;
+    pathPart = split.pathPart;
+    mode = 'hosted';
+    phase = 'dns';
+    return `${from} -> ${dns.address} | ask ${host}`;
+  }
+
+  return {
+    step({ method: nextMethod = 'GET', path = '/about', from: nextFrom = '10.2' } = {}) {
+      let frame;
+      if (mode === 'idle' || phase === 'done') {
+        frame = newTrace(nextMethod, path, nextFrom);
+      } else if (phase === 'dns') {
+        // Hop 2/N — the answer: the ledger is consulted at this tick, so a
+        // warm entry inside ttlTicks answers from the cache and an expired
+        // one re-consults the authority.
+        const atTick = bumpTick();
+        const answer = dns.lookup(host, atTick);
+        if (answer.status === 'NX') {
+          mode = 'nx';
+          phase = 'render';
+        } else {
+          source = answer.source;
+          target = answer.target;
+          phase = 'chain';
+        }
+        frame =
+          answer.status === 'NX'
+            ? `${dns.address} -> ${from} | NX no record`
+            : `${dns.address} -> ${from} | ${host} is ${target} (${source})`;
+      } else if (phase === 'render') {
+        // CHECKS: Hop 3/3 — the browser renders the NX card and the GET that
+        // would carry pathPart is never emitted.
+        phase = 'done';
+        onFinish({ from, to: dns.address, request: `ask ${host}`, response: 'NX no record' });
+        frame = `Browser ${from} rendered NX — no GET emitted for ${host}`;
+      } else {
+        // phase 'chain': hops 3..10/10 (hosted) or 1..8/8 (host-less) ride
+        // the Stage 5 machine with the resolved path; when it completes the
+        // wrapper settles so the next trace re-reads the URL input.
+        frame = chain.step({ method, path: pathPart, from });
+        if (chain.snapshot().hop >= CHAIN_TOTAL) phase = 'done';
+      }
+      return frame;
+    },
+
+    snapshot() {
+      const chainTrace = chain.snapshot();
+      if (mode === 'nx') {
+        return {
+          hop: phase === 'render' ? 2 : 3,
+          method,
+          path: `${host}${pathPart}`,
+          from,
+          request: `ask ${host}`,
+          host,
+          nx: true,
+          dnsSource: null,
+          dnsTarget: null,
+          totalHops: NX_TOTAL,
+          response: 'NX no record',
+          status: 'NX',
+          body: 'no record',
+          done: phase === 'done',
+        };
+      }
+      if (mode === 'hosted') {
+        const outerHop = phase === 'dns' ? 1 : chainTrace.hop + 2;
+        return {
+          ...(phase === 'dns' ? null : chainTrace),
+          hop: outerHop,
+          method,
+          path: `${host}${pathPart}`,
+          from,
+          request: `GET ${pathPart}`,
+          host,
+          nx: false,
+          dnsSource: source,
+          dnsTarget: target,
+          totalHops: HOSTED_TOTAL,
+          done: phase === 'done' || outerHop >= HOSTED_TOTAL,
+        };
+      }
+      if (mode === 'hostless') {
+        return {
+          ...chainTrace,
+          host: null,
+          nx: false,
+          dnsSource: null,
+          dnsTarget: null,
+          totalHops: CHAIN_TOTAL,
+          done: chainTrace.hop >= CHAIN_TOTAL,
+        };
+      }
+      // idle: the chain machine's fresh record (hop 0) before any trace.
+      return {
+        ...chainTrace,
+        host: null,
+        nx: false,
+        dnsSource: null,
+        dnsTarget: null,
+        totalHops: CHAIN_TOTAL,
+        done: false,
+      };
+    },
+  };
+}
