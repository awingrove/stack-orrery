+    // CHECKS: stage 7 is outside the live set and fails loud.
+    expect(() => createEngine({ stage: 7 })).toThrow(/stage must be 1, 2, 3, 4, 5, or 6/);
+  });
+
+  it('stage 6 hosted trace walks DNS ask + answer + the stage-5 chain in 10 hops', () => {
+    const engine = createEngine({ stage: 6 });
+    const frames = [];
+    for (let hop = 0; hop < 10; hop++) {
+      frames.push(engine.traceHop({ path: 'example.com/about' }).lastFrame);
+    }
+    const snap = engine.snapshot();
+    expect(snap.trace.hop).toBe(10);
+    expect(snap.trace.totalHops).toBe(10);
+    expect(snap.trace.wireRequest).toBe('GET /about');
+    expect(snap.trace.targetServer).toBe('10.11');
+    expect(frames[0]).toBe('10.2 -> 10.60 | ask example.com');
+    expect(frames[1]).toBe('10.60 -> 10.2 | example.com = 10.1 (authoritative)');
+    expect(frames[2]).toBe('10.2 -> 10.1 | GET /about');
+    // Hops 4-10 replay the Stage 5 chain against the resolved target.
+    expect(frames[3]).toBe('routed 10.2 -> 10.1 (GET /about) to LoadBalancer');
+    expect(frames[4]).toBe('LB 10.1 -> 10.11 (GET /about) queued');
+    expect(frames[5]).toBe('Database SELECT /about @ 10.31 (fresh)');
+    expect(frames[6]).toBe('10.11 -> 10.2 | 200 This is the about page (cache MISS)');
+    expect(frames[7]).toBe('Network delivered 200 response to 10.2');
+    expect(frames[8]).toBe('Browser 10.2 received and displayed 200');
+    expect(frames[9]).toBe('Worker 10.41 idle — no async jobs in this trace');
+    // The response landed on the learner's browser with the full URL kept
+    // as the displayed request.
+    expect(snap.browserDisplay).toMatchObject({
+      request: 'GET example.com/about',
+      status: 200,
+      body: 'This is the about page',
+    });
+    // The second run's ask is a ledger HIT, not an authoritative consult.
+    engine.traceHop({ path: 'example.com/about' });
+    engine.traceHop({ path: 'example.com/about' });
+    expect(engine.snapshot().dns.lastLookup.status).toBe('HIT');
+  });
+
+  // PINS: the unknown-name branch — the trace is DNS ask + NX answer + the
+  // browser's NX card, and nothing reaches the LB or its queues.
+  it('stage 6 NX trace renders the NX card without emitting a GET', () => {
+    const engine = createEngine({ stage: 6 });
+    const frames = [];
+    for (let hop = 0; hop < 3; hop++) {
+      frames.push(engine.traceHop({ path: 'nope.example/about' }).lastFrame);
+    }
+    const snap = engine.snapshot();
+    expect(snap.trace.hop).toBe(3);
+    expect(snap.trace.totalHops).toBe(3);
+    expect(snap.trace.dnsStatus).toBe('NX');
+    expect(frames[0]).toBe('10.2 -> 10.60 | ask nope.example');
+    expect(frames[1]).toBe('10.60 -> 10.2 | nope.example = NX no record');
+    expect(frames[2]).toBe(
+      'Browser 10.2 rendered NX no record — no GET emitted (nope.example unresolved @ 10.60)',
+    );
+    // The browser renders the NX card; the HTTP wire stayed silent.
+    expect(snap.browserDisplay).toEqual({
+      from: '10.60',
+      to: '10.2',
+      request: 'GET nope.example/about',
+      response: 'NX no record',
+      status: 'NX',
+      body: 'no record',
+    });
+    expect(snap.loadBalancer.forwarded).toBe(0);
+    expect(snap.loadBalancer.nextBackend).toBe('10.11');
+    expect(snap.servers.every((s) => s.served === 0)).toBe(true);
+    expect(snap.workerQueue.enqueued).toBe(0);
+  });
+
+  // PINS: the named counter-example — a host-less GET /about on stage 6
+  // replays the stage-5 story byte-identically: same hop count, same frames,
+  // and no DNS hop anywhere.
+  it('stage 6 host-less trace replays the stage-5 8-hop story byte-identically', () => {
+    const stage5 = createEngine({ stage: 5 });
+    const stage6 = createEngine({ stage: 6 });
+    const run = (engine) => {
+      const frames = [];
+      for (let hop = 0; hop < 8; hop++) {
+        frames.push(engine.traceHop({ path: '/about' }).lastFrame);
+      }
+      return { frames, trace: engine.snapshot().trace };
+    };
+    const s5 = run(stage5);
+    const s6 = run(stage6);
+    expect(s6.frames).toEqual(s5.frames);
+    expect(s6.trace.totalHops).toBe(8);
+    expect(s6.trace.host).toBe(null);
+    // Not a single ask reached the resolver.
+    expect(stage6.snapshot().dns.lookups).toBe(0);
+  });
+});
