+
+function stagePill(stage, label, testId) {
+  const pill = document.createElement('button');
+  pill.type = 'button';
+  pill.className = 'stage-pill';
+  pill.dataset.stage = stage;
+  pill.dataset.testid = testId;
+  pill.textContent = label;
+  return pill;
+}
+
+function compTab(name) {
+  const tab = document.createElement('button');
+  tab.type = 'button';
+  tab.className = 'comp-tab';
+  tab.dataset.select = name;
+  tab.textContent = name;
+  return tab;
+}
+
+function nodeHead(role, subtitle, chip) {
+  const head = document.createElement('header');
+  head.className = 'node-head';
+  const name = document.createElement('div');
+  name.className = 'node-name';
+  const roleEl = document.createElement('span');
+  roleEl.className = 'role-name';
+  roleEl.textContent = role;
+  const subEl = document.createElement('span');
+  subEl.className = 'node-subtitle';
+  subEl.textContent = subtitle;
+  const ipChip = document.createElement('span');
+  ipChip.className = 'ip-chip';
+  ipChip.textContent = chip;
+  const codeChip = document.createElement('span');
+  codeChip.className = 'code-chip';
+  codeChip.textContent = '</> Code';
+  name.append(roleEl, subEl);
+  head.append(name, ipChip, codeChip);
+  return head;
+}
+
+function dnsCard() {
