+  if (document.getElementById('node-dns')) return;
+
+  document
+    .querySelector('[data-testid="stage-pill-5"]')
+    .after(stagePill('6', '6 · Multi-Net / CDN', 'stage-pill-6'));
+
+  const world = document.getElementById('orrery-world');
+  world.append(dnsCard(), routerCard());
+
+  const tabs = document.querySelector('.comp-tabs');
+  tabs.append(compTab('dns'), compTab('router'));
