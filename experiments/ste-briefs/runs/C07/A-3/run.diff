diff --git a/test/sim/router.test.js b/test/sim/router.test.js
new file mode 100644
index 0000000..adc25e4
--- /dev/null
+++ b/test/sim/router.test.js
@@ -0,0 +1,113 @@
+import { describe, it, expect } from 'vitest';
+import { createNetwork } from '../../js/sim/network.js';
+import { createRouter } from '../../js/sim/router.js';
+import { createWebServer } from '../../js/sim/webserver.js';
+
+describe('createRouter', () => {
+  // PINS: same-subnet sends keep today's contract byte-for-byte — a
+  // registered host answers, an unregistered same-subnet host throws, and
+  // with no gateway attached a cross-subnet target throws the same
+  // "no server at <addr>" error it always has.
+  it('leaves same-subnet sends and queue deliveries unchanged and fails loud without a gateway', () => {
+    const net10 = createNetwork();
+    net10.registerServer('10.1', createWebServer({ address: '10.1' }));
+    expect(net10.send({ from: '10.2', to: '10.1', request: 'GET /about' }).response).toBe(
+      '200 This is the about page',
+    );
+    expect(() => net10.send({ from: '10.2', to: '10.9', request: 'GET /' })).toThrow(
+      /no server at 10\.9/,
+    );
+    // No gateway: a cross-subnet address is just an unregistered host.
+    expect(() => net10.send({ from: '10.2', to: '20.1', request: 'GET /' })).toThrow(
+      /no server at 20\.1/,
+    );
+    net10.deliverToQueue({ id: 't:1', from: '10.2', to: '10.1', request: 'GET /', atTick: 1 });
+    expect(() =>
+      net10.deliverToQueue({ id: 't:2', from: '10.2', to: '20.5', request: 'GET /', atTick: 1 }),
+    ).toThrow(/no server at 20\.5/);
+  });
+
+  // PINS: a cross-subnet frame takes exactly one router hop — the Router
+  // rewrites the source to its interface on the destination subnet,
+  // delivers there, and counts the frame once.
+  it('forwards a cross-subnet frame through exactly one router hop and rides isYou through', () => {
+    const net10 = createNetwork();
+    const net20 = createNetwork();
+    net10.registerServer('10.1', createWebServer({ address: '10.1' }));
+    net20.registerServer('20.5', createWebServer({ address: '20.5' }));
+    const router = createRouter({
+      leftAddress: '10.65',
+      rightAddress: '20.1',
+      leftNetwork: net10,
+      rightNetwork: net20,
+    });
+    net10.attachGateway(router);
+
+    const sent = net10.send({ from: '10.2', to: '20.5', request: 'GET /' });
+    expect(sent).toEqual({
+      from: '10.2',
+      to: '20.5',
+      request: 'GET /',
+      response: '200 Welcome to the home page',
+      routedFrom: '20.1',
+    });
+    expect(router.snapshot().routed).toBe(1);
+    expect(router.snapshot().lastForward).toEqual({
+      from: '20.1', // the Router's 20-side interface carried the frame in
+      to: '20.5',
+      request: 'GET /',
+    });
+
+    // Queue deliveries take the same single hop; isYou rides through to
+    // the destination host's queue row.
+    net10.deliverToQueue({
+      id: 'you:1',
+      from: '10.2',
+      to: '20.5',
+      request: 'GET /about',
+      atTick: 1,
+      isYou: true,
+    });
+    expect(router.snapshot().routed).toBe(2);
+    const queued = net20.resolve('20.5').queueSnapshot();
+    expect(queued).toEqual([
+      { id: 'you:1', from: '20.1', to: '20.5', request: 'GET /about', atTick: 1, isYou: true },
+    ]);
+
+    // A same-subnet send leaves the router untouched.
+    net10.send({ from: '10.2', to: '10.1', request: 'GET /' });
+    expect(router.snapshot().routed).toBe(2);
+  });
+
+  // PINS: the named counter-example — an unregistered 20.x host (20.9)
+  // throws the destination network's fail-loud error, and the failed frame
+  // leaves the routed counter untouched.
+  it('fails loud on an unregistered subnet-20 host (20.9) without counting a routed frame', () => {
+    const net10 = createNetwork();
+    const net20 = createNetwork();
+    const router = createRouter({
+      leftNetwork: net10,
+      rightNetwork: net20,
+    });
+    net10.attachGateway(router);
+    expect(() => net10.send({ from: '10.2', to: '20.9', request: 'GET /' })).toThrow(
+      /no server at 20\.9/,
+    );
+    expect(() =>
+      net10.deliverToQueue({ id: 't:1', from: '10.2', to: '20.9', request: 'GET /', atTick: 1 }),
+    ).toThrow(/no server at 20\.9/);
+    expect(router.snapshot()).toMatchObject({ routed: 0, lastForward: null });
+  });
+
+  it('rejects a non mini-IP interface, a same-subnet pair, or a missing network', () => {
+    expect(() => createRouter({ leftAddress: '1065' })).toThrow(/invalid mini-IP/);
+    expect(() => createRouter({ rightAddress: '201' })).toThrow(/invalid mini-IP/);
+    expect(() => createRouter({ leftAddress: '10.65', rightAddress: '10.1' })).toThrow(
+      /distinct subnets/,
+    );
+    const router = createRouter({ leftAddress: '10.65', rightAddress: '20.1' });
+    expect(() => router.attachNetworks({ left: createNetwork(), right: null })).toThrow(
+      /two distinct networks/,
+    );
+  });
+});
