new file mode 100644
index 0000000..a251645
--- /dev/null
+++ b/js/sim/router.js
@@ -0,0 +1,76 @@
+// DOCUMENTS: the Stage 6 component — a Router joining two Network instances
+// (the 10.x fabric and the 20.x fabric). Each side owns one interface mini-IP
+// (defaults 10.65 / 20.1): a frame whose sender and target live in different
+// subnets reaches the Router through its network's gateway hook and takes
+// exactly one router hop — the Router rewrites the source to its interface
+// on the destination subnet and delivers the frame there, counting the hop
+// in `routed`. `isYou` rides through untouched so the learner's queue pill
+// survives the crossing.
+//
+// CHECKS: the constructor rejects an address that is not a two-number
+// mini-IP and an interface pair whose two numbers name the same subnet
+// (a router joins distinct subnets); a forward into a subnet with no
+// registered host at the target address throws from that subnet's network —
+// fail-loud, the same "no server at <addr>" shape network.js carries.
+const MINI_IP = /^\d+\.\d+$/;
+
+export function createRouter({
+  leftAddress = '10.65',
+  rightAddress = '20.1',
+  leftNetwork = null,
+  rightNetwork = null,
+} = {}) {
+  for (const addr of [leftAddress, rightAddress]) {
+    if (!MINI_IP.test(addr)) {
+      throw new Error(`router: invalid mini-IP address ${addr}`);
+    }
+  }
+  if (leftAddress.split('.')[0] === rightAddress.split('.')[0]) {
+    throw new Error(
+      `router: interfaces ${leftAddress} and ${rightAddress} must name distinct subnets`,
+    );
+  }
+  let left = leftNetwork;
+  let right = rightNetwork;
+  let routed = 0;
+  let lastForward = null;
+
+  // CHECKS: attachNetworks fails loud unless both networks are given and
+  // distinct — a router bridging one network to itself would loop frames.
+  function attachNetworks({ left: l, right: r }) {
+    if (!l || !r || l === r) {
+      throw new Error('router: attachNetworks requires two distinct networks');
+    }
+    left = l;
+    right = r;
+  }
+
+  // The Router's interface on the destination subnet — the frame's source
+  // as seen inside that subnet.
+  function interfaceFor(subnet) {
+    if (subnet === leftAddress.split('.')[0]) return { network: left, from: leftAddress };
+    if (subnet === rightAddress.split('.')[0]) return { network: right, from: rightAddress };
+    throw new Error(`router: no interface on subnet ${subnet}`);
+  }
+
+  function forward({ from, to, request }) {
+    const { network, from: hopFrom } = interfaceFor(String(to).split('.')[0]);
+    const record = network.send({ from: hopFrom, to, request });
+    routed += 1;
+    lastForward = { from: hopFrom, to, request };
+    return { from, to, request, response: record.response, routedFrom: hopFrom };
+  }
+
+  function forwardToQueue({ id, to, request, atTick, isYou = false }) {
+    const { network, from: hopFrom } = interfaceFor(String(to).split('.')[0]);
+    network.deliverToQueue({ id, from: hopFrom, to, request, atTick, isYou });
+    routed += 1;
+    lastForward = { from: hopFrom, to, request };
+  }
+
+  function snapshot() {
+    return { leftAddress, rightAddress, routed, lastForward };
+  }
+
+  return { attachNetworks, forward, forwardToQueue, snapshot };
+}
diff --git a/js/sim/trace-helpers.js b/js/sim/trace-helpers.js
new file mode 100644
index 0000000..77ee7e0
--- /dev/null
+++ b/js/sim/trace-helpers.js
@@ -0,0 +1,107 @@
+// DOCUMENTS: shared trace-machine helpers — the queue-drain loop, the
+// backend pick, the serve/finish record builders, the fresh trace shape,
+// and the Stage 6 host/path split. Both the classic machine (trace.js) and
+// the hosted Stage 6 runner (trace-hosted.js) build on these so the two
+// machines stay one contract on the wire.
+//
+// CHECKS: the Stage 6 split branches on host syntax — a path with a host
+// before its first `/` (example.com/about) resolves through DNS; a path
+// starting with `/` (about) is host-less and keeps the Stage 5 story.
+export function freshTrace() {
+  return {
+    hop: 0,
+    method: 'GET',
+    path: '/about',
+    from: '10.2',
+    request: 'GET /about',
+    // The request as it travels the wire: identical to `request` except on
+    // a hosted Stage 6 path, where the host is resolved away first.
+    wireRequest: 'GET /about',
+    // The wire request's path part — the cache/db narratives name it.
+    wirePath: '/about',
+    host: null,
+    hostPath: null,
+    hostless: false,
+    dnsAddress: null,
+    dnsStatus: null,
+    dnsTarget: null,
+    totalHops: null,
+    targetServer: null,
+    cacheStatus: null,
+    dbOp: null,
+    dbStale: false,
+    asyncJob: false,
+    response: null,
+    status: null,
+    body: null,
+    routeId: null,
+  };
+}
+
+export function parseStage6Path(path) {
+  const slash = path.indexOf('/');
+  const host = slash === -1 ? path : path.slice(0, slash);
+  const hostPath = slash === -1 ? '/' : path.slice(slash);
+  return { host, hostPath };
+}
+
+// Serve from the front of the target's queue until the trace's own request
+// (isYou) comes back, or the queue runs dry this tick.
+export function drainUntilYou(targetServer, getTick) {
+  for (;;) {
+    const batch = targetServer.step(getTick());
+    const you = batch.find((item) => item.isYou);
+    if (you || batch.length === 0) return you;
+  }
+}
+
+export function backendFor(servers, targetAddress) {
+  return servers.find((s) => s.address === targetAddress) ?? servers[0];
+}
+
+// Copy the drained response record into the trace state and hand it to the
+// engine (the served-exchange record + route highlight feed on it).
+export function serve(trace, you, onServe) {
+  trace.response = you.response;
+  trace.status = you.status;
+  trace.body = you.body;
+  trace.routeId = you.routeId;
+  onServe(you);
+}
+
+// Final hop: the rendered response lands on the browser the trace
+// originated from (the engine routes it into the right browser state).
+export function finish(trace, toAddress, onFinish) {
+  onFinish({
+    from: trace.from ?? '10.2',
+    to: toAddress,
+    request: trace.request,
+    response: trace.response,
+  });
+}
+
+// The cache/database narrative for a synchronously served request — the
+// Stage 4 story both Stage 5 and the Stage 6 hosted path carry at their
+// cache/db hop. An async job narrates its WorkerQueue enqueue instead.
+export function dbOpFrame(trace, backendAddress, cache, database, workerQueue) {
+  if (trace.asyncJob) {
+    return `${backendAddress} -> ${workerQueue ? workerQueue.address : '10.40'} | enqueued async job (${trace.wirePath})`;
+  }
+  if (trace.dbOp === 'WRITE') {
+    return `Database WRITE ${trace.wirePath} @ ${database.primaryAddress} (replica ${database.replicaAddress} lags ${database.replicationLagTicks}t)`;
+  }
+  if (trace.dbOp === 'SELECT') {
+    return `Database SELECT ${trace.wirePath} @ ${database.replicaAddress} (${trace.dbStale ? 'STALE' : 'fresh'})`;
+  }
+  return `Database SKIP ${trace.wirePath} (warm cache HIT @ ${cache.address})`;
+}
+
+// The worker tail narrative: an async job commits through the worker; a
+// synchronously served request finds the worker idle.
+export function workerTailFrame(trace, database, workerQueue) {
+  const dbTarget = database ? database.primaryAddress : '10.30';
+  const workerAddr = workerQueue ? workerQueue.workerAddress : '10.41';
+  return trace.asyncJob
+    ? `Worker ${workerAddr} finished job and committed to Database ${dbTarget}`
+    : `Worker ${workerAddr} idle — no async jobs in this trace`;
+}
