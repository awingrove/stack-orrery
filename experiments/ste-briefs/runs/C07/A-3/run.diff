+import { describe, it, expect } from 'vitest';
+import { createDns } from '../../js/sim/dns.js';
+import { createEngine } from '../../js/sim/engine.js';
+
+describe('createDns', () => {
+  // PINS: both TTL counter-examples from the stage6a brief — a hit inside
+  // ttlTicks increments cachedHits with no authoritative consult (the
+  // answer's status stays HIT), and an expired entry does not answer from
+  // the ledger (the same ask re-consults and reports AUTH).
+  it('resolves authoritatively on a miss, serves ledger hits inside ttlTicks, and never answers an expired entry from the ledger', () => {
+    const dns = createDns({ address: '10.60', ttlTicks: 5 });
+
+    // Cold ask: the authoritative table answers and the entry warms the
+    // ledger (expiresAtTick = 1 + 5 = 6, alive through tick 5).
+    expect(dns.lookup('example.com', 1)).toEqual({
+      status: 'AUTH',
+      name: 'example.com',
+      target: '10.1',
+    });
+    expect(dns.snapshot(1).entries).toEqual([
+      {
+        name: 'example.com',
+        target: '10.1',
+        cachedAtTick: 1,
+        expiresAtTick: 6,
+        ttlRemaining: 5,
+      },
+    ]);
+
+    // Warm ask inside ttlTicks: a ledger HIT — the counters prove the
+    // authoritative table was left untouched on this ask.
+    expect(dns.lookup('example.com', 5)).toEqual({
+      status: 'HIT',
+      name: 'example.com',
+      target: '10.1',
+    });
+    let snap = dns.snapshot(5);
+    expect(snap.lastLookup).toEqual({
+      name: 'example.com',
+      status: 'HIT',
+      target: '10.1',
+      atTick: 5,
+    });
+    expect(snap).toMatchObject({
+      lookups: 2,
+      cachedHits: 1,
+      authoritative: { 'example.com': '10.1' },
+    });
+
+    // CHECKS: the tick the TTL names is the first tick the entry is gone —
+    // the lookup evicts it and re-consults the authoritative table instead
+    // of answering the stale ledger row.
+    expect(dns.lookup('example.com', 6)).toEqual({
+      status: 'AUTH',
+      name: 'example.com',
+      target: '10.1',
+    });
+    snap = dns.snapshot(6);
+    expect(snap).toMatchObject({ lookups: 3, cachedHits: 1 });
+    expect(snap.entries).toEqual([
+      {
+        name: 'example.com',
+        target: '10.1',
+        cachedAtTick: 6,
+        expiresAtTick: 11,
+        ttlRemaining: 5,
+      },
+    ]);
+
+    // CHECKS: the constructor rejects a non-mini-IP address and a
+    // non-positive or non-integer ttlTicks (fail-loud over silent misconfig).
+    expect(() => createDns({ address: '1060' })).toThrow(/invalid mini-IP/);
+    expect(() => createDns({ ttlTicks: 0 })).toThrow(/ttlTicks/);
+    expect(() => createDns({ ttlTicks: 2.5 })).toThrow(/ttlTicks/);
+  });
+
+  // PINS: the unknown-name branch — NX is an answer, not a throw at the
+  // DNS layer; nothing is cached and the counters still count the ask.
+  it('answers an unknown name with NX no record and never throws at the DNS layer', () => {
+    const dns = createDns({ address: '10.60', ttlTicks: 300 });
+    expect(dns.lookup('nope.example', 1)).toEqual({
+      status: 'NX',
+      name: 'nope.example',
+      target: null,
+    });
+    expect(dns.lookup('nope.example', 2)).toEqual({
+      status: 'NX',
+      name: 'nope.example',
+      target: null,
+    });
+    const snap = dns.snapshot(2);
+    expect(snap).toMatchObject({ lookups: 2, cachedHits: 0 });
+    expect(snap.entries).toEqual([]);
+    expect(snap.lastLookup).toEqual({
+      name: 'nope.example',
+      status: 'NX',
+      target: null,
+      atTick: 2,
+    });
+  });
+});
+
+describe('stage 6 engine DNS wiring', () => {
+  it('exposes DNS 10.60 on the snapshot and resolves hosted traces through it', () => {
+    const engine = createEngine({ stage: 6, dnsTtlTicks: 300 });
+    let snap = engine.snapshot();
+    expect(snap.dns).not.toBe(null);
+    expect(snap.dns.address).toBe('10.60');
+    expect(snap.dns.ttlTicks).toBe(300);
+    expect(snap.dns.authoritative).toEqual({ 'example.com': '10.1' });
+    expect(snap.dns.lookups).toBe(0);
+
+    // The first 2 hops of a hosted trace are the DNS ask and its answer.
+    engine.traceHop({ path: 'example.com/about' });
+    engine.traceHop({ path: 'example.com/about' });
+    snap = engine.snapshot();
+    expect(snap.dns.lookups).toBe(1);
+    expect(snap.dns.cachedHits).toBe(0);
+    expect(snap.dns.lastLookup).toEqual({
+      name: 'example.com',
+      status: 'AUTH',
+      target: '10.1',
+      atTick: 0,
+    });
+    expect(snap.dns.entries.map((e) => e.name)).toEqual(['example.com']);
+
+    // The second trace's ask is a ledger HIT inside ttlTicks — the first
+    // run finishes (10 hops), then the next run's ask hits the ledger.
+    for (let hop = 0; hop < 8; hop++) engine.traceHop({ path: 'example.com/about' });
+    engine.traceHop({ path: 'example.com/about' });
+    engine.traceHop({ path: 'example.com/about' });
+    snap = engine.snapshot();
+    expect(snap.dns).toMatchObject({ lookups: 2, cachedHits: 1 });
+    expect(snap.dns.lastLookup.status).toBe('HIT');
+
+    // Stages 1-5 expose no resolver at all.
+    expect(createEngine({ stage: 5 }).snapshot().dns).toBe(null);
+    expect(createEngine({ stage: 1 }).snapshot().dns).toBe(null);
+  });
+});
