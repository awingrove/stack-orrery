+// DOCUMENTS: the bottom inspector's code side — hand-edited mirrors of the
+// Stage 6 components' real implementations (js/sim/dns.js and
+// js/sim/router.js are the executable truth; these render the same logic
+// for learners). Split from inspector-source-stack.js by responsibility
+// (guard-file-size).
+export const COMPONENT_SOURCE = {
+  dns: {
+    file: 'js/sim/dns.js',
+    code: `createDns({ address = '10.60', ttlTicks = 300 } = {}) {
+  // address must be "<net>.<host>"; ttlTicks a positive integer — fail-loud
+  const AUTHORITATIVE = { 'example.com': '10.1' };
+  const cache = new Map();  // name -> { name, target, expiresAtTick }
+  let lookups = 0, cachedHits = 0, lastLookup = null;
+  function lookup(name, currentTick = 0) {
+    lookups += 1;
+    for (const e of cache.values())
+      if (currentTick >= e.expiresAtTick) cache.delete(e.name);  // TTL elapsed
+    const entry = cache.get(name);
+    if (entry) {  // ledger hit inside ttlTicks: no authoritative consult
+      cachedHits += 1;
+      lastLookup = { name, status: 'HIT', target: entry.target, atTick: currentTick };
+      return { status: 'HIT', name, target: entry.target };
+    }
+    const target = AUTHORITATIVE[name] ?? null;
+    if (target !== null) {  // miss or expired entry: consult the zone, cache it
+      cache.set(name, { name, target, cachedAtTick: currentTick,
+        expiresAtTick: currentTick + ttlTicks });
+      lastLookup = { name, status: 'AUTH', target, atTick: currentTick };
+      return { status: 'AUTH', name, target };
+    }
+    lastLookup = { name, status: 'NX', target: null, atTick: currentTick };
+    return { status: 'NX', name, target: null };  // NX, not a throw
+  }
+  function snapshot(currentTick = 0) {
+    return { address, ttlTicks, lookups, cachedHits,
+      authoritative: { ...AUTHORITATIVE }, lastLookup,
+      entries: [...cache.values()].map((e) => ({ ...e,
+        ttlRemaining: e.expiresAtTick - currentTick })) };
+  }
+  return { address, lookup, snapshot };
+}`,
+  },
+  router: {
+    file: 'js/sim/router.js',
+    code: `createRouter({ leftAddress = '10.65', rightAddress = '20.1',
+  leftNetwork, rightNetwork } = {}) {
+  // both interfaces two-number mini-IPs naming distinct subnets — fail-loud
+  let routed = 0, lastForward = null;
+  function interfaceFor(subnet) {  // the Router's interface on that subnet
+    if (subnet === leftAddress.split('.')[0]) return { network: leftNetwork, from: leftAddress };
+    if (subnet === rightAddress.split('.')[0]) return { network: rightNetwork, from: rightAddress };
+    throw new Error(\`router: no interface on subnet \${subnet}\`);
+  }
+  function forward({ from, to, request }) {  // synchronous send
+    const { network, from: hopFrom } = interfaceFor(to.split('.')[0]);
+    const record = network.send({ from: hopFrom, to, request });
+    routed += 1;  // exactly one router hop per cross-subnet frame
+    lastForward = { from: hopFrom, to, request };
+    return { from, to, request, response: record.response, routedFrom: hopFrom };
+  }
+  function forwardToQueue({ id, from, to, request, atTick, isYou = false }) {
+    const { network, from: hopFrom } = interfaceFor(to.split('.')[0]);
+    network.deliverToQueue({ id, from: hopFrom, to, request, atTick, isYou });
+    routed += 1;  // isYou rides through untouched
+    lastForward = { from: hopFrom, to, request };
+  }
+  return { attachNetworks, forward, forwardToQueue,
+    snapshot: () => ({ leftAddress, rightAddress, routed, lastForward }) };
+}`,
+  },
+};
