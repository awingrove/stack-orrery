new file mode 100644
index 0000000..968aa8a
--- /dev/null
+++ b/js/sim/trace-hosted.js
@@ -0,0 +1,171 @@
+// DOCUMENTS: the Stage 6 hosted-path trace machine — a browser path that
+// carries a host (`example.com/about`, split on the first `/`). The run
+// walks 10 hops: the browser asks DNS 10.60, the resolver answers from its
+// tick-TTL ledger or its authoritative table, the browser emits the GET
+// with the resolved target, then the Stage 5 chain (LB route, round-robin
+// enqueue, cache/db hop, serve, network delivery, browser display, worker
+// tail) runs against the resolved target. A resolver NX answer ends the
+// run after 3 hops: ask, NX answer, and the browser rendering the NX card —
+// the request ends at the resolver and no GET is emitted.
+//
+// The runner owns its own run state; the classic machine in trace.js hands
+// it a parsed host and takes the frame back. Frames consume the
+// components' actual messages: the resolver's lookup result carries the
+// hop-2 story (ledger HIT vs authoritative consult vs NX), and the drained
+// queue record carries the cache/db story.
+//
+// CHECKS: the ledger-hit narrative names the cache HIT and the
+// authoritative narrative names the consult — a hit inside ttlTicks reads
+// differently from a fresh resolve, so a wrong ledger branch is visible in
+// the trace text itself.
+import {
+  freshTrace,
+  drainUntilYou,
+  backendFor,
+  serve,
+  finish,
+  dbOpFrame,
+  workerTailFrame,
+} from './trace-helpers.js';
+
+export function createHostedRunner(deps) {
+  const {
+    serverAddress,
+    servers,
+    lb,
+    dns,
+    cache,
+    database,
+    workerQueue,
+    bumpTick,
+    getTick,
+    onServe,
+    onFinish,
+    onNx,
+  } = deps;
+  let trace = freshTrace();
+  let served = null; // the drained response record, held between the drain and the serve hop
+
+  function finalHop() {
+    // A hosted run is 10 hops unless the resolver answered NX (3).
+    return trace.totalHops ?? 10;
+  }
+
+  return {
+    get traceSnapshot() {
+      return { ...trace };
+    },
+
+    // One hop for a hosted path; the caller has already parsed the host.
+    // Returns the hop's lastFrame string.
+    step({ method, path, from, host, hostPath }) {
+      const final = finalHop();
+      let frame = null;
+      if (trace.hop === 0 || trace.hop >= final) {
+        // Run start: the browser splits host from path and asks the
+        // resolver; the full URL request stays on the trace for display.
+        const request = `${method} ${path}`;
+        trace = {
+          ...freshTrace(),
+          hop: 1,
+          method,
+          path,
+          from,
+          request,
+          wireRequest: request,
+          wirePath: hostPath,
+          host,
+          hostPath,
+          hostless: false,
+          dnsAddress: dns ? dns.address : '10.60',
+          totalHops: 10,
+        };
+        served = null;
+        frame = `${from} -> ${trace.dnsAddress} | ask ${host}`;
+      } else if (trace.hop === 1) {
+        // Hop 2/10: the resolver answers — a ledger hit inside ttlTicks, an
+        // authoritative consult on a miss, or NX for an unknown name. The
+        // lookup runs here, against the engine's current tick.
+        trace.hop = 2;
+        const result = dns.lookup(trace.host, getTick());
+        trace.dnsStatus = result.status;
+        trace.dnsTarget = result.target;
+        if (result.status === 'NX') {
+          trace.totalHops = 3;
+          frame = `${trace.dnsAddress} -> ${trace.from} | ${trace.host} = NX no record`;
+        } else {
+          trace.wireRequest = `${trace.method} ${hostPath}`;
+          const how = result.status === 'HIT' ? 'cache HIT' : 'authoritative';
+          frame = `${trace.dnsAddress} -> ${trace.from} | ${trace.host} = ${result.target} (${how})`;
+        }
+      } else if (trace.hop === 2 && trace.dnsStatus === 'NX') {
+        // Hop 3/3: the browser renders the NX card — the run ends here and
+        // the HTTP wire stays silent.
+        trace.hop = 3;
+        onNx({ name: trace.host, path: trace.path, from: trace.dnsAddress });
+        frame = `Browser ${trace.from} rendered NX no record — no GET emitted (${trace.host} unresolved @ ${trace.dnsAddress})`;
+      } else if (trace.hop === 2 && trace.dnsTarget) {
+        // Hop 3/10: the browser emits the GET with the resolved target; the
+        // host has left the wire request.
+        trace.hop = 3;
+        frame = `${trace.from} -> ${trace.dnsTarget} | ${trace.wireRequest}`;
+      } else if (trace.hop === 3) {
+        // Hop 4/10: the network routes the resolved request to the LB.
+        trace.hop = 4;
+        frame = `routed ${trace.from} -> ${serverAddress} (${trace.wireRequest}) to LoadBalancer`;
+      } else if (trace.hop === 4) {
+        // Hop 5/10: the LB's round-robin pick enqueues the resolved request.
+        trace.hop = 5;
+        const atTick = bumpTick();
+        const target = lb.enqueue({
+          id: `you:${atTick}`,
+          from: trace.from,
+          to: serverAddress,
+          request: trace.wireRequest,
+          atTick,
+          isYou: true,
+        });
+        trace.targetServer = target;
+        frame = `LB ${serverAddress} -> ${target} (${trace.wireRequest}) queued`;
+      } else if (trace.hop === 5) {
+        // Hop 6/10: the target backend drains its queue and narrates the
+        // cache/db hop it actually took (an async POST narrates the enqueue).
+        trace.hop = 6;
+        const backend = backendFor(servers, trace.targetServer);
+        served = drainUntilYou(backend, getTick);
+        if (served) {
+          trace.cacheStatus = served.cacheStatus ?? null;
+          trace.dbOp = served.dbOp ?? null;
+          trace.dbStale = Boolean(served.dbStale);
+          trace.asyncJob = Boolean(served.asyncJob);
+          frame = dbOpFrame(trace, backend.address, cache, database, workerQueue);
+        }
+      } else if (trace.hop === 6) {
+        // Hop 7/10: the webserver answers — an immediate 202 for async
+        // jobs, the actually-served response for everything else.
+        trace.hop = 7;
+        if (served) {
