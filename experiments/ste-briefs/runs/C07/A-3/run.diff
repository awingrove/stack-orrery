@@ -0,0 +1,144 @@
+import { test, expect } from '@playwright/test';
+
+// Stage 6a — DNS with a tick-TTL ledger + cross-subnet Router. The sim runs
+// from a fixed seed, so every trace sequence here is identical on every
+// run. Titles are manifest pins (SIM-6 / PANEL-6): do not reword.
+
+// CHECKS: the live stage set now includes 6 — the pill activates the
+// 8-ring topology with DNS 10.60 and the Router 10.65 ⇄ 20.1 cards, a
+// hosted path resolves through the ledger, and the inspector shows the
+// resolver's code and TTL state.
+test('should switch to Stage 6, resolve example.com through DNS 10.60, and inspect DNS code + TTL ledger', async ({
+  page,
+}) => {
+  await page.goto('/panel.html');
+
+  await page.getByTestId('stage-pill-6').click();
+  await expect(page.getByTestId('node-dns')).toBeVisible();
+  await expect(page.getByTestId('node-router')).toBeVisible();
+  await expect(page.locator('.orrery-ring')).toHaveCount(8);
+  await expect(page.locator('.orrery-ring').first()).toHaveAttribute('r', '400');
+  await expect(page.locator('.orrery-ring').last()).toHaveAttribute('r', '3200');
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 0 · Cached hits: 0 · TTL: 300t');
+  await expect(page.getByTestId('router-stats')).toHaveText('Routed: 0');
+
+  // First trace: the ask misses the ledger and consults the authoritative
+  // table; the resolved entry warms it with its remaining TTL.
+  await page.getByTestId('url-input').fill('example.com/about');
+  for (let hop = 0; hop < 2; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText(
+    'Hop 2/10: DNS (10.60) -> example.com = 10.1 (authoritative)',
+  );
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 1 · Cached hits: 0 · TTL: 300t');
+  await expect(page.getByTestId('dns-entries-list')).toContainText('example.com -> 10.1');
+  for (let hop = 0; hop < 8; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText('Hop 10/10');
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+
+  // Second trace: the ask inside ttlTicks is a ledger HIT.
+  for (let hop = 0; hop < 2; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText(
+    'Hop 2/10: DNS (10.60) -> example.com = 10.1 (cache HIT)',
+  );
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 2 · Cached hits: 1 · TTL: 300t');
+
+  await page.getByTestId('node-dns').click();
+  await expect(page.getByTestId('inspector-code')).toContainText('createDns');
+  await expect(page.getByTestId('inspector-state')).toContainText('"cachedHits": 1');
+  await page.getByTestId('node-router').click();
+  await expect(page.getByTestId('inspector-code')).toContainText('createRouter');
+  await expect(page.getByTestId('inspector-state')).toContainText('"leftAddress": "10.65"');
+  await expect(page.getByTestId('inspector-state')).toContainText('"rightAddress": "20.1"');
+});
+
+// The hosted narrative: the ask and the answer are their own hops before
+// the Stage 5 chain takes over with the resolved target.
+test('should trace example.com/about with DNS ask + answer hops', async ({ page }) => {
+  await page.goto('/panel.html');
+
+  await page.getByTestId('stage-pill-6').click();
+  await page.getByTestId('url-input').fill('example.com/about');
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 1/10: Browser (10.2) asks DNS (10.60) for "example.com" ("GET example.com/about")',
+  );
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 2/10: DNS (10.60) -> example.com = 10.1 (authoritative)',
+  );
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 3/10: Browser (10.2) emits "GET /about" to 10.1',
+  );
+  for (let hop = 0; hop < 7; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 10/10: Worker (10.41) idle — no async jobs in this trace',
+  );
+  await expect(page.getByTestId('network-last-frame')).toHaveText(
+    'Worker 10.41 idle — no async jobs in this trace',
+  );
+});
+
+// Negative-case pin: a host-less path on stage 6 keeps the stage-5 hop
+// story — 8 hops, stage-5 texts, and an untouched resolver ledger.
+test('should keep GET /about on Stage 6 at the Stage 5 hop story', async ({ page }) => {
+  await page.goto('/panel.html');
+
+  await page.getByTestId('stage-pill-6').click();
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 0 · Cached hits: 0 · TTL: 300t');
+  await page.getByTestId('url-input').fill('/about');
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 1/8: Browser (10.2) emits "GET /about"',
+  );
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 2/8: Network (10.x) routes to LoadBalancer (10.1)',
+  );
+  for (let hop = 0; hop < 6; hop++) await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toContainText('Hop 8/8');
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('This is the about page');
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 0 · Cached hits: 0 · TTL: 300t');
+});
+
+// Negative-case pin: an unknown name ends the run at the NX card — the
+// trace is ask + NX answer + render, and nothing reaches the LB or queues.
+test('should render the NX card for nope.example/about without emitting a GET', async ({
+  page,
+}) => {
+  await page.goto('/panel.html');
+
+  await page.getByTestId('stage-pill-6').click();
+  await page.getByTestId('url-input').fill('nope.example/about');
+  await page.getByTestId('btn-next-hop').click();
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 2/3: DNS (10.60) -> nope.example = NX no record',
+  );
+  await page.getByTestId('btn-next-hop').click();
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 3/3: Browser (10.2) rendered NX no record — no GET emitted',
+  );
+  await expect(page.getByTestId('browser-status-badge')).toContainText('NX');
+  await expect(page.getByTestId('browser-rendered-body')).toHaveText('no record');
+  // The HTTP wire stayed silent: the LB forwarded nothing and no job queued.
+  await expect(page.getByTestId('lb-next-backend')).toHaveText('Next -> 10.11');
+  await expect(page.getByTestId('lb-backend-1')).toHaveText('10.11 WebServer-1 (0)');
+  await expect(page.getByTestId('queue-stats')).toHaveText(
+    'Enqueued: 0 · Completed: 0 · Active: none',
+  );
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 1 · Cached hits: 0 · TTL: 300t');
+});
+
+// CHECKS: the deep-link live set extends to 6 — ?stage=6 restores the DNS
+// topology on load, and stage commits rewrite the URL in place.
+test('should deep-link ?stage=6 into the 8-ring DNS topology', async ({ page }) => {
+  await page.goto('/panel.html?stage=6');
+  await expect(page.getByTestId('stage-pill-6')).toHaveAttribute('aria-current', 'true');
+  await expect(page.getByTestId('node-dns')).toBeVisible();
+  await expect(page.getByTestId('node-router')).toBeVisible();
+  await expect(page.locator('.orrery-ring')).toHaveCount(8);
+  await expect(page.getByTestId('dns-stats')).toHaveText('Lookups: 0 · Cached hits: 0 · TTL: 300t');
+  await page.getByTestId('stage-pill-2').click();
+  await expect(page).toHaveURL(/stage=2/);
+});
