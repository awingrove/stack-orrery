+  card.dataset.testid = 'node-dns';
+  card.dataset.component = 'dns';
+  card.hidden = true;
+  card.append(nodeHead('DNS', 'resolver · tick-TTL ledger', '10.60'));
+  const stats = document.createElement('p');
+  stats.id = 'dns-stats';
+  stats.dataset.testid = 'dns-stats';
+  stats.className = 'mono last-frame';
+  stats.textContent = 'Lookups: 0 · Cached hits: 0 · TTL: 300t';
+  const list = document.createElement('ul');
+  list.id = 'dns-entries-list';
+  list.dataset.testid = 'dns-entries-list';
