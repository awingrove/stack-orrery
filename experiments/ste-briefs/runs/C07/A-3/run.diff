+import { describe, it, expect } from 'vitest';
+import { computeStageLayout } from '../../js/panel/layout.js';
+
+// Stage-boundary extraction from camera.test.js (guard-file-size): the
+// Stage 6 eight-ring DNS orrery layout is pinned here.
+describe('orrery layout — Stage 6', () => {
+  it('lays out the eight-ring Stage 6 DNS orrery with the router beside the 10.x hub', () => {
+    // Stage 6: 8 layers -> 8 rings; DNS 10.60 gets Ring 7 and the Router
+    // side-card sits beside the Network hub on Ring 6.
+    const stage6 = computeStageLayout(6, 5);
+    expect(stage6.rings.map((r) => r.radius)).toEqual([
+      400, 800, 1200, 1600, 2000, 2400, 2800, 3200,
+    ]);
+    expect(stage6.rings.map((r) => r.id)).toEqual([
+      'ring-db',
+      'ring-workers',
+      'ring-cache',
+      'ring-compute',
+      'ring-lb',
+      'ring-network',
+      'ring-dns',
+      'ring-clients',
+    ]);
+    expect(stage6.nodes['node-dns']).toMatchObject({
+      x: -2800,
+      y: 0,
+      radius: 2800,
+      ring: 'ring-dns',
+    });
+    expect(stage6.nodes['node-router']).toMatchObject({
+      radius: 2400,
+      ring: 'ring-network',
+    });
+    expect(stage6.nodes['node-router'].x).not.toBe(stage6.nodes['node-network'].x);
+    expect(stage6.nodes['node-browser']).toMatchObject({ x: -3200, y: 0, ring: 'ring-clients' });
+    expect(stage6.wires.map((w) => w.id)).toEqual([
+      'wire-browser-network',
+      'wire-network-lb',
+      'wire-lb-webserver',
+      'wire-lb-webserver-2',
+      'wire-webserver-cache',
+      'wire-webserver-2-cache',
+      'wire-cache-db',
+      'wire-cache-queue',
+      'wire-queue-worker',
+      'wire-worker-db',
+      'wire-browser-dns',
+      'wire-network-router',
+    ]);
+    expect(stage6.bounds).toEqual({ minX: -3380, maxX: 120, minY: -540, maxY: 540 });
+    // A tuned ring gap rescales the eight rings as r_k = k * ringGap.
+    const tuned = computeStageLayout(6, 5, { ringGap: 300 });
+    expect(tuned.rings.map((r) => r.radius)).toEqual([300, 600, 900, 1200, 1500, 1800, 2100, 2400]);
+    expect(tuned.nodes['node-dns']).toMatchObject({ x: -2100, y: 0, radius: 2100 });
+  });
+});
