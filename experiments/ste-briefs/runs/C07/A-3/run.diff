@@ -0,0 +1,90 @@
+// DOCUMENTS: the Stage 6 component — a DNS resolver at 10.60 with a
+// tick-TTL ledger, mirroring the Cache's ledger pattern (js/sim/cache.js):
+// entries carry expiresAtTick, lookups evict anything past its TTL first,
+// and a hit inside ttlTicks is counted as a cached hit while a miss or an
+// expired entry consults the authoritative table. Deterministic by
+// construction: no clock, no RNG — time arrives as the `currentTick`
+// argument.
+//
+// CHECKS: the constructor rejects an address that is not a two-number
+// mini-IP and a ttlTicks that is not a positive integer (fail-loud over
+// silent mis-configuration), while lookup() of an unknown name answers
+// { status: 'NX' } instead of throwing — the browser renders the NX card;
+// the throw rule stays with cross-subnet addresses (network.js / router.js).
+const AUTHORITATIVE = { 'example.com': '10.1' };
+
+export function createDns({ address = '10.60', ttlTicks = 300 } = {}) {
+  if (!/^\d+\.\d+$/.test(address)) {
+    throw new Error(`dns: invalid mini-IP address ${address}`);
+  }
+  if (!Number.isInteger(ttlTicks) || ttlTicks < 1) {
+    throw new Error(`dns: ttlTicks must be a positive integer, got ${ttlTicks}`);
+  }
+  // name -> { name, target, cachedAtTick, expiresAtTick }
+  const cache = new Map();
+  let lookups = 0;
+  let cachedHits = 0;
+  let lastLookup = null;
+
+  // An entry is stale the moment the current tick reaches its expiry, the
+  // same boundary the Cache ledger uses: cached at tick T with ttlTicks N
+  // means alive through tick T + N - 1.
+  function evictExpired(currentTick = 0) {
+    for (const entry of cache.values()) {
+      if (currentTick >= entry.expiresAtTick) cache.delete(entry.name);
+    }
+  }
+
+  function lookup(name, currentTick = 0) {
+    lookups += 1;
+    const key = String(name);
+    evictExpired(currentTick);
+    const entry = cache.get(key);
+    if (entry) {
+      // Ledger hit: the authoritative table is left untouched on this ask.
+      cachedHits += 1;
+      lastLookup = { name: key, status: 'HIT', target: entry.target, atTick: currentTick };
+      return { status: 'HIT', name: key, target: entry.target };
+    }
+    const target = AUTHORITATIVE[key] ?? null;
+    if (target !== null) {
+      cache.set(key, {
+        name: key,
+        target,
+        cachedAtTick: currentTick,
+        expiresAtTick: currentTick + ttlTicks,
+      });
+      lastLookup = { name: key, status: 'AUTH', target, atTick: currentTick };
+      return { status: 'AUTH', name: key, target };
+    }
+    lastLookup = { name: key, status: 'NX', target: null, atTick: currentTick };
+    return { status: 'NX', name: key, target: null };
+  }
+
+  function snapshot(currentTick = 0) {
+    evictExpired(currentTick);
+    return {
+      address,
+      ttlTicks,
+      lookups,
+      cachedHits,
+      authoritative: { ...AUTHORITATIVE },
+      lastLookup,
+      entries: [...cache.values()].map((e) => ({
+        name: e.name,
+        target: e.target,
+        cachedAtTick: e.cachedAtTick,
+        expiresAtTick: e.expiresAtTick,
+        ttlRemaining: e.expiresAtTick - currentTick,
+      })),
+    };
+  }
+
+  return {
+    get address() {
+      return address;
+    },
+    lookup,
+    snapshot,
+  };
+}
