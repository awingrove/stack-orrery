+import { describe, it, expect } from 'vitest';
+import { describeSnapshot } from '../../js/panel/model.js';
+import { formatComponentState } from '../../js/panel/inspector-state.js';
+
+// Stage-boundary extraction (guard-file-size): the Stage 6 DNS narrative
+// branches and the dns/router inspector state are pinned here so
+// model.test.js keeps only the shared stories.
+const DNS = {
+  address: '10.60',
+  ttlTicks: 300,
+  lookups: 2,
+  cachedHits: 1,
+  authoritative: { 'example.com': '10.1' },
+  lastLookup: { name: 'example.com', status: 'HIT', target: '10.1', atTick: 2 },
+  entries: [
+    {
+      name: 'example.com',
+      target: '10.1',
+      cachedAtTick: 1,
+      expiresAtTick: 301,
+      ttlRemaining: 299,
+    },
+  ],
+};
+const ROUTER = {
+  leftAddress: '10.65',
+  rightAddress: '20.1',
+  routed: 0,
+  lastForward: null,
+};
+const WORKER_QUEUE = {
+  address: '10.40',
+  workerAddress: '10.41',
+  jobDurationTicks: 2,
+  enqueued: 0,
+  completed: 0,
+  activeJob: null,
+  pendingJobs: [],
+  lastJobResult: null,
+};
+
+describe('describeSnapshot — Stage 6 trace branches', () => {
+  it('describes Stage 6 hosted 10-hop DNS trace labels and dns/router inspector state', () => {
+    const snap = {
+      stage: 6,
+      tick: 2,
+      users: 5,
+      serverAddress: '10.1',
+      queueDepth: 0,
+      served: 1,
+      avgLatencyTicks: 1,
+      loadBalancer: {
+        address: '10.1',
+        algorithm: 'round-robin',
+        backends: ['10.11', '10.12'],
+        nextBackend: '10.12',
+        forwarded: 1,
+        lastTarget: '10.11',
+        perBackend: { 10.11: 1, 10.12: 0 },
+      },
+      cache: {
+        address: '10.20',
+        ttlTicks: 10,
+        hits: 0,
+        misses: 1,
+        sets: 1,
+        evictions: 0,
+        lastLookup: null,
+        entries: [],
+      },
+      database: {
+        primaryAddress: '10.30',
+        replicaAddress: '10.31',
+        replicationLagTicks: 3,
+        reads: 1,
+        writes: 0,
+        staleReads: 0,
+        replicated: 0,
+        lastOp: null,
+        pendingReplication: 0,
+        rows: [],
+      },
+      workerQueue: WORKER_QUEUE,
+      dns: DNS,
+      router: ROUTER,
+      servers: [
+        { address: '10.11', queueDepth: 0, served: 1, queue: [] },
+        { address: '10.12', queueDepth: 0, served: 0, queue: [] },
+      ],
+      trace: {
+        hop: 7,
+        method: 'GET',
+        path: 'example.com/about',
+        request: 'GET example.com/about',
+        wireRequest: 'GET /about',
+        wirePath: '/about',
+        host: 'example.com',
+        hostPath: '/about',
+        hostless: false,
+        dnsAddress: '10.60',
+        dnsStatus: 'AUTH',
+        dnsTarget: '10.1',
+        totalHops: 10,
+        targetServer: '10.11',
+        cacheStatus: 'MISS',
+        dbOp: 'SELECT',
+        dbStale: false,
+        asyncJob: false,
+        response: '200 This is the about page',
+        status: 200,
+        body: 'This is the about page',
+        routeId: 'route-about',
+      },
+    };
+    const labels = describeSnapshot(snap);
+    expect(labels.stage).toBe(6);
+    expect(labels.totalHops).toBe(10);
+    expect(labels.hop).toBe(7);
+    expect(labels.hopStatus).toBe(
+      'Hop 7/10: WebServer (10.11) -> "200 This is the about page" (cache MISS)',
+    );
+
+    // Every hop of the hosted shape reads as its own sentence.
+    const hopLabels = (hop, over = {}) =>
+      describeSnapshot({ ...snap, trace: { ...snap.trace, hop, ...over } }).hopStatus;
+    expect(hopLabels(1)).toBe(
+      'Hop 1/10: Browser (10.2) asks DNS (10.60) for "example.com" ("GET example.com/about")',
+    );
+    expect(hopLabels(2)).toBe('Hop 2/10: DNS (10.60) -> example.com = 10.1 (authoritative)');
+    expect(hopLabels(3)).toBe('Hop 3/10: Browser (10.2) emits "GET /about" to 10.1');
+    expect(hopLabels(4)).toBe('Hop 4/10: Network (10.x) routes to LoadBalancer (10.1)');
+    expect(hopLabels(5)).toBe('Hop 5/10: LoadBalancer (10.1) -> 10.11 queue');
+    expect(hopLabels(6)).toBe('Hop 6/10: Database SELECT @ Replica (10.31) — fresh');
+    expect(hopLabels(7)).toBe(
+      'Hop 7/10: WebServer (10.11) -> "200 This is the about page" (cache MISS)',
+    );
+    expect(hopLabels(8)).toBe('Hop 8/10: Network delivers 200 response to 10.2');
+    expect(hopLabels(9)).toBe('Hop 9/10: Browser (10.2) received and displayed 200');
+    expect(hopLabels(10)).toBe('Hop 10/10: Worker (10.41) idle — no async jobs in this trace');
+    expect(hopLabels(11)).toBe('Idle — type a path and click Go or Step 1 Hop ->');
+
+    // A warm ledger answers the ask differently: the answer names the HIT,
+    // not a fresh authoritative consult.
+    expect(
+      describeSnapshot({ ...snap, trace: { ...snap.trace, hop: 2, dnsStatus: 'HIT' } }).hopStatus,
+    ).toBe('Hop 2/10: DNS (10.60) -> example.com = 10.1 (cache HIT)');
+
+    // The dns and router inspectors carry the ledger and the hop counter;
+    // the network interface table names the resolver and both router sides.
+    const dnsState = JSON.parse(formatComponentState(snap, 'dns'));
+    expect(dnsState).toEqual(DNS);
+    const routerState = JSON.parse(formatComponentState(snap, 'router'));
+    expect(routerState).toEqual(ROUTER);
+    const networkState = JSON.parse(formatComponentState(snap, 'network'));
+    expect(networkState.interfaces['10.60']).toBe('DNS');
+    expect(networkState.interfaces['10.65']).toBe('Router (10.x side)');
+    expect(networkState.interfaces['20.1']).toBe('Router (20.x side)');
+    expect(labels.dnsStatsLabel).toBe('Lookups: 2 · Cached hits: 1 · TTL: 300t');
+    expect(labels.dnsEntries).toEqual(DNS.entries);
+    expect(labels.routerStatsLabel).toBe('Routed: 0');
+  });
+
+  it('describes a Stage 6 NX trace in 3 hops that never emits a GET', () => {
+    const snap = {
+      stage: 6,
+      tick: 1,
+      users: 5,
+      serverAddress: '10.1',
+      queueDepth: 0,
+      served: 0,
+      avgLatencyTicks: 0,
+      workerQueue: WORKER_QUEUE,
+      dns: {
+        ...DNS,
+        lookups: 1,
+        cachedHits: 0,
+        lastLookup: { name: 'nope.example', status: 'NX', target: null, atTick: 1 },
+        entries: [],
+      },
+      trace: {
+        hop: 3,
+        method: 'GET',
+        path: 'nope.example/about',
+        request: 'GET nope.example/about',
+        wireRequest: 'GET nope.example/about',
+        wirePath: '/about',
+        host: 'nope.example',
+        hostPath: '/about',
+        hostless: false,
+        dnsAddress: '10.60',
+        dnsStatus: 'NX',
+        dnsTarget: null,
+        totalHops: 3,
+        targetServer: null,
+        cacheStatus: null,
+        dbOp: null,
+        dbStale: false,
+        asyncJob: false,
+        response: null,
+        status: null,
+        body: null,
+        routeId: null,
+      },
+    };
+    expect(describeSnapshot(snap).hop).toBe(3);
+    expect(describeSnapshot(snap).hopStatus).toBe(
+      'Hop 3/3: Browser (10.2) rendered NX no record — no GET emitted',
+    );
+    expect(describeSnapshot({ ...snap, trace: { ...snap.trace, hop: 1 } }).hopStatus).toBe(
+      'Hop 1/3: Browser (10.2) asks DNS (10.60) for "nope.example" ("GET nope.example/about")',
+    );
+    expect(describeSnapshot({ ...snap, trace: { ...snap.trace, hop: 2 } }).hopStatus).toBe(
+      'Hop 2/3: DNS (10.60) -> nope.example = NX no record',
+    );
+  });
+
+  // PINS: the named counter-example — a host-less GET /about on stage 6
+  // reads the stage-5 8-hop story byte-identically: no DNS hop, no DNS ask
+  // sentence, denominators unchanged.
+  it('keeps a Stage 6 host-less GET /about at the Stage 5 hop story byte-identically', () => {
+    const hostlessTrace = {
+      hop: 2,
+      method: 'GET',
+      path: '/about',
+      request: 'GET /about',
+      wireRequest: 'GET /about',
+      wirePath: '/about',
+      host: null,
+      hostPath: null,
+      hostless: true,
+      dnsAddress: null,
+      dnsStatus: null,
+      dnsTarget: null,
+      totalHops: 8,
+      targetServer: '10.11',
+      cacheStatus: null,
+      dbOp: null,
+      dbStale: false,
+      asyncJob: false,
+      response: null,
+      status: null,
+      body: null,
+      routeId: null,
+    };
+    const base = {
+      tick: 2,
+      users: 5,
+      serverAddress: '10.1',
+      queueDepth: 0,
+      served: 1,
+      avgLatencyTicks: 1,
+      workerQueue: WORKER_QUEUE,
+      trace: hostlessTrace,
+    };
+    const stage6Hostless = describeSnapshot({ ...base, stage: 6 });
+    const stage5 = describeSnapshot({ ...base, stage: 5 });
+    expect(stage6Hostless.totalHops).toBe(8);
+    // Byte-identical hop text, hop by hop — the stage number itself is the
+    // only difference between the two snapshots.
+    for (let hop = 1; hop <= 8; hop++) {
+      const t = { ...hostlessTrace, hop };
+      expect(describeSnapshot({ ...base, stage: 6, trace: t }).hopStatus).toBe(
+        describeSnapshot({ ...base, stage: 5, trace: t }).hopStatus,
+      );
+    }
+    expect(stage5.hopStatus).toBe('Hop 2/8: Network (10.x) routes to LoadBalancer (10.1)');
+    expect(stage6Hostless.hopStatus).toBe('Hop 2/8: Network (10.x) routes to LoadBalancer (10.1)');
+  });
+});
