+++ b/e2e/compare.spec.js
@@ -0,0 +1,110 @@
+import { test, expect } from '@playwright/test';
+
+// B-5 compare tray (docs/plans/2026-10-25-b5-compare-tray.md §4): the tray
+// inside the log-card compares the two most recent COMPLETED trace runs,
+// hop-aligned with verbatim journey-log frame texts. Crowd ticks stay out
+// (the sole push site is the trace completion branch); a stage switch
+// clears the pair. The sim runs from a fixed seed, so every hop count and
+// frame read here is identical on every run.
+
+const HOP = async (page) => page.getByTestId('btn-next-hop').click();
+
+test('should compare the last two trace runs hop-by-hop in the compare tray', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-3').click();
+  await page.getByTestId('url-input').fill('/about');
+
+  // Hidden/incomplete-state rule: zero or one stored run renders no rows.
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  await expect(page.getByTestId('compare-tray')).toBeHidden();
+  await expect(page.getByTestId('compare-rows').locator('.compare-row')).toHaveCount(0);
+
+  // The second completed run fills B: 6 vs 6 hops, MISS then HIT. Round-
+  // robin sent run 1 to backend 10.11 (cold cache MISS) and run 2 to 10.12
+  // (shared warm HIT) — the tray reads the runs' own frame texts verbatim.
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  await expect(page.getByTestId('compare-headline')).toHaveText(
+    '6 vs 6 hops · GET /about vs GET /about',
+  );
+  const rows = page.getByTestId('compare-rows').locator('.compare-row');
+  await expect(rows).toHaveCount(6);
+  await expect(rows.nth(3).locator('.compare-left')).toHaveText(
+    '10.11 -> 10.20 | cache MISS (/about)',
+  );
+  await expect(rows.nth(3).locator('.compare-right')).toHaveText(
+    '10.12 -> 10.20 | cache HIT (/about)',
+  );
+  // Equal runs align row for row: no em-dash anywhere.
+  await expect(rows.nth(5).locator('.compare-right')).not.toHaveText('—');
+});
+
+test('should show em-dash rows where one run is shorter (9 vs 6)', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-6').click();
+
+  // Run A: the cd.example.com MISS pulls the origin through the Router and
+  // fills the edge ledger (9 hops).
+  await page.getByTestId('url-input').fill('cd.example.com/about');
+  for (let hop = 0; hop < 9; hop++) await HOP(page);
+  // Run B: the hosted plain path rides the DNS prelude into the full
+  // stage-5 chain (9 hops) — it becomes the left slot; the MISS run shifts
+  // out of the pair.
+  await page.getByTestId('url-input').fill('example.com/about');
+  for (let hop = 0; hop < 9; hop++) await HOP(page);
+  // Run C: the same CDN name inside the ledger's TTL answers an edge HIT in
+  // 6 hops — the pair is now the 9-hop example.com run vs the 6-hop HIT.
+  await page.getByTestId('url-input').fill('cd.example.com/about');
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 6/6: Browser (10.2) received and displayed 200',
+  );
+
+  await expect(page.getByTestId('compare-headline')).toHaveText(
+    '9 vs 6 hops · example.com/about vs cd.example.com/about',
+  );
+  const rows = page.getByTestId('compare-rows').locator('.compare-row');
+  await expect(rows).toHaveCount(9);
+  // The exhausted right side renders the em-dash at rows 7-9; nothing drops.
+  await expect(rows.nth(6).locator('.compare-right')).toHaveText('—');
+  await expect(rows.nth(7).locator('.compare-right')).toHaveText('—');
+  await expect(rows.nth(8).locator('.compare-right')).toHaveText('—');
+  await expect(rows.nth(8).locator('.compare-left')).toHaveText(
+    'Worker 10.41 idle — no async jobs in this trace',
+  );
+});
+
+test('should never compare crowd-tick runs into the tray', async ({ page }) => {
+  await page.goto('/panel.html');
+
+  // Two completed stage-1 traces pin the pair.
+  for (let hop = 0; hop < 4; hop++) await HOP(page);
+  for (let hop = 0; hop < 4; hop++) await HOP(page);
+  const headline = page.getByTestId('compare-headline');
+  const expected = await headline.textContent();
+  await expect(headline).toHaveText('4 vs 4 hops · GET /about vs GET /about');
+  await expect(page.getByTestId('compare-rows').locator('.compare-row')).toHaveCount(4);
+
+  // Crowd ticks land in the journey log while the clock runs — none of them
+  // may shift the tray's pair (trace-runs-only contract).
+  await page.getByTestId('start-button').click();
+  await expect
+    .poll(async () => Number(await page.getByTestId('tick').textContent()), { timeout: 10_000 })
+    .toBeGreaterThanOrEqual(3);
+  await page.getByTestId('start-button').click(); // pause, determinism done
+  await expect(headline).toHaveText(expected);
+  await expect(page.getByTestId('compare-rows').locator('.compare-row')).toHaveCount(4);
+});
+
+test('should clear the compare tray on a stage switch', async ({ page }) => {
+  await page.goto('/panel.html');
+
+  for (let hop = 0; hop < 4; hop++) await HOP(page);
+  for (let hop = 0; hop < 4; hop++) await HOP(page);
+  await expect(page.getByTestId('compare-headline')).toContainText('4 vs 4 hops');
+  await expect(page.getByTestId('compare-rows').locator('.compare-row')).toHaveCount(4);
+
+  await page.getByTestId('stage-pill-2').click();
+  // Cross-stage shapes are not comparable: no stale rows, no crash.
+  await expect(page.getByTestId('compare-tray')).toBeHidden();
+  await expect(page.getByTestId('compare-rows').locator('.compare-row')).toHaveCount(0);
+});
diff --git a/js/panel/compare.js b/js/panel/compare.js
new file mode 100644
index 0000000..1de0795
--- /dev/null
+++ b/js/panel/compare.js
@@ -0,0 +1,108 @@
+// DOCUMENTS: B-5 compare tray — the auto-pair diff of the two most recent
+// completed trace runs, JS-built into the existing .log-card (panel.html
+// sits at its 550-line cap; stage6-registry.js injection precedent). The
+// tray renders verbatim journey-log entry texts only: minting, rewriting,
+// or summarising hop frames would be a DL-1/DL-3 defect. Slot selection and
+// row alignment are the pure contracts in model.js (nextCompareSlots /
+// alignCompareRows); this module owns the DOM writes. Crowd ticks cannot
+// reach it — the sole push site is panel.js's stepOneHop completion branch,
+// and switchStage is the sole clear site.
+import { alignCompareRows, nextCompareSlots } from './model.js';
+
+let tray = null;
+let headline = null;
+let rows = null;
+let slots = { a: null, b: null };
+
+// CHECKS: injection runs once at panel boot, before any completion branch
+// can fire. Hidden/incomplete-state rule: zero or one stored run renders no
+// rows at all — the tray stays hidden until a pair exists (the rule the e2e
+// suite pins).
+export function initCompareTray() {
+  if (tray) return;
+  const logCard = document.querySelector('.log-card');
+  if (!logCard) return;
+  tray = document.createElement('div');
+  tray.id = 'compare-tray';
+  tray.className = 'compare-tray';
+  tray.dataset.testid = 'compare-tray';
+  tray.hidden = true;
+  headline = document.createElement('h3');
+  headline.id = 'compare-headline';
+  headline.className = 'compare-headline';
+  headline.dataset.testid = 'compare-headline';
+  rows = document.createElement('ol');
+  rows.id = 'compare-rows';
+  rows.className = 'compare-rows';
+  rows.dataset.testid = 'compare-rows';
+  tray.append(headline, rows);
+  logCard.append(tray);
+}
+
+// panel.js's completion-branch caller: derives the run's own label from its
+// trace snapshot (grounded: hosted stage-6 paths carry the split
+// `trace.host` + resource `trace.path`; stages 1-5 carry the full
+// `trace.request`), counts hops from the snapshot entries themselves, and
+// copies the entry objects so the stored pair is immune to later
+// JOURNEY_CAP trims and relabel object swaps in render.js.
+export function pushTraceRun(run, entries, trace) {
+  if (!tray) initCompareTray();
+  if (!tray || !Array.isArray(entries) || entries.length === 0) return;
+  const host = trace?.host ?? null;
+  const label = host ? `${host}${trace.path ?? ''}` : (trace?.request ?? '');
+  pushCompareRun({
+    run,
+    label,
+    hops: entries.length,
+    entries: entries.map((entry) => ({ ...entry })),
+  });
+}
+
+// Canonical push: one completed run snapshot in, nextCompareSlots decides
+// fill/shift/no-op (a stored run re-push is a no-op and re-renders nothing).
+export function pushCompareRun({ run, label, hops, entries }) {
+  const next = nextCompareSlots(slots, { run, label, hops, entries });
+  slots = { a: next.a, b: next.b };
+  if (next.changed) renderTray();
+  return next.changed;
+}
+
+// CHECKS: a stage switch empties the tray — cross-stage shapes are not
+// comparable. Named counter-example (pinned in e2e/compare.spec.js): two
+// pinned runs, a switch to another stage leaves the tray hidden and empty —
+// no stale rows, no crash.
+export function clearCompare() {
+  slots = { a: null, b: null };
+  renderTray();
+}
+
+function renderTray() {
+  if (!tray) return;
+  if (!slots.a || !slots.b) {
+    tray.hidden = true;
+    headline.textContent = '';
+    rows.replaceChildren();
+    return;
+  }
+  tray.hidden = false;
+  headline.textContent = `${slots.a.hops} vs ${slots.b.hops} hops · ${slots.a.label} vs ${slots.b.label}`;
+  rows.replaceChildren(
+    ...alignCompareRows(slots.a, slots.b).map((row) => {
+      const item = document.createElement('li');
+      item.className = 'compare-row';
+      const n = document.createElement('span');
+      n.className = 'compare-n';
+      n.textContent = String(row.n);
+      item.append(n, cell('compare-left', row.left), cell('compare-right', row.right));
+      return item;
+    }),
+  );
+}
+
+function cell(className, text) {
+  const span = document.createElement('span');
+  span.className = className;
+  span.textContent = text;
+  span.title = text; // the full frame stays reachable under the ellipsis
+  return span;
+}
