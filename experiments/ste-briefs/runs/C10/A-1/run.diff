index 297e340..87a95ac 100644
--- a/js/panel/model.js
+++ b/js/panel/model.js
@@ -167,6 +167,47 @@ export function orderJourneyEntries(entries, entry) {
   return ordered;
 }
 
+// ---- B-5 compare tray (pure contracts; the DOM lives in compare.js) -------
+
+// CHECKS: row alignment pads the exhausted side with an em-dash and never
+// mutates an entry's text — the tray renders verbatim journey-log frames
+// (DL-1/DL-3: compare never mints or rewrites hop text). Named
+// counter-example (pinned in test/panel/model.test.js): 9-by-6 runs produce
+// 9 rows, rows 7-9 carrying `—` on the right; nothing drops.
+export function alignCompareRows(left, right) {
+  const total = Math.max(left.entries.length, right.entries.length);
+  return Array.from({ length: total }, (_, i) => ({
+    n: i + 1,
+    left: left.entries[i]?.text ?? '—',
+    right: right.entries[i]?.text ?? '—',
+  }));
+}
+
+// CHECKS: slot selection — always the two most recent COMPLETED trace runs.
+// A run equal to a stored slot's run id is a no-op (the tray does not
+// duplicate); the first push fills A, the second fills B, and a third
+// distinct run shifts A <- old B, B <- new. Tick-shaped runs never compare:
+// a push carrying `hops` < 2 or no hop entries is ignored — the
+// trace-runs-only counter-example (crowd ticks must never shift slots) is
+// pinned in test/panel/model.test.js.
+export function nextCompareSlots(slots, newRun) {
+  const current = slots ?? { a: null, b: null };
+  if (
+    !newRun ||
+    typeof newRun.hops !== 'number' ||
+    newRun.hops < 2 ||
+    !Array.isArray(newRun.entries) ||
+    newRun.entries.length === 0 ||
+    newRun.run === current.a?.run ||
+    newRun.run === current.b?.run
+  ) {
+    return { a: current.a, b: current.b, changed: false };
+  }
+  if (!current.a) return { a: newRun, b: null, changed: true };
+  if (!current.b) return { a: current.a, b: newRun, changed: true };
+  return { a: current.b, b: newRun, changed: true };
+}
+
 export function describeSnapshot(snapshot) {
   const stage = snapshot.stage ?? 1;
   const latencyMs = Math.round(snapshot.avgLatencyTicks * TICK_MS);
