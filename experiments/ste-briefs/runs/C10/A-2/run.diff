+++ b/e2e/compare.spec.js
@@ -0,0 +1,127 @@
+import { test, expect } from '@playwright/test';
+
+// B-5 compare tray (compare tray auto-pair brief): the tray inside the
+// log-card compares the two most recent completed trace runs,
+// hop-aligned, with the exhausted side reading an em-dash. Assertions read
+// the real page — the tray's rows are the runs' journey-entry texts
+// verbatim; no doubles, no scripted counts except the hop pins themselves.
+// Hop counts are grounded in the trace machines (trace.js / trace-stage6.js):
+// stage 3 = 6 hops, stage 1 = 4, stage 2 = 5, stage 6 hosted = 9, CDN edge
+// HIT = 6.
+
+const HOP = async (page) => page.getByTestId('btn-next-hop').click();
+const rows = (page) => page.getByTestId('compare-rows').locator('.compare-row');
+const runHops = async (page, count) => {
+  for (let hop = 0; hop < count; hop++) await HOP(page);
+};
+
+test('should compare the last two trace runs hop-by-hop in the compare tray', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-3').click();
+  // The brief's "MISS then HIT over example.com" grounds to the stage-3
+  // shape: 6 hops per trace, and the typed path is the resource path only
+  // (/about — stage 3 has no DNS). Two traces: the first MISSes Cache
+  // 10.20 and warms it, the second HITs the shared entry from 10.12.
+  await page.getByTestId('url-input').fill('/about');
+  await runHops(page, 6);
+  await runHops(page, 6);
+
+  await expect(page.getByTestId('compare-tray')).toBeVisible();
+  await expect(page.getByTestId('compare-headline')).toHaveText('6 vs 6 hops · /about vs /about');
+  await expect(rows(page)).toHaveCount(6);
+  // Verbatim journey-entry texts, hop-aligned: row 4 is both runs' cache
+  // check — the cold MISS on the left, the warm HIT on the right.
+  const row4 = rows(page).nth(3).locator('.compare-cell');
+  await expect(row4.first()).toHaveText('10.11 -> 10.20 | cache MISS (/about)');
+  await expect(row4.last()).toHaveText('10.12 -> 10.20 | cache HIT (/about)');
+});
+
+test('should show em-dash rows where one run is shorter (9 vs 6)', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-6').click();
+  // Warm the edge first: the initial cd.example.com run is the 9-hop MISS
+  // that pulls the origin through the Router and fills the ledger. It is
+  // shifted out of the tray by the two most recent runs below.
+  await page.getByTestId('url-input').fill('cd.example.com/about');
+  await runHops(page, 9);
+  // A hosted subnet-10 run: example.com/about rides the DNS ask/answer
+  // prelude + the stage-5 chain = 9 hops.
+  await page.getByTestId('url-input').fill('example.com/about');
+  await runHops(page, 9);
+  // The warm edge answers the third run from its fill ledger: 6 hops.
+  await page.getByTestId('url-input').fill('cd.example.com/about');
+  await runHops(page, 6);
+
+  await expect(page.getByTestId('compare-headline')).toHaveText(
+    '9 vs 6 hops · example.com/about vs cd.example.com/about',
+  );
+  await expect(rows(page)).toHaveCount(9);
+  // Rows 7–9: the exhausted right side reads the em-dash, the left keeps
+  // its own frame — nothing drops (frames grounded in trace-stage6.js's
+  // hosted shape: network delivery, browser render, idle worker tail).
+  const expectedTail = [
+    'Network delivered 200 response to 10.2',
+    'Browser 10.2 received and displayed 200',
+    'Worker 10.41 idle — no async jobs in this trace',
+  ];
+  for (const [i, text] of expectedTail.entries()) {
+    const cells = rows(page)
+      .nth(6 + i)
+      .locator('.compare-cell');
+    await expect(cells.first()).toHaveText(text);
+    await expect(cells.last()).toHaveText('—');
+  }
+  // Snapshot-at-completion: 24 journey entries tripped the live log's
+  // 20-entry cap, but the tray's stored run snapshots still show all rows
+  // of their two runs, hop 1 verbatim.
+  const firstRow = rows(page).first().locator('.compare-cell');
+  await expect(firstRow.first()).toHaveText('10.2 -> 10.60 | who is example.com?');
+  await expect(firstRow.last()).toHaveText('10.2 -> 10.60 | who is cd.example.com?');
+});
+
+test('should never compare crowd-tick runs into the tray', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('url-input').fill('/about');
+  await runHops(page, 4);
+  // Hidden/incomplete-state rule: one stored run is not a pair yet.
+  await expect(page.getByTestId('compare-tray')).toBeHidden();
+  await runHops(page, 4);
+  const headline = page.getByTestId('compare-headline');
+  await expect(headline).toHaveText('4 vs 4 hops · /about vs /about');
+  await expect(rows(page)).toHaveCount(4);
+  const headlineBefore = await headline.textContent();
+  const rowCountBefore = await rows(page).count();
+
+  // Crowd ticks run the engine clock; each tick frame is its own journey
+  // run in #journey-log — but a tick is not a trace run, so the tray
+  // slots stay exactly these two trace runs.
+  await page.getByTestId('start-button').click();
+  await expect
+    .poll(async () => Number(await page.getByTestId('tick').textContent()), { timeout: 5_000 })
+    .toBeGreaterThanOrEqual(3);
+  await page.getByTestId('start-button').click(); // pause, tray must be untouched
+  await expect(page.getByTestId('tick')).not.toHaveText('0');
+  await expect(headline).toHaveText(headlineBefore);
+  await expect(rows(page)).toHaveCount(rowCountBefore);
+});
+
+test('should clear the compare tray on a stage switch', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('url-input').fill('/about');
+  await runHops(page, 4);
+  await runHops(page, 4);
+  await expect(page.getByTestId('compare-tray')).toBeVisible();
+  await expect(rows(page)).toHaveCount(4);
+
+  // Cross-stage shapes are not comparable: the tray empties (no stale
+  // rows, no crash) and hides until a fresh pair completes.
+  await page.getByTestId('stage-pill-2').click();
+  await expect(page.getByTestId('compare-tray')).toBeHidden();
+  await expect(page.getByTestId('compare-rows')).toHaveText('');
+
+  // A fresh pair on the new stage re-fills it (stage 2 = 5-hop shapes).
+  await runHops(page, 5);
+  await runHops(page, 5);
+  await expect(page.getByTestId('compare-headline')).toHaveText('5 vs 5 hops · /about vs /about');
+  await expect(rows(page)).toHaveCount(5);
+});
diff --git a/js/panel/compare.js b/js/panel/compare.js
new file mode 100644
index 0000000..3e2ad32
--- /dev/null
+++ b/js/panel/compare.js
@@ -0,0 +1,106 @@
+// DOCUMENTS: the B-5 compare tray — a JS-built auto-pair diff inside the
+// existing .log-card (panel.html sits at its line cap; stage6-registry.js
+// injection precedent). It holds the two most recent completed
+// trace runs, hop-aligned, the exhausted side reading the em-dash; rows
+// are the runs' stored journey-entry texts verbatim — this module does not
+// mint or rewrite a hop frame (DL-1/DL-3). The pure slot/align contracts
+// live in model.js (nextCompareSlots / alignCompareRows, unit-pinned);
+// everything here is DOM-bound and covered by e2e/compare.spec.js.
+import { alignCompareRows, nextCompareSlots } from './model.js';
+import { els } from './render.js';
+
+let slots = { a: null, b: null };
+let tray = null;
+let headline = null;
+let rows = null;
+let injected = false;
+
+// CHECKS: injection is idempotent and lazy (stage6-registry.js precedent)
+// — called once at panel boot, before any push can arrive; content comes
+// from textContent/attributes only, no innerHTML (CSP rule).
+export function initCompareTray() {
+  if (injected) return;
+  injected = true;
+  tray = document.createElement('section');
+  tray.id = 'compare-tray';
+  tray.dataset.testid = 'compare-tray';
+  tray.className = 'compare-tray';
+  // Hidden/incomplete-state rule: zero or one stored run → no tray rows.
+  tray.hidden = true;
+  const title = document.createElement('h3');
+  title.className = 'compare-title';
+  title.textContent = 'Compare last two runs';
+  headline = document.createElement('p');
+  headline.id = 'compare-headline';
+  headline.dataset.testid = 'compare-headline';
+  headline.className = 'compare-headline';
+  rows = document.createElement('ol');
+  rows.id = 'compare-rows';
+  rows.dataset.testid = 'compare-rows';
+  rows.className = 'compare-rows';
+  tray.append(title, headline, rows);
+  document.querySelector('.log-card').append(tray);
+}
+
+// The run's own request descriptor, read from the trace snapshot: trace.js
+// and trace-stage6.js both carry `path`, and the stage-6 machine adds
+// `host` (the typed path minus its resource part), so the descriptor is
+// `host + path` when a host exists and the typed path otherwise. A
+// snapshot without a trace falls back to the URL controls captured at
+// completion (defensive only — both trace machines carry path).
+function labelOf(snapshot) {
+  const trace = snapshot?.trace ?? null;
+  if (trace?.path) {
+    return trace.host ? `${trace.host}${trace.path}` : trace.path;
+  }
+  return `${els.method.value} ${els.urlInput.value}`;
+}
+
+// CHECKS: only the stepOneHop completion branch (the same branch that
+// calls relabelJourneyRun) calls this — the crowd-tick addToJourney
+// branches never do, so the tray holds exactly the two most recent
+// completed trace runs and a third distinct run shifts A ← old B, B ← new.
+export function pushCompareRun({ run, snapshot, hops, entries }) {
+  if (!injected) initCompareTray();
+  const next = nextCompareSlots(slots, { run, label: labelOf(snapshot), hops, entries });
+  if (!next.changed) return;
+  slots = next;
+  renderCompare();
+}
+
+// Stage switch clears the tray (cross-stage shapes are not comparable).
+export function clearCompare() {
+  slots = { a: null, b: null };
+  if (injected) renderCompare();
+}
+
+function renderCompare() {
+  const { a, b } = slots;
+  tray.hidden = !(a && b);
+  headline.textContent = a && b ? `${a.hops} vs ${b.hops} hops · ${a.label} vs ${b.label}` : '';
+  rows.replaceChildren(...(a && b ? alignCompareRows(a, b).map(rowOf) : []));
+}
+
+// One row per hop index: `n | left frame | right frame`, the texts verbatim
+// from the stored entries. Both frame cells are single-line and ellipsize,
+// with a title tooltip carrying the full text (consistent per row — the
+// tray stays inside the log-card, the .comp-tabs spillover lesson).
+function rowOf(row) {
+  const item = document.createElement('li');
+  item.className = 'compare-row';
+  const n = document.createElement('span');
+  n.className = 'compare-n';
+  n.textContent = String(row.n);
+  const left = cellOf(row.left);
+  const right = cellOf(row.right);
+  item.append(n, left, right);
+  return item;
+}
+
+function cellOf(text) {
+  const cell = document.createElement('span');
+  cell.className = 'compare-cell';
+  cell.textContent = text;
+  cell.title = text;
+  return cell;
+}
diff --git a/js/panel/journey-log.js b/js/panel/journey-log.js
new file mode 100644
index 0000000..10be42a
--- /dev/null
+++ b/js/panel/journey-log.js
@@ -0,0 +1,59 @@
+// DOCUMENTS: the wire journey log's store + DOM render, split from
+// render.js by responsibility (guard-file-size: render.js stays the
+// snapshot renderer). Ordering is the pure contract in model.js
+// (orderJourneyEntries): entries render newest-run-first and, inside one
+// run, hop-ascending whatever emission order the trace engine produces.
+// The cap keeps the 20 newest entries (bottom tail trimmed), like the
+// previous DOM trim, and the consecutive-emission dedupe (same label +
+// text emitted twice in a row) stays: the duplicate frame is not logged.
+import { orderJourneyEntries } from './model.js';
+import { els } from './render.js';
+
+const JOURNEY_CAP = 20;
+let journeyEntries = [];
+let lastEmitted = null;
+
+export function addToJourney(label, text, { run = 0, hop = 0 } = {}) {
+  if (lastEmitted && lastEmitted.label === label && lastEmitted.text === text) return;
+  lastEmitted = { label, text };
+  journeyEntries = orderJourneyEntries(journeyEntries, { label, text, run, hop }).slice(
+    0,
+    JOURNEY_CAP,
+  );
+  renderJourney();
+}
+
+// CHECKS: a trace run's stored hop denominators must be the run's FINAL hop
+// count. An NX run's estimate (`host ? 9 : 8`) bakes `hop 1/9` before the
+// answer proves the run ends at 2; once the final hop lands, relabelRun()
+// rewrites every entry of that run so the log never advertises hops the
+// run did not take (render() re-reads journeyEntries only).
+export function relabelJourneyRun(run, totalHops) {
+  journeyEntries = journeyEntries.map((entry) =>
+    entry.run === run && entry.hop > 0
+      ? { ...entry, label: `hop ${entry.hop}/${totalHops}` }
+      : entry,
+  );
+  renderJourney();
+}
+
+// CHECKS: the run's hop entries (hop > 0) as fresh copies, hop-ascending —
+// the compare tray's snapshot taken at completion, immune to later
+// JOURNEY_CAP trims of the live array (B-5 snapshot-at-completion rule).
+export function getRunEntries(run) {
+  return journeyEntries
+    .filter((entry) => entry.run === run && entry.hop > 0)
+    .sort((a, b) => a.hop - b.hop)
+    .map((entry) => ({ ...entry }));
+}
+
+function renderJourney() {
+  els.journeyLog.replaceChildren(
+    ...journeyEntries.map((entry) => {
+      const item = document.createElement('li');
+      item.className = 'journey-entry';
+      item.textContent = `${entry.label} · ${entry.text}`;
+      return item;
+    }),
+  );
+}
