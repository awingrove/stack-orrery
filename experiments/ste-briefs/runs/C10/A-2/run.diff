index 297e340..ab97f65 100644
--- a/js/panel/model.js
+++ b/js/panel/model.js
@@ -167,6 +167,55 @@ export function orderJourneyEntries(entries, entry) {
   return ordered;
 }
 
+// B-5 compare-tray pure contracts (unit-pinned in test/panel/model.test.js;
+// the DOM side lives in compare.js). Rows align by hop index over
+// max(left.hops, right.hops); the exhausted side reads the em-dash; entry
+// texts pass through verbatim (DL-1/DL-3 — nothing mints hop frames here).
+const COMPARE_DASH = '—';
+
+export function alignCompareRows(left, right) {
+  const total = Math.max(left.hops, right.hops);
+  return Array.from({ length: total }, (_, i) => ({
+    n: i + 1,
+    left: left.entries[i]?.text ?? COMPARE_DASH,
+    right: right.entries[i]?.text ?? COMPARE_DASH,
+  }));
+}
+
+// The slot branch: first fill A, then B, then shift A ← old B, B ← new.
+// Rejection rule (named counter-example, the slot-purity pin): a run with
+// hops < 2 or no hop entries is ignored — a crowd tick (`{ hops: 0 }`)
+// leaves the stored slots untouched; a re-push of either stored run id is
+// a no-op.
+export function nextCompareSlots(slots, newRun) {
+  const valid =
+    newRun && newRun.hops >= 2 && Array.isArray(newRun.entries) && newRun.entries.length > 0;
+  if (!valid || slots.a?.run === newRun.run || slots.b?.run === newRun.run) {
+    return { a: slots.a, b: slots.b, changed: false };
+  }
+  if (!slots.a) return { a: newRun, b: slots.b, changed: true };
+  if (!slots.b) return { a: slots.a, b: newRun, changed: true };
+  return { a: slots.b, b: newRun, changed: true };
+}
+
+// CHECKS: the live final hop reads from the trace itself — stage 6's shape
+// is (nx ? 2 : cdn ? (edgeStatus === 'HIT' ? 6 : 9) : host ? 9 : 8)
+// (mirroring trace-stage6.js): a host-less trace stops at its normal
+// stage-5 count, an NX answer at the answer hop, a CDN GET at 6 only after
+// the answer proved an edge HIT; other stages use TOTAL_HOPS (the helper
+// moved here from panel.js — one shared source).
+export function totalHopsFor(stage) {
+  return TOTAL_HOPS[stage] ?? TOTAL_HOPS[1];
+}
+export function traceFinalHop(snapshot, stage) {
+  if (snapshot.stage === 6 && snapshot.trace) {
+    if (snapshot.trace.nx) return 2;
+    if (snapshot.trace.cdn) return snapshot.trace.edgeStatus === 'HIT' ? 6 : 9;
+    return snapshot.trace.host ? 9 : 8;
+  }
+  return totalHopsFor(stage);
+}
+
 export function describeSnapshot(snapshot) {
   const stage = snapshot.stage ?? 1;
   const latencyMs = Math.round(snapshot.avgLatencyTicks * TICK_MS);
