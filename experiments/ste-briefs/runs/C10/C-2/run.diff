+    const right = compareRun(
+      2,
+      6,
+      Array.from({ length: 6 }, (_, i) => `R${i + 1} frame`),
+    );
+    const rows = alignCompareRows(left, right);
+    expect(rows).toHaveLength(9);
+    expect(rows.map((row) => row.n)).toEqual([1, 2, 3, 4, 5, 6, 7, 8, 9]);
+    expect(rows[6]).toEqual({ n: 7, left: 'L7 frame', right: '—' });
+    expect(rows[7].right).toBe('—');
+    expect(rows[8].right).toBe('—');
+    expect(rows.map((row) => row.left)).toEqual(
+      Array.from({ length: 9 }, (_, i) => `L${i + 1} frame`),
+    );
+  });
+
+  it('aligns equal runs hop-for-hop with identical cells', () => {
+    const texts = Array.from({ length: 6 }, (_, i) => `frame ${i + 1}`);
+    const rows = alignCompareRows(compareRun(1, 6, texts), compareRun(2, 6, texts));
+    expect(rows).toHaveLength(6);
+    for (const row of rows) expect(row.left).toBe(row.right);
+  });
+
+  // PINS: verbatim passthrough — the runs are deeply frozen, so any
+  // mutation attempt inside alignment throws; the row cells are the exact
+  // stored strings (byte-identical, no minting or rewriting).
+  it('passes entry texts through verbatim and never mutates the runs', () => {
+    const texts = ['10.2 -> 10.1 | GET /about', 'WebServer (10.1) -> "200 ok"'];
+    const freezeDeep = (run) =>
+      Object.freeze({ ...run, entries: Object.freeze(run.entries.map(Object.freeze)) });
+    const rows = alignCompareRows(
+      freezeDeep(compareRun(1, 2, texts)),
+      freezeDeep(compareRun(2, 2, texts)),
+    );
+    expect(rows.map((row) => row.left)).toEqual(texts);
+    expect(rows[0].right).toBe('10.2 -> 10.1 | GET /about');
+    expect(rows[1].right).toBe('WebServer (10.1) -> "200 ok"');
+  });
+});
+
+describe('nextCompareSlots', () => {
+  it('fills slot A then B and shifts A ← old B on a third distinct run', () => {
+    const run1 = compareRun(1, 6, ['a1', 'a2']);
+    const run2 = compareRun(2, 6, ['b1', 'b2']);
+    const run3 = compareRun(3, 6, ['c1', 'c2']);
+    const first = nextCompareSlots({ a: null, b: null }, run1);
+    expect(first.changed).toBe(true);
+    expect(first.a).toBe(run1);
+    expect(first.b).toBe(null);
+    const second = nextCompareSlots(first, run2);
+    expect(second.changed).toBe(true);
+    expect(second.a).toBe(run1);
+    expect(second.b).toBe(run2);
+    const third = nextCompareSlots(second, run3);
+    expect(third.changed).toBe(true);
+    expect(third.a).toBe(run2);
+    expect(third.b).toBe(run3);
+  });
+
+  it('re-pushing a run already in the slots is a no-op with unchanged slots', () => {
+    const run1 = compareRun(1, 6, ['a1']);
+    const run2 = compareRun(2, 6, ['b1']);
+    const filled = nextCompareSlots(nextCompareSlots({ a: null, b: null }, run1), run2);
+    const again = nextCompareSlots(filled, run2);
+    expect(again.changed).toBe(false);
+    expect(again.a).toBe(filled.a);
+    expect(again.b).toBe(filled.b);
+    // The older slot's run id is equally a no-op (the tray does not duplicate).
+    expect(nextCompareSlots(filled, run1).changed).toBe(false);
+  });
+
+  // PINS: the trace-runs-only counter-example — a crowd tick never enters
+  // the slots: tick-shaped runs (hops < 2 or no hop entries) are rejected
+  // without shifting A or B.
+  it('rejects tick-shaped runs with no hop entries (crowd ticks never compare)', () => {
+    const run1 = compareRun(1, 6, ['a1']);
+    const run2 = compareRun(2, 6, ['b1']);
+    const filled = nextCompareSlots(nextCompareSlots({ a: null, b: null }, run1), run2);
+    const tickRun = { run: 'tick 9', hops: 0, label: 'tick 9', entries: [] };
+    const oneHop = { run: 9, hops: 1, label: 'GET /about', entries: [{ hop: 1, text: 'x' }] };
+    for (const shaped of [tickRun, oneHop, null]) {
+      const next = nextCompareSlots(filled, shaped);
+      expect(next.changed).toBe(false);
+      expect(next.a).toBe(filled.a);
+      expect(next.b).toBe(filled.b);
+    }
+  });
+});
