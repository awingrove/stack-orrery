--- /dev/null
+++ b/e2e/compare.spec.js
@@ -0,0 +1,123 @@
+import { test, expect } from '@playwright/test';
+
+// B-5 compare tray (brief docs/plans/2026-10-25-b5-compare-tray.md): the
+// tray lives inside the log-card and holds the two most recent completed
+// trace runs, hop-aligned with em-dashes where one run ended sooner. Crowd
+// ticks stay out; a stage switch clears. All assertions read the real
+// injected DOM (data-testid compare-tray / compare-headline /
+// compare-rows) — no proxy anywhere; the tray renders the journey log's
+// own verbatim frames.
+
+const HOP = async (page) => page.getByTestId('btn-next-hop').click();
+const rowLocator = (page) => page.getByTestId('compare-rows').locator('.compare-row');
+
+test('should compare the last two trace runs hop-by-hop in the compare tray', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-3').click();
+  await page.getByTestId('url-input').fill('/about');
+
+  // Run 1 and run 2: the cold MISS from 10.11 pairs with the warm HIT from
+  // 10.12 (6 hops each).
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  // One stored run is a pair-incomplete tray: hidden, no rows.
+  await expect(page.getByTestId('compare-tray')).toBeHidden();
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  await expect(page.getByTestId('compare-headline')).toHaveText(
+    '6 vs 6 hops · GET /about vs GET /about',
+  );
+  await expect(rowLocator(page)).toHaveCount(6);
+  const row4 = rowLocator(page).nth(3);
+  await expect(row4.locator('.compare-left')).toHaveText('10.11 -> 10.20 | cache MISS (/about)');
+  await expect(row4.locator('.compare-right')).toHaveText('10.12 -> 10.20 | cache HIT (/about)');
+
+  // Three more full runs: the live journey log is trimmed to its 20-entry
+  // cap, but the tray's stored snapshots keep every row of their two runs
+  // (snapshot-at-completion counter-example).
+  for (let run = 0; run < 3; run++) {
+    for (let hop = 0; hop < 6; hop++) await HOP(page);
+  }
+  await expect(page.locator('#journey-log .journey-entry')).toHaveCount(20);
+  await expect(page.getByTestId('compare-headline')).toHaveText(
+    '6 vs 6 hops · GET /about vs GET /about',
+  );
+  await expect(rowLocator(page)).toHaveCount(6);
+  // The new pair is runs 4 and 5 (round-robin 10.12 then 10.11, both warm
+  // HITs on the shared entry) — complete on both sides despite the trims.
+  await expect(rowLocator(page).nth(3).locator('.compare-left')).toHaveText(
+    '10.12 -> 10.20 | cache HIT (/about)',
+  );
+  await expect(rowLocator(page).nth(3).locator('.compare-right')).toHaveText(
+    '10.11 -> 10.20 | cache HIT (/about)',
+  );
+});
+
+test('should show em-dash rows where one run is shorter (9 vs 6)', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-6').click();
+
+  // Run 1: the hosted non-CDN shape (9 hops) — it also warms the origin.
+  await page.getByTestId('url-input').fill('example.com/about');
+  for (let hop = 0; hop < 9; hop++) await HOP(page);
+  // Run 2: the first cd.example.com run MISSes the edge and fills it
+  // (9 hops) — this run ends up on the left of the tray pair.
+  await page.getByTestId('url-input').fill('cd.example.com/about');
+  for (let hop = 0; hop < 9; hop++) await HOP(page);
+  await expect(page.getByTestId('cdn-stats')).toHaveText(
+    'Hits: 0 · Misses: 1 · Fills: 1 · TTL: 10t',
+  );
+  // Run 3: inside the edge TTL the same path is a 6-hop HIT — after the
+  // third-run shift the pair is (9-hop MISS, 6-hop HIT).
+  await page.getByTestId('url-input').fill('cd.example.com/about');
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+
+  await expect(page.getByTestId('compare-headline')).toHaveText(
+    '9 vs 6 hops · cd.example.com/about vs cd.example.com/about',
+  );
+  await expect(rowLocator(page)).toHaveCount(9);
+  // Rows 7-9: the HIT run has ended — the right cell reads the em-dash and
+  // the left cell keeps its verbatim frame (nothing drops).
+  for (const n of [6, 7, 8]) {
+    await expect(rowLocator(page).nth(n).locator('.compare-right')).toHaveText('—');
+    await expect(rowLocator(page).nth(n).locator('.compare-left')).not.toHaveText('—');
+  }
+  // Row 1 is the DNS ask of the 9-hop MISS run, verbatim.
+  await expect(rowLocator(page).first().locator('.compare-left')).toHaveText(
+    '10.2 -> 10.60 | who is cd.example.com?',
+  );
+});
+
+test('should never compare crowd-tick runs into the tray', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-3').click();
+  await page.getByTestId('url-input').fill('/about');
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+
+  const headline = await page.getByTestId('compare-headline').textContent();
+  const rows = await rowLocator(page).allTextContents();
+  expect(rows).toHaveLength(6);
+
+  // The crowd runs for several ticks: tick frames join the journey log but
+  // must stay out of the tray (trace-runs-only counter-example).
+  await page.getByTestId('start-button').click();
+  await page.waitForTimeout(600);
+  await page.getByTestId('start-button').click(); // pause
+  expect(Number(await page.locator('#tick').textContent())).toBeGreaterThan(0);
+  await expect(page.getByTestId('compare-headline')).toHaveText(headline);
+  await expect(rowLocator(page)).toHaveCount(6);
+  expect(await rowLocator(page).allTextContents()).toEqual(rows);
+});
+
+test('should clear the compare tray on a stage switch', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-3').click();
+  await page.getByTestId('url-input').fill('/about');
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  await expect(page.getByTestId('compare-tray')).toBeVisible();
+
+  await page.getByTestId('stage-pill-1').click();
+  // Cross-stage shapes are not comparable: no stale rows, no crash.
+  await expect(page.getByTestId('compare-tray')).toBeHidden();
+  await expect(rowLocator(page)).toHaveCount(0);
+});
diff --git a/js/panel/compare.js b/js/panel/compare.js
new file mode 100644
index 0000000..3bd2508
--- /dev/null
+++ b/js/panel/compare.js
@@ -0,0 +1,99 @@
+// DOCUMENTS: the compare tray (B-5 brief) — the DOM-bound module injected
+// into the existing .log-card at panel boot. This module owns wiring only:
+// the slot/align branch logic is the pure contract in model.js (unit-pinned
+// in test/panel/model.test.js), and row texts are the journey log's own
+// verbatim entries read at completion. No hop text is minted, rewritten, or
+// summarized here (DL-1/DL-3), and the tray stays hidden whenever fewer
+// than two distinct runs are stored (empty-state rule: hidden, consistently).
+import { alignCompareRows, nextCompareSlots } from './model.js';
+import { getRunEntries } from './render.js';
+
+let slots = { a: null, b: null };
+let tray = null;
+let headline = null;
+let rows = null;
+
+// The run's own descriptor, from the trace snapshot's path/host fields
+// (grounded in trace.js / trace-stage6.js): a hosted stage-6 run reads
+// `<host><path>` (e.g. cd.example.com/about); stages 1-5 carry no host on
+// the trace, so the run's `request` string ("GET /about") labels it.
+export function compareLabel(snapshot) {
+  const t = snapshot.trace ?? {};
+  return t.host ? `${t.host}${t.path}` : t.request;
+}
+
+// PINS: rows render the stored verbatim texts — n | left | right, one row
+// per hop over the pair's max, the exhausted side an em-dash. The headline
+// is the model's `${a.hops} vs ${b.hops} hops · <left> vs <right>`.
+function renderTray() {
+  const { a, b } = slots;
+  if (!a || !b) {
+    tray.hidden = true; // pair incomplete → no rows render (hidden, consistently)
+    return;
+  }
+  headline.textContent = `${a.hops} vs ${b.hops} hops · ${a.label} vs ${b.label}`;
+  rows.replaceChildren(
+    ...alignCompareRows(a, b).map(({ n, left, right }) => {
+      const row = document.createElement('li');
+      row.className = 'compare-row';
+      const nCell = document.createElement('span');
+      nCell.className = 'compare-n';
+      nCell.textContent = String(n);
+      const leftCell = document.createElement('span');
+      leftCell.className = 'compare-left';
+      leftCell.textContent = left;
+      leftCell.title = left; // the full frame on hover (cells ellipsize)
+      const rightCell = document.createElement('span');
+      rightCell.className = 'compare-right';
+      rightCell.textContent = right;
+      rightCell.title = right;
+      row.append(nCell, leftCell, rightCell);
+      return row;
+    }),
+  );
+  tray.hidden = false;
+}
+
+// Lazy lookup precedent (renderDnsHud / the stage-6 cards): the tray is
+// injected once into the existing .log-card — panel.js calls this at boot.
+export function initCompareTray() {
+  if (tray) return;
+  const card = document.querySelector('.log-card');
+  if (!card) return;
+  tray = document.createElement('div');
+  tray.id = 'compare-tray';
+  tray.className = 'compare-tray';
+  tray.dataset.testid = 'compare-tray';
+  tray.hidden = true;
+  headline = document.createElement('p');
+  headline.id = 'compare-headline';
+  headline.className = 'compare-headline';
+  headline.dataset.testid = 'compare-headline';
+  rows = document.createElement('ol');
+  rows.id = 'compare-rows';
+  rows.className = 'compare-rows';
+  rows.dataset.testid = 'compare-rows';
+  tray.append(headline, rows);
+  card.append(tray);
+}
+
+// CHECKS: only panel.js's stepOneHop completion branch pushes. The entries
+// snapshot is taken HERE, at completion, so later journey-log cap trims
+// cannot empty or reorder the stored rows; a re-push of a stored run id is
+// a model-level no-op (slots unchanged, no re-render).
+export function pushCompareRun({ run, hops, label }) {
+  if (!tray) initCompareTray();
+  const runSnapshot = { run, hops, label, entries: getRunEntries(run) };
+  const next = nextCompareSlots(slots, runSnapshot);
+  slots = { a: next.a, b: next.b };
+  if (next.changed) renderTray();
+}
+
+// Stage switches clear the tray: cross-stage shapes are not comparable.
+export function clearCompare() {
+  slots = { a: null, b: null };
+  if (!tray) return;
+  headline.textContent = '';
+  rows.replaceChildren();
+  tray.hidden = true;
+}
diff --git a/js/panel/model.js b/js/panel/model.js
index 297e340..9598ad5 100644
--- a/js/panel/model.js
+++ b/js/panel/model.js
@@ -248,3 +248,47 @@ export function describeSnapshot(snapshot) {
     matchedRouteId: snapshot.lastMatchedRoute ?? null,
   };
 }
+
+// B-5 compare tray pure contracts (unit-pinned; compare.js owns the DOM
+// wiring). Both consume the journey log's own entries — rows carry the
+// stored texts verbatim and nothing here mints or rewrites hop frames
+// (DL-1/DL-3).
+
+// PINS: rows align by hop index over max(left.hops, right.hops); the
+// exhausted side renders the em-dash. Named counter-example (pinned in
+// test/panel/model.test.js): 9-by-6 runs produce 9 rows, rows 7-9 right
+// cell '—'; nothing drops. Entries are matched by their hop key, so the
+// texts pass through byte-identical and are never mutated.
+export function alignCompareRows(left, right) {
+  const total = Math.max(left?.hops ?? 0, right?.hops ?? 0);
+  return Array.from({ length: total }, (_, i) => {
+    const n = i + 1;
+    return {
+      n,
+      left: left?.entries?.find((entry) => entry.hop === n)?.text ?? '—',
+      right: right?.entries?.find((entry) => entry.hop === n)?.text ?? '—',
+    };
+  });
+}
+
+// PINS: the slot branch — first push fills A, second fills B (changed:
+// true), a third distinct run shifts A ← old B / B ← new; a run whose id
+// already sits in a slot is a no-op (the tray never duplicates). Trace-
+// runs-only counter-example (pinned): a tick-shaped run — crowd ticks
+// carry hops < 2 and no hop entries — is rejected without moving a slot.
+export function nextCompareSlots(slots, newRun) {
+  const a = slots?.a ?? null;
+  const b = slots?.b ?? null;
+  const comparable =
+    newRun &&
+    Number.isInteger(newRun.hops) &&
+    newRun.hops >= 2 &&
+    Array.isArray(newRun.entries) &&
+    newRun.entries.length > 0;
+  if (!comparable || a?.run === newRun.run || b?.run === newRun.run) {
+    return { a, b, changed: false };
+  }
+  if (!a) return { a: newRun, b, changed: true };
+  if (!b) return { a, b: newRun, changed: true };
+  return { a: b, b: newRun, changed: true };
+}
