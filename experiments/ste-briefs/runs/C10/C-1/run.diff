@@ -0,0 +1,97 @@
+import { test, expect } from '@playwright/test';
+
+// Compare tray (b5 brief): auto-pair diff of the two most recent completed
+// trace runs, hop-aligned, em-dash where one run ends sooner. Hop counts
+// grounded in the sim at write time: stage 3 = 6 hops (trace.js), stage 6
+// hosted non-CDN = 9, CDN MISS = 9, CDN HIT = 6 (trace-stage6.js +
+// cdn-chain.js via panel.js traceFinalHop). All assertions read the tray's
+// real DOM over the panel's real logged entries — no scripted counts
+// except the hop pins themselves.
+
+const GO = async (page) => page.getByTestId('btn-url-go').click();
+
+test('should compare the last two trace runs hop-by-hop in the compare tray', async ({ page }) => {
+  await page.goto('/panel.html?stage=3');
+  // Run 1: the cold Cache 10.20 lookup misses (6 hops). Run 2: the shared
+  // entry answers a warm HIT (6 hops). Two distinct completed runs.
+  await GO(page);
+  await GO(page);
+  await expect(page.getByTestId('hop-status')).toHaveText('Hop 6/6: Browser (10.2) rendered 200');
+  await expect(page.getByTestId('cache-stats')).toHaveText('Hits: 1 · Misses: 1 · TTL: 10t');
+
+  const headline = page.getByTestId('compare-headline');
+  await expect(headline).toHaveText('6 vs 6 hops · GET /about vs GET /about');
+  const rows = page.getByTestId('compare-rows');
+  await expect(rows.locator('.compare-row')).toHaveCount(6);
+  // Hop-aligned: hop 1 of both runs is the same emit frame over 10.1, and
+  // equal hop counts render no exhausted-side em-dash anywhere.
+  await expect(rows.locator('.compare-row').first()).toContainText('10.2 -> 10.1 | GET /about');
+  await expect(rows).not.toContainText('—');
+});
+
+test('should show em-dash rows where one run is shorter (9 vs 6)', async ({ page }) => {
+  await page.goto('/panel.html?stage=6');
+  // Warm-↑ MISS: the first cd.example.com/about run pulls the origin and
+  // fills the edge ledger (9 hops) — it fills slot A first.
+  await page.getByTestId('url-input').fill('cd.example.com/about');
+  await GO(page);
+  // A hosted non-CDN run: example.com resolves to 10.1, so the trace rides
+  // the 9-hop hosted shape (slot B).
+  await page.getByTestId('url-input').fill('example.com/about');
+  await GO(page);
+  // The warm HIT run (6 hops, inside the 10t edge TTL) is a third distinct
+  // run: slots shift A <- old B, B <- HIT — a 9-by-6 pair.
+  await page.getByTestId('url-input').fill('cd.example.com/about');
+  await GO(page);
+
+  await expect(page.getByTestId('compare-headline')).toHaveText(
+    '9 vs 6 hops · GET example.com/about vs GET cd.example.com/about',
+  );
+  const rows = page.getByTestId('compare-rows');
+  await expect(rows.locator('.compare-row')).toHaveCount(9);
+  // Rows 1-6 pair real frames (the ask hop names each run's own host);
+  // rows 7-9 read the em-dash on the exhausted right side — nothing drops.
+  await expect(rows.locator('.compare-row').first()).toContainText('who is example.com?');
+  await expect(rows.locator('.compare-row').first()).toContainText('who is cd.example.com?');
+  for (const index of [6, 7, 8]) {
+    await expect(rows.locator('.compare-row').nth(index).locator('.compare-right')).toHaveText('—');
+  }
+});
+
+test('should never compare crowd-tick runs into the tray', async ({ page }) => {
+  await page.goto('/panel.html?stage=1');
+  // Two completed stage-1 trace runs pin the tray at 4-by-4.
+  await GO(page);
+  await GO(page);
+  const headline = page.getByTestId('compare-headline');
+  await expect(headline).toHaveText('4 vs 4 hops · GET /about vs GET /about');
+  const rows = page.getByTestId('compare-rows');
+  await expect(rows.locator('.compare-row')).toHaveCount(4);
+
+  // The crowd runs for several ticks: its tick frames land in the journey
+  // log, but a tick entry must not shift the tray's slots (trace-runs-only).
+  await page.getByTestId('start-button').click();
+  await page.waitForTimeout(700);
+  await page.getByTestId('start-button').click(); // pause, determinism intact
+  await expect(headline).toHaveText('4 vs 4 hops · GET /about vs GET /about');
+  await expect(rows.locator('.compare-row')).toHaveCount(4);
+});
+
+test('should clear the compare tray on a stage switch', async ({ page }) => {
+  await page.goto('/panel.html?stage=6');
+  // MISS fills the edge (9 hops, slot A), the second run HITs (6 hops,
+  // slot B): the pinned pair is 9 vs 6.
+  await page.getByTestId('url-input').fill('cd.example.com/about');
+  await GO(page);
+  await GO(page);
+  await expect(page.getByTestId('compare-headline')).toHaveText(
+    '9 vs 6 hops · GET cd.example.com/about vs GET cd.example.com/about',
+  );
+  await expect(page.getByTestId('compare-tray')).toBeVisible();
+
+  // Counter-example contract: cross-stage shapes are not comparable — the
+  // switch empties the tray with no stale rows and no crash.
+  await page.getByTestId('stage-pill-1').click();
+  await expect(page.getByTestId('compare-tray')).toBeHidden();
+  await expect(page.getByTestId('compare-rows')).toHaveText('');
+});
