+describe('compare tray pure contracts', () => {
+  // Verbatim frame texts — the tray renders these byte-identically.
+  const entry = (hop, text) => ({ run: 1, hop, label: `hop ${hop}/9`, text });
+  const runWith = (run, hops, textOf = (h) => `frame ${h}`) => ({
+    run,
+    hops,
+    entries: Array.from({ length: hops }, (_, i) => entry(i + 1, textOf(i + 1))),
+  });
+  const nine = runWith(1, 9, (h) => `hop ${h} emit frame`);
+  const six = runWith(2, 6, (h) => `hop ${h} warm frame`);
+
+  it('aligns unequal 9-by-6 runs into 9 rows with rows 7-9 reading an em-dash on the right', () => {
+    const rows = alignCompareRows(nine, six);
+    expect(rows).toHaveLength(9);
+    expect(rows.map((row) => row.n)).toEqual([1, 2, 3, 4, 5, 6, 7, 8, 9]);
+    // Rows 1-6 pair hop-for-hop; the shorter run's exhausted side is '—'.
+    expect(rows[0]).toEqual({ n: 1, left: 'hop 1 emit frame', right: 'hop 1 warm frame' });
+    expect(rows[5]).toEqual({ n: 6, left: 'hop 6 emit frame', right: 'hop 6 warm frame' });
+    expect(rows.slice(6).map((row) => [row.left, row.right])).toEqual([
+      ['hop 7 emit frame', '—'],
+      ['hop 8 emit frame', '—'],
+      ['hop 9 emit frame', '—'],
+    ]);
+  });
+
+  it('aligns equal runs hop-for-hop with no em-dash anywhere', () => {
+    const twin = runWith(3, 9, (h) => `hop ${h} twin frame`);
+    const rows = alignCompareRows(nine, twin);
+    expect(rows).toHaveLength(9);
+    for (const row of rows) {
+      expect(row.left).toBe(`hop ${row.n} emit frame`);
+      expect(row.right).toBe(`hop ${row.n} twin frame`);
+      expect(row.left).not.toBe('—');
+      expect(row.right).not.toBe('—');
+    }
+  });
+
+  it('passes entry texts through byte-identically and never mutates the stored runs', () => {
+    const before = JSON.stringify([nine, six]);
+    const rows = alignCompareRows(nine, six);
+    expect(rows.map((row) => row.left)).toEqual(nine.entries.map((e) => e.text));
+    expect(rows.map((row) => row.right)).toEqual([
+      ...six.entries.map((e) => e.text),
+      '—',
+      '—',
+      '—',
+    ]);
+    // Both stored runs are untouched objects: verbatim passthrough only.
+    expect(JSON.stringify([nine, six])).toBe(before);
+  });
+
+  it('fills slot A first, then B with changed:true, then shifts A <- old B on a third run', () => {
+    const a = runWith(11, 9);
+    const b = runWith(12, 6);
+    const c = runWith(13, 9);
+    expect(nextCompareSlots({ a: null, b: null }, a)).toEqual({ a, b: null, changed: true });
+    expect(nextCompareSlots({ a, b: null }, b)).toEqual({ a, b, changed: true });
+    expect(nextCompareSlots({ a, b }, c)).toEqual({ a: b, b: c, changed: true });
+  });
+
+  it('re-pushing a run already in a slot is a no-op (changed:false, slots untouched)', () => {
+    const a = runWith(11, 9);
+    const b = runWith(12, 6);
+    // Same id as either slot: no duplicate, no shift, same pair.
+    expect(nextCompareSlots({ a, b }, b)).toEqual({ a, b, changed: false });
+    expect(nextCompareSlots({ a, b }, a)).toEqual({ a, b, changed: false });
+  });
+
+  it('ignores tick-shaped runs with fewer than 2 hops or no hop entries (trace-runs-only)', () => {
+    // CHECKS: the trace-runs-only counter-example in its machine form — a
+    // crowd tick (shaped { hops: 0 }) and an entries-less run never shift
+    // slots, whatever their run id is.
+    const a = runWith(11, 9);
+    const b = runWith(12, 6);
+    const tick = { run: 99, hops: 0, entries: [] };
+    expect(nextCompareSlots({ a, b }, tick)).toEqual({ a, b, changed: false });
+    expect(nextCompareSlots({ a, b }, { run: 100, hops: 9, entries: [] })).toEqual({
+      a,
+      b,
+      changed: false,
+    });
+    expect(nextCompareSlots({ a: null, b: null }, null)).toEqual({
+      a: null,
+      b: null,
+      changed: false,
+    });
+  });
+
+  it('a stored run keeps its snapshot intact through later pushes (snapshot immunity)', () => {
+    // CHECKS: the snapshot-at-completion counter-example's pure side — the
+    // first stored run keeps its full 9-entry snapshot even after it falls
+    // out of the slot pair (the live journey log may cap-trim meanwhile).
