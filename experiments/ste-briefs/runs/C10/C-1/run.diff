@@ -167,6 +183,40 @@ export function orderJourneyEntries(entries, entry) {
   return ordered;
 }
 
+// PINS: compare rows align by hop index over the taller run; the exhausted
+// side renders '—' and entry texts pass through byte-identically (never
+// minted or rewritten, DL-1). Counter-example: 9-by-6 runs → 9 rows, rows
+// 7-9 right cell '—'; nothing drops (test/panel/model.test.js).
+export function alignCompareRows(left, right) {
+  const total = Math.max(left.hops, right.hops);
+  const rows = [];
+  for (let n = 1; n <= total; n += 1) {
+    rows.push({
+      n,
+      left: left.entries.find((entry) => entry.hop === n)?.text ?? '—',
+      right: right.entries.find((entry) => entry.hop === n)?.text ?? '—',
+    });
+  }
+  return rows;
+}
+
+// PINS: slot allocation for the two most recent completed trace runs.
+// Rejection rule: runs with fewer than 2 hops or no hop entries are
+// ignored — the trace-runs-only counter-example (a crowd tick,
+// `{ hops: 0 }`, never shifts slots). Same-run re-push is a no-op; else
+// first fill A, then B, then shift A <- old B, B <- new. Pure (snapshot
+// immunity). Pinned in model.test.js.
+export function nextCompareSlots(slots, newRun) {
+  const complete =
+    newRun && Array.isArray(newRun.entries) && newRun.entries.length > 0 && (newRun.hops ?? 0) >= 2;
+  if (!complete || slots.a?.run === newRun.run || slots.b?.run === newRun.run) {
+    return { a: slots.a ?? null, b: slots.b ?? null, changed: false };
+  }
+  if (!slots.a) return { a: newRun, b: slots.b ?? null, changed: true };
+  if (!slots.b) return { a: slots.a, b: newRun, changed: true };
+  return { a: slots.b, b: newRun, changed: true };
+}
+
 export function describeSnapshot(snapshot) {
   const stage = snapshot.stage ?? 1;
   const latencyMs = Math.round(snapshot.avgLatencyTicks * TICK_MS);
