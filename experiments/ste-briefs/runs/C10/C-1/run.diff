new file mode 100644
index 0000000..d488ffb
--- /dev/null
+++ b/js/panel/compare.js
@@ -0,0 +1,109 @@
+// DOCUMENTS: the compare tray (DESIGN.md, 2026-10-25) — DOM-bound sibling
+// of render.js inside the existing .log-card. Pure slot allocation and row
+// alignment live in model.js (nextCompareSlots, alignCompareRows); this
+// module owns only the tray's DOM wiring, built JS-side like the stage-6
+// cards (lazy-lookup precedent: renderStage6Hud / stage6-registry.js). The
+// tray renders verbatim journey-log entry texts — minting, rewriting, or
+// summarizing hop frames is out of its scope (AGENTS.md DL-1). panel.js's stepOneHop
+// completion branch and switchStage are the only callers that mutate state.
+import { alignCompareRows, nextCompareSlots } from './model.js';
+
+// The tray's two slot runs, most recent pair only. Each stored run keeps
+// the entry objects copied at completion, so the journey log's later
+// 20-entry cap cannot empty or reorder tray rows (snapshot immunity).
+let slots = { a: null, b: null };
+let tray = null;
+
+// Lazy injection: #compare-tray (headline + rows) appended to the log-card
+// once at boot; every later lookup reuses the captured references.
+function ensureTray() {
+  if (tray) return tray;
+  const logCard = document.querySelector('.log-card');
+  if (!logCard) return null;
+  const el = document.createElement('div');
+  el.id = 'compare-tray';
+  el.className = 'compare-tray';
+  el.setAttribute('data-testid', 'compare-tray');
+  const headline = document.createElement('p');
+  headline.id = 'compare-headline';
+  headline.className = 'compare-headline';
+  headline.setAttribute('data-testid', 'compare-headline');
+  const rows = document.createElement('ol');
+  rows.id = 'compare-rows';
+  rows.className = 'compare-rows';
+  rows.setAttribute('data-testid', 'compare-rows');
+  el.append(headline, rows);
+  logCard.append(el);
+  tray = { el, headline, rows };
+  return tray;
+}
+
+function rowCell(text, extraClass) {
+  const cell = document.createElement('span');
+  cell.className = `compare-cell ${extraClass}`;
+  cell.textContent = text;
+  if (text !== '—') cell.title = text; // full frame readable when ellipsized
+  return cell;
+}
+
+function rowNumber(n) {
+  const cell = document.createElement('span');
+  cell.className = 'compare-n';
+  cell.textContent = String(n);
+  return cell;
+}
+
+// Hidden/incomplete-state rule (chosen consistently): with zero or one
+// stored run the tray renders no rows and stays hidden — no empty-state
+// line, no stale rows after a stage switch.
+function renderCompare() {
+  const view = ensureTray();
+  if (!view) return;
+  const { a, b } = slots;
+  if (!a || !b) {
+    view.el.hidden = true;
+    view.headline.textContent = '';
+    view.rows.replaceChildren();
+    return;
+  }
+  view.el.hidden = false;
+  view.headline.textContent = `${a.hops} vs ${b.hops} hops · ${a.label} vs ${b.label}`;
+  view.rows.replaceChildren(
+    ...alignCompareRows(a, b).map((row) => {
+      const item = document.createElement('li');
+      item.className = 'compare-row';
+      item.append(
+        rowNumber(row.n),
+        rowCell(row.left, 'compare-left'),
+        rowCell(row.right, 'compare-right'),
+      );
+      return item;
+    }),
+  );
+}
+
+// PINS: a completed trace run enters the tray here — panel.js's completion
+// branch is the sole push site, so crowd-tick runs never reach it. The
+// branch arithmetic (first-fill / second-fill / shift / same-run no-op /
+// incomplete-run rejection) is the pure contract in model.js; the DOM side
+// re-renders only when the slot pair actually changed.
+export function pushCompareRun({ run, label, hops, entries }) {
+  const next = nextCompareSlots(slots, { run, label, hops, entries });
+  slots = { a: next.a, b: next.b };
+  renderCompare();
+  return next.changed;
+}
+
+// CHECKS: switching stages empties the tray (cross-stage shapes are not
+// comparable — a stage-6 run beside a stage-1 run would diff unlike
+// stories). Renders the hidden state immediately, no stale rows.
+export function clearCompare() {
+  slots = { a: null, b: null };
+  renderCompare();
+}
+
+// Boot hook (panel.js): injects the tray into the log-card in its hidden
+// initial state so the DOM node exists before the first completed run.
+export function initCompareTray() {
+  renderCompare();
+}
