+    const afterC = nextCompareSlots(afterB, b);
+    expect(afterC.a).toBe(a);
+    const afterD = nextCompareSlots(afterC, c);
+    expect(afterD).toEqual({ a: b, b: c, changed: true });
+    expect(alignCompareRows(a, runWith(24, 9)).map((row) => row.left)).toEqual(
+      Array.from({ length: 9 }, (_, i) => `kept ${i + 1}`),
+    );
+  });
