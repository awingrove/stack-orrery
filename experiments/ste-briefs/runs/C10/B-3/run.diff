@@ -0,0 +1,87 @@
+// DOCUMENTS: compare tray (b5 brief) — auto-pair diff of the two most recent
+// completed trace runs, injected into the existing .log-card because
+// panel.html sits at its 550-line cap (stage6-registry.js / lazy-lookup
+// precedent: the tray's ids are looked up lazily, not eagerly). DOM-only:
+// the pure slot ring and row alignment live in model.js (unit-pinned); this
+// module stores run snapshots and renders rows. Frames are verbatim
+// journey-log entry texts; minting or rewriting hop frames is a defect
+// (DL-1/DL-3). No inline handlers or styles (AGENTS.md CSP rule); content
+// goes through textContent only.
+import { alignCompareRows, nextCompareSlots } from './model.js';
+
+let slots = { a: null, b: null };
+let tray = null;
+let headline = null;
+let rows = null;
+
+// CHECKS: the tray injects once at panel boot into the current .log-card
+// (after #journey-log); calling init again must not duplicate it.
+export function initCompareTray() {
+  if (tray) return;
+  const card = document.querySelector('.log-card');
+  if (!card) return;
+  tray = document.createElement('section');
+  tray.id = 'compare-tray';
+  tray.className = 'compare-tray';
+  tray.dataset.testid = 'compare-tray';
+  headline = document.createElement('p');
+  headline.id = 'compare-headline';
+  headline.className = 'compare-headline';
+  headline.dataset.testid = 'compare-headline';
+  rows = document.createElement('ol');
+  rows.id = 'compare-rows';
+  rows.className = 'compare-rows';
+  rows.dataset.testid = 'compare-rows';
+  tray.append(headline, rows);
+  card.append(tray);
+  renderTray();
+}
+
+// CHECKS: the sole push site is panel.js's stepOneHop completion branch (the
+// same branch that calls relabelJourneyRun) — crowd ticks log through
+// addToJourney and never reach this call, so tick runs cannot shift the
+// slots. Zero or one stored run renders NO tray (hidden — the hidden/
+// incomplete-state rule, one consistent choice).
+export function pushCompareRun({ run, label, hops, entries }) {
+  const next = nextCompareSlots(slots, { run, label, hops, entries });
+  if (!next.changed) return;
+  slots = next;
+  renderTray();
+}
+
+// CHECKS: switchStage empties the tray — cross-stage shapes are not
+// comparable, so the slots reset and the tray hides again.
+export function clearCompare() {
+  slots = { a: null, b: null };
+  renderTray();
+}
+
+function renderTray() {
+  if (!tray) return;
+  const pair = slots.a && slots.b;
+  tray.hidden = !pair;
+  headline.textContent = pair
+    ? // Headline text is the brief's contract: `<left> vs <right> hops ·
+      // <left label> vs <right label>`.
+      `${slots.a.hops} vs ${slots.b.hops} hops · ${slots.a.label} vs ${slots.b.label}`
+    : '';
+  rows.replaceChildren();
+  if (!pair) return;
+  rows.replaceChildren(
+    ...alignCompareRows(slots.a, slots.b).map((row) => {
+      const li = document.createElement('li');
+      li.className = 'compare-row';
+      const n = document.createElement('span');
+      n.className = 'compare-n';
+      n.textContent = String(row.n);
+      const left = document.createElement('span');
+      left.className = 'compare-left';
+      left.textContent = row.left;
+      const right = document.createElement('span');
+      right.className = 'compare-right';
+      right.textContent = row.right;
+      li.append(n, left, right);
+      return li;
+    }),
+  );
+}
