+++ b/js/panel/model.js
@@ -167,6 +167,45 @@ export function orderJourneyEntries(entries, entry) {
   return ordered;
 }
 
+// --- Compare tray pure contracts (b5 brief) — DOM-free, unit-pinned. ------
+
+// PINS: hop-aligned diff rows over max(left.hops, right.hops); the exhausted
+// side reads the em-dash and nothing drops — a 9-by-6 pair yields exactly 9
+// rows with rows 7-9 right cell `—` (named counter-example, pinned in
+// test/panel/model.test.js). Both sides' texts pass through verbatim: the
+// tray renders journey-log entry texts, it never mints or rewrites hop
+// frames (DL-1/DL-3).
+export function alignCompareRows(left, right) {
+  const rows = [];
+  for (let i = 0; i < Math.max(left.hops, right.hops); i += 1) {
+    rows.push({
+      n: i + 1,
+      left: i < left.entries.length ? left.entries[i].text : '—',
+      right: i < right.entries.length ? right.entries[i].text : '—',
+    });
+  }
+  return rows;
+}
+
+// PINS: the compare-tray slot ring (a = older, b = newest of the two most
+// recent completed runs). First push fills A; a second distinct run fills B;
+// a third shifts A <- old B, B <- new. A run equal to the right slot's run
+// id is a no-op (changed: false — the tray does not duplicate a run). A run
+// with hops < 2 or no hop entries is IGNORED — the trace-runs-only rule:
+// a tick-shaped run { hops: 0 } must never enter the slots (named
+// counter-example, pinned in test/panel/model.test.js).
+export function nextCompareSlots(slots, newRun) {
+  const ignored =
+    !newRun || !newRun.entries || newRun.entries.length === 0 || (newRun.hops ?? 0) < 2;
+  if (ignored || (slots.b && slots.b.run === newRun.run)) {
+    return { a: slots.a, b: slots.b, changed: false };
+  }
+  const stored = { ...newRun, entries: newRun.entries.map((entry) => ({ ...entry })) };
+  if (!slots.a) return { a: stored, b: slots.b, changed: true };
+  if (!slots.b) return { a: slots.a, b: stored, changed: true };
+  return { a: slots.b, b: stored, changed: true };
+}
+
 export function describeSnapshot(snapshot) {
   const stage = snapshot.stage ?? 1;
   const latencyMs = Math.round(snapshot.avgLatencyTicks * TICK_MS);
