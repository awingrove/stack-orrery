@@ -0,0 +1,117 @@
+import { test, expect } from '@playwright/test';
+
+// Compare tray (b5 brief): the tray lives in the real .log-card and
+// compares the two most recent completed trace runs hop-by-hop with
+// verbatim journey-log texts. Hops are stepped on the real controls; the
+// hop counts below are the trace shapes pinned by the sim specs (stage 3 =
+// 6 hops; stage 6 hosted = 9, CDN edge HIT = 6).
+
+const HOP = async (page) => page.getByTestId('btn-next-hop').click();
+const tray = (page) => page.getByTestId('compare-tray');
+const rowCells = (page) => page.getByTestId('compare-rows').locator('.compare-row').locator('span');
+
+test('should compare the last two trace runs hop-by-hop in the compare tray', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-3').click();
+  // The tray is JS-built into the existing log-card at boot.
+  await expect(page.locator('.log-card #compare-tray')).toHaveCount(1);
+  // Hidden/incomplete-state rule: zero or one stored run renders no tray.
+  await expect(tray(page)).toBeHidden();
+
+  // Run 1: the cold cache lookup MISSes and warms Cache 10.20.
+  await page.getByTestId('url-input').fill('/about');
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  await expect(page.getByTestId('hop-status')).toContainText('Hop 6/6');
+  await expect(tray(page)).toBeHidden(); // one run alone compares nothing
+
+  // Run 2: round-robin moves to 10.12; the shared entry answers a warm HIT.
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  await expect(page.getByTestId('cache-stats')).toHaveText('Hits: 1 · Misses: 1 · TTL: 10t');
+
+  await expect(tray(page)).toBeVisible();
+  await expect(page.getByTestId('compare-headline')).toHaveText('6 vs 6 hops · /about vs /about');
+  const rows = page.getByTestId('compare-rows').locator('.compare-row');
+  await expect(rows).toHaveCount(6);
+  // Row texts are the runs' own journey-log frames, verbatim: hop 4 is the
+  // cache-check hop, and it is exactly where MISS and HIT differ.
+  await expect(rows.nth(3).locator('.compare-left')).toHaveText(
+    '10.11 -> 10.20 | cache MISS (/about)',
+  );
+  await expect(rows.nth(3).locator('.compare-right')).toHaveText(
+    '10.12 -> 10.20 | cache HIT (/about)',
+  );
+  // Equal runs leave no em-dash cells anywhere.
+  await expect(rowCells(page).filter({ hasText: '—' })).toHaveCount(0);
+});
+
+test('should show em-dash rows where one run is shorter (9 vs 6)', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-6').click();
+
+  // Run 1: the first cd.example.com trace MISSes and fills the edge (9 hops).
+  await page.getByTestId('url-input').fill('cd.example.com/about');
+  for (let hop = 0; hop < 9; hop++) await HOP(page);
+  await expect(page.getByTestId('hop-status')).toContainText('Hop 9/9');
+
+  // Run 2: a hosted subnet-10 path rides the DNS prelude + stage-5 chain
+  // (9 hops). Slots: cd-MISS, example.com.
+  await page.getByTestId('url-input').fill('example.com/about');
+  for (let hop = 0; hop < 9; hop++) await HOP(page);
+  await expect(page.getByTestId('hop-status')).toContainText('Hop 9/9');
+
+  // Run 3: a warm GET inside the edge TTL is the 6-hop HIT shape; the shift
+  // leaves example.com (9) as the left side and the cd HIT (6) as the right.
+  await page.getByTestId('url-input').fill('cd.example.com/about');
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  await expect(page.getByTestId('hop-status')).toContainText('Hop 6/6');
+
+  await expect(tray(page)).toBeVisible();
+  await expect(page.getByTestId('compare-headline')).toHaveText(
+    '9 vs 6 hops · example.com/about vs cd.example.com/about',
+  );
+  const rows = page.getByTestId('compare-rows').locator('.compare-row');
+  await expect(rows).toHaveCount(9); // nothing drops
+  await expect(rows.nth(5).locator('.compare-right')).not.toHaveText('—');
+  // The exhausted side reads the em-dash on rows 7-9 (named counter-example).
+  for (const i of [6, 7, 8]) {
+    await expect(rows.nth(i).locator('.compare-right')).toHaveText('—');
+    await expect(rows.nth(i).locator('.compare-left')).not.toHaveText('—');
+  }
+});
+
+test('should never compare crowd-tick runs into the tray', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('url-input').fill('/about');
+  for (let hop = 0; hop < 4; hop++) await HOP(page);
+  for (let hop = 0; hop < 4; hop++) await HOP(page);
+
+  await expect(tray(page)).toBeVisible();
+  const headlineBefore = await page.getByTestId('compare-headline').textContent();
+  const rowsBefore = await page.getByTestId('compare-rows').innerHTML();
+
+  // Crowd ticks join #journey-log as their own runs but must not shift the
+  // tray's slots — the sole push site is the trace completion branch.
+  await page.getByTestId('start-button').click();
+  await page.waitForTimeout(600);
+  await page.getByTestId('start-button').click(); // pause
+  await expect(page.getByTestId('journey-log')).toContainText(/tick \d+ ·/);
+
+  await expect(page.getByTestId('compare-headline')).toHaveText(headlineBefore);
+  await expect(page.getByTestId('compare-rows').innerHTML()).resolves.toBe(rowsBefore);
+});
+
+test('should clear the compare tray on a stage switch', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-3').click();
+  await page.getByTestId('url-input').fill('/about');
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  await expect(tray(page)).toBeVisible();
+  await expect(page.getByTestId('compare-rows').locator('.compare-row')).toHaveCount(6);
+
+  // Cross-stage shapes are not comparable: the slots reset, no stale rows.
+  await page.getByTestId('stage-pill-1').click();
+  await expect(tray(page)).toBeHidden();
+  await expect(page.getByTestId('compare-rows')).toHaveText('');
+  await expect(page.getByTestId('compare-headline')).toHaveText('');
+});
