--- /dev/null
+++ b/e2e/compare.spec.js
@@ -0,0 +1,124 @@
+import { test, expect } from '@playwright/test';
+
+// B-5 compare tray (auto-pair diff of the two most recent completed trace
+// runs), asserted on the real page — the tray reads the panel's real logged
+// entries; no doubles. The sim runs from a fixed seed, so the hop shapes are
+// identical on every run: stage 3 traces are 6 hops each (MISS then HIT over
+// the shared cache); stage 6 hosted traces are 9 hops, a warm edge HIT 6.
+// The tray hides while the pair is incomplete and holds verbatim journey-log
+// entry texts (no minted hop frames).
+
+const HOP = async (page) => page.getByTestId('btn-next-hop').click();
+
+test('should compare the last two trace runs hop-by-hop in the compare tray', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-3').click();
+
+  // One stored run is an incomplete pair — the tray stays hidden.
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  await expect(page.getByTestId('compare-tray')).toBeHidden();
+  await expect(page.getByTestId('compare-rows')).toHaveText('');
+
+  // The second completed run completes the pair: the tray opens on the
+  // auto-paired MISS/HIT runs, hop-aligned 6 by 6.
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  await expect(page.getByTestId('compare-tray')).toBeVisible();
+  await expect(page.getByTestId('compare-headline')).toHaveText(
+    '6 vs 6 hops · GET /about vs GET /about',
+  );
+  const rows = page.getByTestId('compare-rows').locator('.compare-row');
+  await expect(rows).toHaveCount(6);
+  // Verbatim frames from the runs' own journey entries (emit hop first; the
+  // render hop carries the last wire frame, as the live log does).
+  await expect(rows.nth(0).locator('.compare-left')).toHaveText('10.2 -> 10.1 | GET /about');
+  await expect(rows.nth(0).locator('.compare-right')).toHaveText('10.2 -> 10.1 | GET /about');
+  await expect(rows.nth(3).locator('.compare-left')).toContainText('cache MISS');
+  await expect(rows.nth(3).locator('.compare-right')).toContainText('cache HIT');
+  await expect(rows.nth(4).locator('.compare-left')).toContainText(
+    '200 This is the about page (MISS)',
+  );
+  await expect(rows.nth(4).locator('.compare-right')).toContainText(
+    '200 This is the about page (HIT)',
+  );
+  await expect(rows.nth(5).locator('.compare-right')).not.toHaveText('—');
+
+  // Snapshot immunity: two more full runs push the live journey log past its
+  // 20-entry cap, yet the tray still shows all aligned rows of its stored pair.
+  for (let hop = 0; hop < 12; hop++) await HOP(page);
+  await expect(page.getByTestId('compare-headline')).toHaveText(
+    '6 vs 6 hops · GET /about vs GET /about',
+  );
+  await expect(rows).toHaveCount(6);
+  await expect(rows.nth(0).locator('.compare-left')).toHaveText('10.2 -> 10.1 | GET /about');
+});
+
+test('should show em-dash rows where one run is shorter (9 vs 6)', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-6').click();
+
+  // Warm-up edge MISS over cd.example.com/about (9 hops): it fills the edge
+  // ledger and is then displaced out of the tray by the next runs.
+  await page.getByTestId('url-input').fill('cd.example.com/about');
+  for (let hop = 0; hop < 9; hop++) await HOP(page);
+
+  // Run A: the hosted subnet-10 trace — the full 9-hop shape.
+  await page.getByTestId('url-input').fill('example.com/about');
+  for (let hop = 0; hop < 9; hop++) await HOP(page);
+  await expect(page.getByTestId('hop-status')).toContainText('Hop 9/9');
+
+  // Run B: a warm edge HIT — 6 hops. The pair reads 9 vs 6.
+  await page.getByTestId('url-input').fill('cd.example.com/about');
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  await expect(page.getByTestId('hop-status')).toContainText('Hop 6/6');
+
+  await expect(page.getByTestId('compare-headline')).toHaveText(
+    '9 vs 6 hops · GET example.com/about vs GET cd.example.com/about',
+  );
+  const rows = page.getByTestId('compare-rows').locator('.compare-row');
+  await expect(rows).toHaveCount(9);
+  // The exhausted side renders the em-dash in rows 7-9; nothing drops.
+  for (const index of [6, 7, 8]) {
+    await expect(rows.nth(index).locator('.compare-empty')).toHaveText('—');
+    await expect(rows.nth(index).locator('.compare-left')).not.toHaveText('—');
+  }
+  await expect(rows.nth(0).locator('.compare-left')).toHaveText(
+    '10.2 -> 10.60 | who is example.com?',
+  );
+  await expect(rows.nth(1).locator('.compare-right')).toHaveText('10.60 -> 10.2 | 20.1');
+  await expect(rows.nth(3).locator('.compare-right')).toContainText('edge HIT');
+});
+
+// CHECKS: the named counter-example — crowd ticks never enter the tray.
+test('should never compare crowd-tick runs into the tray', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-3').click();
+  for (let hop = 0; hop < 12; hop++) await HOP(page); // two completed runs
+
+  const headline = page.getByTestId('compare-headline');
+  const rows = page.getByTestId('compare-rows').locator('.compare-row');
+  await expect(headline).toHaveText('6 vs 6 hops · GET /about vs GET /about');
+  const rowCount = await rows.count();
+  expect(rowCount).toBe(6);
+
+  // Start the crowd: several tick entries flow into #journey-log — none of
+  // them may shift the stored pair.
+  await page.getByTestId('start-button').click();
+  await expect(page.getByTestId('journey-log')).toContainText(/tick \d+/);
+  await page.getByTestId('start-button').click(); // pause
+  await expect(headline).toHaveText('6 vs 6 hops · GET /about vs GET /about');
+  await expect(rows).toHaveCount(rowCount);
+});
+
+test('should clear the compare tray on a stage switch', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-3').click();
+  for (let hop = 0; hop < 12; hop++) await HOP(page); // pair pinned
+  await expect(page.getByTestId('compare-tray')).toBeVisible();
+
+  // Cross-stage shapes are not comparable: the tray empties — no stale
+  // rows, no crash.
+  await page.getByTestId('stage-pill-1').click();
+  await expect(page.getByTestId('compare-tray')).toBeHidden();
+  await expect(page.getByTestId('compare-headline')).toHaveText('');
+  await expect(page.getByTestId('compare-rows')).toHaveText('');
+});
diff --git a/js/panel/compare.js b/js/panel/compare.js
new file mode 100644
index 0000000..23ce1a5
--- /dev/null
+++ b/js/panel/compare.js
@@ -0,0 +1,115 @@
+// DOCUMENTS: the compare tray (B-5 brief) — a JS-built auto-pair diff inside
+// the existing .log-card (no static markup; the page sits at its 550-line
+// cap). It compares the two most recent completed trace runs, hop-aligned,
+// with verbatim journey-log entry texts: the tray renders no minted,
+// rewritten, or summarized hop frames (DL-1/DL-3). Pure slot/align logic
+// lives in model.js (unit-pinned); this module is DOM-bound only, on the
+// lazy-lookup precedent of renderDnsHud / stage6-registry.js — no innerHTML,
+// no inline handlers or styles (AGENTS.md CSP rule).
+import { alignCompareRows, nextCompareSlots } from './model.js';
+import { getRunEntries } from './render.js';
+
+// CHECKS: hidden while the pair is incomplete (zero or one stored run) — the
+// chosen consistent state is `hidden`, not an empty-state line; clearCompare
+// returns the tray to the same hidden state.
+let slots = { a: null, b: null };
+let injected = false;
+
+// CHECKS: the tray's snapshot at completion stores COPIES of the run's entry
+// objects, so later JOURNEY_CAP trims and relabels of the live journey log
+// can never empty or reorder the tray rows (named counter-example: after
+// three more full trace runs the tray still shows all rows of its two stored
+// runs — pinned in e2e/compare.spec.js).
+function renderTray() {
+  const tray = document.getElementById('compare-tray');
+  if (!tray) return;
+  const headline = tray.querySelector('#compare-headline');
+  const rows = tray.querySelector('#compare-rows');
+  if (!slots.a || !slots.b) {
+    tray.hidden = true;
+    headline.textContent = '';
+    rows.replaceChildren();
+    return;
+  }
+  tray.hidden = false;
+  headline.textContent = `${slots.a.hops} vs ${slots.b.hops} hops · ${slots.a.label} vs ${slots.b.label}`;
+  rows.replaceChildren(
+    ...alignCompareRows(slots.a, slots.b).map(({ n, left, right }) => {
+      const item = document.createElement('li');
+      item.className = 'compare-row';
+      for (const [cell, text] of [
+        ['compare-n', String(n)],
+        ['compare-cell compare-left', left],
+        ['compare-cell compare-right', right],
+      ]) {
+        const span = document.createElement('span');
+        span.className = text === '—' ? `${cell} compare-empty` : cell;
+        span.textContent = text;
+        item.append(span);
+      }
+      return item;
+    }),
+  );
+}
+
+// CHECKS: the tray renders the run's OWN entry texts — every cell is a
+// stored entry's text or the em-dash for an exhausted side (alignCompareRows
+// never invents one). The completion snapshot is taken HERE (the tray's
+// caller owns the completion branch, not the entry assembly): the label is
+// the run's own request descriptor from the trace snapshot (trace.js /
+// trace-stage6.js ground the path/host fields — no URL-input fallback) and
+// the entries are getRunEntries(run), hop-ascending.
+export function pushCompareRun(snapshot, run) {
+  const entries = getRunEntries(run);
+  if (entries.length === 0) return;
+  const newRun = {
+    run,
+    label: compareRunLabel(snapshot?.trace),
+    hops: entries.length,
+    entries: entries.map((entry) => ({ ...entry })),
+  };
+  const next = nextCompareSlots(slots, newRun);
+  if (!next.changed) return;
+  slots = { a: next.a, b: next.b };
+  renderTray();
+}
+
+export function clearCompare() {
+  slots = { a: null, b: null };
+  renderTray();
+}
+
+// CHECKS: the run label is the run's own request descriptor from the trace
+// snapshot — method + typed path; stage 6 hosted runs carry the host in a
+// separate field (trace-stage6.js), so it rejoins here (`GET
+// example.com/about`), host-less runs read `GET /about` verbatim.
+export function compareRunLabel(trace) {
+  if (!trace) return '';
+  return trace.host
+    ? `${trace.method} ${trace.host}${trace.path}`
+    : `${trace.method} ${trace.path}`;
+}
+
+// Boot injection (called from panel.js): the tray joins the existing
+// .log-card after the journey log, hidden until a full pair exists.
+export function initCompareTray() {
+  if (injected) return;
+  injected = true;
+  const card = document.querySelector('.log-card');
+  if (!card) return;
+  const tray = document.createElement('div');
+  tray.id = 'compare-tray';
+  tray.dataset.testid = 'compare-tray';
+  tray.className = 'compare-tray';
+  const headline = document.createElement('p');
+  headline.id = 'compare-headline';
+  headline.dataset.testid = 'compare-headline';
+  headline.className = 'compare-headline';
+  const rows = document.createElement('ol');
+  rows.id = 'compare-rows';
+  rows.dataset.testid = 'compare-rows';
+  rows.className = 'compare-rows';
+  tray.append(headline, rows);
+  card.append(tray);
+  renderTray();
+}
diff --git a/js/panel/model.js b/js/panel/model.js
index 297e340..26c9151 100644
--- a/js/panel/model.js
+++ b/js/panel/model.js
@@ -167,6 +167,43 @@ export function orderJourneyEntries(entries, entry) {
   return ordered;
 }
 
+// PINS: compare-tray alignment (B-5) — rows align by hop index over
+// max(left.hops, right.hops); an exhausted side renders the em-dash, never a
+// minted summary (DL-1/DL-3: the tray renders verbatim journey-log texts).
+// Named counter-example: 9-by-6 runs produce 9 rows with the em-dash in the
+// right cell of rows 7-9; nothing drops. Entry texts pass through untouched.
+export function alignCompareRows(left, right) {
+  const total = Math.max(left.hops, right.hops);
+  const rows = [];
+  for (let i = 0; i < total; i += 1) {
+    rows.push({
+      n: i + 1,
+      left: left.entries[i]?.text ?? '—',
+      right: right.entries[i]?.text ?? '—',
+    });
+  }
+  return rows;
+}
+
+// CHECKS: compare-tray slot branch (B-5). A distinct run fills A first, then
+// B; a third distinct run shifts A <- old B, B <- new. Re-pushing the current
+// right slot's run id is a no-op (the tray does not duplicate). A run with
+// fewer than 2 hops or no hop entries is ignored — a crowd tick's
+// tick-shaped run must never shift the pair (named counter-example, pinned
+// in test/panel/model.test.js).
+export function nextCompareSlots(slots, newRun) {
+  const entries = Array.isArray(newRun?.entries) ? newRun.entries : [];
+  if ((newRun?.hops ?? entries.length) < 2 || entries.length < 2) {
+    return { a: slots.a, b: slots.b, changed: false };
+  }
+  if (slots.b && newRun.run === slots.b.run) {
+    return { a: slots.a, b: slots.b, changed: false };
+  }
+  if (!slots.a) return { a: newRun, b: slots.b, changed: true };
+  if (!slots.b) return { a: slots.a, b: newRun, changed: true };
+  return { a: slots.b, b: newRun, changed: true };
+}
+
 export function describeSnapshot(snapshot) {
   const stage = snapshot.stage ?? 1;
   const latencyMs = Math.round(snapshot.avgLatencyTicks * TICK_MS);
