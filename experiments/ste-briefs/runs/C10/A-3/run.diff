@@ -0,0 +1,141 @@
+import { test, expect } from '@playwright/test';
+
+// B-5 compare tray (2026-10-25 brief): the tray diffs the two most recent
+// completed trace runs, hop-aligned, with em-dash cells where one run
+// ended sooner. Every cell is a verbatim journey-log entry text from the
+// snapshot taken at the run's completion — the tray does not mint hop
+// frames. Crowd ticks do not enter (a tick has no completion branch), and a
+// stage switch clears the tray. All assertions read the real page.
+
+const HOP = async (page) => page.getByTestId('btn-next-hop').click();
+
+// Stage 3: the first 6-hop trace misses Cache 10.20 (round-robin -> 10.11)
+// and the second hits it (-> 10.12) — a 6-by-6 pair whose hop-4 cells
+// genuinely differ, so the diff is the cache story itself.
+test('should compare the last two trace runs hop-by-hop in the compare tray', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-3').click();
+  await expect(page.getByTestId('node-cache')).toBeVisible();
+
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+
+  await expect(page.getByTestId('compare-tray')).toBeVisible();
+  await expect(page.getByTestId('compare-headline')).toHaveText('6 vs 6 hops · /about vs /about');
+  const rows = page.getByTestId('compare-rows');
+  await expect(rows.locator('.compare-row')).toHaveCount(6);
+  // Verbatim passthrough: the tray cells are the runs' own journey-log
+  // entry texts — no `hop n/m` labels, no rewritten frames.
+  await expect(rows.locator('.compare-row').first()).toContainText('10.2 -> 10.1 | GET /about');
+  // The aligned diff teaches the cache story: row 4 is MISS on the left,
+  // HIT on the right (10.11 warmed, 10.12 served from the shared entry).
+  await expect(rows.locator('.compare-row').nth(3)).toContainText('10.11 -> 10.20 | cache MISS');
+  await expect(rows.locator('.compare-row').nth(3)).toContainText('10.12 -> 10.20 | cache HIT');
+});
+
+// Stage 6: a warm-up MISS fills the edge, then example.com/about (9 hops)
+// runs, then the warm cd.example.com/about HIT ends in 6 hops — the stored
+// pair is 9 vs 6, so rows 7-9 render em-dashes on the shorter side and
+// nothing drops.
+test('should show em-dash rows where one run is shorter (9 vs 6)', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-6').click();
+  await expect(page.getByTestId('node-cdn')).toBeVisible();
+
+  await page.getByTestId('url-input').fill('cd.example.com/about');
+  for (let hop = 0; hop < 9; hop++) await HOP(page); // warm-up MISS fills the edge
+  await page.getByTestId('url-input').fill('example.com/about');
+  for (let hop = 0; hop < 9; hop++) await HOP(page);
+  await page.getByTestId('url-input').fill('cd.example.com/about');
+  for (let hop = 0; hop < 6; hop++) await HOP(page); // edge HIT inside the TTL
+
+  await expect(page.getByTestId('compare-headline')).toHaveText(
+    '9 vs 6 hops · example.com/about vs cd.example.com/about',
+  );
+  const rows = page.getByTestId('compare-rows');
+  await expect(rows.locator('.compare-row')).toHaveCount(9);
+  // Rows 7-9: the 6-hop HIT run ended at its browser render, so the right
+  // cells are em-dashes while the left side keeps its own frame texts.
+  for (const n of [7, 8, 9]) {
+    const row = rows.locator('.compare-row').nth(n - 1);
+    await expect(row.locator('.compare-right')).toHaveText('—');
+    await expect(row.locator('.compare-left')).not.toHaveText('—');
+  }
+  // The alignment itself is verbatim: row 7's left cell is the hosted
+  // run's own network delivery frame.
+  await expect(rows.locator('.compare-row').nth(6).locator('.compare-left')).toHaveText(
+    'Network delivered 200 response to 10.2',
+  );
+});
+
+// Named counter-example (trace-runs-only): a crowd tick has no completion
+// branch, so starting the crowd after two traces ran must leave the tray
+// showing exactly those two stored runs — no shifting, no new rows.
+test('should never compare crowd-tick runs into the tray', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-3').click();
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+
+  const headline = page.getByTestId('compare-headline');
+  await expect(headline).toHaveText('6 vs 6 hops · /about vs /about');
+  const headlineText = await headline.textContent();
+
+  await page.getByTestId('start-button').click();
+  await page.waitForTimeout(1200); // several crowd ticks land in the journey log
+  await page.getByTestId('start-button').click(); // pause
+
+  await expect(headline).toHaveText(headlineText);
+  await expect(page.getByTestId('compare-rows').locator('.compare-row')).toHaveCount(6);
+});
+
+// Named counter-example (stage-switch-clears): pinned stage runs, switch
+// stage — the tray renders empty (no stale rows, no crash), because
+// cross-stage shapes are not comparable.
+test('should clear the compare tray on a stage switch', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-3').click();
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  await expect(page.getByTestId('compare-tray')).toBeVisible();
+  await expect(page.getByTestId('compare-rows').locator('.compare-row')).toHaveCount(6);
+
+  await page.getByTestId('stage-pill-1').click();
+
+  await expect(page.getByTestId('compare-tray')).toBeHidden();
+  await expect(page.getByTestId('compare-rows')).toHaveText('');
+});
+
+// Named counter-example (snapshot-at-completion): the crowd floods the live
+// journey log past its 20-entry cap, so the second stored run's entries are
+// trimmed out of the log entirely — the tray still shows every row of both
+// stored runs, because the slots hold the copies taken at each completion.
+test('should keep both stored runs fully rendered after the journey log trims them', async ({
+  page,
+}) => {
+  await page.goto('/panel.html');
+  for (let hop = 0; hop < 4; hop++) await HOP(page);
+  for (let hop = 0; hop < 4; hop++) await HOP(page);
+  await expect(page.getByTestId('compare-headline')).toHaveText('4 vs 4 hops · /about vs /about');
+
+  // 25 crowd ticks flood the log: the 20-entry cap leaves only tick
+  // entries, and the trace runs' entries are gone from the live log.
+  await page.getByTestId('start-button').click();
+  await page.waitForTimeout(2500);
+  await page.getByTestId('start-button').click();
+  await expect(page.getByTestId('journey-log').locator('.journey-entry')).toHaveCount(20);
+
+  // The next completion pushes a third distinct run: the stored run 2
+  // (already trimmed from the log) stays whole on the left, the new run
+  // lands on the right — 4 aligned rows, every cell verbatim.
+  for (let hop = 0; hop < 4; hop++) await HOP(page);
+  await expect(page.getByTestId('compare-headline')).toHaveText('4 vs 4 hops · /about vs /about');
+  const rows = page.getByTestId('compare-rows');
+  await expect(rows.locator('.compare-row')).toHaveCount(4);
+  await expect(rows.locator('.compare-row').first().locator('.compare-left')).toContainText(
+    '10.2 -> 10.1 | GET /about',
+  );
+  await expect(rows.locator('.compare-row').first().locator('.compare-right')).toContainText(
+    '10.2 -> 10.1 | GET /about',
+  );
+});
diff --git a/js/panel/compare.js b/js/panel/compare.js
new file mode 100644
index 0000000..14fa806
--- /dev/null
+++ b/js/panel/compare.js
@@ -0,0 +1,108 @@
+// DOCUMENTS: the compare tray (B-5) — a JS-built auto-pair diff inside the
+// log-card (no static markup). It shows the two most recent
+// completed trace runs hop-aligned with a `9 vs 6 hops · <left> vs <right>`
+// headline; every cell is a verbatim journey-log entry text from the
+// snapshot taken at the run's completion (render.js getRunEntries), so the
+// tray does not mint, rewrite, or summarize hop frames (DL-1/DL-3). The
+// slot shift/no-op/reject branches and the row alignment are pure model.js
+// contracts (nextCompareSlots / alignCompareRows); this module owns the
+// DOM only, reading the panel's real logged entries — no proxy doubles.
+import { alignCompareRows, nextCompareSlots } from './model.js';
+
+// CHECKS: the label is the run's own request descriptor from the trace
+// snapshot — `host + path` when the run is hosted (Stage 6 DNS shapes),
+// the path alone otherwise — both fields are grounded in trace.js /
+// trace-stage6.js freshTrace, so the tray never falls back to the URL
+// input's current value (a later edit would mislabel a stored run).
+function compareLabel(trace) {
+  if (!trace || typeof trace.path !== 'string') return '';
+  return trace.host ? `${trace.host}${trace.path}` : trace.path;
+}
+
+let slots = { a: null, b: null };
+let tray = null;
+let headline = null;
+let rows = null;
+
+// Lazy-lookup precedent (renderDnsHud / stage-6 cards): the tray injects
+// itself into the existing log-card once at panel boot, before any run can
+// complete, so every later lookup resolves.
+export function initCompareTray() {
+  if (tray) return;
+  const logCard = document.querySelector('.log-card');
+  tray = document.createElement('div');
+  tray.id = 'compare-tray';
+  tray.setAttribute('data-testid', 'compare-tray');
+  headline = document.createElement('p');
+  headline.id = 'compare-headline';
+  headline.className = 'compare-headline';
+  headline.setAttribute('data-testid', 'compare-headline');
+  rows = document.createElement('ol');
+  rows.id = 'compare-rows';
+  rows.className = 'compare-rows';
+  rows.setAttribute('data-testid', 'compare-rows');
+  tray.append(headline, rows);
+  if (logCard) logCard.append(tray);
+  renderTray();
+}
+
+// CHECKS: completion is the only push site (panel.js stepOneHop's final-hop
+// branch) — a crowd tick has no completion branch and never reaches the
+// slots. The run record `{ run, hops, label, entries }` is handed to the
+// pure nextCompareSlots, then the tray re-renders from its own stored
+// slots: later JOURNEY_CAP trims of the live log must not empty or reorder
+// these rows.
+export function pushCompareRun({ run, hops, trace, entries }) {
+  const result = nextCompareSlots(slots, {
+    run,
+    hops,
+    label: compareLabel(trace),
+    entries,
+  });
+  slots = { a: result.a, b: result.b };
+  renderTray();
+  return result.changed;
+}
+
+// CHECKS: a stage switch empties the tray — cross-stage shapes are not
+// comparable (named counter-example: pinned stage runs, switch stage, the
+// tray renders empty, no stale rows, no crash).
+export function clearCompare() {
+  slots = { a: null, b: null };
+  renderTray();
+}
+
+// CHECKS: zero or one stored run is an incomplete pair — the tray renders
+// hidden with no rows at all (not an empty-state line), so a lone trace
+// run never shows a self-comparison. Consistent pick per brief B-5.
+function renderTray() {
+  if (!tray) return;
+  const { a, b } = slots;
+  if (!a || !b) {
+    tray.hidden = true;
+    headline.textContent = '';
+    rows.replaceChildren();
+    return;
+  }
+  tray.hidden = false;
+  headline.textContent = `${a.hops} vs ${b.hops} hops · ${a.label} vs ${b.label}`;
+  rows.replaceChildren(
+    ...alignCompareRows(a, b).map((row) => {
+      const item = document.createElement('li');
+      item.className = 'compare-row';
+      const n = document.createElement('span');
+      n.className = 'compare-n';
+      n.textContent = String(row.n);
+      const left = document.createElement('span');
+      left.className = 'compare-left';
+      left.textContent = row.left;
+      left.title = row.left;
+      const right = document.createElement('span');
+      right.className = 'compare-right';
+      right.textContent = row.right;
+      right.title = row.right;
+      item.append(n, left, right);
+      return item;
+    }),
+  );
+}
