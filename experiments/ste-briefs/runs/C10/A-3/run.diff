@@ -167,6 +167,46 @@ export function orderJourneyEntries(entries, entry) {
   return ordered;
 }
 
+// B-5 compare tray — pure slot/align contracts. compare.js (DOM-bound)
+// consumes these; the branches stay here so the unit suite pins them and the
+// DOM side only renders their result.
+
+// PINS: alignment rows are hop-indexed over max(left.hops, right.hops); each
+// side's cell is that hop's own entry text or the em-dash once the run
+// ended — nothing drops, texts pass through byte-identical and are read,
+// never mutated (compare never mints hop text, DL-1/DL-3). Named
+// counter-example (pinned in test/panel/model.test.js): 9-by-6 runs produce
+// 9 rows with rows 7-9 right cells '—'.
+export function alignCompareRows(left, right) {
+  const rows = [];
+  for (let n = 1; n <= Math.max(left.hops, right.hops); n += 1) {
+    rows.push({
+      n,
+      left: left.entries.find((entry) => entry.hop === n)?.text ?? '—',
+      right: right.entries.find((entry) => entry.hop === n)?.text ?? '—',
+    });
+  }
+  return rows;
+}
+
+// CHECKS: the slot branch — a run enters only with hops >= 2 and at least
+// one hop entry, so a tick-shaped run (`{ hops: 0 }`) is rejected here
+// (the trace-runs-only counter-example's purity pin: crowd ticks must not
+// shift slots). A run whose id matches an occupied slot is a no-op (the
+// tray does not duplicate); otherwise the first push fills A then B and a
+// third distinct run shifts A <- old B, B <- new.
+export function nextCompareSlots(slots, newRun) {
+  if (!newRun || newRun.hops < 2 || !Array.isArray(newRun.entries) || newRun.entries.length === 0) {
+    return { a: slots.a, b: slots.b, changed: false };
+  }
+  if (slots.a?.run === newRun.run || slots.b?.run === newRun.run) {
+    return { a: slots.a, b: slots.b, changed: false };
+  }
+  if (!slots.a) return { a: newRun, b: slots.b, changed: true };
+  if (!slots.b) return { a: slots.a, b: newRun, changed: true };
+  return { a: slots.b, b: newRun, changed: true };
+}
+
 export function describeSnapshot(snapshot) {
   const stage = snapshot.stage ?? 1;
   const latencyMs = Math.round(snapshot.avgLatencyTicks * TICK_MS);
