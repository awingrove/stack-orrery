@@ -0,0 +1,125 @@
+import { test, expect } from '@playwright/test';
+
+// Compare tray (b5 brief): the tray auto-pairs the two most recent
+// completed trace runs, hop-aligned, em-dash where one side ended sooner,
+// verbatim journey-log frames. Crowd ticks are excluded from the pair; a
+// stage switch clears. All assertions read the real panel's injected tray —
+// the pure slot/alignment logic is unit-pinned in test/panel/model.test.js.
+
+const HOP = async (page) => page.getByTestId('btn-next-hop').click();
+
+test('should compare the last two trace runs hop-by-hop in the compare tray', async ({ page }) => {
+  await page.goto('/panel.html');
+  // Stage 3: the trace shape is 6 hops; a cold /about MISS warms Cache
+  // 10.20 and the next run serves a shared HIT (6 vs 6, grounded — stage 3
+  // traces stay at 6 hops).
+  await page.getByTestId('stage-pill-3').click();
+  await page.getByTestId('url-input').fill('/about');
+
+  // Before the pair is complete the tray renders nothing (hidden rule).
+  await expect(page.getByTestId('compare-tray')).toBeHidden();
+
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  await expect(page.getByTestId('hop-status')).toHaveText('Hop 6/6: Browser (10.2) rendered 200');
+  // One stored run is still an incomplete pair: hidden, not half-rendered.
+  await expect(page.getByTestId('compare-tray')).toBeHidden();
+
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  await expect(page.getByTestId('compare-tray')).toBeVisible();
+  await expect(page.getByTestId('compare-headline')).toHaveText(
+    '6 vs 6 hops · GET /about vs GET /about',
+  );
+  const rows = page.getByTestId('compare-rows').locator('.compare-row');
+  await expect(rows).toHaveCount(6);
+  // The diff shows the mechanism, verbatim: hop 4 is the cache check the
+  // two runs actually took (cold MISS on 10.11, warm HIT on 10.12).
+  await expect(rows.nth(3).locator('.compare-left')).toHaveText(
+    '10.11 -> 10.20 | cache MISS (/about)',
+  );
+  await expect(rows.nth(3).locator('.compare-right')).toHaveText(
+    '10.12 -> 10.20 | cache HIT (/about)',
+  );
+});
+
+test('should show em-dash rows where one run is shorter (9 vs 6)', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-6').click();
+
+  // Run 1: the first cd.example.com trace MISSes the empty edge and fills
+  // it (9 hops).
+  await page.getByTestId('url-input').fill('cd.example.com/about');
+  for (let hop = 0; hop < 9; hop++) await HOP(page);
+
+  // Run 2: a hosted example.com trace rides the DNS prelude into the
+  // stage-5 chain — 9 hops (grounded: traceFinalHop host branch).
+  await page.getByTestId('url-input').fill('example.com/about');
+  for (let hop = 0; hop < 9; hop++) await HOP(page);
+  // A hosted run's last hop is the stage-5 worker tail (s5=7), not the
+  // render (the render landed at hop 8).
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 9/9: Worker (10.41) idle — no async jobs in this trace',
+  );
+
+  // Run 3: cd.example.com again — inside the fill's TTL the edge serves a
+  // HIT in 6 hops, shifting the pair to the 9-by-6 diff.
+  await page.getByTestId('url-input').fill('cd.example.com/about');
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  await expect(page.getByTestId('hop-status')).toHaveText(
+    'Hop 6/6: Browser (10.2) received and displayed 200',
+  );
+
+  await expect(page.getByTestId('compare-headline')).toHaveText(
+    '9 vs 6 hops · GET example.com/about vs GET cd.example.com/about',
+  );
+  const rows = page.getByTestId('compare-rows').locator('.compare-row');
+  await expect(rows).toHaveCount(9);
+  // The left run's first hop is the DNS ask, verbatim.
+  await expect(rows.nth(0).locator('.compare-left')).toHaveText(
+    '10.2 -> 10.60 | who is example.com?',
+  );
+  // Named counter-example (brief): rows 7-9 — the 6-hop HIT ended sooner;
+  // the exhausted right side renders the em-dash, nothing drops.
+  for (const index of [6, 7, 8]) {
+    await expect(rows.nth(index).locator('.compare-right')).toHaveText('—');
+  }
+  await expect(rows.nth(5).locator('.compare-right')).not.toHaveText('—');
+});
+
+test('should never compare crowd-tick runs into the tray', async ({ page }) => {
+  await page.goto('/panel.html');
+  // Two stage-1 trace runs pin the pair (4 vs 4 hops).
+  await page.getByTestId('url-input').fill('/about');
+  for (let run = 0; run < 2; run++) {
+    for (let hop = 0; hop < 4; hop++) await HOP(page);
+  }
+  await expect(page.getByTestId('compare-tray')).toBeVisible();
+  const headline = await page.getByTestId('compare-headline').textContent();
+  expect(headline).toBe('4 vs 4 hops · GET /about vs GET /about');
+  const rowCount = await page.getByTestId('compare-rows').locator('.compare-row').count();
+  expect(rowCount).toBe(4);
+
+  // Start the crowd: tick runs enter the journey log, but a tick entry
+  // must not shift the tray slots — the headline and rows stay exactly
+  // the two stored trace runs.
+  await page.getByTestId('start-button').click();
+  await page.waitForTimeout(600);
+  await expect(page.getByTestId('compare-headline')).toHaveText(headline);
+  await expect(page.getByTestId('compare-rows').locator('.compare-row')).toHaveCount(rowCount);
+  await page.getByTestId('start-button').click(); // pause
+});
+
+test('should clear the compare tray on a stage switch', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('url-input').fill('/about');
+  for (let run = 0; run < 2; run++) {
+    for (let hop = 0; hop < 4; hop++) await HOP(page);
+  }
+  await expect(page.getByTestId('compare-tray')).toBeVisible();
+
+  // Cross-stage shapes are not comparable: the switch empties the tray —
+  // no stale rows, no crash.
+  await page.getByTestId('stage-pill-2').click();
+  await expect(page.getByTestId('compare-tray')).toBeHidden();
+  await expect(page.getByTestId('compare-rows')).toHaveText('');
+  await expect(page.getByTestId('compare-headline')).toHaveText('');
+});
