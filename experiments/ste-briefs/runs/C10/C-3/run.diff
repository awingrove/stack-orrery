+// Compare-tray contracts (b5): the pure slot/alignment logic compare.js
+// renders. Runs carry { run, label, hops, entries } — entries are the run's
+// own journey-log entries (hop-ascending), texts verbatim frames.
+describe('compare tray contracts', () => {
+  const makeRun = (run, hopTexts, label = 'GET /about') => ({
+    run,
+    label,
+    hops: hopTexts.length,
+    entries: hopTexts.map((text, i) => ({
+      run,
+      hop: i + 1,
+      label: `hop ${i + 1}/${hopTexts.length}`,
+      text,
+    })),
+  });
+  const nine = Array.from({ length: 9 }, (_, i) => `left frame ${i + 1}`);
+  const six = Array.from({ length: 6 }, (_, i) => `right frame ${i + 1}`);
+
+  it('aligns unequal 9-by-6 runs into 9 rows with em-dashes on the exhausted right side', () => {
+    const rows = alignCompareRows(makeRun(1, nine), makeRun(2, six));
+    expect(rows).toHaveLength(9);
+    expect(rows.map((r) => r.n)).toEqual([1, 2, 3, 4, 5, 6, 7, 8, 9]);
+    expect(rows[0]).toEqual({ n: 1, left: 'left frame 1', right: 'right frame 1' });
+    expect(rows[5].right).toBe('right frame 6');
+    // Named counter-example (brief): rows 7-9 — the right run ended sooner;
+    // nothing drops and no fabricated frame is minted.
+    for (const row of rows.slice(6)) expect(row.right).toBe('—');
+    expect(rows[8].left).toBe('left frame 9');
+  });
+
+  it('aligns equal runs hop-for-hop with no em-dash rows', () => {
+    const rows = alignCompareRows(makeRun(1, six), makeRun(2, six, 'GET /warm'));
+    expect(rows).toHaveLength(6);
+    for (const row of rows) {
+      expect(row.left).not.toBe('—');
+      expect(row.right).not.toBe('—');
+    }
+    expect(rows[3].right).toBe('right frame 4');
+  });
+
+  it('passes entry texts through verbatim without mutating the stored runs', () => {
+    const left = makeRun(1, nine);
+    const right = makeRun(2, six);
+    const leftBefore = left.entries.map((e) => e.text);
+    const rightBefore = right.entries.map((e) => e.text);
+    const rows = alignCompareRows(left, right);
+    // Byte-identical passthrough on both sides.
+    expect(rows.map((r) => r.left)).toEqual(leftBefore);
+    expect(rows.slice(0, 6).map((r) => r.right)).toEqual(rightBefore);
+    // The stored runs are untouched (no mutation, no rewrite — DL-1/DL-3).
+    expect(left.entries.map((e) => e.text)).toEqual(leftBefore);
+    expect(right.entries.map((e) => e.text)).toEqual(rightBefore);
+    expect(left.hops).toBe(9);
+    expect(right.hops).toBe(6);
+  });
+
+  it('fills slot A on the first push, slot B on the second, and shifts A<-old B / B<-new on the third', () => {
+    let slots = { a: null, b: null };
+    const first = makeRun(1, six);
+    const second = makeRun(2, six, 'GET /warm');
+    const third = makeRun(3, nine, 'GET /cold');
+    slots = nextCompareSlots(slots, first);
+    expect(slots).toEqual({ a: first, b: null, changed: true });
+    slots = nextCompareSlots(slots, second);
+    expect(slots).toEqual({ a: first, b: second, changed: true });
+    slots = nextCompareSlots(slots, third);
+    // The third distinct run shifts the pair; the old B survives as A.
+    expect(slots).toEqual({ a: second, b: third, changed: true });
+  });
+
+  it('re-pushing a stored run is a no-op — changed:false and the slots stay untouched', () => {
+    const first = makeRun(1, six);
+    const second = makeRun(2, six, 'GET /warm');
+    let slots = nextCompareSlots({ a: null, b: null }, first);
+    slots = nextCompareSlots(slots, second);
+    // Named counter-example (brief): a completed run equal to the right
+    // slot's run id must not duplicate or shift.
+    const repushed = nextCompareSlots(slots, { ...second });
+    expect(repushed).toEqual({ a: first, b: second, changed: false });
+    // The same holds for the left slot (a) — the tray does not duplicate.
+    expect(nextCompareSlots(slots, { ...first })).toEqual({
+      a: first,
+      b: second,
+      changed: false,
+    });
+  });
+
+  it('ignores tick-shaped runs with fewer than two hop entries (the trace-runs-only rule)', () => {
+    const first = makeRun(1, six);
+    const second = makeRun(2, six, 'GET /warm');
+    const slots = nextCompareSlots(nextCompareSlots({ a: null, b: null }, first), second);
+    // A crowd tick run is `{ hops: 0 }` with no hop entries: rejected.
+    const tick = { run: 99, label: 'tick 7', hops: 0, entries: [] };
+    expect(nextCompareSlots(slots, tick)).toEqual({ a: first, b: second, changed: false });
+    // A single-entry run cannot be a trace run either (traces take >= 4).
+    const oneHop = { run: 100, label: 'GET /x', hops: 1, entries: [{ text: 'frame' }] };
+    expect(nextCompareSlots(slots, oneHop)).toEqual({ a: first, b: second, changed: false });
+    // A null/shapeless push is ignored, not a crash.
+    expect(nextCompareSlots(slots, null)).toEqual({ a: first, b: second, changed: false });
+  });
+});
