new file mode 100644
index 0000000..f57b2fb
--- /dev/null
+++ b/js/panel/compare.js
@@ -0,0 +1,89 @@
+// DOCUMENTS: compare tray (b5) — auto-pair diff of the two most recent
+// completed trace runs, injected into the existing .log-card at boot (the
+// JS-built-injection precedent of renderDnsHud / stage6-registry.js: no
+// static markup, no panel.html growth). The slot and alignment logic is the
+// pure contract in model-compare.js; this module owns the DOM wiring only,
+// and the tray renders verbatim journey-log entry texts only — no minted or
+// rewritten hop frames (DL-1/DL-3). Hidden/incomplete rule: with zero or one
+// stored run the tray renders nothing (hidden attribute) — the choice is
+// consistent on push, clear, and boot.
+import { alignCompareRows, nextCompareSlots } from './model-compare.js';
+
+export { compareRunLabel } from './model-compare.js';
+
+let slots = { a: null, b: null };
+let tray = null;
+
+// CHECKS: the tray's stored run is a snapshot — entries are copied at
+// completion (getRunEntries), so later JOURNEY_CAP trims of the live log
+// cannot empty or reorder the tray rows. A re-pushed run whose id matches a
+// stored slot does not duplicate (nextCompareSlots no-op).
+export function pushCompareRun(run) {
+  const next = nextCompareSlots(slots, run);
+  slots = { a: next.a, b: next.b };
+  if (next.changed) renderCompare();
+}
+
+// CHECKS: a stage switch empties the tray — cross-stage shapes are not
+// comparable (brief branch contract; pinned by e2e/compare.spec.js).
+export function clearCompare() {
+  slots = { a: null, b: null };
+  renderCompare();
+}
+
+// Boot injection: the tray appends to the static .log-card; a re-init (the
+// module runs once per page load) must not mint a second tray.
+export function initCompareTray() {
+  if (tray || document.getElementById('compare-tray')) return;
+  const logCard = document.querySelector('.log-card');
+  if (!logCard) return;
+  tray = document.createElement('section');
+  tray.id = 'compare-tray';
+  tray.dataset.testid = 'compare-tray';
+  tray.className = 'compare-tray';
+  tray.hidden = true;
+  const headline = document.createElement('h3');
+  headline.id = 'compare-headline';
+  headline.dataset.testid = 'compare-headline';
+  headline.className = 'compare-headline';
+  const rows = document.createElement('ol');
+  rows.id = 'compare-rows';
+  rows.dataset.testid = 'compare-rows';
+  rows.className = 'compare-rows';
+  tray.append(headline, rows);
+  logCard.append(tray);
+}
+
+function renderCompare() {
+  const headline = tray?.querySelector('#compare-headline');
+  const rows = tray?.querySelector('#compare-rows');
+  if (!headline || !rows) return;
+  // Hidden/incomplete-state rule: zero or one stored run renders nothing.
+  if (!slots.a || !slots.b) {
+    tray.hidden = true;
+    headline.textContent = '';
+    rows.replaceChildren();
+    return;
+  }
+  tray.hidden = false;
+  headline.textContent = `${slots.a.hops} vs ${slots.b.hops} hops · ${slots.a.label} vs ${slots.b.label}`;
+  rows.replaceChildren(
+    ...alignCompareRows(slots.a, slots.b).map((row) => {
+      const item = document.createElement('li');
+      item.className = 'compare-row';
+      const n = document.createElement('span');
+      n.className = 'compare-n';
+      n.textContent = String(row.n);
+      const left = document.createElement('span');
+      left.className = 'compare-left';
+      left.textContent = row.left;
+      left.title = row.left;
+      const right = document.createElement('span');
+      right.className = 'compare-right';
+      right.textContent = row.right;
+      right.title = row.right;
+      item.append(n, left, right);
+      return item;
+    }),
+  );
+}
diff --git a/js/panel/model-compare.js b/js/panel/model-compare.js
new file mode 100644
index 0000000..2ab521e
--- /dev/null
+++ b/js/panel/model-compare.js
@@ -0,0 +1,51 @@
+// DOCUMENTS: compare-tray pure contracts (b5) — split from model.js by
+// responsibility (guard-file-size; model.js keeps the journey/snapshot
+// label contracts). No DOM here: compare.js owns the tray wiring, and the
+// tray renders verbatim journey-log entry texts — it mints no hop frames
+// (DL-1/DL-3).
+
+// PINS: compare-tray alignment — rows align by hop index over
+// max(left.hops, right.hops); the exhausted side renders the em-dash and
+// nothing drops. Each cell is that hop's entry `text` verbatim; texts pass
+// through byte-identical and the stored runs are left unmutated.
+export function alignCompareRows(left, right) {
+  const rows = [];
+  const total = Math.max(left.hops, right.hops);
+  for (let n = 1; n <= total; n += 1) {
+    rows.push({
+      n,
+      left: left.entries[n - 1]?.text ?? '—',
+      right: right.entries[n - 1]?.text ?? '—',
+    });
+  }
+  return rows;
+}
+
+// PINS: compare-tray slot allocation — pure; compare.js owns the DOM side.
+// Branch conditions: a run enters only with at least two hop entries (a
+// crowd tick carries none — `{ hops: 0 }` is rejected here, the
+// trace-runs-only rule); a run whose id matches a stored slot is a no-op;
+// otherwise an empty A fills first, then B, and a third distinct run
+// shifts A <- old B, B <- new.
+export function nextCompareSlots(slots, newRun) {
+  if (!newRun || !Array.isArray(newRun.entries) || newRun.entries.length < 2) {
+    return { a: slots.a, b: slots.b, changed: false };
+  }
+  if (slots.a?.run === newRun.run || slots.b?.run === newRun.run) {
+    return { a: slots.a, b: slots.b, changed: false };
+  }
+  if (!slots.a) return { a: newRun, b: slots.b, changed: true };
+  if (!slots.b) return { a: slots.a, b: newRun, changed: true };
+  return { a: slots.b, b: newRun, changed: true };
+}
+
+// CHECKS: the tray's run label is the run's own request descriptor from the
+// trace snapshot (grounded: trace.js stages 1-5 carry `request` = "GET
+// <path>"; trace-stage6.js re-points `request` at the resource path after
+// the DNS answer, so a hosted run rebuilds host + path from the trace's own
+// `host`/`path`/`method` fields). The URL input is not consulted anywhere.
+export function compareRunLabel(trace) {
+  if (!trace) return 'unknown request';
+  if (trace.host) return `${trace.method} ${trace.host}${trace.path}`;
+  return trace.request;
+}
