new file mode 100644
index 0000000..8fa64ae
--- /dev/null
+++ b/js/panel/compare.js
@@ -0,0 +1,113 @@
+// DOCUMENTS: compare tray (B-5) — DOM-bound module inside the log-card. Pure
+// slot/align logic lives in model.js (nextCompareSlots, alignCompareRows);
+// this module owns the DOM only: it stores verbatim copies of a run's
+// journey entries, taken at completion (immune to the journey-log cap),
+// renders the hop-aligned rows, and mints no hop text of its own
+// (DL-1/DL-3). Engine-free: no sim imports, DOM reads and model calls only.
+// CHECKS: pushCompareRun is called only from panel.js's completion branch
+// and clearCompare only from switchStage — crowd ticks cannot reach here,
+// and a run joins with its own entry snapshot (the named counter-examples
+// are pinned in e2e/compare.spec.js).
+import { alignCompareRows, nextCompareSlots } from './model.js';
+
+const slots = { a: null, b: null };
+let tray = null;
+let headline = null;
+let rows = null;
+
+export function initCompareTray() {
+  if (tray) return;
+  const logCard = document.querySelector('.log-card');
+  if (!logCard) return;
+  tray = document.createElement('div');
+  tray.id = 'compare-tray';
+  tray.dataset.testid = 'compare-tray';
+  tray.className = 'compare-tray';
+  headline = document.createElement('p');
+  headline.id = 'compare-headline';
+  headline.dataset.testid = 'compare-headline';
+  headline.className = 'compare-headline';
+  rows = document.createElement('ol');
+  rows.id = 'compare-rows';
+  rows.dataset.testid = 'compare-rows';
+  tray.append(headline, rows);
+  logCard.append(tray);
+  renderCompare();
+}
+
+function renderCompare() {
+  if (!tray) return;
+  const { a, b } = slots;
+  // CHECKS: hidden while the pair is incomplete or empty — fewer than two
+  // stored runs render no rows at all (the tray's one consistent state for
+  // the hidden/incomplete rule; the stage-switch e2e pin reads it).
+  tray.hidden = !(a && b);
+  if (!a || !b) {
+    headline.textContent = '';
+    rows.replaceChildren();
+    return;
+  }
+  headline.textContent = `${a.hops} vs ${b.hops} hops · ${a.label} vs ${b.label}`;
+  rows.replaceChildren(
+    ...alignCompareRows(a, b).map((row) => {
+      const li = document.createElement('li');
+      li.className = 'compare-row';
+      const n = document.createElement('span');
+      n.className = 'compare-n';
+      n.textContent = String(row.n);
+      const left = document.createElement('span');
+      left.className = 'compare-cell';
+      left.textContent = row.left;
+      const right = document.createElement('span');
+      right.className = `compare-cell${row.right === '—' ? ' exhausted' : ''}`;
+      right.textContent = row.right;
+      li.append(n, left, right);
+      return li;
+    }),
+  );
+}
+
+// CHECKS: entries arrive raw from render.js's getRunEntries and are stored
+// as verbatim copies — later journey-log trims, relabels, or crowd ticks
+// reorder the live log without touching these rows (snapshot-at-completion
+// contract; the run id keys the no-op/duplicate rule in model.js).
+export function pushCompareRun({ run, trace, entries }) {
+  if (!tray || !Array.isArray(entries) || entries.length === 0) return;
+  const label = labelFromTrace(trace) ?? fallbackLabel();
+  const next = nextCompareSlots(slots, {
+    run,
+    label,
+    hops: entries.length,
+    entries: entries.map((entry) => ({ ...entry })),
+  });
+  slots.a = next.a;
+  slots.b = next.b;
+  renderCompare();
+}
+
+// The run's own request descriptor: stages 1-5 and host-less stage-6 traces
+// carry `request` verbatim; a hosted stage-6 trace re-points `request` at
+// the resolved resource path at the answer hop, so the typed descriptor is
+// rebuilt from the trace's own host/path fields (trace-stage6.js).
+function labelFromTrace(trace) {
+  if (!trace) return null;
+  if (trace.host && typeof trace.path === 'string') {
+    return `${trace.method ?? 'GET'} ${trace.host}${trace.path}`;
+  }
+  return typeof trace.request === 'string' ? trace.request : null;
+}
+
+// URL-input fallback (brief-reported decision): snapshot.trace carries
+// request/path/host on every real trace, so this reads only when a trace
+// field is absent — the input values are the ones live at completion time.
+function fallbackLabel() {
+  const method = document.getElementById('req-method');
+  const input = document.getElementById('url-input');
+  return `${method?.value ?? 'GET'} ${input?.value ?? ''}`.trim();
+}
+
+export function clearCompare() {
+  slots.a = null;
+  slots.b = null;
+  renderCompare();
+}
