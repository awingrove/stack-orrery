+// PINS: compare-tray slot machine (pure; the DOM side lives in compare.js).
+// A run enters only from panel.js's completion branch; crowd ticks cannot
+// call it, and a tick-shaped run (`{ hops: 0 }`) is rejected here as well —
+// runs with fewer than 2 hop entries are ignored, leaving both slots and
+// the changed flag untouched (named counter-example pinned in
+// test/panel/model.test.js).
+export function nextCompareSlots(slots, newRun) {
+  const valid =
+    newRun && newRun.hops >= 2 && Array.isArray(newRun.entries) && newRun.entries.length > 0;
+  if (!valid) return { ...slots, changed: false };
+  if (newRun.run === slots.a?.run || newRun.run === slots.b?.run) {
+    return { a: slots.a, b: slots.b, changed: false };
+  }
+  if (!slots.a) return { a: newRun, b: slots.b ?? null, changed: true };
+  if (!slots.b) return { a: slots.a, b: newRun, changed: true };
+  return { a: slots.b, b: newRun, changed: true };
+}
+
+// PINS: hop-aligned compare rows over max(left.hops, right.hops); the
+// exhausted side renders the em-dash (the 9-by-6 counter-example pins rows
+// 7-9 right = '—') and every cell is the stored entry's own text,
+// byte-for-byte — alignment reads, it never mutates or rewrites (verbatim
+// journey-log contract, DL-1/DL-3).
+export function alignCompareRows(left, right) {
+  const total = Math.max(left.hops, right.hops);
+  const rows = [];
+  for (let n = 1; n <= total; n += 1) {
+    rows.push({
+      n,
+      left: left.entries[n - 1]?.text ?? '—',
+      right: right.entries[n - 1]?.text ?? '—',
+    });
+  }
+  return rows;
+}
+
 export function describeSnapshot(snapshot) {
   const stage = snapshot.stage ?? 1;
   const latencyMs = Math.round(snapshot.avgLatencyTicks * TICK_MS);
