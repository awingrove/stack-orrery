+  it('a third distinct run shifts A <- old B and B <- new', () => {
+    const first = runOf(1, 6);
+    const second = runOf(2, 9);
+    const third = runOf(3, 4);
+    const after = nextCompareSlots({ a: first, b: second }, third);
+    expect(after).toEqual({ a: second, b: third, changed: true });
+  });
+
+  it('a same-run re-push is a no-op with changed false and slots unchanged', () => {
+    const first = runOf(1, 6);
+    const second = runOf(2, 9);
+    const slots = { a: first, b: second };
+    // The right slot's own run id (the tray does not duplicate a run).
+    expect(nextCompareSlots(slots, runOf(2, 9))).toEqual({ a: first, b: second, changed: false });
+    // The left slot's run id is a no-op too.
+    expect(nextCompareSlots(slots, runOf(1, 6))).toEqual({ a: first, b: second, changed: false });
+  });
+
+  it('a tick-shaped run with no hop entries is rejected — slots untouched', () => {
+    // Named counter-example: crowd ticks (`addToJourney('tick …', { run })`)
+    // cannot reach the tray, and a tick-shaped run fed here changes nothing.
+    const first = runOf(1, 6);
+    const second = runOf(2, 9);
+    const slots = { a: first, b: second };
+    const tickRun = { run: 3, label: 'tick 5', hops: 0, entries: [] };
+    expect(nextCompareSlots(slots, tickRun)).toEqual({ a: first, b: second, changed: false });
+    // The hops < 2 rule is the same rejection: a one-entry run is ignored.
+    expect(nextCompareSlots(slots, runOf(4, 1))).toEqual({ a: first, b: second, changed: false });
+  });
+});
