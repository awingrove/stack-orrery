index 0000000..21e2a8b
--- /dev/null
+++ b/e2e/compare.spec.js
@@ -0,0 +1,131 @@
+import { test, expect } from '@playwright/test';
+
+// Compare tray (B-5): the auto-pair diff of the two most recent completed
+// trace runs, asserted on the real page served by the real static server.
+// The tray reads the panel's real journey-log entries (no doubles), so every
+// cell text below is grounded in the sim's own frames: stage 3 traces are 6
+// hops (trace.js), and the stage-6b CDN shapes are 9 hops (MISS/pull) vs 6
+// (warm HIT) — cdn-chain.js. Crowd ticks (`addToJourney('tick …', { run })`)
+// cannot reach the push site (panel.js's completion branch only).
+
+const HOP = async (page) => page.getByTestId('btn-next-hop').click();
+
+// Stage 3 grounds the pair: run 1 (round-robin -> 10.11) MISSes the cold
+// cache, run 2 (-> 10.12) serves a warm HIT; both runs are 6 hops. The
+// grounded path is the plain '/about' — a hosted 'example.com/about' has no
+// DNS stage here, 404s, and cannot warm the cache (no MISS→HIT story).
+test('should compare the last two trace runs hop-by-hop in the compare tray', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-3').click();
+  await page.getByTestId('url-input').fill('/about');
+
+  // One completed run is an incomplete pair: the tray stays hidden.
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  const tray = page.getByTestId('compare-tray');
+  await expect(tray).toBeHidden();
+
+  // The second completed run pairs with the first: 6 vs 6, rows aligned by
+  // hop over the run's own stored entries.
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  await expect(tray).toBeVisible();
+  await expect(page.getByTestId('compare-headline')).toHaveText(
+    '6 vs 6 hops · GET /about vs GET /about',
+  );
+  const rowList = tray.getByTestId('compare-rows');
+  const rows = rowList.locator('.compare-row');
+  await expect(rows).toHaveCount(6);
+  // Row 1 is the run's own hop-1 frame, verbatim from the journey log.
+  await expect(rows.nth(0).locator('.compare-cell').first()).toHaveText(
+    '10.2 -> 10.1 | GET /about',
+  );
+  // The two runs really differ where the cache story differs: hop 4 is the
+  // backend's cache-aside lookup — MISS on the cold run, HIT on the warm one.
+  await expect(rows.nth(3)).toContainText('cache MISS (/about)');
+  await expect(rows.nth(3)).toContainText('cache HIT (/about)');
+});
+
+// Stage 6b grounds the em-dash: the first cd.example.com/about run MISSes
+// and pulls the origin (9 hops, filling the edge); the second rides the
+// warm ledger (6 hops). Rows align over max(9, 6) — rows 7-9 right = '—'.
+test('should show em-dash rows where one run is shorter (9 vs 6)', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-6').click();
+  await page.getByTestId('url-input').fill('cd.example.com/about');
+
+  for (let hop = 0; hop < 9; hop++) await HOP(page); // MISS: fills the edge
+  for (let hop = 0; hop < 6; hop++) await HOP(page); // warm HIT: 6 hops
+
+  await expect(page.getByTestId('compare-headline')).toHaveText(
+    '9 vs 6 hops · GET cd.example.com/about vs GET cd.example.com/about',
+  );
+  const rows = page.getByTestId('compare-rows').locator('.compare-row');
+  await expect(rows).toHaveCount(9);
+  // Rows 7-9: the HIT run has ended — right cell is the em-dash, left keeps
+  // the MISS run's frames (nothing drops).
+  for (const i of [6, 7, 8]) {
+    await expect(rows.nth(i).locator('.compare-cell.exhausted')).toHaveText('—');
+    await expect(rows.nth(i).locator('.compare-cell').first()).not.toHaveText('—');
+  }
+  // The runs really differ at hop 4: the edge's MISS vs its warm HIT frame.
+  await expect(rows.nth(3)).toContainText('MISS — pulling origin 10.1 via router');
+  await expect(rows.nth(3)).toContainText('edge HIT');
+});
+
+// Counter-example (trace-runs-only): crowd ticks are their own journey runs
+// but cannot enter the tray — the stored pair stays byte-identical while the
+// journey log fills with tick entries.
+test('should never compare crowd-tick runs into the tray', async ({ page }) => {
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-3').click();
+  await page.getByTestId('url-input').fill('example.com/about');
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+
+  const beforeHeadline = await page.getByTestId('compare-headline').textContent();
+  const beforeRows = await page
+    .getByTestId('compare-rows')
+    .locator('.compare-row')
+    .allTextContents();
+
+  await page.getByTestId('start-button').click(); // crowd runs, ticks log
+  await expect
+    .poll(async () => page.getByTestId('journey-log').locator('.journey-entry').count(), {
+      timeout: 10_000,
+    })
+    .toBeGreaterThan(12);
+  await page.getByTestId('start-button').click(); // pause keeps state
+
+  // The crowd really produced tick runs in the journey log…
+  await expect(
+    page.getByTestId('journey-log').locator('.journey-entry').filter({ hasText: /^tick/ }),
+  ).not.toHaveCount(0);
+  // …and the tray still shows exactly the two trace runs, rows unchanged.
+  await expect(page.getByTestId('compare-headline')).toHaveText(beforeHeadline);
+  const afterRows = await page
+    .getByTestId('compare-rows')
+    .locator('.compare-row')
+    .allTextContents();
+  expect(afterRows).toEqual(beforeRows);
+});
+
+// Counter-example (stage switch clears): two pinned stage-3 runs, one pill
+// click — the tray renders empty (no stale rows, no crash).
+test('should clear the compare tray on a stage switch', async ({ page }) => {
+  const errors = [];
+  page.on('pageerror', (error) => errors.push(error));
+  page.on('console', (msg) => {
+    if (msg.type() === 'error') errors.push(msg.text());
+  });
+  await page.goto('/panel.html');
+  await page.getByTestId('stage-pill-3').click();
+  await page.getByTestId('url-input').fill('example.com/about');
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  for (let hop = 0; hop < 6; hop++) await HOP(page);
+  await expect(page.getByTestId('compare-tray')).toBeVisible();
+
+  await page.getByTestId('stage-pill-1').click();
+  await expect(page.getByTestId('compare-tray')).toBeHidden();
+  await expect(page.getByTestId('compare-rows')).toHaveText('');
+  await expect(page.getByTestId('compare-headline')).toHaveText('');
+  expect(errors).toEqual([]);
+});
