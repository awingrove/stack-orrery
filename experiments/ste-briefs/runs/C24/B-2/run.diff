diff --git a/test/sim/pool-truth.test.js b/test/sim/pool-truth.test.js
new file mode 100644
index 0000000..3eca04c
--- /dev/null
+++ b/test/sim/pool-truth.test.js
@@ -0,0 +1,24 @@
+// CHECKS: the top-level `primaryQueue` / `primaryFiles` keys name the pool's
+// primary backend (finding 1-06, Stage R2c) — a 10.12-side fs edit lands only
+// in servers[1].files while the primary view stays backend 10.11's, and the
+// solo stage-1 backend IS the primary (one backend, one shape, no aggregate).
+import { describe, it, expect } from 'vitest';
+import { createEngine } from '../../js/sim/engine.js';
+
+describe('engine snapshot pool truth', () => {
+  it("the primary shape names itself — 'primaryQueue' / 'primaryFiles' - the pool's primary-backend story, not an aggregate", () => {
+    const pool = createEngine({ seed: 42, stage: 2 });
+    pool.setWebFile('10.12', '/about', 'New body');
+    const snap = pool.snapshot();
+    expect(snap.primaryFiles['/about']).toBe('This is the about page');
+    expect(snap.primaryQueue).toEqual([]);
+    expect(snap.servers[1].files['/about']).toBe('New body');
+    expect(snap.servers[0].files['/about']).toBe('This is the about page');
+
+    const solo = createEngine({ seed: 42, stage: 1 });
+    solo.setWebFile('10.1', '/about', 'New body');
+    const soloSnap = solo.snapshot();
+    expect(soloSnap.primaryFiles['/about']).toBe('New body');
+    expect(soloSnap.servers[0].files['/about']).toBe('New body');
+  });
+});
