+// place (same seam discipline as the other helpers) and no engine closure
+// is taken.
+// CHECKS: the branch conditions are the LB record's own — an all-down pool
+// returns the refusal record, the trace gains refused = true, onRefusal is
+// offered the record, and the frame narrates the refusal card (no [object
+// Object] target, nothing enqueued, no served data); a one-down pool
+// narrates the crossed seat in the enqueued frame ("— <ip> is down —
+// skipped"); a both-up pool keeps the clean byte shape ("LB ... queued").
+// Returns { frame, refused } so the caller can branch without re-reading
+// the record.
+export function lbEnqueueHop(trace, { serverAddress, lb, bumpTick, onRefusal }) {
+  const atTick = bumpTick();
+  const target = lb.enqueue({
+    id: `you:${atTick}`,
+    from: trace.from,
+    to: serverAddress,
+    request: trace.request,
+    atTick,
+    isYou: true,
+  });
+  if (target?.refused === true) {
+    trace.refused = true;
+    onRefusal?.(target);
+    return { frame: lbRefusedFrame(serverAddress, target, trace.request), refused: true };
+  }
+  trace.targetServer = target;
+  return {
+    frame: lbEnqueuedFrame(serverAddress, target, trace.request, lb.lastSkip?.()),
+    refused: false,
+  };
+}
