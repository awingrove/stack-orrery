@@ -146,6 +146,90 @@ describe('createEngine', () => {
     expect(snap.trace.hop).toBe(8);
     expect(snap.browserDisplay.status).toBe(200);
   });
+
+  // CHECKS: named DL-3 counter-example (finding 1-01) — the stage-6 machine
+  // consumes the shared helper's refusal branch: an all-down record aborts
+  // the walk at the LB hop with the stage-2 machine's refusal card, and the
+  // next traceHop restarts a fresh trace — no [object Object] target and no
+  // phantom hop past the refusal. Host-less /about puts the LB hop at
+  // hop 3, so the abort is visible three calls in.
+  it("DL-3 counter-example — an all-down stage-6 pool aborts the trace at the LB hop with the stage-2 machine's refusal card: neither [object Object] nor a phantom chain", () => {
+    const engine = createEngine({ seed: 42, stage: 6, users: 12 });
+    engine.setServerDown('10.11', true);
+    engine.setServerDown('10.12', true);
+    engine.traceHop({ method: 'GET', path: '/about' }); // hop 1 — the emit frame
+    engine.traceHop(); // hop 2 — routed to the LB
+    const snap = engine.traceHop(); // hop 3 — the LB hop, all-down
+    expect(snap.trace.hop).toBe(3);
+    expect(snap.trace.refused).toBe(true);
+    expect(snap.trace.targetServer).toBe(null);
+    expect(snap.lastFrame).toBe(
+      'LB 10.1 -> 10.11 | GET /about => connection refused (nothing enqueued)',
+    );
+    // The refusal card is the stage-2 machine's: the browser renders the
+    // refusal, no exchange finished, no served status inherited.
+    expect(snap.browserDisplay).toMatchObject({ status: 'REFUSED', response: null });
+    expect(snap.trace.status).toBe(null);
+    // The FOURTH call restarts clean at hop 1 — no phantom hop 4.
+    const restart = engine.traceHop();
+    expect(restart.trace.hop).toBe(1);
+    expect(restart.trace.refused).toBe(false);
+  });
+
+  // PINS: the byte-identity claim — the same all-down pool, same request,
+  // both machines: the stage-2 LB-hop frame string and the stage-6 one are
+  // equal (one refusal card vocabulary across the two trace machines).
+  it("the stage-6 all-down refusal frame is byte-identical to the stage-2 machine's for the same request", () => {
+    const allDown = (engine) => {
+      engine.setServerDown('10.11', true);
+      engine.setServerDown('10.12', true);
+      engine.traceHop({ method: 'GET', path: '/about' });
+      engine.traceHop();
+      return engine.traceHop(); // the LB hop, all-down
+    };
+    const stage2 = allDown(createEngine({ seed: 42, stage: 2 }));
+    const stage6 = allDown(createEngine({ seed: 42, stage: 6 }));
+    expect(stage2.lastFrame).toBe(
+      'LB 10.1 -> 10.11 | GET /about => connection refused (nothing enqueued)',
+    );
+    expect(stage6.lastFrame).toBe(stage2.lastFrame);
+  });
+
+  // CHECKS: the skip narration rides the same helper — a one-down pool
+  // narrates the crossed seat and the walk continues to a real served
+  // story (the clean both-up byte shape is pinned by the prelude and
+  // host-less tests above, so no new test for it here).
+  it('a one-down stage-6 pool narrates the crossed seat in the LB frame', () => {
+    const engine = createEngine({ seed: 42, stage: 6 });
+    engine.setServerDown('10.11', true);
+    engine.traceHop({ method: 'GET', path: '/about' }); // hop 1 — the emit frame
+    engine.traceHop(); // hop 2 — routed to the LB
+    const snap = engine.traceHop(); // hop 3 — the LB hop, 10.11 down
+    expect(snap.lastFrame).toBe('LB 10.1 -> 10.12 (GET /about) queued — 10.11 is down — skipped');
+    expect(snap.trace.refused).toBe(false);
+    expect(snap.trace.targetServer).toBe('10.12');
+    // The walk continues: the healthy backend serves the full chain.
+    let last;
+    for (let hop = 4; hop <= 8; hop++) last = engine.traceHop();
+    expect(last.trace.hop).toBe(8);
+    expect(last.trace.refused).toBe(false);
+    // The served story completed: the healthy backend's 200 rides the trace.
+    expect(last.trace.status).toBe(200);
+  });
+
+  // CHECKS: the parity contract's false leg (finding 1-02) — a normal
+  // hosted trace's completed record reads refused === false like stages
+  // 1-5; the true leg is the all-down counter-example above.
+  it('the stage-6 trace record exposes the same refused vocabulary as stages 1-5', () => {
+    const engine = createEngine({ stage: 6 });
+    let snap;
+    for (let hop = 1; hop <= 9; hop++) {
+      snap = engine.traceHop({ method: 'GET', path: 'example.com/about' });
+      expect(snap.trace.refused).toBe(false);
+    }
+    expect(snap.trace.hop).toBe(9);
+    expect(snap.browserDisplay.status).toBe(200);
+  });
 });
 
