+// DOCUMENTS: lbEnqueueHop — the one LB-hop hop site shared by trace.js's
+// stages 2-5 branch and trace-stage6.js's chainStep(2) (R1a, finding 1-01):
+// the enqueue runs the real round-robin selection over the live pool, the
+// frame is minted from the LB's own record, and the caller's trace mutates
+// in place (same seam discipline as the helpers above — no engine
+// closures). Returns { frame, refused }; the caller's final-hop logic
+// reads its own trace state.
+//
+// CHECKS: an all-down pool's refusal record aborts the trace at this hop —
+// trace.refused flips true, onRefusal fires, the frame names the refusal
+// and nothing was enqueued (no "[object Object]" token, no phantom chain);
+// a one-down pool narrates the crossed seat from lastSkip() ("— 10.11 is
+// down — skipped"); both backends up keeps the clean "LB ... queued" byte
+// shape. The skippedAt consult happens on the enqueued path only — a
+// refusal record read no cursor seat, so no skip text can ride it.
+export function lbEnqueueHop(trace, { serverAddress, lb, bumpTick, onRefusal }) {
+  const atTick = bumpTick();
+  const target = lb.enqueue({
+    id: `you:${atTick}`,
+    from: trace.from,
+    to: serverAddress,
+    request: trace.request,
+    atTick,
+    isYou: true,
+  });
+  if (target?.refused === true) {
+    trace.refused = true;
+    onRefusal?.(target);
+    return { frame: lbRefusedFrame(serverAddress, target, trace.request), refused: true };
+  }
+  trace.targetServer = target;
+  return {
+    frame: lbEnqueuedFrame(serverAddress, target, trace.request, lb.lastSkip?.()),
+    refused: false,
+  };
+}
+
