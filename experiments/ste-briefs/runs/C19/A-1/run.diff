diff --git a/test/sim/engine.test.js b/test/sim/engine.test.js
index 81e7e6c..cbc9782 100644
--- a/test/sim/engine.test.js
+++ b/test/sim/engine.test.js
@@ -351,3 +351,82 @@ describe('createEngine stage 6b — the CDN edge at 20.1', () => {
     expect(snap.cdn).toMatchObject({ hits: 0, misses: 0, fills: 0, ledger: [] });
   });
 });
+
+// PINS: R1a (finding 1-01) — the stage-6 machine's LB hop is the stages 2-5
+// machine's one implementation (trace-helpers.js lbEnqueueHop), so the
+// refusal record aborts the walk, the crossed seat is narrated, and the
+// `refused` field name matches across stages.
+describe('createEngine stage 6 — LB-hop parity with the stages 2-5 machine', () => {
+  it("DL-3 counter-example — an all-down stage-6 pool aborts the trace at the LB hop with the stage-2 machine's refusal card: neither [object Object] nor a phantom chain", () => {
+    const engine = createEngine({ seed: 42, stage: 6, arrivalProb: 0 });
+    engine.setServerDown('10.11', true);
+    engine.setServerDown('10.12', true);
+    let snap;
+    for (let hop = 1; hop <= 4; hop++) {
+      snap = engine.traceHop({ method: 'GET', path: 'example.com/about' });
+      expect(snap.trace.hop).toBe(hop);
+    }
+    // Hop 4 is the LB hop on a hosted path (ask + answer prelude first).
+    expect(snap.lastFrame).toBe(
+      'LB 10.1 -> 10.11 | GET /about => connection refused (nothing enqueued)',
+    );
+    expect(snap.trace.refused).toBe(true);
+    expect(snap.trace.targetServer).toBe(null);
+    expect(snap.trace.status).toBe(null);
+    expect(snap.refusedCount).toBe(1);
+    // The next traceHop() restarts clean at hop 1 — the walk ended at the
+    // refusal hop, so no phantom hop 5 of the dead trace exists.
+    snap = engine.traceHop();
+    expect(snap.trace.hop).toBe(1);
+    expect(snap.lastFrame).toBe('10.2 -> 10.1 | GET /about');
+    expect(engine.snapshot().served).toBe(0);
+  });
+
+  it("the stage-6 all-down refusal frame is byte-identical to the stage-2 machine's for the same request", () => {
+    const s2 = createEngine({ seed: 42, stage: 2, arrivalProb: 0 });
+    s2.setServerDown('10.11', true);
+    s2.setServerDown('10.12', true);
+    s2.traceHop(); // hop 1 — the emit estimate
+    s2.traceHop(); // hop 2 — routed to the LoadBalancer
+    const stage2 = s2.traceHop(); // hop 3 — the LB hop, all-down
+    expect(stage2.trace.hop).toBe(3);
+    const s6 = createEngine({ seed: 42, stage: 6, arrivalProb: 0 });
+    s6.setServerDown('10.11', true);
+    s6.setServerDown('10.12', true);
+    s6.traceHop({ method: 'GET', path: 'example.com/about' }); // hop 1 — the DNS ask
+    s6.traceHop(); // hop 2 — the ledger answer
+    s6.traceHop(); // hop 3 — routed to the LoadBalancer
+    const stage6 = s6.traceHop(); // hop 4 — the LB hop, all-down
+    expect(stage6.trace.hop).toBe(4);
+    // One request, one pool state: the two machines mint one frame string.
+    expect(stage2.lastFrame).toBe(stage6.lastFrame);
+    expect(stage6.lastFrame).toBe(
+      'LB 10.1 -> 10.11 | GET /about => connection refused (nothing enqueued)',
+    );
+  });
+
+  it('a one-down stage-6 pool narrates the crossed seat in the LB frame', () => {
+    const engine = createEngine({ seed: 42, stage: 6, arrivalProb: 0 });
+    engine.setServerDown('10.11', true);
+    let snap;
+    for (let hop = 1; hop <= 4; hop++) {
+      snap = engine.traceHop({ method: 'GET', path: 'example.com/about' });
+      expect(snap.trace.hop).toBe(hop);
+    }
+    expect(snap.lastFrame).toBe('LB 10.1 -> 10.12 (GET /about) queued — 10.11 is down — skipped');
+    expect(snap.trace.refused).toBe(false);
+    // The healthy-path pin lives in the DNS-prelude test's sibling frames —
+    // both-up keeps the clean "LB ... queued" byte shape (no new test).
+  });
+
+  it('the stage-6 trace record exposes the same refused vocabulary as stages 1-5', () => {
+    const engine = createEngine({ seed: 42, stage: 6 });
+    let snap;
+    for (let hop = 1; hop <= 9; hop++) {
+      snap = engine.traceHop({ method: 'GET', path: 'example.com/about' });
+      expect(snap.trace.hop).toBe(hop);
+    }
+    expect(snap.browserDisplay.status).toBe(200);
+    expect(engine.snapshot().trace.refused).toBe(false);
+  });
+});
