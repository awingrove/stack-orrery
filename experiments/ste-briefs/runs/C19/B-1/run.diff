@@ -351,3 +351,98 @@ describe('createEngine stage 6b — the CDN edge at 20.1', () => {
     expect(snap.cdn).toMatchObject({ hits: 0, misses: 0, fills: 0, ledger: [] });
   });
 });
+
+// R1a — the stage-6 LB hop tells the stage-2..5 machine's ONE refusal +
+// skip story: the helper (trace-helpers.js lbEnqueueHop) mutates the live
+// trace and narrates from the LB's own selection record, the refused walk
+// ends at hop 3 (the next traceHop restarts through the existing
+// `hop >= finalHop` path), and `trace.refused` reads the same vocabulary
+// stages 1-5 expose.
+describe('createEngine stage-6 LB-hop story parity (R1a)', () => {
+  it("DL-3 counter-example — an all-down stage-6 pool aborts the trace at the LB hop with the stage-2 machine's refusal card: neither [object Object] nor a phantom chain", () => {
+    const engine = createEngine({ seed: 42, stage: 6 });
+    engine.setServerDown('10.11', true);
+    engine.setServerDown('10.12', true);
+    // The hosted shape's LB hop is machine hop 4 (ask, answer, routed, LB —
+    // the byte-identical stage-5 chain replay above the DNS prelude), so
+    // the walk reaches the refusal card there.
+    let snap;
+    for (let hop = 1; hop <= 4; hop++) {
+      snap = engine.traceHop({ method: 'GET', path: 'example.com/about' });
+      expect(snap.trace.hop).toBe(hop);
+    }
+    // The LB hop is where the refusal record aborts the walk with the
+    // shared refusal card — no "[object Object]" enqueue narration.
+    expect(snap.lastFrame).toBe(
+      'LB 10.1 -> 10.11 | GET /about => connection refused (nothing enqueued)',
+    );
+    expect(snap.trace.refused).toBe(true);
+    expect(snap.trace.targetServer).toBe(null);
+    expect(snap.browserDisplay).toMatchObject({ status: 'REFUSED', response: null });
+    expect(snap.refusedCount).toBe(1);
+    // No phantom hop 5: the refused walk ENDED at the LB hop, so the next
+    // traceHop() restarts a fresh trace at hop 1 (the DNS ask again).
+    snap = engine.traceHop({ method: 'GET', path: 'example.com/about' });
+    expect(snap.trace.hop).toBe(1);
+    expect(snap.trace.refused).toBe(false);
+    expect(snap.lastFrame).toBe('10.2 -> 10.60 | who is example.com?');
+  });
+
+  it("the stage-6 all-down refusal frame is byte-identical to the stage-2 machine's for the same request", () => {
+    // The same all-down scenario on the stage-2 machine (seeded run like
+    // the failover suite's refusal pin): its LB-hop frame string must equal
+    // the stage-6 hop-3 frame string from the counter-example above — one
+    // refusal card, two machines.
+    const stage2 = createEngine({ seed: 42, stage: 2, users: 5, arrivalProb: 0 });
+    stage2.setServerDown('10.11', true);
+    stage2.setServerDown('10.12', true);
+    stage2.traceHop(); // hop 1 — the emit
+    stage2.traceHop(); // hop 2 — routed to the LB
+    const stage2Snap = stage2.traceHop(); // hop 3 — the LB hop, all-down
+    expect(stage2Snap.trace.refused).toBe(true);
+    expect(stage2Snap.lastFrame).toBe(
+      'LB 10.1 -> 10.11 | GET /about => connection refused (nothing enqueued)',
+    );
+    const stage6 = createEngine({ seed: 42, stage: 6 });
+    stage6.setServerDown('10.11', true);
+    stage6.setServerDown('10.12', true);
+    stage6.traceHop({ method: 'GET', path: 'example.com/about' }); // hop 1 — the ask
+    stage6.traceHop(); // hop 2 — the ledger answer
+    stage6.traceHop(); // hop 3 — routed to the LB (the byte-identical chain replay)
+    const stage6Snap = stage6.traceHop(); // hop 4 — the LB hop, all-down
+    expect(stage6Snap.trace.hop).toBe(4);
+    // Byte-identity is the pin: the two machines mint the same refusal
+    // card from the same LB record.
+    expect(stage6Snap.lastFrame).toBe(stage2Snap.lastFrame);
+  });
+
+  it('a one-down stage-6 pool narrates the crossed seat in the LB frame', () => {
+    const engine = createEngine({ seed: 42, stage: 6 });
+    engine.setServerDown('10.11', true);
+    let snap;
+    for (let hop = 1; hop <= 4; hop++) {
+      snap = engine.traceHop({ method: 'GET', path: 'example.com/about' });
+      expect(snap.trace.hop).toBe(hop);
+    }
+    // The health-aware cursor crossed the down 10.11 seat and picked
+    // 10.12 — the skip narration rides the enqueued frame, the walk does
+    // NOT abort (the healthy-path pin lives in the stage-5 chain tests).
+    expect(snap.lastFrame).toBe('LB 10.1 -> 10.12 (GET /about) queued — 10.11 is down — skipped');
+    expect(snap.trace.refused).toBe(false);
+  });
+
+  it('the stage-6 trace record exposes the same refused vocabulary as stages 1-5', () => {
+    // Test 1 pins refused === true on the refusal path; here the normal
+    // (both-up) hosted trace completes and the record still reads the same
+    // field as the other stages — false at the final render.
+    const engine = createEngine({ seed: 42, stage: 6 });
+    let snap;
+    for (let hop = 1; hop <= 9; hop++) {
+      snap = engine.traceHop({ method: 'GET', path: 'example.com/about' });
+      expect(snap.trace.hop).toBe(hop);
+    }
+    expect(snap.trace.hop).toBe(9);
+    expect(snap.browserDisplay.status).toBe(200);
+    expect(snap.trace.refused).toBe(false);
+  });
+});
