+// DOCUMENTS: R1a — the ONE LB hop shared by both trace machines (trace.js
+// stages 2-5 and trace-stage6.js's chain): the real lb.enqueue on the
+// request path, the refusal/skip narrative minted from the LB's own
+// selection state — one story, one implementation. The trace mutates in
+// place (targetServer / refused), no engine closures cross this seam.
+//
+// CHECKS: an all-down pool aborts the hop with the refusal card — the
+// record sets trace.refused and no target is kept (named counter-example:
+// the enqueued "queued" byte shape never narrates a refusal record, no
+// "[object Object]" on the wire). A one-down pool narrates the crossed
+// seat in the enqueued frame ("queued — <seat> is down — skipped", no
+// refusal). A both-up pool keeps the clean byte shape ("queued", no skip
+// suffix).
+export function lbEnqueueHop(trace, { serverAddress, lb, bumpTick, onRefusal }) {
+  const atTick = bumpTick();
+  const target = lb.enqueue({
+    id: `you:${atTick}`,
+    from: trace.from,
+    to: serverAddress,
+    request: trace.request,
+    atTick,
+    isYou: true,
+  });
+  if (target?.refused === true) {
+    trace.refused = true;
+    onRefusal?.(target);
+    return { frame: lbRefusedFrame(serverAddress, target, trace.request), refused: true };
+  }
+  trace.targetServer = target;
+  return {
+    frame: lbEnqueuedFrame(serverAddress, target, trace.request, lb.lastSkip?.()),
+    refused: false,
+  };
+}
