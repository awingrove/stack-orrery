+// R1a (docs/plans/2026-11-01-r1a-stage6-lb-hop-unification.md): the stage-6
+// trace machine tells the SAME LB story as the stage-2..5 machine — the
+// shared lbEnqueueHop hop, refusal termination at hop 3, one refused
+// vocabulary. Titles are manifest refs (SIM slice) — do not reword.
+describe('createEngine stage-6 LB-hop parity (R1a)', () => {
+  // PINS: the named counter-example — an all-down pool aborts the trace at
+  // the LB hop with the stage-2 machine's refusal card, and the FOURTH
+  // traceHop() restarts a fresh trace at hop 1: no [object Object] in any
+  // frame, no phantom hop 4. Host-less shape — the LB hop sits at hop 3
+  // here, where the brief's three-calls/hop-3 pins live byte-for-byte (the
+  // hosted shape's refusal is pinned in the parity test below).
+  it("DL-3 counter-example — an all-down stage-6 pool aborts the trace at the LB hop with the stage-2 machine's refusal card: neither [object Object] nor a phantom chain", () => {
+    const engine = createEngine({ seed: 42, stage: 6, users: 5, arrivalProb: 0 });
+    engine.setServerDown('10.11', true);
+    engine.setServerDown('10.12', true);
+    engine.traceHop({ method: 'GET', path: '/about' }); // hop 1 — the emit
+    engine.traceHop(); // hop 2 — routed to the LB
+    const snap = engine.traceHop(); // hop 3 — the LB hop, all-down
+    expect(snap.trace.hop).toBe(3);
+    expect(snap.lastFrame).toBe(
+      'LB 10.1 -> 10.11 | GET /about => connection refused (nothing enqueued)',
+    );
+    expect(snap.trace.refused).toBe(true);
+    expect(snap.trace.targetServer).toBe(null);
+    expect(snap.browserDisplay).toMatchObject({ status: 'REFUSED', response: null });
+    expect(snap.refusedCount).toBe(1); // the refusal funnel really answered
+    // The fourth call restarts cleanly at hop 1 of a fresh emission.
+    const restart = engine.traceHop({ method: 'GET', path: '/about' });
+    expect(restart.trace.hop).toBe(1);
+    expect(restart.trace.refused).toBe(false);
+    expect(restart.lastFrame).toBe('10.2 -> 10.1 | GET /about');
+  });
+
+  // PINS: one refusal card minted once — the stage-2 machine's LB-hop frame
+  // and the stage-6 hosted trace's refusal frame are byte-identical for the
+  // same request (the hosted shape's LB hop sits at hop 4, after the DNS
+  // ask/answer prelude and the re-pointed route hop).
+  it("the stage-6 all-down refusal frame is byte-identical to the stage-2 machine's for the same request", () => {
+    const stage2 = createEngine({ seed: 42, stage: 2, users: 5, arrivalProb: 0 });
+    stage2.setServerDown('10.11', true);
+    stage2.setServerDown('10.12', true);
+    stage2.traceHop(); // hop 1 — the emit
+    stage2.traceHop(); // hop 2 — routed to the LB
+    const stage2Frame = stage2.traceHop().lastFrame; // hop 3 — the LB hop
+    const stage6 = createEngine({ seed: 42, stage: 6, users: 5, arrivalProb: 0 });
+    stage6.setServerDown('10.11', true);
+    stage6.setServerDown('10.12', true);
+    stage6.traceHop({ method: 'GET', path: 'example.com/about' }); // hop 1 — the DNS ask
+    stage6.traceHop(); // hop 2 — the ledger answer
+    stage6.traceHop(); // hop 3 — routed to the LB
+    const stage6Snap = stage6.traceHop(); // hop 4 — the LB hop
+    expect(stage6Snap.trace.hop).toBe(4);
+    expect(stage2Frame).toBe(stage6Snap.lastFrame);
+    expect(stage6Snap.lastFrame).toBe(
+      'LB 10.1 -> 10.11 | GET /about => connection refused (nothing enqueued)',
+    );
+  });
+
+  // PINS: the healthy-with-a-skip path — the frame reads the LB's own
+  // lastSkip() and names the crossed seat; the refusal card's byte shape
+  // lives in the pins above and the healthy 9-hop story already shipped.
+  it('a one-down stage-6 pool narrates the crossed seat in the LB frame', () => {
+    const engine = createEngine({ seed: 42, stage: 6, users: 5, arrivalProb: 0 });
+    engine.setServerDown('10.11', true);
+    engine.traceHop({ method: 'GET', path: '/about' }); // hop 1
+    engine.traceHop(); // hop 2
+    const snap = engine.traceHop(); // hop 3 — the skip narration
+    expect(snap.trace.hop).toBe(3);
+    expect(snap.lastFrame).toBe('LB 10.1 -> 10.12 (GET /about) queued — 10.11 is down — skipped');
+    expect(snap.trace.refused).toBe(false);
+    expect(snap.trace.targetServer).toBe('10.12');
+  });
+
+  // PINS: the vocabulary parity on the happy path — a completed normal
+  // hosted trace reads refused false, same field the refusal path sets true.
+  it('the stage-6 trace record exposes the same refused vocabulary as stages 1-5', () => {
+    const engine = createEngine({ stage: 6 });
+    let snap;
+    for (let hop = 1; hop <= 9; hop++) {
+      snap = engine.traceHop({ method: 'GET', path: 'example.com/about' });
+      expect(snap.trace.hop).toBe(hop);
+    }
+    expect(snap.trace.refused).toBe(false);
+    expect(snap.browserDisplay.status).toBe(200);
+  });
+});
