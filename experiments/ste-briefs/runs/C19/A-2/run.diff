+    engine.traceHop({ method: 'GET', path: '/about' }); // hop 2 — routed to the LB
+    const snap = engine.traceHop({ method: 'GET', path: '/about' }); // hop 3 — the LB hop
+    expect(snap.lastFrame).toBe('LB 10.1 -> 10.12 (GET /about) queued — 10.11 is down — skipped');
+    expect(snap.trace.refused).toBe(false);
+  });
+
