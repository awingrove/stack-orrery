   });
+
+  // CHECKS (DL-3 counter-example): an all-down stage-6 pool tells the
+  // stage-2 machine's LB story — the refusal card at the LB hop (hop 3 on
+  // the host-less /about shape), the walk ENDED there (finalHop 3), and
+  // the next traceHop restarting a fresh emission at hop 1. Two pins in
+  // one: no "[object Object] queued" and no phantom hop 4.
+  it("DL-3 counter-example — an all-down stage-6 pool aborts the trace at the LB hop with the stage-2 machine's refusal card: neither [object Object] nor a phantom chain", () => {
+    const engine = createEngine({ seed: 42, stage: 6, users: 5, arrivalProb: 0 });
+    engine.setServerDown('10.11', true);
+    engine.setServerDown('10.12', true);
+    let snap = null;
+    for (let hop = 1; hop <= 3; hop++) {
+      snap = engine.traceHop({ method: 'GET', path: '/about' });
+      expect(snap.trace.hop).toBe(hop);
+    }
+    expect(snap.lastFrame).toBe(
+      'LB 10.1 -> 10.11 | GET /about => connection refused (nothing enqueued)',
+    );
+    expect(snap.trace.refused).toBe(true);
+    // The fourth call restarts a fresh emission at hop 1 — the refused
+    // trace cannot walk a phantom hop 4.
+    snap = engine.traceHop({ method: 'GET', path: '/about' });
+    expect(snap.trace.hop).toBe(1);
+    expect(snap.trace.refused).toBe(false);
+    expect(snap.lastFrame).toBe('10.2 -> 10.1 | GET /about');
+  });
+
+  // CHECKS: one LB story across the machines — the stage-2 machine's LB-hop
+  // refusal frame (its hop 3) and the stage-6 machine's LB-hop refusal
+  // frame (hop 3 of the host-less shape) are byte-identical for the same
+  // request, both minted by the shared lbEnqueueHop seam.
+  it("the stage-6 all-down refusal frame is byte-identical to the stage-2 machine's for the same request", () => {
+    const stage2 = createEngine({ seed: 42, stage: 2, users: 5, arrivalProb: 0 });
+    stage2.setServerDown('10.11', true);
+    stage2.setServerDown('10.12', true);
+    stage2.traceHop(); // hop 1 — the emit frame
+    stage2.traceHop(); // hop 2 — routed to the LB
+    const stage2Snap = stage2.traceHop(); // hop 3 — the LB hop, all-down
+    const stage6 = createEngine({ seed: 42, stage: 6, users: 5, arrivalProb: 0 });
+    stage6.setServerDown('10.11', true);
+    stage6.setServerDown('10.12', true);
+    stage6.traceHop({ method: 'GET', path: '/about' }); // hop 1 — the emit frame
+    stage6.traceHop({ method: 'GET', path: '/about' }); // hop 2 — routed to the LB
+    const stage6Snap = stage6.traceHop({ method: 'GET', path: '/about' }); // hop 3 — the LB hop
+    expect(stage6Snap.lastFrame).toBe(stage2Snap.lastFrame);
+  });
+
+  // CHECKS: named counter-example — a one-down pool does NOT refuse: the
+  // LB hop narrates the crossed seat and the trace stays served (the
+  // healthy-path byte shape is pinned by the prelude tests above).
