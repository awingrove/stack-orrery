+// DOCUMENTS: the B-6b LB hop as one shared implementation — the stage-5
+// branch text moved here (byte-shape-identical) so the stage-2..5 machine
+// (trace.js) and the stage-6 machine (trace-stage6.js chainStep s5===2)
+// enqueue through the same seam: the helper mutates the live trace in
+// place (refusal stamp, target pick) and mints the frame from the LB's own
+// selection record, with onRefusal handed in as the engine's negative
+// branch (same seam discipline as the other helpers: no engine closures).
+//
+// CHECKS: one LB story across both machines — an all-down pool narrates
+// the refusal card (`LB ... -> <seat> | <request> => connection refused
+// (nothing enqueued)`) and stamps trace.refused for the caller's
+// termination contract, never a "[object Object] queued" phantom; a
+// one-down pool narrates the crossed seat in the enqueued frame (`queued —
+// <seat> is down — skipped`) without aborting the trace; a both-up pool
+// keeps the clean byte shape (`queued`) — the frames are the same pair the
+// frame builders above mint, so the stage-2 and stage-6 machines cannot
+// drift apart.
+export function lbEnqueueHop(trace, { serverAddress, lb, bumpTick, onRefusal }) {
+  const atTick = bumpTick();
+  const target = lb.enqueue({
+    id: `you:${atTick}`,
+    from: trace.from,
+    to: serverAddress,
+    request: trace.request,
+    atTick,
+    isYou: true,
+  });
+  if (target?.refused === true) {
+    trace.refused = true;
+    onRefusal?.(target);
+    return { frame: lbRefusedFrame(serverAddress, target, trace.request), refused: true };
+  }
+  trace.targetServer = target;
+  return {
+    frame: lbEnqueuedFrame(serverAddress, target, trace.request, lb.lastSkip?.()),
+    refused: false,
+  };
+}
+
