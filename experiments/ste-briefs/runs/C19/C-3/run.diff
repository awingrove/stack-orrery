 });
 
+// CHECKS (R1a): the stage-6 chain runs the stages 2-5 machine's ONE LB
+// story. Named counter-examples pinned: an all-down pool aborts with the
+// refusal card (hosted the LB hop is hop 4 behind the DNS prelude, host-less
+// it IS hop 3 — the next emission restarts either way, no phantom chain),
+// a one-down pool narrates the crossed seat, and a completed trace exposes
+// refused: false like stages 1-5.
+describe('createEngine stage 6 — one LB story across the trace machines', () => {
+  it("DL-3 counter-example — an all-down stage-6 pool aborts the trace at the LB hop with the stage-2 machine's refusal card: neither [object Object] nor a phantom chain", () => {
+    const engine = createEngine({ stage: 6 });
+    engine.setServerDown('10.11', true);
+    engine.setServerDown('10.12', true);
+    // Hosted shape: the DNS prelude shifts the LB hop to hop 4 — the
+    // refusal card still lands on the LB hop itself.
+    engine.traceHop({ method: 'GET', path: 'example.com/about' });
+    engine.traceHop(); // the ledger answer
+    engine.traceHop(); // routed to the LB
+    let snap = engine.traceHop(); // the LB hop, all-down
+    expect(snap.trace.hop).toBe(4);
+    expect(snap.trace.refused).toBe(true);
+    expect(snap.lastFrame).toBe(
+      'LB 10.1 -> 10.11 | GET /about => connection refused (nothing enqueued)',
+    );
+    expect(snap.browserDisplay).toMatchObject({ status: 'REFUSED', response: null });
+    // Host-less shape: the LB hop IS hop 3 — three traceHop() calls.
+    engine.traceHop({ method: 'GET', path: '/about' });
+    engine.traceHop();
+    snap = engine.traceHop();
+    expect(snap.trace.hop).toBe(3);
+    expect(snap.trace.refused).toBe(true);
+    expect(snap.lastFrame).toBe(
+      'LB 10.1 -> 10.11 | GET /about => connection refused (nothing enqueued)',
+    );
+    // The restart is a fresh emission through the ordinary hop >= finalHop
+    // path — no phantom hop of the dead walk, no [object Object] frame.
+    engine.setServerDown('10.11', false);
+    engine.setServerDown('10.12', false);
+    snap = engine.traceHop();
+    expect(snap.trace.hop).toBe(1);
+    expect(snap.trace.refused).toBe(false);
+    expect(snap.lastFrame).toBe('10.2 -> 10.1 | GET /about');
+  });
+
+  it("the stage-6 all-down refusal frame is byte-identical to the stage-2 machine's for the same request", () => {
+    const stage2 = createEngine({ seed: 42, stage: 2, users: 5, arrivalProb: 0 });
+    stage2.setServerDown('10.11', true);
+    stage2.setServerDown('10.12', true);
+    stage2.traceHop(); // hop 1 - the emit estimate
+    stage2.traceHop(); // hop 2 - routed to the LB
+    const stage2Frame = stage2.traceHop().lastFrame; // hop 3 - the LB hop, all-down
+
+    const stage6 = createEngine({ stage: 6 });
+    stage6.setServerDown('10.11', true);
+    stage6.setServerDown('10.12', true);
+    stage6.traceHop(); // hop 1 - the emit
+    stage6.traceHop(); // hop 2 - routed to the LB
+    const stage6Frame = stage6.traceHop().lastFrame; // hop 3 - the LB hop, all-down
+
+    expect(stage6Frame).toBe(stage2Frame);
+    expect(stage6Frame).toBe(
+      'LB 10.1 -> 10.11 | GET /about => connection refused (nothing enqueued)',
+    );
+  });
+
+  it('a one-down stage-6 pool narrates the crossed seat in the LB frame', () => {
+    const engine = createEngine({ stage: 6 });
+    engine.setServerDown('10.11', true);
+    engine.traceHop(); // hop 1 - the emit
+    engine.traceHop(); // hop 2 - routed to the LB
+    const snap = engine.traceHop(); // hop 3 - the LB hop, only 10.11 down
+    expect(snap.trace.hop).toBe(3);
+    expect(snap.trace.refused).toBe(false);
+    expect(snap.lastFrame).toBe('LB 10.1 -> 10.12 (GET /about) queued — 10.11 is down — skipped');
+  });
+
+  it('the stage-6 trace record exposes the same refused vocabulary as stages 1-5', () => {
+    const engine = createEngine({ stage: 6 });
+    for (let hop = 1; hop <= 9; hop++) {
+      engine.traceHop({ method: 'GET', path: 'example.com/about' });
+    }
+    expect(engine.snapshot().trace.refused).toBe(false);
+  });
+});
+
