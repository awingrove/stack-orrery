+// CHECKS: named counter-examples — an all-down pool returns the refusal
+// record, the trace refuses, onRefusal fires, and the frame is the refusal
+// card with no served data; a one-down pool narrates the crossed seat the
+// cursor skipped ("— 10.11 is down — skipped"); a healthy pool keeps the
+// clean byte shape (no skip clause, targetServer set to the real pick).
+export function lbEnqueueHop(trace, { serverAddress, lb, bumpTick, onRefusal }) {
+  const atTick = bumpTick();
+  const target = lb.enqueue({
+    id: `you:${atTick}`,
+    from: trace.from,
+    to: serverAddress,
+    request: trace.request,
+    atTick,
+    isYou: true,
+  });
+  if (target?.refused === true) {
+    trace.refused = true;
+    onRefusal?.(target);
+    return { frame: lbRefusedFrame(serverAddress, target, trace.request), refused: true };
+  }
+  const skippedAt = lb.lastSkip?.();
+  trace.targetServer = target;
+  return {
+    frame: lbEnqueuedFrame(serverAddress, target, trace.request, skippedAt),
+    refused: false,
+  };
+}
