+    const stage2 = createEngine({ seed: 42, stage: 2, users: 5, arrivalProb: 0 });
+    stage2.setServerDown('10.11', true);
+    stage2.setServerDown('10.12', true);
+    stage2.traceHop(); // hop 1 — emit
+    stage2.traceHop(); // hop 2 — routed to the LB
+    const s2 = stage2.traceHop(); // hop 3 — the LB hop, all-down
+
+    const stage6 = createEngine({ stage: 6 });
+    stage6.setServerDown('10.11', true);
+    stage6.setServerDown('10.12', true);
+    stage6.traceHop({ method: 'GET', path: '/about' });
+    stage6.traceHop();
+    const s6 = stage6.traceHop(); // hop 3 — the same LB hop on stage 6
+
+    expect(s2.trace.hop).toBe(3);
+    expect(s6.trace.hop).toBe(3);
+    expect(s6.lastFrame).toBe(s2.lastFrame);
+    expect(s6.lastFrame).toBe(
+      'LB 10.1 -> 10.11 | GET /about => connection refused (nothing enqueued)',
+    );
+  });
+
+  // PINS: R1a — a one-down pool keeps the served story: the frame names
