+
+  // PINS: R1a — the stage-6 chain runs the same LB hop as the stage-2..5
+  // machine: an all-down pool stamps `refused` and aborts at hop 3 with
+  // the refusal card (no served data, no record object on the wire), and
+  // a fourth traceHop restarts a fresh emission — no phantom hop 4.
+  it("DL-3 counter-example — an all-down stage-6 pool aborts the trace at the LB hop with the stage-2 machine's refusal card: neither [object Object] nor a phantom chain", () => {
+    const engine = createEngine({ stage: 6 });
+    engine.setServerDown('10.11', true);
+    engine.setServerDown('10.12', true);
+    engine.traceHop({ method: 'GET', path: '/about' }); // hop 1 — the emit estimate
+    engine.traceHop(); // hop 2 — routed to the LB
+    const snap = engine.traceHop(); // hop 3 — the LB hop, all-down
+    expect(snap.trace.hop).toBe(3);
+    expect(snap.lastFrame).toBe(
+      'LB 10.1 -> 10.11 | GET /about => connection refused (nothing enqueued)',
+    );
+    expect(snap.trace.refused).toBe(true);
+    expect(snap.trace.targetServer).toBe(null);
+    // The FOURTH traceHop restarts clean at hop 1 — no phantom hop 4.
+    expect(engine.traceHop().trace.hop).toBe(1);
+  });
+
+  // PINS: R1a — the two machines mint byte-identical refusal frames for
+  // the same all-down pool and the same request (one helper, one shape).
