+// DOCUMENTS: the LB-hop branch both trace machines run (trace.js's
+// stages 2-5 branch and trace-stage6.js's chainStep s5 === 2): one real
+// lb.enqueue per call, the outcome read off the record the transport
+// handed back. Extracted by the R1a parity fix (finding 1-01) so the
+// stage-6 machine tells the same LB story as the stage-2..5 machine from
+// one implementation — the branch text moved here byte-shape-identical
+// from trace.js's stage-5 LB branch. trace mutates in place (the same
+// seam discipline as the other helpers: no engine closures, no return of
+// a rebuilt trace), and onRefusal stays optional.
+//
+// CHECKS: the named counter-examples on this one seam — an all-down pool
+// returns the transport's refusal record: trace.refused flips true, the
+// frame is the refusal card ("connection refused (nothing enqueued)",
+// no [object Object], trace.targetServer untouched), and onRefusal fires
+// with the record; a one-down pool enqueues at the seat the cursor crossed
+// and the frame names the skip ("10.11 is down — skipped") with
+// trace.refused staying false; a both-up pool keeps the clean byte shape
+// ("LB 10.1 -> 10.11 (GET /about) queued"). Returns { frame, refused }.
+export function lbEnqueueHop(trace, { serverAddress, lb, bumpTick, onRefusal }) {
+  const atTick = bumpTick();
+  const target = lb.enqueue({
+    id: `you:${atTick}`,
+    from: trace.from,
+    to: serverAddress,
+    request: trace.request,
+    atTick,
+    isYou: true,
+  });
+  if (target?.refused === true) {
+    trace.refused = true;
+    onRefusal?.(target);
+    return { frame: lbRefusedFrame(serverAddress, target, trace.request), refused: true };
+  }
+  trace.targetServer = target;
+  return {
+    frame: lbEnqueuedFrame(serverAddress, target, trace.request, lb.lastSkip?.()),
+    refused: false,
+  };
+}
