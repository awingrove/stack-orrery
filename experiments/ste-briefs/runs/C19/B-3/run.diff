@@ -351,3 +351,89 @@ describe('createEngine stage 6b — the CDN edge at 20.1', () => {
     expect(snap.cdn).toMatchObject({ hits: 0, misses: 0, fills: 0, ledger: [] });
   });
 });
+
+// R1a — stage-6 LB-hop unification
+// (docs/plans/2026-11-01-r1a-stage6-lb-hop-unification.md): the stage-6
+// chain's LB hop is the shared helper the stage-2..5 machine runs — an
+// all-down pool aborts with the refusal card, a one-down pool narrates the
+// crossed seat, and trace.refused reads the same on every stage. Titles
+// are manifest refs (SIM slice tests) — do not reword. Geometry note: the
+// brief's sketch places the refusal at hosted hop 3 after three calls, but
+// the machine's pinned hosted shape (the 9-hop test above) puts the LB hop
+// at hop 4 (ask, answer, route, LB), so the frames and flags pin at that
+// real geometry.
+describe('createEngine stage 6 — LB-hop refusal parity with the stage-2 machine', () => {
+  it("DL-3 counter-example — an all-down stage-6 pool aborts the trace at the LB hop with the stage-2 machine's refusal card: neither [object Object] nor a phantom chain", () => {
+    const engine = createEngine({ seed: 42, stage: 6, users: 5, arrivalProb: 0 });
+    engine.setServerDown('10.11', true);
+    engine.setServerDown('10.12', true);
+    let snap;
+    for (let hop = 1; hop <= 3; hop++) {
+      snap = engine.traceHop({ method: 'GET', path: 'example.com/about' });
+      expect(snap.trace.hop).toBe(hop);
+    }
+    snap = engine.traceHop(); // hop 4 — the LB hop, all-down pool
+    expect(snap.trace.hop).toBe(4);
+    expect(snap.trace.refused).toBe(true);
+    expect(snap.trace.targetServer).toBe(null);
+    expect(snap.trace.status).toBe(null);
+    expect(snap.lastFrame).toBe(
+      'LB 10.1 -> 10.11 | GET /about => connection refused (nothing enqueued)',
+    );
+    expect(snap.lastFrame).not.toContain('[object Object]');
+    // The walk is over: the next traceHop restarts a fresh trace at hop 1
+    // — no phantom hop narrated from the dead trace's [object Object].
+    snap = engine.traceHop({ method: 'GET', path: 'example.com/about' });
+    expect(snap.trace.hop).toBe(1);
+    expect(snap.trace.refused).toBe(false);
+    expect(snap.lastFrame).toBe('10.2 -> 10.60 | who is example.com?');
+  });
+
+  it("the stage-6 all-down refusal frame is byte-identical to the stage-2 machine's for the same request", () => {
+    const stage2 = createEngine({ seed: 42, stage: 2, users: 5, arrivalProb: 0 });
+    stage2.setServerDown('10.11', true);
+    stage2.setServerDown('10.12', true);
+    stage2.traceHop(); // hop 1 — the emit estimate
+    stage2.traceHop(); // hop 2 — routed to the LoadBalancer
+    const lbHop2 = stage2.traceHop(); // the machine's LB branch (trace.hop 2 -> 3)
+    const stage6 = createEngine({ seed: 42, stage: 6, users: 5, arrivalProb: 0 });
+    stage6.setServerDown('10.11', true);
+    stage6.setServerDown('10.12', true);
+    for (let hop = 1; hop <= 3; hop++) {
+      stage6.traceHop({ method: 'GET', path: 'example.com/about' });
+    }
+    const lbHop6 = stage6.traceHop(); // the shared LB hop on the hosted shape
+    expect(lbHop2.trace.hop).toBe(3);
+    expect(lbHop2.lastFrame).toBe(
+      'LB 10.1 -> 10.11 | GET /about => connection refused (nothing enqueued)',
+    );
+    expect(lbHop6.trace.hop).toBe(4);
+    expect(lbHop6.lastFrame).toBe(lbHop2.lastFrame);
+  });
+
+  it('a one-down stage-6 pool narrates the crossed seat in the LB frame', () => {
+    const engine = createEngine({ seed: 42, stage: 6, users: 5, arrivalProb: 0 });
+    engine.setServerDown('10.11', true);
+    for (let hop = 1; hop <= 3; hop++) {
+      const snap = engine.traceHop({ method: 'GET', path: 'example.com/about' });
+      expect(snap.trace.hop).toBe(hop);
+    }
+    const snap = engine.traceHop(); // hop 4 — the LB hop, only 10.11 down
+    expect(snap.trace.hop).toBe(4);
+    expect(snap.trace.refused).toBe(false); // a skip is not a refusal — the story continues
+    expect(snap.lastFrame).toBe('LB 10.1 -> 10.12 (GET /about) queued — 10.11 is down — skipped');
+  });
+
+  it('the stage-6 trace record exposes the same refused vocabulary as stages 1-5', () => {
+    const engine = createEngine({ seed: 42, stage: 6, users: 5, arrivalProb: 0 });
+    let snap;
+    for (let hop = 1; hop <= 9; hop++) {
+      snap = engine.traceHop({ method: 'GET', path: 'example.com/about' });
+      expect(snap.trace.hop).toBe(hop);
+    }
+    // A clean both-up run keeps the stage-side parity field false.
+    expect(snap.trace.refused).toBe(false);
+    expect(engine.snapshot().trace.refused).toBe(false);
+    expect(engine.snapshot().browserDisplay.status).toBe(200);
+  });
+});
